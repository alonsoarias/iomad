{{!
    @template format_trail/local/content

    Trail Format - Main course content template for Moodle 4.5 compatibility.

    This template renders the course content for Trail format.
    It extends the core course format templates while providing
    Trail-specific functionality.

    Context variables required:
    * title - The course title
    * format - The format name (trail)
    * initialsection - Section 0 data (optional)
    * sections - Array of section data
    * hasnavigation - Whether single section navigation is shown
    * sectionnavigation - Navigation data for single section view
    * sectionselector - Selector data for single section view
    * singlesection - Data for the currently viewed section
    * sectionreturn - Section return number
    * numsections - Add section data
    * bulkedittools - Bulk edit tools data

    Example context (json):
    {
        "title": "Trail Course",
        "format": "trail",
        "courseid": 2
    }
}}
<div id="{{uniqid}}-course-format" class="format-trail-content">
    <h2 class="accesshide">{{{title}}}</h2>
    {{#hasnavigation}}
    <p class="text-right"><a href="{{{maincoursepage}}}">{{#str}}maincoursepage{{/str}}</a></p>
    {{/hasnavigation}}
    {{{completionhelp}}}
    <ul class="{{format}}" data-for="course_sectionlist">
        {{#initialsection}}
            {{$ core_courseformat/local/content/section }}
                {{> format_trail/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/initialsection}}
        {{#sections}}
            {{$ core_courseformat/local/content/section }}
                {{> format_trail/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/sections}}
    </ul>
    {{#hasnavigation}}
    <div class="single-section">
        {{#sectionnavigation}}
            {{$ core_courseformat/local/content/sectionnavigation }}
                {{> core_courseformat/local/content/sectionnavigation }}
            {{/ core_courseformat/local/content/sectionnavigation }}
        {{/sectionnavigation}}
        <ul class="{{format}}">
        {{#singlesection}}
            {{$ core_courseformat/local/content/section }}
                {{> format_trail/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/singlesection}}
        </ul>
        {{#sectionselector}}
            {{$ core_courseformat/local/content/sectionselector }}
                {{> core_courseformat/local/content/sectionselector }}
            {{/ core_courseformat/local/content/sectionselector }}
        {{/sectionselector}}
    </div>
    {{/hasnavigation}}
    {{#numsections}}
        {{$ core_courseformat/local/content/addsection}}
            {{> core_courseformat/local/content/addsection}}
        {{/ core_courseformat/local/content/addsection}}
    {{/numsections}}
    {{#bulkedittools}}
        {{$ core_courseformat/local/content/bulkedittools}}
            {{> core_courseformat/local/content/bulkedittools}}
        {{/ core_courseformat/local/content/bulkedittools}}
    {{/bulkedittools}}
</div>
