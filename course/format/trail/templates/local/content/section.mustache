{{!
    @template format_trail/local/content/section

    Trail Format - Section template for Moodle 4.5 compatibility.

    This template renders a single section in Trail format.

    Context variables required:
    * id - Section ID
    * num - Section number
    * header - Section header data
    * cmlist - Course modules list
    * summary - Section summary
    * iscurrent - Whether this is the current section
    * ishidden - Whether section is hidden
    * hasimage - Whether section has an image
    * sectionimage - Section image data

    Example context (json):
    {
        "id": 1,
        "num": 1,
        "header": {
            "name": "Section 1"
        }
    }
}}
{{$ core_courseformat/local/content/section }}
<li id="section-{{num}}"
    class="section main clearfix{{#ishidden}} hidden{{/ishidden}}{{#iscurrent}} current{{/iscurrent}}{{#isstealth}} orphaned{{/isstealth}}"
    data-sectionid="{{id}}"
    data-sectionreturnid="{{sectionreturnid}}"
    data-for="section"
    data-id="{{id}}"
    data-number="{{num}}"
    {{#contentcollapsed}}data-collapsed="true"{{/contentcollapsed}}
    >
    {{#header}}
        {{$ core_courseformat/local/content/section/header }}
            {{> core_courseformat/local/content/section/header }}
        {{/ core_courseformat/local/content/section/header }}
    {{/header}}
    <div class="content">
        {{#summary}}
            {{$ core_courseformat/local/content/section/summary }}
                {{> core_courseformat/local/content/section/summary }}
            {{/ core_courseformat/local/content/section/summary }}
        {{/summary}}
        {{#availability}}
            {{> format_trail/availability }}
        {{/availability}}
        {{#cmlist}}
            {{$ core_courseformat/local/content/section/cmlist }}
                {{> core_courseformat/local/content/section/cmlist }}
            {{/ core_courseformat/local/content/section/cmlist }}
        {{/cmlist}}
        {{#insertafter}}
            {{$ core_courseformat/local/content/section/cmlist }}
                {{> core_courseformat/local/content/section/cmlist }}
            {{/ core_courseformat/local/content/section/cmlist }}
        {{/insertafter}}
    </div>
    {{#controlmenu}}
        {{$ core_courseformat/local/content/section/controlmenu }}
            {{> core_courseformat/local/content/section/controlmenu }}
        {{/ core_courseformat/local/content/section/controlmenu }}
    {{/controlmenu}}
</li>
{{/ core_courseformat/local/content/section }}
