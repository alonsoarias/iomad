{{!
    @template local_jobboard/pages/documents/bulk_validate

    Bulk document validation page template with Bootstrap 5.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle (string) - Page title
    * stats (object) - Statistics {totalpending, typecount}
    * vacancies (array) - Vacancies for filter
    * selectedvacancyid (number) - Selected vacancy ID
    * documenttypes (array) - Document types for filter
    * selecteddocumenttype (string) - Selected document type
    * pendingbytype (array) - Pending documents by type
    * haspendingbytype (bool) - Has pending by type
    * hastypeselected (bool) - Has type selected
    * documents (array) - Documents to display
    * hasdocuments (bool) - Has documents
    * typename (string) - Selected type name
    * documentcount (number) - Document count
    * rejectreasons (array) - Rejection reasons
    * filterformurl (string) - Filter form URL
    * actionformurl (string) - Action form URL
    * dashboardurl (string) - Dashboard URL
    * reviewurl (string) - Review URL
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "stats": {"totalpending": 25, "typecount": 5}
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-bulk-validate" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton jb-skeleton-text" style="width: 40%; height: 2em;"></div>
        <div class="d-flex gap-2">
            <div class="jb-skeleton jb-skeleton-text" style="width: 120px; height: 40px;"></div>
            <div class="jb-skeleton jb-skeleton-text" style="width: 120px; height: 40px;"></div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="card"><div class="card-body"><div class="jb-skeleton jb-skeleton-text" style="height: 80px;"></div></div></div>
        </div>
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="card"><div class="card-body"><div class="jb-skeleton jb-skeleton-text" style="height: 80px;"></div></div></div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex gap-3">
                <div class="jb-skeleton jb-skeleton-text" style="width: 200px; height: 40px;"></div>
                <div class="jb-skeleton jb-skeleton-text" style="width: 200px; height: 40px;"></div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            <div class="jb-skeleton jb-skeleton-text" style="height: 300px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-bulk-validate" data-region="jobboard-bulk-validate">
    {{! Skip Link for Accessibility }}
    <a href="#bulk-validate-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 jb-fade-in">
        <h1 class="fs-3 mb-0">
            <i class="fa fa-list-check text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h1>
        <div class="btn-group" role="group" aria-label="{{#str}}actions{{/str}}">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
            <a href="{{reviewurl}}" class="btn btn-outline-primary">
                <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                {{#str}}reviewapplications, local_jobboard{{/str}}
            </a>
        </div>
    </header>

    {{! Statistics Cards }}
    <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
        <div class="col-lg-6 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: 0.05s;">
            <div class="card shadow-sm jb-hover-lift">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded bg-warning text-white p-3 me-3">
                        <i class="fa fa-clock fa-lg" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold">{{stats.totalpending}}</div>
                        <div class="small text-muted">{{#str}}pendingvalidation, local_jobboard{{/str}}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: 0.1s;">
            <div class="card shadow-sm jb-hover-lift">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded bg-primary text-white p-3 me-3">
                        <i class="fa fa-folder fa-lg" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold">{{stats.typecount}}</div>
                        <div class="small text-muted">{{#str}}documenttypes, local_jobboard{{/str}}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{! Filter Form }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" aria-label="{{#str}}filter{{/str}}" style="animation-delay: 0.15s;">
        <div class="card-body">
            <form method="get" action="{{filterformurl}}" class="jb-filter-form" role="search" aria-label="{{#str}}filterdocuments, local_jobboard{{/str}}">
                <div class="row align-items-end">
                    <div class="col-lg-4 col-md-6 mb-2">
                        <label class="form-label small text-muted" for="vacancyid">{{#str}}vacancy, local_jobboard{{/str}}</label>
                        <select name="vacancyid" id="vacancyid" class="form-select">
                            <option value="0">{{#str}}allvacancies, local_jobboard{{/str}}</option>
                            {{#vacancies}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/vacancies}}
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-2">
                        <label class="form-label small text-muted" for="documenttype">{{#str}}documenttype, local_jobboard{{/str}}</label>
                        <select name="documenttype" id="documenttype" class="form-select">
                            <option value="">{{#str}}selecttype, local_jobboard{{/str}}</option>
                            {{#documenttypes}}
                            <option value="{{code}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/documenttypes}}
                        </select>
                    </div>
                    <div class="col-lg-4 col-md-12 mb-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa fa-filter me-1" aria-hidden="true"></i>
                            {{#str}}filter{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    {{! Main Content }}
    <main id="bulk-validate-main-content">
        {{! Pending By Type Summary }}
        {{#haspendingbytype}}
        <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="pending-heading" style="animation-delay: 0.2s;">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="fs-5 mb-0" id="pending-heading">
                    <i class="fa fa-folder-open text-warning me-2" aria-hidden="true"></i>
                    {{#str}}pendingbytype, local_jobboard{{/str}}
                </h2>
            </div>
            <div class="card-body">
                <div class="row">
                    {{#pendingbytype}}
                    <div class="col-lg-3 col-md-4 col-6 mb-3">
                        <a href="{{selecturl}}" class="text-decoration-none d-block">
                            <div class="card h-100 jb-hover-lift {{#isselected}}border-primary{{/isselected}} {{^isselected}}border-warning{{/isselected}}">
                                <div class="card-body text-center py-3">
                                    <h3 class="fs-2 mb-1 {{#isselected}}text-primary{{/isselected}}{{^isselected}}text-warning{{/isselected}}">
                                        {{count}}
                                    </h3>
                                    <p class="mb-0 small text-muted fw-medium">{{typename}}</p>
                                    {{#isselected}}
                                    <span class="badge bg-primary mt-2">
                                        <i class="fa fa-check me-1" aria-hidden="true"></i>
                                        {{#str}}selected{{/str}}
                                    </span>
                                    {{/isselected}}
                                </div>
                            </div>
                        </a>
                    </div>
                    {{/pendingbytype}}
                </div>
            </div>
        </section>
        {{/haspendingbytype}}

        {{! Document List (when type selected) }}
        {{#hastypeselected}}
        <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="documents-heading" style="animation-delay: 0.25s;">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="fs-5 mb-0" id="documents-heading">
                    <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                    {{typename}}
                </h2>
                <span class="badge rounded-pill bg-warning">
                    {{documentcount}} {{#str}}documents, local_jobboard{{/str}}
                </span>
            </div>
            <div class="card-body">
                {{#hasdocuments}}
                <form method="post" action="{{actionformurl}}" id="bulk-validate-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="vacancyid" value="{{selectedvacancyid}}">
                    <input type="hidden" name="documenttype" value="{{selecteddocumenttype}}">

                    {{! Select All Checkbox }}
                    <div class="d-flex align-items-center mb-3 p-2 bg-light rounded">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="selectall" aria-label="{{#str}}selectall{{/str}}">
                            <label class="form-check-label fw-bold" for="selectall">
                                {{#str}}selectall{{/str}}
                            </label>
                        </div>
                        <span class="ms-auto small text-muted" id="selection-count">
                            0 {{#str}}selected{{/str}}
                        </span>
                    </div>

                    {{! Documents Table }}
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="{{#str}}documentstovalidate, local_jobboard{{/str}}">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 40px;"></th>
                                    <th scope="col">{{#str}}applicant, local_jobboard{{/str}}</th>
                                    <th scope="col" class="d-none d-md-table-cell">{{#str}}vacancy, local_jobboard{{/str}}</th>
                                    <th scope="col">{{#str}}filename, local_jobboard{{/str}}</th>
                                    <th scope="col" class="d-none d-lg-table-cell">{{#str}}uploaded, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}actions{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#documents}}
                                <tr data-document-id="{{id}}">
                                    <td>
                                        <div class="form-check">
                                            <input type="checkbox" name="documents[]" value="{{id}}" class="form-check-input doc-checkbox" aria-label="{{#str}}selectdocument, local_jobboard{{/str}} {{filename}}">
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-light me-2 d-flex align-items-center justify-content-center d-none d-sm-flex" style="width: 36px; height: 36px;">
                                                <i class="fa fa-user text-muted" aria-hidden="true"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">{{applicantname}}</strong>
                                                <small class="text-muted">{{applicantemail}}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <code class="text-primary">{{vacancycode}}</code>
                                    </td>
                                    <td>
                                        <code class="small">{{filename}}</code>
                                    </td>
                                    <td class="d-none d-lg-table-cell">
                                        <small class="text-muted">{{uploadeddate}}</small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            {{#downloadurl}}
                                            <a href="{{downloadurl}}" class="btn btn-outline-primary" target="_blank" title="{{#str}}view{{/str}}">
                                                <i class="fa fa-eye" aria-hidden="true"></i>
                                                <span class="visually-hidden">{{#str}}view{{/str}}</span>
                                            </a>
                                            {{/downloadurl}}
                                            <a href="{{validateurl}}" class="btn btn-outline-success" title="{{#str}}validate, local_jobboard{{/str}}">
                                                <i class="fa fa-check" aria-hidden="true"></i>
                                                <span class="visually-hidden">{{#str}}validate, local_jobboard{{/str}}</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                {{/documents}}
                            </tbody>
                        </table>
                    </div>

                    {{! Bulk Action Panel }}
                    <div class="card mt-4 bg-light">
                        <div class="card-header bg-transparent">
                            <h3 class="fs-6 mb-0">
                                <i class="fa fa-list-check me-2" aria-hidden="true"></i>
                                {{#str}}bulkactions, local_jobboard{{/str}}
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                {{! Approve Selected }}
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <div class="card border-success h-100">
                                        <div class="card-body">
                                            <h4 class="card-title fs-6 text-success">
                                                <i class="fa fa-check me-2" aria-hidden="true"></i>
                                                {{#str}}approveselected, local_jobboard{{/str}}
                                            </h4>
                                            <div class="mb-3">
                                                <label for="notes_approve" class="form-label small text-muted">
                                                    {{#str}}notes, local_jobboard{{/str}}
                                                </label>
                                                <textarea name="notes" id="notes_approve" class="form-control" rows="2" placeholder="{{#str}}optionalnotes, local_jobboard{{/str}}"></textarea>
                                            </div>
                                            <button type="submit" name="action" value="validate" class="btn btn-success w-100">
                                                <i class="fa fa-check me-2" aria-hidden="true"></i>
                                                {{#str}}approveselected, local_jobboard{{/str}}
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                {{! Reject Selected }}
                                <div class="col-md-6">
                                    <div class="card border-danger h-100">
                                        <div class="card-body">
                                            <h4 class="card-title fs-6 text-danger">
                                                <i class="fa fa-xmark me-2" aria-hidden="true"></i>
                                                {{#str}}rejectselected, local_jobboard{{/str}}
                                            </h4>
                                            <div class="mb-3">
                                                <label for="rejectreason" class="form-label small text-muted">
                                                    {{#str}}rejectreason, local_jobboard{{/str}}
                                                </label>
                                                <select name="rejectreason" id="rejectreason" class="form-select">
                                                    <option value="">{{#str}}selectreason, local_jobboard{{/str}}</option>
                                                    {{#rejectreasons}}
                                                    <option value="{{code}}">{{label}}</option>
                                                    {{/rejectreasons}}
                                                </select>
                                            </div>
                                            <button type="submit" name="action" value="reject" class="btn btn-danger w-100">
                                                <i class="fa fa-xmark me-2" aria-hidden="true"></i>
                                                {{#str}}rejectselected, local_jobboard{{/str}}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                {{! JavaScript for select all }}
                {{#js}}
                (function() {
                    var selectAll = document.getElementById('selectall');
                    var checkboxes = document.querySelectorAll('.doc-checkbox');
                    var countDisplay = document.getElementById('selection-count');

                    function updateCount() {
                        var count = document.querySelectorAll('.doc-checkbox:checked').length;
                        countDisplay.textContent = count + ' {{#str}}selected{{/str}}';
                    }

                    selectAll.addEventListener('change', function() {
                        var self = this;
                        checkboxes.forEach(function(cb) {
                            cb.checked = self.checked;
                        });
                        updateCount();
                    });

                    checkboxes.forEach(function(cb) {
                        cb.addEventListener('change', updateCount);
                    });
                })();
                {{/js}}

                {{/hasdocuments}}
                {{^hasdocuments}}
                <div class="text-center py-4" role="status">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light mb-3" style="width: 80px; height: 80px;">
                        <i class="fa fa-circle-check fa-2x text-success" aria-hidden="true"></i>
                    </div>
                    <h3 class="fs-5 text-muted mb-2">{{#str}}nodocumentspending, local_jobboard{{/str}}</h3>
                    <p class="text-muted mb-0">{{#str}}alldocumentsvalidated, local_jobboard{{/str}}</p>
                </div>
                {{/hasdocuments}}
            </div>
        </section>
        {{/hastypeselected}}
    </main>

    {{! Navigation Footer }}
    <nav class="d-flex flex-wrap justify-content-center gap-2 mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-gauge me-2" aria-hidden="true"></i>
            {{#str}}dashboard, local_jobboard{{/str}}
        </a>
        <a href="{{assignreviewerurl}}" class="btn btn-outline-primary">
            <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
            {{#str}}assignreviewer, local_jobboard{{/str}}
        </a>
        {{#canviewreports}}
        <a href="{{reportsurl}}" class="btn btn-outline-info">
            <i class="fa fa-chart-bar me-2" aria-hidden="true"></i>
            {{#str}}reports, local_jobboard{{/str}}
        </a>
        {{/canviewreports}}
    </nav>
</div>
{{/loading}}
