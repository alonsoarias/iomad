{{!
    @template local_jobboard/pages/admin/dashboard

    Main dashboard page template with Bootstrap 5 from Moodle 4.5.
    Provides role-based views for admins, reviewers, and applicants.

    Context variables:
    * isadmin (bool) - User is admin/manager
    * isreviewer (bool) - User can review
    * isapplicant (bool) - User can apply
    * isvieweronly (bool) - User can only view
    * welcome (object) - Welcome section {username, rolelabel, message, greeting}
    * showpubliclink (bool) - Show public page link
    * publicurl (string) - URL to public page
    * applicationsurl (string) - URL to applications
    * stats (array) - Admin stat cards
    * applicantstats (array) - Applicant stat cards
    * adminsections (array) - Admin section cards
    * workflowsections (array) - Workflow cards
    * reportsections (array) - Report cards
    * configsections (array) - Config cards
    * applicantsections (array) - Applicant section cards
    * reviewersection (object) - Reviewer section data
    * alerts (array) - Alert messages
    * hasnextconvocatoria (bool) - Has upcoming deadline
    * nextconvocatoria (object) - Next convocatoria data
    * hasrecentactivity (bool) - Has recent activity
    * recentactivity (array) - Recent activity items
}}
<div class="local-jobboard-dashboard" data-region="jobboard-dashboard">
    {{! Skip Link for Accessibility }}
    <a href="#main-content" class="visually-hidden-focusable">
        {{#str}}skiptomain, local_jobboard{{/str}}
    </a>

    {{! Welcome Header }}
    <header class="bg-primary text-white rounded p-4 mb-4 jb-fade-in">
        <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center mb-2">
                    <h1 class="fs-4 fw-bold mb-0 me-3">
                        {{#welcome.greeting}}{{welcome.greeting}}{{/welcome.greeting}}
                        {{^welcome.greeting}}{{#str}}dashboard, local_jobboard{{/str}}{{/welcome.greeting}}
                    </h1>
                    {{#welcome.rolelabel}}
                    <span class="badge bg-light text-dark rounded-pill">
                        <i class="fa fa-user-tag me-1" aria-hidden="true"></i>
                        {{welcome.rolelabel}}
                    </span>
                    {{/welcome.rolelabel}}
                </div>
                {{#welcome.message}}
                <p class="mb-0 opacity-75 lead">{{welcome.message}}</p>
                {{/welcome.message}}

                {{! Quick Actions }}
                {{#showpubliclink}}
                <nav class="mt-3 pt-3 border-top border-light d-flex flex-wrap gap-2" aria-label="{{#str}}quickactions, local_jobboard{{/str}}">
                    <a href="{{publicurl}}" class="btn btn-light btn-sm jb-hover-lift">
                        <i class="fa fa-globe me-2" aria-hidden="true"></i>
                        {{#str}}viewpublicpage, local_jobboard{{/str}}
                    </a>
                    {{#isapplicant}}
                    <a href="{{applicationsurl}}" class="btn btn-outline-light btn-sm jb-hover-lift">
                        <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                        {{#str}}myapplications, local_jobboard{{/str}}
                    </a>
                    {{/isapplicant}}
                    {{#isadmin}}
                    <a href="{{manageurl}}" class="btn btn-outline-light btn-sm jb-hover-lift">
                        <i class="fa fa-gears me-2" aria-hidden="true"></i>
                        {{#str}}managevacancies, local_jobboard{{/str}}
                    </a>
                    {{/isadmin}}
                </nav>
                {{/showpubliclink}}
            </div>
            <div class="d-none d-md-block ms-4" aria-hidden="true">
                <i class="fa fa-briefcase fa-4x opacity-25"></i>
            </div>
        </div>
    </header>

    {{! Main Content Area }}
    <main id="main-content">
        {{! System Alerts }}
        {{#alerts.0}}
        <section class="mb-4" role="region" aria-label="{{#str}}notifications{{/str}}">
            {{#alerts}}
            <div class="jb-fade-in-up">
                {{> local_jobboard/components/alert }}
            </div>
            {{/alerts}}
        </section>
        {{/alerts.0}}

        {{! Urgent: Next Convocatoria Deadline Banner }}
        {{#hasnextconvocatoria}}
        <div class="alert alert-{{nextconvocatoria.alertclass}} d-flex flex-column flex-md-row align-items-start align-items-md-center mb-4 jb-fade-in-up"
             role="alert"
             aria-live="polite">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <div class="flex-shrink-0 me-3">
                    {{#nextconvocatoria.iscritical}}
                    <i class="fa fa-triangle-exclamation fa-2x" aria-hidden="true"></i>
                    {{/nextconvocatoria.iscritical}}
                    {{^nextconvocatoria.iscritical}}
                    <i class="fa fa-calendar-xmark fa-2x" aria-hidden="true"></i>
                    {{/nextconvocatoria.iscritical}}
                </div>
                <div>
                    <div class="fw-bold mb-1">
                        {{#nextconvocatoria.iscritical}}
                        <span class="badge bg-danger me-2">
                            <i class="fa fa-fire me-1" aria-hidden="true"></i>
                            {{#str}}critical, local_jobboard{{/str}}
                        </span>
                        {{/nextconvocatoria.iscritical}}
                        <span class="text-dark">{{nextconvocatoria.code}}</span> - {{nextconvocatoria.name}}
                    </div>
                    <small class="d-block">
                        <i class="fa fa-clock me-1" aria-hidden="true"></i>
                        {{#str}}closingon, local_jobboard{{/str}} <strong>{{nextconvocatoria.enddate}}</strong>
                        <span class="badge bg-{{nextconvocatoria.alertclass}} ms-2">
                            {{nextconvocatoria.daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                        </span>
                    </small>
                </div>
            </div>
            <div class="ms-md-auto mt-2 mt-md-0">
                <a href="{{nextconvocatoria.url}}" class="btn btn-{{nextconvocatoria.alertclass}} btn-sm jb-hover-lift">
                    <i class="fa fa-eye me-1" aria-hidden="true"></i>
                    {{#str}}viewdetails, local_jobboard{{/str}}
                </a>
            </div>
        </div>
        {{/hasnextconvocatoria}}

        {{! ==================== ADMIN/MANAGER SECTION ==================== }}
        {{#isadmin}}
        <section class="mb-5" aria-labelledby="admin-heading">
            <header class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fs-5 text-muted mb-0" id="admin-heading">
                    <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                    {{#str}}administracion, local_jobboard{{/str}}
                </h2>
            </header>

            {{! Statistics Dashboard }}
            {{#stats.0}}
            <div class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
                {{#stats}}
                <div class="col-lg-3 col-md-6 mb-3">
                    {{> local_jobboard/components/stat_card }}
                </div>
                {{/stats}}
            </div>
            {{/stats.0}}

            {{! Admin Action Cards }}
            {{#adminsections.0}}
            <div class="row jb-stagger">
                {{#adminsections}}
                <div class="col-lg-4 col-md-6 mb-4">
                    <article class="card h-100 shadow-sm jb-hover-lift">
                        <div class="card-header bg-{{color}} text-white">
                            <h3 class="fs-6 mb-0 d-flex align-items-center">
                                {{#icon}}<i class="fa fa-{{icon}} me-2" aria-hidden="true"></i>{{/icon}}
                                {{title}}
                            </h3>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="text-muted mb-3">{{description}}</p>
                            {{#features.0}}
                            <ul class="list-unstyled small text-muted mb-0 mt-auto">
                                {{#features}}
                                <li class="mb-1 d-flex align-items-start">
                                    <i class="fa fa-circle-check text-{{../color}} me-2 mt-1" aria-hidden="true"></i>
                                    <span>{{.}}</span>
                                </li>
                                {{/features}}
                            </ul>
                            {{/features.0}}
                        </div>
                        <div class="card-footer bg-white">
                            <a href="{{url}}" class="btn btn-{{color}} w-100 d-flex justify-content-between align-items-center">
                                <span>{{buttonlabel}}</span>
                                <i class="fa fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                </div>
                {{/adminsections}}
            </div>
            {{/adminsections.0}}

            {{! Workflow Management Section }}
            {{#workflowsections.0}}
            <div class="border-top my-4 pt-4">
                <h3 class="fs-6 text-muted mb-3">
                    <i class="fa fa-diagram-project me-2" aria-hidden="true"></i>
                    {{#str}}workflowmanagement, local_jobboard{{/str}}
                </h3>
            </div>
            <div class="row mb-4 jb-stagger">
                {{#workflowsections}}
                <div class="col-md-4 col-sm-6 mb-3">
                    <div class="card border-0 bg-light h-100 jb-hover-shadow">
                        <div class="card-body d-flex align-items-start">
                            <div class="rounded-circle bg-{{color}} text-white p-3 me-3 flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                {{#icon}}<i class="fa fa-{{icon}}" aria-hidden="true"></i>{{/icon}}
                            </div>
                            <div class="flex-grow-1">
                                <h4 class="fs-6 mb-1">{{title}}</h4>
                                <p class="small text-muted mb-2">{{description}}</p>
                                <a href="{{url}}" class="btn btn-sm btn-outline-{{color}}">
                                    {{#buttonicon}}<i class="fa fa-{{buttonicon}} me-1" aria-hidden="true"></i>{{/buttonicon}}
                                    {{buttonlabel}}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/workflowsections}}
            </div>
            {{/workflowsections.0}}

            {{! Reports Section }}
            {{#reportsections.0}}
            <div class="border-top my-4 pt-4">
                <h3 class="fs-6 text-muted mb-3">
                    <i class="fa fa-chart-bar me-2" aria-hidden="true"></i>
                    {{#str}}reportsanddata, local_jobboard{{/str}}
                </h3>
            </div>
            <div class="row mb-4 jb-stagger">
                {{#reportsections}}
                <div class="col-md-4 col-sm-6 mb-3">
                    <div class="card border-0 bg-light h-100 jb-hover-shadow">
                        <div class="card-body d-flex align-items-start">
                            <div class="rounded-circle bg-{{color}} text-white p-3 me-3 flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                {{#icon}}<i class="fa fa-{{icon}}" aria-hidden="true"></i>{{/icon}}
                            </div>
                            <div class="flex-grow-1">
                                <h4 class="fs-6 mb-1">{{title}}</h4>
                                <p class="small text-muted mb-2">{{description}}</p>
                                <a href="{{url}}" class="btn btn-sm btn-outline-{{color}}">
                                    {{#buttonicon}}<i class="fa fa-{{buttonicon}} me-1" aria-hidden="true"></i>{{/buttonicon}}
                                    {{buttonlabel}}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/reportsections}}
            </div>
            {{/reportsections.0}}

            {{! Configuration Section }}
            {{#configsections.0}}
            <div class="border-top my-4 pt-4">
                <h3 class="fs-6 text-muted mb-3">
                    <i class="fa fa-gears me-2" aria-hidden="true"></i>
                    {{#str}}systemconfiguration, local_jobboard{{/str}}
                </h3>
            </div>
            <div class="row mb-4 jb-stagger">
                {{#configsections}}
                <div class="col-md-3 col-sm-6 mb-3">
                    <a href="{{url}}" class="card border-0 bg-light h-100 jb-hover-lift text-decoration-none">
                        <div class="card-body text-center py-4">
                            <div class="rounded-circle bg-{{color}} text-white p-3 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                {{#icon}}<i class="fa fa-{{icon}} fa-lg" aria-hidden="true"></i>{{/icon}}
                            </div>
                            <h4 class="fs-6 mb-1 text-dark">{{title}}</h4>
                            <p class="small text-muted mb-0">{{description}}</p>
                        </div>
                    </a>
                </div>
                {{/configsections}}
            </div>
            {{/configsections.0}}
        </section>
        {{/isadmin}}

        {{! ==================== REVIEWER SECTION ==================== }}
        {{#isreviewer}}
        <section class="mb-5" aria-labelledby="reviewer-heading">
            <header class="mb-4">
                <h2 class="fs-5 text-muted mb-0" id="reviewer-heading">
                    <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                    {{#str}}reviewertasks, local_jobboard{{/str}}
                </h2>
            </header>

            <div class="row">
                <div class="col-lg-8 mb-4 mb-lg-0">
                    <article class="card shadow-sm h-100 jb-fade-in-up">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h3 class="fs-6 mb-0">
                                <i class="fa fa-list-check me-2" aria-hidden="true"></i>
                                {{#str}}myreviews, local_jobboard{{/str}}
                            </h3>
                            {{#reviewersection.pendingcount}}
                            <span class="badge bg-warning text-dark">
                                {{reviewersection.pendingcount}} {{#str}}pending, local_jobboard{{/str}}
                            </span>
                            {{/reviewersection.pendingcount}}
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">{{#str}}myreviews_desc, local_jobboard{{/str}}</p>

                            {{#reviewersection.haspendingreview}}
                            <div class="alert alert-warning d-flex align-items-center" role="alert">
                                <i class="fa fa-triangle-exclamation fa-lg me-3" aria-hidden="true"></i>
                                <div>
                                    <strong>{{#str}}attentionrequired, local_jobboard{{/str}}</strong>
                                    <p class="mb-0 small">{{#str}}pending_reviews_alert, local_jobboard, {{reviewersection.pendingcount}}{{/str}}</p>
                                </div>
                            </div>
                            {{/reviewersection.haspendingreview}}

                            {{^reviewersection.haspendingreview}}
                            <div class="alert alert-success d-flex align-items-center" role="status">
                                <i class="fa fa-circle-check fa-lg me-3" aria-hidden="true"></i>
                                <span>{{#str}}nopendingreview, local_jobboard{{/str}}</span>
                            </div>
                            {{/reviewersection.haspendingreview}}
                        </div>
                        <div class="card-footer bg-white">
                            <a href="{{reviewersection.url}}" class="btn btn-info jb-hover-lift">
                                <i class="fa fa-clipboard-list me-2" aria-hidden="true"></i>
                                {{#str}}viewmyreviews, local_jobboard{{/str}}
                                <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                </div>
                <div class="col-lg-4">
                    <div class="card shadow-sm h-100 bg-info text-white jb-fade-in-up">
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <div class="mb-3">
                                <i class="fa fa-award fa-3x opacity-75" aria-hidden="true"></i>
                            </div>
                            <p class="display-4 fw-bold mb-1">{{reviewersection.completedcount}}</p>
                            <p class="mb-0 opacity-75">{{#str}}completedreviews, local_jobboard{{/str}}</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        {{/isreviewer}}

        {{! ==================== APPLICANT SECTION ==================== }}
        {{#isapplicant}}
        <section class="mb-5" aria-labelledby="applicant-heading">
            <header class="mb-4">
                <h2 class="fs-5 text-muted mb-0" id="applicant-heading">
                    <i class="fa fa-user me-2" aria-hidden="true"></i>
                    {{#str}}myapplications, local_jobboard{{/str}}
                </h2>
            </header>

            {{! Applicant Statistics }}
            {{#applicantstats.0}}
            <div class="row mb-4" role="region" aria-label="{{#str}}mystats, local_jobboard{{/str}}">
                {{#applicantstats}}
                <div class="col-lg-3 col-md-6 mb-3">
                    {{> local_jobboard/components/stat_card }}
                </div>
                {{/applicantstats}}
            </div>
            {{/applicantstats.0}}

            {{! Applicant Action Cards }}
            {{#applicantsections.0}}
            <div class="row jb-stagger">
                {{#applicantsections}}
                <div class="col-lg-6 mb-4">
                    <article class="card h-100 shadow-sm jb-hover-lift">
                        <div class="card-header bg-{{color}} text-white">
                            <h3 class="fs-6 mb-0">
                                {{#icon}}<i class="fa fa-{{icon}} me-2" aria-hidden="true"></i>{{/icon}}
                                {{title}}
                            </h3>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">{{description}}</p>
                            {{#alert}}
                            <div class="alert alert-{{alerttype}} d-flex align-items-center mb-0" role="alert">
                                <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
                                <span class="small">{{alert}}</span>
                            </div>
                            {{/alert}}
                        </div>
                        <div class="card-footer bg-white">
                            <a href="{{url}}" class="btn btn-{{color}} d-flex justify-content-between align-items-center">
                                <span>{{buttonlabel}}</span>
                                <i class="fa fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                </div>
                {{/applicantsections}}
            </div>
            {{/applicantsections.0}}
        </section>
        {{/isapplicant}}

        {{! ==================== VIEWER ONLY SECTION ==================== }}
        {{#isvieweronly}}
        <section>
            {{> local_jobboard/components/empty_state }}
        </section>
        {{/isvieweronly}}

        {{! ==================== RECENT ACTIVITY TIMELINE ==================== }}
        {{#hasrecentactivity}}
        <section class="mt-5" aria-labelledby="activity-heading">
            <header class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fs-5 text-muted mb-0" id="activity-heading">
                    <i class="fa fa-clock-rotate-left me-2" aria-hidden="true"></i>
                    {{#str}}recentactivity, local_jobboard{{/str}}
                </h2>
                {{#viewallactivityurl}}
                <a href="{{viewallactivityurl}}" class="btn btn-sm btn-outline-secondary jb-hover-lift">
                    <i class="fa fa-list me-1" aria-hidden="true"></i>
                    {{#str}}viewall, local_jobboard{{/str}}
                </a>
                {{/viewallactivityurl}}
            </header>
            <div class="card shadow-sm jb-fade-in-up">
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        {{#recentactivity}}
                        <li class="list-group-item d-flex align-items-start py-3">
                            <span class="rounded-circle bg-{{color}} text-white p-2 me-3 flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fa fa-{{icon}}" aria-hidden="true"></i>
                            </span>
                            <div class="flex-grow-1 min-width-0">
                                <a href="{{url}}" class="text-dark text-decoration-none fw-medium d-block text-truncate">
                                    {{label}}
                                </a>
                                <small class="text-muted d-flex align-items-center mt-1">
                                    <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                    <time datetime="{{timecreatediso}}">{{timecreated}}</time>
                                </small>
                            </div>
                            <a href="{{url}}" class="btn btn-sm btn-outline-secondary ms-2 flex-shrink-0" aria-label="{{#str}}view{{/str}}">
                                <i class="fa fa-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                        {{/recentactivity}}
                    </ul>
                </div>
            </div>
        </section>
        {{/hasrecentactivity}}
    </main>
</div>

{{#js}}
require(['local_jobboard/dashboard'], function(dashboard) {
    dashboard.init();
});
{{/js}}
