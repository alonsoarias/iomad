{{!
    @template local_jobboard/pages/admin/doctype_form

    Document type add/edit form page with Bootstrap 5.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pagetitle - string - Page title
    * backurl - string - Back URL
    * isedit - bool - Whether editing existing doctype
    * formhtml - string - Rendered form HTML
    * doctype - object - Document type data if editing {name, code, description}
    * loading - bool - Show skeleton loading state

    Example context (json):
    {
        "pagetitle": "Add Document Type",
        "backurl": "/local/jobboard/admin/doctypes.php",
        "isedit": false
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-doctypes" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton jb-skeleton-text" style="width: 200px; height: 2em;"></div>
        <div class="jb-skeleton jb-skeleton-text" style="width: 100px; height: 38px;"></div>
    </div>
    <div class="card">
        <div class="card-header"><div class="jb-skeleton jb-skeleton-text" style="width: 180px;"></div></div>
        <div class="card-body">
            <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton jb-skeleton-text" style="width: 150px; height: 45px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-doctypes" data-region="jobboard-doctype-form">
    {{! Skip Link for Accessibility }}
    <a href="#doctype-form-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h3 class="mb-0">
            {{#isedit}}
            <i class="fa fa-pen-to-square text-primary me-2" aria-hidden="true"></i>
            {{/isedit}}
            {{^isedit}}
            <i class="fa fa-circle-plus text-success me-2" aria-hidden="true"></i>
            {{/isedit}}
            {{pagetitle}}
        </h3>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}back, local_jobboard{{/str}}
        </a>
    </header>

    {{! Edit Mode Info Banner }}
    {{#isedit}}
    <div class="alert alert-info d-flex align-items-center mb-4 jb-fade-in-up" role="status" style="animation-delay: 0.05s;">
        <i class="fa fa-circle-info me-3" aria-hidden="true"></i>
        <div>
            <strong class="d-block">{{#str}}editingdoctype, local_jobboard{{/str}}</strong>
            {{#doctype.code}}
            <small class="text-muted">{{#str}}code, local_jobboard{{/str}}: <code>{{doctype.code}}</code></small>
            {{/doctype.code}}
        </div>
    </div>
    {{/isedit}}

    {{! Form Card }}
    <main id="doctype-form-content">
        <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.1s;">
            <div class="card-header bg-white d-flex align-items-center">
                <div class="rounded-circle bg-{{#isedit}}primary{{/isedit}}{{^isedit}}success{{/isedit}} text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    {{#isedit}}<i class="fa fa-pen-to-square" aria-hidden="true"></i>{{/isedit}}
                    {{^isedit}}<i class="fa fa-plus" aria-hidden="true"></i>{{/isedit}}
                </div>
                <h5 class="mb-0">
                    {{#isedit}}{{#str}}editdoctypeform, local_jobboard{{/str}}{{/isedit}}
                    {{^isedit}}{{#str}}adddoctypeform, local_jobboard{{/str}}{{/isedit}}
                </h5>
            </div>
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </div>
    </main>

    {{! Help Section }}
    <aside class="mt-4 jb-fade-in" style="animation-delay: 0.15s;">
        <div class="alert alert-light d-flex align-items-start">
            <i class="fa fa-lightbulb text-warning me-3 mt-1" aria-hidden="true"></i>
            <div>
                <strong class="d-block mb-1">{{#str}}doctypehelptitle, local_jobboard{{/str}}</strong>
                <p class="mb-0 small text-muted">{{#str}}doctypehelpdesc, local_jobboard{{/str}}</p>
            </div>
        </div>
    </aside>
</div>
{{/loading}}
