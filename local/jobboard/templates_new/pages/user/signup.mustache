{{!
    @template local_jobboard/pages/user/signup

    Signup page template for Job Board applicants with Bootstrap 5.
    Includes multi-step progress indicator and accessibility features.

    Context variables:
    * title (string) - Page title
    * intro (string) - Introduction text
    * vacancy (object) - Optional vacancy context {title, code, location}
    * applyingfortext (string) - "Applying for" label
    * codetext (string) - "Code" label
    * alreadyaccounttext (string) - Already have account text
    * loginurl (string) - Login URL
    * logintext (string) - Login button text
    * requiredfieldstext (string) - Required fields notice
    * formhtml (string) - Rendered form HTML
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "title": "Create Account",
        "vacancy": {"title": "Professor", "code": "VAC-001"}
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-signup-page container-fluid px-3 px-md-5" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="text-center mb-4 pb-3 border-bottom">
        <div class="jb-skeleton jb-skeleton-avatar mx-auto mb-3" style="width: 80px; height: 80px;"></div>
        <div class="jb-skeleton jb-skeleton-text mx-auto mb-2" style="width: 50%; height: 2em;"></div>
        <div class="jb-skeleton jb-skeleton-text mx-auto" style="width: 70%;"></div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="jb-skeleton jb-skeleton-text mb-2" style="width: 60%;"></div>
            <div class="jb-skeleton jb-skeleton-text" style="width: 40%;"></div>
        </div>
    </div>
    <div class="mb-4">
        <div class="d-flex justify-content-between">
            <div class="jb-skeleton jb-skeleton-avatar" style="width: 40px; height: 40px;"></div>
            <div class="jb-skeleton jb-skeleton-avatar" style="width: 40px; height: 40px;"></div>
            <div class="jb-skeleton jb-skeleton-avatar" style="width: 40px; height: 40px;"></div>
            <div class="jb-skeleton jb-skeleton-avatar" style="width: 40px; height: 40px;"></div>
            <div class="jb-skeleton jb-skeleton-avatar" style="width: 40px; height: 40px;"></div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-signup-page container-fluid px-3 px-md-5" data-region="jobboard-signup">
    {{! Skip Link for Accessibility }}
    <a href="#signup-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Header Section }}
    <header class="text-center mb-4 pb-3 border-bottom jb-fade-in">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white mb-3" style="width: 80px; height: 80px;">
            <i class="fa fa-user-plus fa-2x" aria-hidden="true"></i>
        </div>
        <h1 class="h3 mb-2">{{title}}</h1>
        {{#intro}}
        <p class="text-muted mb-0">{{intro}}</p>
        {{/intro}}
    </header>

    {{! Vacancy Info Card (if applying to specific vacancy) }}
    {{#vacancy}}
    <div class="card mb-4 border-primary jb-fade-in-up" style="animation-delay: 0.1s;">
        <div class="card-header bg-primary text-white py-2">
            <h2 class="h6 mb-0 d-flex align-items-center">
                <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                {{applyingfortext}}
            </h2>
        </div>
        <div class="card-body py-3">
            <h3 class="card-title h5 mb-2 fw-bold">{{vacancy.title}}</h3>
            <div class="d-flex flex-wrap gap-3 small">
                <span>
                    <i class="fa fa-hashtag text-muted me-1" aria-hidden="true"></i>
                    <strong>{{vacancy.code}}</strong>
                </span>
                {{#vacancy.location}}
                <span>
                    <i class="fa fa-location-dot text-muted me-1" aria-hidden="true"></i>
                    {{vacancy.location}}
                </span>
                {{/vacancy.location}}
            </div>
        </div>
    </div>
    {{/vacancy}}

    {{! Already have account notice }}
    <div class="alert alert-info d-flex align-items-center mb-4 jb-fade-in-up" role="alert" style="animation-delay: 0.15s;">
        <i class="fa fa-circle-info me-3 fs-4" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <strong>{{alreadyaccounttext}}</strong>
        </div>
        <a href="{{loginurl}}" class="btn btn-sm btn-primary jb-hover-lift">
            <i class="fa fa-right-to-bracket me-1" aria-hidden="true"></i>
            {{logintext}}
        </a>
    </div>

    {{! Required fields notice }}
    <p class="text-muted small mb-4 jb-fade-in" aria-live="polite">
        <span class="text-danger" aria-hidden="true">*</span>
        {{requiredfieldstext}}
    </p>

    {{! Progress Steps Indicator }}
    <nav class="jb-progress-container mb-4 jb-fade-in-up" id="jb-signup-progress" aria-label="{{#str}}signup_progress, local_jobboard{{/str}}" style="animation-delay: 0.2s;">
        <p class="text-muted small mb-2 text-center">
            {{#str}}signup_progress, local_jobboard{{/str}}
        </p>
        <ol class="jb-progress-steps d-flex justify-content-between list-unstyled mb-0" role="list">
            <li class="jb-step active text-center" data-step="0" data-section="accountheader" role="listitem">
                <div class="jb-step-icon rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-1" style="width: 40px; height: 40px;" aria-hidden="true">
                    <i class="fa fa-key"></i>
                </div>
                <span class="jb-step-label small d-block">{{#str}}signup_step_account, local_jobboard{{/str}}</span>
            </li>
            <li class="jb-step text-center" data-step="1" data-section="personalinfo" role="listitem">
                <div class="jb-step-icon rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-1" style="width: 40px; height: 40px;" aria-hidden="true">
                    <i class="fa fa-user"></i>
                </div>
                <span class="jb-step-label small d-block">{{#str}}signup_step_personal, local_jobboard{{/str}}</span>
            </li>
            <li class="jb-step text-center" data-step="2" data-section="contactinfo" role="listitem">
                <div class="jb-step-icon rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-1" style="width: 40px; height: 40px;" aria-hidden="true">
                    <i class="fa fa-phone"></i>
                </div>
                <span class="jb-step-label small d-block">{{#str}}signup_step_contact, local_jobboard{{/str}}</span>
            </li>
            <li class="jb-step text-center" data-step="3" data-section="academicheader" role="listitem">
                <div class="jb-step-icon rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-1" style="width: 40px; height: 40px;" aria-hidden="true">
                    <i class="fa fa-graduation-cap"></i>
                </div>
                <span class="jb-step-label small d-block">{{#str}}signup_step_academic, local_jobboard{{/str}}</span>
            </li>
            <li class="jb-step text-center" data-step="4" data-section="termsheader" role="listitem">
                <div class="jb-step-icon rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-1" style="width: 40px; height: 40px;" aria-hidden="true">
                    <i class="fa fa-circle-check"></i>
                </div>
                <span class="jb-step-label small d-block">{{#str}}signup_step_confirm, local_jobboard{{/str}}</span>
            </li>
        </ol>
    </nav>

    {{! The form content }}
    <main id="signup-main-content">
        <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.25s;">
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </div>
    </main>

    {{! Help Section }}
    <aside class="mt-4 text-center jb-fade-in" style="animation-delay: 0.3s;">
        <p class="text-muted small mb-0">
            <i class="fa fa-circle-question me-1" aria-hidden="true"></i>
            {{#str}}signup_help, local_jobboard{{/str}}
        </p>
    </aside>
</div>
{{/loading}}
