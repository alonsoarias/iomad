{{!
    @template local_jobboard/pages/public/convocatoria

    Public convocatoria detail page template with Bootstrap 5.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * breadcrumbs (array) - Breadcrumb items
    * convocatoria (object) - Convocatoria data
    * isopen (bool) - Is open
    * isclosed (bool) - Is closed
    * isclosingsoon (bool) - Closing soon
    * daysremaining (number) - Days until close
    * totalvacancies (number) - Total vacancies
    * totalpositions (number) - Total positions
    * isloggedin (bool) - User is logged in
    * statuscolor (string) - Status color class
    * statusicon (string) - Status icon
    * statusmessage (string) - Status message
    * progresscolor (string) - Progress bar color
    * progresspercent (number) - Progress percentage
    * sharelinks (object) - Social sharing links
    * vacanciesurl (string) - View vacancies URL
    * loginurl (string) - Login URL
    * signupurl (string) - Signup URL
    * backurl (string) - Back URL
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "convocatoria": {"id": 1, "name": "2024 Call", "code": "CONV-001"},
        "isopen": true,
        "totalvacancies": 5
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-public-convocatoria" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 200px;"></div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton jb-skeleton-text" style="width: 50%;"></div>
        <div class="jb-skeleton jb-skeleton-text" style="width: 150px; height: 50px;"></div>
    </div>
    <div class="jb-skeleton jb-skeleton-text mb-4" style="width: 100%; height: 60px;"></div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 200px;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="jb-skeleton jb-skeleton-text mb-2" style="width: 100%;"></div>
                    <div class="jb-skeleton jb-skeleton-text mb-2" style="width: 100%;"></div>
                    <div class="jb-skeleton jb-skeleton-text" style="width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-public-convocatoria" data-region="jobboard-public-convocatoria" data-convocatoria-id="{{convocatoria.id}}">
    {{! Skip Link for Accessibility }}
    <a href="#convocatoria-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="mb-4 jb-fade-in">
        {{> local_jobboard/components/breadcrumb }}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">
            <h1 class="fs-3 mb-0">
                <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                {{convocatoria.name}}
            </h1>
            {{#totalvacancies}}
            <a href="{{vacanciesurl}}" class="btn btn-primary btn-lg jb-hover-lift">
                <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                {{#str}}viewvacancies, local_jobboard{{/str}} ({{totalvacancies}})
            </a>
            {{/totalvacancies}}
        </div>
    </header>

    {{! Status Banner }}
    <div class="alert alert-{{statuscolor}} d-flex justify-content-between align-items-center mb-4 jb-fade-in-up {{#isclosingsoon}}jb-pulse{{/isclosingsoon}}" role="status" style="animation-delay: 0.05s;">
        <span class="fw-medium">
            <i class="fa fa-{{statusicon}} me-2" aria-hidden="true"></i>
            {{statusmessage}}
        </span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-{{convocatoria.statuscolor}}">{{convocatoria.statuslabel}}</span>
            <code class="bg-white px-2 py-1 rounded small">{{convocatoria.code}}</code>
        </div>
    </div>

    <div class="row">
        {{! Main Content Column }}
        <main class="col-lg-8" id="convocatoria-main-content">
            {{! Description Card }}
            {{#convocatoria.description}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="desc-heading" style="animation-delay: 0.1s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="desc-heading">
                        <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                        {{#str}}description, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{{convocatoria.description}}}
                </div>
            </section>
            {{/convocatoria.description}}

            {{! Terms Card }}
            {{#convocatoria.terms}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="terms-heading" style="animation-delay: 0.15s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="terms-heading">
                        <i class="fa fa-gavel text-warning me-2" aria-hidden="true"></i>
                        {{#str}}convocatoriaterms, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{{convocatoria.terms}}}
                </div>
            </section>
            {{/convocatoria.terms}}

            {{! Attachments Card }}
            {{#convocatoria.hasattachments}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="attachments-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="attachments-heading">
                        <i class="fa fa-paperclip text-info me-2" aria-hidden="true"></i>
                        {{#str}}attachments, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        {{#convocatoria.attachments}}
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>
                                <i class="fa fa-file-{{icon}} text-muted me-2" aria-hidden="true"></i>
                                {{name}}
                            </span>
                            <a href="{{url}}" class="btn btn-sm btn-outline-primary" target="_blank">
                                <i class="fa fa-download me-1" aria-hidden="true"></i>
                                {{#str}}download{{/str}}
                            </a>
                        </li>
                        {{/convocatoria.attachments}}
                    </ul>
                </div>
            </section>
            {{/convocatoria.hasattachments}}
        </main>

        {{! Sidebar Column }}
        <aside class="col-lg-4">
            {{! Key Details Card }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="details-heading" style="animation-delay: 0.1s;">
                <div class="card-header bg-primary text-white">
                    <h2 class="fs-5 mb-0" id="details-heading">
                        <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
                        {{#str}}details, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa fa-briefcase text-muted me-2" aria-hidden="true"></i>
                                {{#str}}vacancies, local_jobboard{{/str}}
                            </span>
                            <span class="badge rounded-pill bg-primary">{{totalvacancies}}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa fa-users text-muted me-2" aria-hidden="true"></i>
                                {{#str}}positions, local_jobboard{{/str}}
                            </span>
                            <span class="badge rounded-pill bg-success">{{totalpositions}}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa fa-flag text-muted me-2" aria-hidden="true"></i>
                                {{#str}}status, local_jobboard{{/str}}
                            </span>
                            <span class="badge bg-{{convocatoria.statuscolor}}">{{convocatoria.statuslabel}}</span>
                        </li>
                    </ul>
                </div>
            </section>

            {{! Dates Card }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="dates-heading" style="animation-delay: 0.15s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="dates-heading">
                        <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                        {{#str}}dates, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                <i class="fa fa-play" aria-hidden="true"></i>
                            </div>
                            <span class="text-muted small">{{#str}}startdate, local_jobboard{{/str}}</span>
                        </div>
                        <strong>{{convocatoria.startdateformatted}}</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                <i class="fa fa-stop" aria-hidden="true"></i>
                            </div>
                            <span class="text-muted small">{{#str}}enddate, local_jobboard{{/str}}</span>
                        </div>
                        <div class="text-end">
                            <strong class="{{#isclosingsoon}}text-warning{{/isclosingsoon}} {{#isclosed}}text-secondary{{/isclosed}}">
                                {{convocatoria.enddateformatted}}
                            </strong>
                            {{^isclosed}}
                            <span class="d-block small {{#isclosingsoon}}text-warning fw-bold{{/isclosingsoon}}{{^isclosingsoon}}text-muted{{/isclosingsoon}}">
                                {{daysremaining}} {{#str}}days, local_jobboard{{/str}}
                            </span>
                            {{/isclosed}}
                        </div>
                    </div>

                    {{! Deadline Progress Bar }}
                    {{^isclosed}}
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted">{{#str}}deadlineprogress, local_jobboard{{/str}}</small>
                            <small class="fw-bold">{{progresspercent}}%</small>
                        </div>
                        <div class="progress" style="height: 8px;" role="progressbar" aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}deadlineprogress, local_jobboard{{/str}}">
                            <div class="progress-bar bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                        </div>
                    </div>
                    {{/isclosed}}
                </div>
            </section>

            {{! Share Card }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="share-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="share-heading">
                        <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                        {{#str}}share, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body text-center">
                    <div class="d-flex justify-content-center gap-2" role="group" aria-label="{{#str}}shareconvocatoria, local_jobboard{{/str}}">
                        <a href="{{sharelinks.facebook}}" class="btn btn-outline-primary rounded-circle jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareonfacebook, local_jobboard{{/str}}" style="width: 44px; height: 44px;">
                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                        </a>
                        <a href="{{sharelinks.twitter}}" class="btn btn-outline-info rounded-circle jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareontwitter, local_jobboard{{/str}}" style="width: 44px; height: 44px;">
                            <i class="fab fa-twitter" aria-hidden="true"></i>
                        </a>
                        <a href="{{sharelinks.linkedin}}" class="btn btn-outline-primary rounded-circle jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareonlinkedin, local_jobboard{{/str}}" style="width: 44px; height: 44px;">
                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                        </a>
                        <a href="{{sharelinks.whatsapp}}" class="btn btn-outline-success rounded-circle jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" style="width: 44px; height: 44px;">
                            <i class="fab fa-whatsapp" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </section>

            {{! View Vacancies CTA Card }}
            {{#totalvacancies}}
            <section class="card shadow-sm mb-4 border-primary jb-fade-in-up" aria-labelledby="cta-heading" style="animation-delay: 0.25s;">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
                        <i class="fa fa-briefcase fa-2x" aria-hidden="true"></i>
                    </div>
                    <h2 class="card-title fs-5 mb-2" id="cta-heading">{{#str}}viewvacancies, local_jobboard{{/str}}</h2>
                    <p class="card-text text-muted mb-3">{{#str}}vacanciesavailable, local_jobboard, {{totalvacancies}}{{/str}}</p>
                    <a href="{{vacanciesurl}}" class="btn btn-primary btn-lg w-100 jb-hover-lift">
                        <i class="fa fa-arrow-right me-2" aria-hidden="true"></i>
                        {{#str}}viewvacancies, local_jobboard{{/str}}
                    </a>
                </div>
            </section>
            {{/totalvacancies}}

            {{! Login/Register CTA for non-authenticated users }}
            {{^isloggedin}}
            <section class="card shadow-sm mb-4 border-warning jb-fade-in-up" aria-labelledby="login-heading" style="animation-delay: 0.3s;">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px;">
                        <i class="fa fa-circle-user fa-2x" aria-hidden="true"></i>
                    </div>
                    <h2 class="card-title fs-5 mb-2" id="login-heading">{{#str}}wanttoapply, local_jobboard{{/str}}</h2>
                    <p class="card-text text-muted mb-3">{{#str}}loginrequiredtoapply, local_jobboard{{/str}}</p>
                    <a href="{{loginurl}}" class="btn btn-primary btn-lg w-100 mb-2 jb-hover-lift">
                        <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                        {{#str}}login{{/str}}
                    </a>
                    <a href="{{signupurl}}" class="btn btn-outline-primary w-100 jb-hover-lift">
                        <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                        {{#str}}createaccount{{/str}}
                    </a>
                </div>
            </section>
            {{/isloggedin}}
        </aside>
    </div>

    {{! Navigation Footer }}
    <nav class="mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{backurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}backtoconvocatorias, local_jobboard{{/str}}
        </a>
    </nav>
</div>
{{/loading}}
