{{!
    @template local_jobboard/pages/review/assign_reviewer

    Assign reviewer to applications page template with Bootstrap 5.

    Context variables:
    * pagetitle - Page title string
    * stats - Statistics object
    * vacancies - Vacancies for filter dropdown
    * selectedvacancyid - Currently selected vacancy ID
    * reviewers - Available reviewers with workload
    * hasreviewers - Boolean if has reviewers
    * unassigned - Unassigned applications list
    * hasunassigned - Boolean if has unassigned
    * filterformurl - URL for filter form
    * actionformurl - URL for action form
    * dashboardurl - URL to dashboard
    * reviewurl - URL to review applications
    * bulkvalidateurl - URL to bulk validation
    * sesskey - Session key
    * loading - bool - Show skeleton loading state

    Example context (json):
    {
        "pagetitle": "Assign Reviewer",
        "stats": {"unassigned": 10, "reviewers": 5}
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-assign-reviewer" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between mb-4">
        <div class="jb-skeleton jb-skeleton-text" style="width: 200px; height: 2em;"></div>
        <div class="jb-skeleton jb-skeleton-text" style="width: 250px; height: 38px;"></div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton jb-skeleton-text" style="height: 100px;"></div></div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-assign-reviewer" data-region="jobboard-assign-reviewer">
    {{! Skip Link for Accessibility }}
    <a href="#assign-reviewer-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h1 class="fs-3 mb-0">
            <i class="fa fa-user-plus text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h1>
        <div class="btn-group">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
            <a href="{{reviewurl}}" class="btn btn-outline-primary jb-hover-lift">
                <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                {{#str}}reviewapplications, local_jobboard{{/str}}
            </a>
        </div>
    </header>

    <main id="assign-reviewer-content">
        {{! Statistics Cards }}
        <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.05s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded bg-warning text-white p-3 me-3">
                            <i class="fa fa-triangle-exclamation" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-3 fw-bold">{{stats.unassigned}}</div>
                            <div class="small text-muted">{{#str}}unassignedapplications, local_jobboard{{/str}}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded bg-primary text-white p-3 me-3">
                            <i class="fa fa-users" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-3 fw-bold">{{stats.reviewers}}</div>
                            <div class="small text-muted">{{#str}}availablereviewers, local_jobboard{{/str}}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.15s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded bg-success text-white p-3 me-3">
                            <i class="fa fa-circle-check" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-3 fw-bold">{{stats.assigned}}</div>
                            <div class="small text-muted">{{#str}}totalassigned, local_jobboard{{/str}}</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.2s;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded bg-info text-white p-3 me-3">
                            <i class="fa fa-chart-bar" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-3 fw-bold">{{stats.avgworkload}}</div>
                            <div class="small text-muted">{{#str}}avgworkload, local_jobboard{{/str}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! Vacancy Filter }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.25s;" aria-label="{{#str}}filter{{/str}}">
            <div class="card-body">
                <form method="get" action="{{filterformurl}}" class="d-flex flex-wrap align-items-center gap-3">
                    <div class="flex-grow-1" style="min-width: 200px;">
                        <label class="visually-hidden" for="vacancyid">{{#str}}vacancy, local_jobboard{{/str}}</label>
                        <select name="vacancyid" id="vacancyid" class="form-select">
                            <option value="0">{{#str}}allvacancies, local_jobboard{{/str}}</option>
                            {{#vacancies}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/vacancies}}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary jb-hover-lift">
                        <i class="fa fa-filter me-1" aria-hidden="true"></i>
                        {{#str}}filter{{/str}}
                    </button>
                </form>
            </div>
        </section>

        {{! Reviewer Workload Summary }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.3s;" aria-labelledby="workload-heading">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="workload-heading">
                    <i class="fa fa-users text-primary me-2" aria-hidden="true"></i>
                    {{#str}}reviewerworkload, local_jobboard{{/str}}
                </h5>
                <span class="badge bg-secondary">{{stats.reviewers}} {{#str}}reviewers, local_jobboard{{/str}}</span>
            </div>
            <div class="card-body">
                {{#hasreviewers}}
                <div class="row">
                    {{#reviewers}}
                    <div class="col-lg-4 col-md-6 mb-3">
                        <div class="card h-100 border-start border-{{workloadcolor}} border-4 jb-fade-in">
                            <div class="card-body">
                                <h6 class="mb-2">
                                    <i class="fa fa-user text-muted me-2" aria-hidden="true"></i>
                                    {{fullname}}
                                </h6>
                                <span class="badge bg-{{workloadcolor}} mb-2">
                                    {{workload}} {{#str}}activeassignments, local_jobboard{{/str}}
                                </span>
                                {{#hasstats}}
                                <div class="small text-muted mt-2">
                                    <i class="fa fa-check me-1" aria-hidden="true"></i>
                                    {{#str}}reviewed, local_jobboard{{/str}}: <strong>{{stats.reviewed}}</strong>
                                    <span class="mx-2">|</span>
                                    <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                    {{#str}}avgtime, local_jobboard{{/str}}: <strong>{{stats.avgtime}}h</strong>
                                </div>
                                {{/hasstats}}
                            </div>
                        </div>
                    </div>
                    {{/reviewers}}
                </div>
                {{/hasreviewers}}
                {{^hasreviewers}}
                <div class="text-center py-4">
                    <div class="rounded-circle bg-light mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="fa fa-users fa-lg text-muted" aria-hidden="true"></i>
                    </div>
                    <p class="text-muted mb-0">{{#str}}noreviewers, local_jobboard{{/str}}</p>
                </div>
                {{/hasreviewers}}
            </div>
        </section>

        {{! Auto-Assign Section }}
        <section class="card shadow-sm mb-4 border-info jb-fade-in-up" style="animation-delay: 0.35s;" aria-labelledby="autoassign-heading">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0" id="autoassign-heading">
                    <i class="fa fa-wand-magic-sparkles me-2" aria-hidden="true"></i>
                    {{#str}}autoassign, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body">
                <form method="post" action="{{actionformurl}}" class="d-flex flex-wrap align-items-center gap-3">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="autoassign">
                    <input type="hidden" name="vacancyid" value="{{selectedvacancyid}}">
                    <div>
                        <label for="maxperreviewer" class="form-label me-2">{{#str}}maxperreviewer, local_jobboard{{/str}}</label>
                        <input type="number" name="maxperreviewer" id="maxperreviewer" value="20" min="1" max="100" class="form-control d-inline-block" style="width: 100px;">
                    </div>
                    <button type="submit" class="btn btn-light jb-hover-lift">
                        <i class="fa fa-wand-magic-sparkles me-2" aria-hidden="true"></i>
                        {{#str}}autoassignall, local_jobboard{{/str}}
                    </button>
                </form>
                <small class="text-muted mt-2 d-block">
                    <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
                    {{#str}}autoassignhelp, local_jobboard{{/str}}
                </small>
            </div>
        </section>

        {{! Manual Assignment Section }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.4s;" aria-labelledby="manual-heading">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="manual-heading">
                    <i class="fa fa-hand-pointer text-primary me-2" aria-hidden="true"></i>
                    {{#str}}manualassign, local_jobboard{{/str}}
                </h5>
                <span class="badge bg-warning">{{stats.unassigned}} {{#str}}pendingassignment, local_jobboard{{/str}}</span>
            </div>
            <div class="card-body">
                {{#hasunassigned}}
                <form method="post" action="{{actionformurl}}" id="manual-assign-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="assign">
                    <input type="hidden" name="vacancyid" value="{{selectedvacancyid}}">

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label for="reviewerid" class="form-label fw-bold">
                                <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                                {{#str}}assignto, local_jobboard{{/str}}
                            </label>
                            <select name="reviewerid" id="reviewerid" class="form-select" required>
                                <option value="">{{#str}}selectreviewer, local_jobboard{{/str}}</option>
                                {{#reviewers}}
                                <option value="{{id}}">{{fullname}} ({{workload}} {{#str}}assigned, local_jobboard{{/str}}){{workloadindicator}}</option>
                                {{/reviewers}}
                            </select>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="selectallapp">
                        <label class="form-check-label fw-bold" for="selectallapp">{{#str}}selectall{{/str}}</label>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 40px;"></th>
                                    <th scope="col">{{#str}}applicant, local_jobboard{{/str}}</th>
                                    <th scope="col">{{#str}}vacancy, local_jobboard{{/str}}</th>
                                    <th scope="col">{{#str}}status{{/str}}</th>
                                    <th scope="col">{{#str}}dateapplied, local_jobboard{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#unassigned}}
                                <tr class="jb-fade-in">
                                    <td>
                                        <input type="checkbox" name="applications[]" value="{{id}}" class="form-check-input app-checkbox">
                                    </td>
                                    <td><strong>{{applicantname}}</strong></td>
                                    <td><code class="text-primary">{{vacancycode}}</code></td>
                                    <td><span class="badge bg-{{statuscolor}}">{{statustext}}</span></td>
                                    <td class="text-muted">{{dateapplied}}</td>
                                </tr>
                                {{/unassigned}}
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary jb-hover-lift">
                            <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                            {{#str}}assignselected, local_jobboard{{/str}}
                        </button>
                    </div>
                </form>
                {{/hasunassigned}}
                {{^hasunassigned}}
                <div class="text-center py-5">
                    <div class="rounded-circle bg-success text-white mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fa fa-circle-check fa-2x" aria-hidden="true"></i>
                    </div>
                    <h5 class="text-success mb-2">{{#str}}alldone, local_jobboard{{/str}}</h5>
                    <p class="text-muted mb-0">{{#str}}nounassignedapplications, local_jobboard{{/str}}</p>
                </div>
                {{/hasunassigned}}
            </div>
        </section>
    </main>

    {{! Navigation Footer }}
    <footer class="card shadow-sm mt-4 bg-light jb-fade-in">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-center gap-2">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
            <a href="{{reviewurl}}" class="btn btn-outline-primary jb-hover-lift">
                <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                {{#str}}reviewapplications, local_jobboard{{/str}}
            </a>
            <a href="{{bulkvalidateurl}}" class="btn btn-outline-success jb-hover-lift">
                <i class="fa fa-check-double me-2" aria-hidden="true"></i>
                {{#str}}bulkvalidation, local_jobboard{{/str}}
            </a>
        </div>
    </footer>
</div>

{{#hasunassigned}}
{{#js}}
(function() {
    var selectAll = document.getElementById('selectallapp');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            var checkboxes = document.querySelectorAll('.app-checkbox');
            var checked = this.checked;
            checkboxes.forEach(function(cb) {
                cb.checked = checked;
            });
        });
    }
})();
{{/js}}
{{/hasunassigned}}
{{/loading}}
