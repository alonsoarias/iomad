{{!
    @template local_jobboard/pages/convocatorias/detail

    View convocatoria details page with Bootstrap 5.
    For applicants viewing available vacancies in a convocatoria.

    Context variables:
    * breadcrumbs (array) - Breadcrumb items
    * convocatoria (object) - Convocatoria data object
    * isopen (bool) - If convocatoria is open
    * isclosingsoon (bool) - If closing soon
    * daysremaining (number) - Days until close
    * stats (array) - Statistics cards
    * vacancies (array) - Vacancy cards
    * hasvacancies (bool) - Has vacancies
    * pagination (string) - Pagination HTML
    * canmanage (bool) - Can manage convocatoria
    * canapply (bool) - Can apply to vacancies
    * backurl (string) - Back URL
    * dashboardurl (string) - Dashboard URL
    * editurl (string) - Edit URL
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "convocatoria": {"id": 1, "name": "2024 Call", "code": "CONV-001"},
        "isopen": true,
        "hasvacancies": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-view-convocatoria" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 200px; height: 1em;"></div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton jb-skeleton-text" style="width: 50%;"></div>
        <div class="jb-skeleton jb-skeleton-text" style="width: 100px; height: 40px;"></div>
    </div>
    <div class="card mb-4">
        <div class="card-header bg-light">
            <div class="jb-skeleton jb-skeleton-text" style="width: 60%;"></div>
        </div>
        <div class="card-body">
            <div class="jb-skeleton jb-skeleton-text mb-3" style="width: 100%; height: 80px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-view-convocatoria" data-region="jobboard-view-convocatoria" data-convocatoria-id="{{convocatoria.id}}">
    {{! Skip Link for Accessibility }}
    <a href="#convocatoria-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Breadcrumb }}
    {{> local_jobboard/components/breadcrumb }}

    {{! Page Header }}
    <header class="mb-4 jb-fade-in">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="fs-4 mb-0">
                <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                {{convocatoria.name}}
            </h1>
            {{#canmanage}}
            <a href="{{editurl}}" class="btn btn-outline-primary jb-hover-lift">
                <i class="fa fa-pen-to-square me-1" aria-hidden="true"></i>
                {{#str}}edit, local_jobboard{{/str}}
            </a>
            {{/canmanage}}
        </div>
    </header>

    {{! Urgent Banner (Closing Soon) }}
    {{#isclosingsoon}}
    <div class="alert alert-warning d-flex align-items-center mb-4 jb-fade-in-up jb-pulse" role="alert" style="animation-delay: 0.05s;">
        <i class="fa fa-triangle-exclamation fa-lg me-3" aria-hidden="true"></i>
        <div>
            <strong>{{#str}}closingsoon, local_jobboard{{/str}}</strong>
            <span class="ms-2">
                {{#str}}daysleft, local_jobboard{{/str}}: <strong>{{daysremaining}}</strong>
            </span>
        </div>
    </div>
    {{/isclosingsoon}}

    {{! Main Content }}
    <main id="convocatoria-main-content">
        {{! Convocatoria Info Card }}
        <article class="card shadow-sm mb-4 border-{{statuscolor}} jb-fade-in-up" aria-labelledby="conv-heading" style="animation-delay: 0.1s;">
            <div class="card-header bg-{{statuscolor}} text-white d-flex justify-content-between align-items-center">
                <h2 class="fs-5 mb-0" id="conv-heading">
                    <code class="me-2 text-white-50">{{convocatoria.code}}</code>
                    {{convocatoria.name}}
                </h2>
                <span class="badge bg-light text-dark">
                    {{#isclosingsoon}}
                    <i class="fa fa-clock me-1" aria-hidden="true"></i>
                    {{#str}}daysleft, local_jobboard{{/str}}: {{daysremaining}}
                    {{/isclosingsoon}}
                    {{^isclosingsoon}}
                    {{statuslabel}}
                    {{/isclosingsoon}}
                </span>
            </div>

            <div class="card-body">
                {{! Description }}
                {{#convocatoria.description}}
                <div class="mb-4">
                    {{{convocatoria.description}}}
                </div>
                {{/convocatoria.description}}

                {{! Dates Row }}
                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="d-flex align-items-center">
                            <div class="bg-success text-white rounded p-2 me-3">
                                <i class="fa fa-calendar-check" aria-hidden="true"></i>
                            </div>
                            <div>
                                <small class="d-block text-muted">{{#str}}convocatoriastartdate, local_jobboard{{/str}}</small>
                                <strong>{{convocatoria.startdateformatted}}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger text-white rounded p-2 me-3">
                                <i class="fa fa-calendar-xmark" aria-hidden="true"></i>
                            </div>
                            <div>
                                <small class="d-block text-muted">{{#str}}convocatoriaenddate, local_jobboard{{/str}}</small>
                                <strong class="{{#isclosingsoon}}text-warning{{/isclosingsoon}}">
                                    {{convocatoria.enddateformatted}}
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>

                {{! Terms }}
                {{#convocatoria.terms}}
                <div class="alert alert-info mb-0">
                    <h3 class="fs-6 alert-heading d-flex align-items-center">
                        <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
                        {{#str}}convocatoriaterms, local_jobboard{{/str}}
                    </h3>
                    <div>
                        {{{convocatoria.terms}}}
                    </div>
                </div>
                {{/convocatoria.terms}}
            </div>
        </article>

        {{! Statistics Row }}
        {{#stats.0}}
        <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
            {{#stats}}
            <div class="col-lg-3 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
                {{> local_jobboard/components/stat_card }}
            </div>
            {{/stats}}
        </section>
        {{/stats.0}}

        {{! Vacancies Section }}
        <section aria-labelledby="vacancies-heading">
            <div class="d-flex justify-content-between align-items-center mb-3 jb-fade-in">
                <h2 class="fs-5 mb-0" id="vacancies-heading">
                    <i class="fa fa-briefcase text-primary me-2" aria-hidden="true"></i>
                    {{#str}}convocatoriavacancies, local_jobboard{{/str}}
                </h2>
                {{#hasvacancies}}
                <span class="badge rounded-pill bg-secondary">
                    {{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                </span>
                {{/hasvacancies}}
            </div>

            {{#hasvacancies}}
            <div class="row">
                {{#vacancies}}
                <div class="col-lg-4 col-md-6 mb-4 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
                    {{> local_jobboard/components/vacancy_card }}
                </div>
                {{/vacancies}}
            </div>
            {{/hasvacancies}}

            {{! Empty State }}
            {{^hasvacancies}}
            {{> local_jobboard/components/empty_state }}
            {{/hasvacancies}}
        </section>
    </main>

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-4 jb-fade-in" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
        {{{pagination}}}
    </nav>
    {{/pagination}}

    {{! Navigation Footer }}
    <nav class="d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{backurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}backtoconvocatorias, local_jobboard{{/str}}
        </a>
        <a href="{{dashboardurl}}" class="btn btn-link text-muted">
            {{#str}}backtodashboard, local_jobboard{{/str}}
            <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
        </a>
    </nav>
</div>
{{/loading}}
