{{!
    @template local_jobboard/pages/applications/apply

    Application form page with Bootstrap 5.

    Context variables:
    * vacancy - Vacancy data (code, title, location, modality, closedate, etc.)
    * convocatoria - Convocatoria info {code, name}
    * steps - Array of progress step items
    * currentstep - Current active step number
    * totalsteps - Total number of steps
    * daysuntilclose - Days remaining until deadline
    * showdeadlinewarning - Whether to show urgent deadline warning
    * deadlinewarningtext - Warning message with days
    * guidelines - Array of guideline strings
    * requireddocs - Array of required document types
    * formhtml - Moodle form HTML (rendered by application_form)
    * isexemption - Boolean if user has exemption
    * exemptioninfo - Exemption details if applicable
    * quicktips - Array of quick tip strings
    * backvacancyurl - URL to vacancy details
    * browservacanciesurl - URL to browse vacancies
    * viewvacancyurl - URL to view vacancy details
    * hasrequireddocs - Boolean if there are required documents
    * loading - Show loading state

    Example context (json):
    {
        "vacancy": {"code": "VAC-001", "title": "Professor Position"},
        "showdeadlinewarning": true
    }
}}
<div class="jb-apply-container" data-region="jobboard-apply">
    {{! Skip Link for Accessibility }}
    <a href="#application-form-container" class="visually-hidden-focusable">
        {{#str}}skiptoform, local_jobboard{{/str}}
    </a>

    <div class="row">
        {{! Main content area (left column) }}
        <main class="col-lg-8 mb-4 mb-lg-0">
            <div class="content-area">
                {{! Page Header }}
                <header class="mb-4 jb-fade-in">
                    {{! Breadcrumb }}
                    <nav aria-label="{{#str}}breadcrumb{{/str}}" class="mb-3">
                        <ol class="breadcrumb small">
                            <li class="breadcrumb-item">
                                <a href="{{browservacanciesurl}}">{{#str}}vacancies, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{backvacancyurl}}">{{vacancy.code}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{#str}}apply, local_jobboard{{/str}}</li>
                        </ol>
                    </nav>

                    <h1 class="fs-3 mb-2 fw-bold">{{#str}}applytovacancy, local_jobboard{{/str}}</h1>
                    <p class="lead text-muted mb-0">{{vacancy.title}}</p>

                    {{#convocatoria}}
                    <div class="mt-2">
                        <span class="badge rounded-pill bg-info">
                            <i class="fa fa-folder-open me-1" aria-hidden="true"></i>
                            {{convocatoria.code}} - {{convocatoria.name}}
                        </span>
                    </div>
                    {{/convocatoria}}
                </header>

                {{! Progress Steps }}
                <nav class="jb-progress-steps mb-4 jb-fade-in-up" id="application-progress" aria-label="{{#str}}applicationprogress, local_jobboard{{/str}}">
                    <div class="d-flex justify-content-between position-relative">
                        {{#steps}}
                        <div class="jb-step {{#isactive}}active{{/isactive}} {{#iscompleted}}completed{{/iscompleted}} text-center"
                             data-step="{{stepnum}}" data-target="{{target}}">
                            <div class="jb-step-icon rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 {{#iscompleted}}bg-success text-white{{/iscompleted}}{{#isactive}}bg-primary text-white{{/isactive}}{{^iscompleted}}{{^isactive}}bg-light text-muted{{/isactive}}{{/iscompleted}}" style="width: 40px; height: 40px;">
                                {{#iscompleted}}
                                <i class="fa fa-check" aria-hidden="true"></i>
                                {{/iscompleted}}
                                {{^iscompleted}}
                                {{stepnum}}
                                {{/iscompleted}}
                            </div>
                            <span class="small {{#isactive}}fw-bold{{/isactive}}">{{label}}</span>
                        </div>
                        {{/steps}}
                    </div>
                </nav>

                {{! Mobile Progress Bar }}
                <div class="d-lg-none mb-4 jb-fade-in-up">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">{{#str}}step, local_jobboard{{/str}} {{currentstep}} {{#str}}of, local_jobboard{{/str}} {{totalsteps}}</span>
                        <span class="small fw-bold">{{progresspercent}}%</span>
                    </div>
                    <div class="progress" style="height: 8px;" role="progressbar" aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: {{progresspercent}}%"></div>
                    </div>
                </div>

                {{! Deadline Warning }}
                {{#showdeadlinewarning}}
                <div class="alert alert-danger d-flex align-items-center mb-4 jb-fade-in-up jb-pulse" role="alert" aria-live="assertive">
                    <div class="flex-shrink-0 me-3">
                        <i class="fa fa-triangle-exclamation fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <strong class="d-block mb-1">{{#str}}deadlinewarning_title, local_jobboard{{/str}}</strong>
                        <span>{{deadlinewarningtext}}</span>
                    </div>
                </div>
                {{/showdeadlinewarning}}

                {{! Exemption Info }}
                {{#isexemption}}
                <div class="alert alert-info d-flex align-items-start mb-4 jb-fade-in-up" role="status">
                    <div class="flex-shrink-0 me-3">
                        <i class="fa fa-id-card fa-2x" aria-hidden="true"></i>
                    </div>
                    <div class="flex-grow-1">
                        <strong class="d-block mb-1">
                            <i class="fa fa-circle-check text-success me-1" aria-hidden="true"></i>
                            {{#str}}exemptionapplied, local_jobboard{{/str}}
                        </strong>
                        {{#exemptioninfo}}
                        <div class="small">
                            <span class="d-block">
                                <strong>{{#str}}exemptiontype, local_jobboard{{/str}}:</strong> {{exemptiontype}}
                            </span>
                            {{#documentref}}
                            <span class="d-block">
                                <strong>{{#str}}documentref, local_jobboard{{/str}}:</strong> {{documentref}}
                            </span>
                            {{/documentref}}
                        </div>
                        {{/exemptioninfo}}
                    </div>
                </div>
                {{/isexemption}}

                {{! Guidelines Card }}
                {{#guidelines.0}}
                <div class="card mb-4 jb-fade-in-up">
                    <div class="card-header bg-white" id="guidelinesHeader">
                        <button class="btn btn-link text-decoration-none p-0 w-100 text-start" type="button" data-bs-toggle="collapse" data-bs-target="#guidelinesCollapse" aria-expanded="false" aria-controls="guidelinesCollapse">
                            <i class="fa fa-circle-info text-info me-2" aria-hidden="true"></i>
                            <span class="fw-bold">{{#str}}applicationguidelines, local_jobboard{{/str}}</span>
                            <i class="fa fa-chevron-down float-end mt-1" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div id="guidelinesCollapse" class="collapse" aria-labelledby="guidelinesHeader">
                        <div class="card-body">
                            <ul class="mb-0">
                                {{#guidelines}}
                                <li>{{.}}</li>
                                {{/guidelines}}
                            </ul>
                        </div>
                    </div>
                </div>
                {{/guidelines.0}}

                {{! Application Form Card }}
                <div class="card shadow-sm jb-fade-in-up" id="application-form-container">
                    <div class="card-header bg-primary text-white">
                        <h2 class="fs-5 mb-0">
                            <i class="fa fa-pen-to-square me-2" aria-hidden="true"></i>
                            {{#str}}applicationform, local_jobboard{{/str}}
                        </h2>
                    </div>
                    <div class="card-body">
                        {{{formhtml}}}
                    </div>
                </div>
            </div>
        </main>

        {{! Sidebar (right column) }}
        <aside class="col-lg-4">
            <div class="sticky-top" style="top: 1rem;">
                {{! Vacancy Info Card }}
                <div class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="card-header bg-white">
                        <h3 class="fs-6 mb-0">
                            <i class="fa fa-briefcase text-primary me-2" aria-hidden="true"></i>
                            {{#str}}vacancyinfo, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <strong class="d-block">{{vacancy.title}}</strong>
                                <code class="small text-muted">{{vacancy.code}}</code>
                            </li>
                            {{#vacancy.location}}
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fa fa-location-dot text-muted me-2" aria-hidden="true"></i>
                                {{vacancy.location}}
                            </li>
                            {{/vacancy.location}}
                            {{#vacancy.modality}}
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fa fa-house-laptop text-muted me-2" aria-hidden="true"></i>
                                {{vacancy.modality}}
                            </li>
                            {{/vacancy.modality}}
                            <li class="list-group-item d-flex align-items-center {{#showdeadlinewarning}}text-danger fw-bold{{/showdeadlinewarning}}">
                                <i class="fa fa-calendar-xmark {{#showdeadlinewarning}}text-danger{{/showdeadlinewarning}}{{^showdeadlinewarning}}text-muted{{/showdeadlinewarning}} me-2" aria-hidden="true"></i>
                                {{#str}}closes, local_jobboard{{/str}}: {{vacancy.closedateformatted}}
                            </li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white">
                        <a href="{{viewvacancyurl}}" class="btn btn-outline-info w-100">
                            <i class="fa fa-eye me-2" aria-hidden="true"></i>
                            {{#str}}viewfulldetails, local_jobboard{{/str}}
                        </a>
                    </div>
                </div>

                {{! Required Documents Card }}
                {{#hasrequireddocs}}
                <div class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.15s;">
                    <div class="card-header bg-white">
                        <h3 class="fs-6 mb-0">
                            <i class="fa fa-file-lines text-warning me-2" aria-hidden="true"></i>
                            {{#str}}requireddocuments, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            {{#requireddocs}}
                            <li class="list-group-item d-flex align-items-center">
                                <i class="fa fa-file-{{icon}} text-muted me-2" aria-hidden="true"></i>
                                {{name}}
                                {{#isrequired}}<span class="text-danger ms-1">*</span>{{/isrequired}}
                            </li>
                            {{/requireddocs}}
                        </ul>
                    </div>
                </div>
                {{/hasrequireddocs}}

                {{! Quick Tips Card }}
                {{#quicktips.0}}
                <div class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.2s;">
                    <div class="card-header bg-white">
                        <h3 class="fs-6 mb-0">
                            <i class="fa fa-lightbulb text-warning me-2" aria-hidden="true"></i>
                            {{#str}}quicktips, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0">
                            {{#quicktips}}
                            <li class="mb-1">{{.}}</li>
                            {{/quicktips}}
                        </ul>
                    </div>
                </div>
                {{/quicktips.0}}

                {{! Back Button }}
                <a href="{{backvacancyurl}}" class="btn btn-outline-secondary w-100 jb-fade-in">
                    <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                    {{#str}}backtovacancy, local_jobboard{{/str}}
                </a>
            </div>
        </aside>
    </div>
</div>
