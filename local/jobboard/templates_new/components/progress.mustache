{{!
    @template local_jobboard/components/progress

    Progress component for multi-step forms and progress indicators.
    Uses custom jb-progress-steps classes.

    Context variables:
    * steps (array) - Progress steps [{label, active, completed, number}]
    * percentage (int) - Progress percentage (0-100) for bar variant
    * variant (string) - steps or bar
    * color (string) - Bootstrap color for bar

    Example context (json):
    {
        "variant": "steps",
        "steps": [
            {"label": "Personal Info", "completed": true},
            {"label": "Documents", "active": true},
            {"label": "Review", "number": 3}
        ]
    }
}}
{{#isstepsvariant}}
<div class="jb-progress-steps" role="navigation" aria-label="{{#str}}applicationprogress, local_jobboard{{/str}}">
    {{#steps}}
    <div class="jb-progress-step{{#active}} active{{/active}}{{#completed}} completed{{/completed}}"
         {{#active}}aria-current="step"{{/active}}>
        <span class="jb-progress-step-label">{{label}}</span>
    </div>
    {{/steps}}
</div>
{{/isstepsvariant}}

{{#isbarvariant}}
<div class="progress" role="progressbar" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100">
    <div class="progress-bar bg-{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}}" style="width: {{percentage}}%">
        {{#showpercentage}}{{percentage}}%{{/showpercentage}}
    </div>
</div>
{{/isbarvariant}}

{{^variant}}
{{! Default: show as bar if percentage provided, otherwise steps }}
{{#percentage}}
<div class="progress" role="progressbar" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100">
    <div class="progress-bar bg-{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}}" style="width: {{percentage}}%">
        {{percentage}}%
    </div>
</div>
{{/percentage}}
{{^percentage}}
{{#steps}}
<div class="jb-progress-steps" role="navigation">
    {{#.}}
    <div class="jb-progress-step{{#active}} active{{/active}}{{#completed}} completed{{/completed}}">
        <span class="jb-progress-step-label">{{label}}</span>
    </div>
    {{/.}}
</div>
{{/steps}}
{{/percentage}}
{{/variant}}
