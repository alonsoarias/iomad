{{!
    @template local_jobboard/components/skeleton

    Loading skeleton component for content placeholders.
    Uses custom jb-skeleton classes (not available in Bootstrap).

    Context variables:
    * type (string) - Skeleton type: text, title, avatar, card, btn, table, list
    * lines (int) - Number of text lines (for type=text)
    * count (int) - Number of items to show (for table/list)
    * columns (int) - Number of columns (for table)

    Example context (json):
    {
        "type": "card"
    }
}}
{{#iscardtype}}
<div class="card jb-skeleton jb-skeleton-card" aria-hidden="true">
    <div class="card-body">
        <div class="jb-skeleton jb-skeleton-title mb-3"></div>
        <div class="jb-skeleton jb-skeleton-text"></div>
        <div class="jb-skeleton jb-skeleton-text"></div>
        <div class="jb-skeleton jb-skeleton-text" style="width: 60%;"></div>
    </div>
</div>
{{/iscardtype}}

{{#istexttype}}
<div aria-hidden="true">
    {{#lines}}
    <div class="jb-skeleton jb-skeleton-text"></div>
    {{/lines}}
    {{^lines}}
    <div class="jb-skeleton jb-skeleton-text"></div>
    <div class="jb-skeleton jb-skeleton-text"></div>
    <div class="jb-skeleton jb-skeleton-text" style="width: 80%;"></div>
    {{/lines}}
</div>
{{/istexttype}}

{{#istitletype}}
<div class="jb-skeleton jb-skeleton-title" aria-hidden="true"></div>
{{/istitletype}}

{{#isavatartype}}
<div class="jb-skeleton jb-skeleton-avatar" aria-hidden="true"></div>
{{/isavatartype}}

{{#isbtntype}}
<div class="jb-skeleton jb-skeleton-btn" aria-hidden="true"></div>
{{/isbtntype}}

{{#istabletype}}
<div class="table-responsive" aria-hidden="true">
    <table class="table">
        <thead>
            <tr>
                {{#tablecolumns}}
                <th><div class="jb-skeleton jb-skeleton-text" style="width: 80%;"></div></th>
                {{/tablecolumns}}
            </tr>
        </thead>
        <tbody>
            {{#tablerows}}
            <tr>
                {{#tablecolumns}}
                <td><div class="jb-skeleton jb-skeleton-text"></div></td>
                {{/tablecolumns}}
            </tr>
            {{/tablerows}}
        </tbody>
    </table>
</div>
{{/istabletype}}

{{#islisttype}}
<ul class="list-group" aria-hidden="true">
    {{#listitems}}
    <li class="list-group-item">
        <div class="d-flex align-items-center">
            <div class="jb-skeleton jb-skeleton-avatar me-3"></div>
            <div class="flex-grow-1">
                <div class="jb-skeleton jb-skeleton-text mb-2" style="width: 70%;"></div>
                <div class="jb-skeleton jb-skeleton-text" style="width: 50%;"></div>
            </div>
        </div>
    </li>
    {{/listitems}}
</ul>
{{/islisttype}}

{{! Default skeleton if no type specified }}
{{^type}}
<div aria-hidden="true">
    <div class="jb-skeleton jb-skeleton-text"></div>
    <div class="jb-skeleton jb-skeleton-text"></div>
    <div class="jb-skeleton jb-skeleton-text" style="width: 80%;"></div>
</div>
{{/type}}
