{{!
    @template local_jobboard/components/timeline

    Timeline component for history/workflow display.
    Uses custom jb-timeline classes (not in Bootstrap).

    Context variables:
    * items (array) - Timeline items [{title, description, date, status, icon, user}]
    * compact (bool) - Use compact variant

    Status options: success, danger, warning, info, default

    Example context (json):
    {
        "items": [
            {
                "title": "Application submitted",
                "description": "Initial submission received",
                "date": "Dec 15, 2024",
                "status": "success",
                "icon": "check"
            }
        ]
    }
}}
<div class="jb-timeline{{#compact}} jb-timeline-compact{{/compact}}">
    {{#items}}
    <div class="jb-timeline-item jb-fade-in-up">
        <div class="jb-timeline-marker jb-timeline-marker-{{#status}}{{status}}{{/status}}{{^status}}default{{/status}}">
            {{#icon}}<i class="fa fa-{{icon}}" aria-hidden="true"></i>{{/icon}}
        </div>
        <div class="jb-timeline-content">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <strong class="text-dark">{{title}}</strong>
                <span class="jb-timeline-date">{{date}}</span>
            </div>
            {{#description}}
            <p class="text-muted mb-1 small">{{description}}</p>
            {{/description}}
            {{#user}}
            <small class="text-muted">
                <i class="fa fa-user me-1" aria-hidden="true"></i>{{user}}
            </small>
            {{/user}}
        </div>
    </div>
    {{/items}}
    {{^items}}
    <div class="text-center text-muted py-3">
        <i class="fa fa-clock-o fa-2x mb-2 d-block" aria-hidden="true"></i>
        {{#str}}nohistory, local_jobboard{{/str}}
    </div>
    {{/items}}
</div>
