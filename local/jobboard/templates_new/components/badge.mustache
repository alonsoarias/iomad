{{!
    @template local_jobboard/components/badge

    Badge component for status indicators.
    Uses Bootstrap 5 classes with custom jb-status-* colors.

    Context variables:
    * text (string) - Badge text
    * color (string) - Bootstrap color or status name
    * pill (bool) - Use pill shape
    * icon (string) - Optional FontAwesome icon
    * tooltip (string) - Optional tooltip text

    Example context (json):
    {
        "text": "Published",
        "color": "published",
        "pill": true,
        "icon": "check-circle"
    }
}}
<span class="badge{{#pill}} rounded-pill{{/pill}} {{#isstatus}}jb-status-{{color}}{{/isstatus}}{{^isstatus}}bg-{{#color}}{{color}}{{/color}}{{^color}}secondary{{/color}}{{/isstatus}}"
      {{#tooltip}}data-bs-toggle="tooltip" title="{{tooltip}}"{{/tooltip}}>
    {{#icon}}<i class="fa fa-{{icon}} me-1" aria-hidden="true"></i>{{/icon}}{{text}}
</span>
