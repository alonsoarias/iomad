{{!
    @template local_jobboard/components/list_group

    List group component for displaying lists.
    Uses Bootstrap 5 list-group classes.

    Context variables:
    * items (array) - List items [{title, subtitle, badge, badgecolor, url, icon, active, disabled}]
    * flush (bool) - Remove borders
    * numbered (bool) - Show numbers
    * horizontal (bool) - Horizontal layout

    Example context (json):
    {
        "items": [
            {"title": "First Item", "subtitle": "Description", "badge": "New", "url": "/item/1"},
            {"title": "Second Item", "active": true}
        ],
        "flush": true
    }
}}
<{{#numbered}}ol{{/numbered}}{{^numbered}}ul{{/numbered}} class="list-group{{#flush}} list-group-flush{{/flush}}{{#numbered}} list-group-numbered{{/numbered}}{{#horizontal}} list-group-horizontal{{/horizontal}}">
    {{#items}}
    {{#url}}
    <a href="{{url}}" class="list-group-item list-group-item-action{{#active}} active{{/active}}{{#disabled}} disabled{{/disabled}} d-flex justify-content-between align-items-start"
       {{#disabled}}aria-disabled="true" tabindex="-1"{{/disabled}}>
    {{/url}}
    {{^url}}
    <li class="list-group-item{{#active}} active{{/active}}{{#disabled}} disabled{{/disabled}} d-flex justify-content-between align-items-start">
    {{/url}}
        <div class="ms-2 me-auto">
            {{#icon}}<i class="fa fa-{{icon}} me-2 text-muted" aria-hidden="true"></i>{{/icon}}
            <span class="fw-semibold">{{title}}</span>
            {{#subtitle}}<br><small class="text-muted">{{subtitle}}</small>{{/subtitle}}
        </div>
        {{#badge}}
        <span class="badge bg-{{#badgecolor}}{{badgecolor}}{{/badgecolor}}{{^badgecolor}}primary{{/badgecolor}} rounded-pill">{{badge}}</span>
        {{/badge}}
    {{#url}}
    </a>
    {{/url}}
    {{^url}}
    </li>
    {{/url}}
    {{/items}}
    {{^items}}
    <li class="list-group-item text-center text-muted py-4">
        <i class="fa fa-list fa-2x mb-2 d-block" aria-hidden="true"></i>
        {{#str}}noitems, local_jobboard{{/str}}
    </li>
    {{/items}}
</{{#numbered}}ol{{/numbered}}{{^numbered}}ul{{/numbered}}>
