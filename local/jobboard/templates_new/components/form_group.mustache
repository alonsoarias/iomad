{{!
    @template local_jobboard/components/form_group

    Form group component for form fields.
    Uses Bootstrap 5 form classes.

    Context variables:
    * id (string) - Field ID
    * name (string) - Field name
    * label (string) - Field label
    * type (string) - Input type: text, email, password, textarea, select, checkbox, radio, file
    * value (string) - Current value
    * placeholder (string) - Placeholder text
    * helptext (string) - Help text below field
    * required (bool) - Field is required
    * disabled (bool) - Field is disabled
    * readonly (bool) - Field is readonly
    * error (string) - Error message
    * options (array) - Options for select [{value, label, selected}]
    * rows (int) - Rows for textarea
    * maxlength (int) - Maximum length
    * pattern (string) - Validation pattern

    Example context (json):
    {
        "id": "email",
        "name": "email",
        "label": "Email Address",
        "type": "email",
        "required": true,
        "placeholder": "user@example.com"
    }
}}
<div class="mb-3">
    {{^ischeckbox}}
    <label for="{{id}}" class="form-label">
        {{label}}
        {{#required}}<span class="text-danger">*</span>{{/required}}
    </label>
    {{/ischeckbox}}

    {{#istexttype}}
    <input type="{{type}}"
           class="form-control{{#error}} is-invalid{{/error}}"
           id="{{id}}"
           name="{{name}}"
           {{#value}}value="{{value}}"{{/value}}
           {{#placeholder}}placeholder="{{placeholder}}"{{/placeholder}}
           {{#required}}required{{/required}}
           {{#disabled}}disabled{{/disabled}}
           {{#readonly}}readonly{{/readonly}}
           {{#maxlength}}maxlength="{{maxlength}}"{{/maxlength}}
           {{#pattern}}pattern="{{pattern}}"{{/pattern}}>
    {{/istexttype}}

    {{#istextarea}}
    <textarea class="form-control{{#error}} is-invalid{{/error}}"
              id="{{id}}"
              name="{{name}}"
              rows="{{#rows}}{{rows}}{{/rows}}{{^rows}}3{{/rows}}"
              {{#placeholder}}placeholder="{{placeholder}}"{{/placeholder}}
              {{#required}}required{{/required}}
              {{#disabled}}disabled{{/disabled}}
              {{#readonly}}readonly{{/readonly}}
              {{#maxlength}}maxlength="{{maxlength}}"{{/maxlength}}>{{value}}</textarea>
    {{/istextarea}}

    {{#isselect}}
    <select class="form-select{{#error}} is-invalid{{/error}}"
            id="{{id}}"
            name="{{name}}"
            {{#required}}required{{/required}}
            {{#disabled}}disabled{{/disabled}}>
        {{#placeholder}}
        <option value="" disabled {{^value}}selected{{/value}}>{{placeholder}}</option>
        {{/placeholder}}
        {{#options}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/options}}
    </select>
    {{/isselect}}

    {{#ischeckbox}}
    <div class="form-check">
        <input type="checkbox"
               class="form-check-input{{#error}} is-invalid{{/error}}"
               id="{{id}}"
               name="{{name}}"
               value="{{#value}}{{value}}{{/value}}{{^value}}1{{/value}}"
               {{#checked}}checked{{/checked}}
               {{#required}}required{{/required}}
               {{#disabled}}disabled{{/disabled}}>
        <label class="form-check-label" for="{{id}}">
            {{label}}
            {{#required}}<span class="text-danger">*</span>{{/required}}
        </label>
    </div>
    {{/ischeckbox}}

    {{#isradio}}
    {{#options}}
    <div class="form-check">
        <input type="radio"
               class="form-check-input{{#error}} is-invalid{{/error}}"
               id="{{id}}_{{value}}"
               name="{{name}}"
               value="{{value}}"
               {{#selected}}checked{{/selected}}
               {{#required}}required{{/required}}
               {{#disabled}}disabled{{/disabled}}>
        <label class="form-check-label" for="{{id}}_{{value}}">{{label}}</label>
    </div>
    {{/options}}
    {{/isradio}}

    {{#isfile}}
    <input type="file"
           class="form-control{{#error}} is-invalid{{/error}}"
           id="{{id}}"
           name="{{name}}"
           {{#accept}}accept="{{accept}}"{{/accept}}
           {{#multiple}}multiple{{/multiple}}
           {{#required}}required{{/required}}
           {{#disabled}}disabled{{/disabled}}>
    {{/isfile}}

    {{#error}}
    <div class="invalid-feedback">{{error}}</div>
    {{/error}}

    {{#helptext}}
    <div class="form-text">{{helptext}}</div>
    {{/helptext}}
</div>
