{{!
    @template local_jobboard/components/stat_card

    Statistics card component for dashboard metrics.
    Uses Bootstrap 5 classes from Moodle 4.5.

    Context variables:
    * value (string|int) - The main statistic value
    * label (string) - Description of the statistic
    * icon (string) - FontAwesome icon name
    * color (string) - Bootstrap color name (primary, success, warning, danger, info)
    * trend (object) - Optional trend indicator {direction: up|down, value: string}
    * url (string) - Optional link URL
    * tooltip (string) - Optional tooltip text

    Example context (json):
    {
        "value": "42",
        "label": "Active Vacancies",
        "icon": "briefcase",
        "color": "primary",
        "trend": {"direction": "up", "value": "+5%"},
        "url": "/vacancies"
    }
}}
<div class="card h-100 jb-hover-lift{{#animate}} jb-fade-in-up{{/animate}}"
     {{#tooltip}}data-bs-toggle="tooltip" title="{{tooltip}}"{{/tooltip}}>
    {{#url}}
    <a href="{{url}}" class="text-decoration-none text-reset">
    {{/url}}
        <div class="card-body jb-stat-card">
            {{! Icon }}
            {{#icon}}
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}} bg-opacity-10"
                      style="width: 60px; height: 60px;">
                    <i class="fa fa-{{icon}} fa-lg text-{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}}" aria-hidden="true"></i>
                </span>
            </div>
            {{/icon}}

            {{! Value }}
            <div class="jb-stat-value text-{{#color}}{{color}}{{/color}}{{^color}}primary{{/color}}">
                {{value}}
            </div>

            {{! Label }}
            <div class="jb-stat-label text-muted">
                {{label}}
            </div>

            {{! Trend indicator }}
            {{#trend}}
            <div class="jb-stat-trend mt-2">
                {{#isup}}
                <span class="jb-stat-trend-up">
                    <i class="fa fa-arrow-up me-1" aria-hidden="true"></i>{{value}}
                </span>
                {{/isup}}
                {{#isdown}}
                <span class="jb-stat-trend-down">
                    <i class="fa fa-arrow-down me-1" aria-hidden="true"></i>{{value}}
                </span>
                {{/isdown}}
            </div>
            {{/trend}}
        </div>
    {{#url}}
    </a>
    {{/url}}
</div>
