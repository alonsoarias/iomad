{{!
    @template local_jobboard/layouts/page

    Base page layout template.
    Note: Breadcrumbs are handled natively by Moodle via $PAGE->navbar

    Context variables:
    * region (string) - Data region identifier
    * pagetitle (string) - Page title
    * pageicon (string) - Icon for page title
    * headeractions (string) - HTML for header action buttons
    * alerts (array) - Alert messages to display
    * content (string) - Main page content (HTML)
    * sidebar (string) - Optional sidebar content (HTML)
    * footer (string) - Optional footer content (HTML)

    Example context (json):
    {
        "region": "jobboard-page",
        "pagetitle": "Page Title",
        "pageicon": "cog",
        "content": "<p>Content</p>"
    }
}}
<div class="local-jobboard-page" data-region="{{region}}">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 mb-0">
            {{#pageicon}}<i class="fa fa-{{pageicon}} text-primary me-2" aria-hidden="true"></i>{{/pageicon}}
            {{pagetitle}}
        </h1>
        {{#headeractions}}
        <div class="d-flex gap-2">
            {{{headeractions}}}
        </div>
        {{/headeractions}}
    </header>

    {{#alerts.0}}
    <div class="mb-4" role="region" aria-label="{{#str}}notifications{{/str}}">
        {{#alerts}}
        {{> local_jobboard/components/alert }}
        {{/alerts}}
    </div>
    {{/alerts.0}}

    {{#sidebar}}
    <div class="row">
        <main class="col-lg-8">
            {{{content}}}
        </main>
        <aside class="col-lg-4">
            {{{sidebar}}}
        </aside>
    </div>
    {{/sidebar}}
    {{^sidebar}}
    <main>
        {{{content}}}
    </main>
    {{/sidebar}}

    {{#footer}}
    <footer class="mt-4 pt-4 border-top">
        {{{footer}}}
    </footer>
    {{/footer}}
</div>
