{{!
    @template local_jobboard/components/alert

    Alert component with enhanced UX.
    Uses custom jb-alert classes for better visual hierarchy.

    Context variables:
    * type (string) - Alert type: success, danger, warning, info, primary
    * message (string) - Alert message content (can be HTML)
    * title (string) - Optional alert title/heading
    * icon (string) - Optional FontAwesome icon name (auto-detected if not provided)
    * dismissible (bool) - Whether alert can be dismissed
    * actions (array) - Optional action buttons [{url, label, color, icon}]
    * compact (bool) - Use compact padding
    * animate (bool) - Enable entrance animation
    * bordered (bool) - Use border-left accent style (default: true)

    Example context (json):
    {
        "type": "success",
        "title": "Success!",
        "message": "Operation completed successfully",
        "dismissible": true,
        "animate": true
    }
}}
<div class="jb-alert jb-alert-{{type}}{{#dismissible}} alert-dismissible{{/dismissible}}{{#compact}} py-3{{/compact}}{{#animate}} jb-fade-in-up{{/animate}}"
     role="alert"
     {{#animate}}aria-live="polite"{{/animate}}>
    <div class="d-flex align-items-start gap-3">
        {{! Icon with semantic color }}
        <div class="jb-alert-icon flex-shrink-0" aria-hidden="true">
            {{#icon}}
            <i class="fa fa-{{icon}} fa-lg"></i>
            {{/icon}}
            {{^icon}}
            {{#issuccess}}<i class="fa fa-circle-check fa-lg"></i>{{/issuccess}}
            {{#isdanger}}<i class="fa fa-circle-xmark fa-lg"></i>{{/isdanger}}
            {{#iswarning}}<i class="fa fa-triangle-exclamation fa-lg"></i>{{/iswarning}}
            {{#isinfo}}<i class="fa fa-circle-info fa-lg"></i>{{/isinfo}}
            {{#isprimary}}<i class="fa fa-bell fa-lg"></i>{{/isprimary}}
            {{/icon}}
        </div>

        {{! Content }}
        <div class="flex-grow-1 min-width-0">
            {{#title}}
            <h5 class="jb-alert-title mb-1">{{title}}</h5>
            {{/title}}
            <div class="jb-alert-message">{{{message}}}</div>

            {{! Action buttons }}
            {{#actions}}
            <div class="jb-alert-actions mt-3 d-flex gap-2 flex-wrap">
                {{#.}}
                <a href="{{url}}" class="btn btn-sm jb-btn-{{#color}}{{color}}{{/color}}{{^color}}outline-{{type}}{{/color}}">
                    {{#icon}}<i class="fa fa-{{icon}} me-1" aria-hidden="true"></i>{{/icon}}
                    {{label}}
                </a>
                {{/.}}
            </div>
            {{/actions}}
        </div>

        {{! Dismiss button }}
        {{#dismissible}}
        <button type="button"
                class="btn-close jb-alert-dismiss flex-shrink-0"
                data-bs-dismiss="alert"
                aria-label="{{#str}}dismiss, local_jobboard{{/str}}">
        </button>
        {{/dismissible}}
    </div>
</div>
