{{!
    @template local_jobboard/components/alert

    Alert component using Bootstrap 5 native classes.

    Context variables:
    * type (string) - Alert type: success, danger, warning, info, primary
    * message (string) - Alert message content (can be HTML)
    * title (string) - Optional alert title/heading
    * icon (string) - Optional FontAwesome icon name (auto-detected if not provided)
    * dismissible (bool) - Whether alert can be dismissed
    * actions (array) - Optional action buttons [{url, label, color}]

    Example context (json):
    {
        "type": "success",
        "title": "Success!",
        "message": "Operation completed successfully",
        "dismissible": true
    }
}}
<div class="alert alert-{{type}} jb-alert-{{type}}{{#dismissible}} alert-dismissible fade show{{/dismissible}}" role="alert">
    <div class="d-flex align-items-start">
        {{! Icon }}
        <div class="me-3" aria-hidden="true">
            {{#icon}}
            <i class="fa fa-{{icon}} fa-lg"></i>
            {{/icon}}
            {{^icon}}
            {{#issuccess}}<i class="fa fa-circle-check fa-lg"></i>{{/issuccess}}
            {{#isdanger}}<i class="fa fa-circle-exclamation fa-lg"></i>{{/isdanger}}
            {{#iswarning}}<i class="fa fa-triangle-exclamation fa-lg"></i>{{/iswarning}}
            {{#isinfo}}<i class="fa fa-circle-info fa-lg"></i>{{/isinfo}}
            {{#isprimary}}<i class="fa fa-bell fa-lg"></i>{{/isprimary}}
            {{/icon}}
        </div>

        <div class="flex-grow-1">
            {{#title}}
            <h5 class="alert-heading fw-bold mb-1">{{title}}</h5>
            {{/title}}
            <div>{{{message}}}</div>

            {{#actions}}
            <div class="mt-3 d-flex gap-2 flex-wrap">
                {{#.}}
                <a href="{{url}}" class="btn btn-sm btn-{{#color}}{{color}}{{/color}}{{^color}}outline-{{type}}{{/color}}">
                    {{#icon}}<i class="fa fa-{{icon}} me-1" aria-hidden="true"></i>{{/icon}}
                    {{label}}
                </a>
                {{/.}}
            </div>
            {{/actions}}
        </div>

        {{#dismissible}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        {{/dismissible}}
    </div>
</div>
