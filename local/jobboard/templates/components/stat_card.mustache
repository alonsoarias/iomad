{{!
    @template local_jobboard/components/stat_card

    Statistics card component for displaying numeric values.
    Enhanced with trend indicators, progress bars, and better visual hierarchy.

    Context variables:
    * value (string|number) - The statistic value
    * label (string) - Label describing the statistic
    * icon (string) - FontAwesome icon name
    * color (string) - Color theme: primary, success, warning, danger, info
    * url (string) - Optional link URL
    * loading (bool) - Show skeleton loading state
    * trend (object) - Optional trend indicator {direction: up|down, value: "12%", label: "vs last month"}
    * progress (object) - Optional progress bar {value: 75, max: 100}
    * sublabel (string) - Optional secondary label below main value
    * compact (bool) - Use compact layout
    * animate (bool) - Enable entrance animation

    Example context (json):
    {
        "value": "42",
        "label": "Applications",
        "icon": "file-alt",
        "color": "primary",
        "url": "/applications",
        "trend": {"direction": "up", "value": "12%", "label": "vs last month"},
        "animate": true
    }
}}
{{#loading}}
{{! Skeleton loading state }}
<div class="card jb-stat-card h-100" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="card-body{{#compact}} py-3{{/compact}}{{^compact}} py-4{{/compact}}">
        <div class="d-flex align-items-start justify-content-between">
            <div class="flex-grow-1">
                <div class="jb-skeleton jb-skeleton-text mb-2" style="width: 40%; height: 0.75rem;"></div>
                <div class="jb-skeleton jb-skeleton-text mb-1" style="width: 60%; height: 1.75rem;"></div>
                <div class="jb-skeleton jb-skeleton-text" style="width: 50%; height: 0.75rem;"></div>
            </div>
            <div class="jb-skeleton jb-skeleton-avatar" style="width: 48px; height: 48px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
{{#url}}
<a href="{{url}}" class="card jb-stat-card h-100 text-decoration-none text-reset jb-hover-lift{{#animate}} jb-fade-in-up{{/animate}}" style="--stat-color: var(--jb-{{color}});">
{{/url}}
{{^url}}
<div class="card jb-stat-card h-100{{#animate}} jb-fade-in-up{{/animate}}" style="--stat-color: var(--jb-{{color}});">
{{/url}}

    {{! Accent top border }}
    <div class="jb-stat-card-accent bg-{{color}}" style="height: 4px;"></div>

    <div class="card-body{{#compact}} py-3{{/compact}}{{^compact}} py-4{{/compact}}">
        <div class="d-flex align-items-start justify-content-between">
            {{! Content }}
            <div class="flex-grow-1 min-width-0">
                {{! Label }}
                <p class="jb-stat-label text-muted small fw-medium text-uppercase mb-1" style="letter-spacing: 0.05em;">
                    {{label}}
                </p>

                {{! Value }}
                <div class="jb-stat-value h3 fw-bold text-{{color}} mb-0">
                    {{value}}
                </div>

                {{! Sublabel }}
                {{#sublabel}}
                <p class="jb-stat-sublabel text-muted small mb-0 mt-1">{{sublabel}}</p>
                {{/sublabel}}

                {{! Trend indicator }}
                {{#trend}}
                <div class="jb-stat-trend mt-2">
                    <span class="badge {{#isup}}jb-badge-soft-success{{/isup}}{{#isdown}}jb-badge-soft-danger{{/isdown}}{{^isup}}{{^isdown}}jb-badge-soft-secondary{{/isdown}}{{/isup}}">
                        {{#isup}}<i class="fa fa-arrow-up fa-xs me-1" aria-hidden="true"></i>{{/isup}}
                        {{#isdown}}<i class="fa fa-arrow-down fa-xs me-1" aria-hidden="true"></i>{{/isdown}}
                        {{value}}
                    </span>
                    {{#label}}
                    <span class="text-muted small ms-1">{{label}}</span>
                    {{/label}}
                </div>
                {{/trend}}
            </div>

            {{! Icon }}
            {{#icon}}
            <div class="jb-stat-icon-wrapper flex-shrink-0 ms-3">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-{{color}}-subtle"
                     style="width: 48px; height: 48px;">
                    <i class="fa fa-{{icon}} fa-lg text-{{color}}" aria-hidden="true"></i>
                </div>
            </div>
            {{/icon}}
        </div>

        {{! Progress bar }}
        {{#progress}}
        <div class="jb-stat-progress mt-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted">{{#str}}progress{{/str}}</span>
                <span class="small fw-medium">{{value}}{{#max}}/{{max}}{{/max}}</span>
            </div>
            <div class="progress jb-progress-sm" role="progressbar" aria-valuenow="{{value}}" aria-valuemin="0" aria-valuemax="{{#max}}{{max}}{{/max}}{{^max}}100{{/max}}">
                <div class="progress-bar bg-{{color}}" style="width: {{percent}}%"></div>
            </div>
        </div>
        {{/progress}}
    </div>

{{#url}}
</a>
{{/url}}
{{^url}}
</div>
{{/url}}
{{/loading}}
