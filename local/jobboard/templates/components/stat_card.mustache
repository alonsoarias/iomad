{{!
    @template local_jobboard/components/stat_card

    Statistics card component for displaying numeric values.

    Context variables:
    * value (string|number) - The statistic value
    * label (string) - Label describing the statistic
    * icon (string) - FontAwesome icon name
    * color (string) - Color theme: primary, success, warning, danger, info
    * url (string) - Optional link URL
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "value": "42",
        "label": "Applications",
        "icon": "file-alt",
        "color": "primary",
        "url": "/applications"
    }
}}
{{#loading}}
{{! Skeleton loading state }}
<div class="card shadow-sm h-100" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="card-body text-center py-4">
        <div class="jb-skeleton jb-skeleton-avatar mx-auto mb-3"></div>
        <div class="jb-skeleton jb-skeleton-text mx-auto" style="width: 40%;"></div>
        <div class="jb-skeleton jb-skeleton-text mx-auto" style="width: 60%;"></div>
    </div>
</div>
{{/loading}}

{{^loading}}
{{#url}}
<a href="{{url}}" class="card shadow-sm h-100 text-decoration-none text-reset">
{{/url}}
{{^url}}
<div class="card shadow-sm h-100">
{{/url}}
    <div class="card-body text-center py-4">
        <div class="rounded-circle bg-{{color}} bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
            <i class="fa fa-{{icon}} fa-lg text-{{color}}" aria-hidden="true"></i>
        </div>
        <div class="fs-2 fw-bold text-{{color}}">{{value}}</div>
        <div class="small text-muted">{{label}}</div>
    </div>
{{#url}}
</a>
{{/url}}
{{^url}}
</div>
{{/url}}
{{/loading}}
