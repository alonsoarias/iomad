{{!
    @template local_jobboard/components/progress

    Enhanced progress bar component with multiple variants.
    Supports stacked progress, labels, and animations.

    Context variables:
    * value (number) - Current value (0-100)
    * color (string) - Color: primary, success, warning, danger, info
    * label (string) - Optional label to show inside bar
    * showpercent (bool) - Show percentage text
    * height (string) - Height in pixels (default: 20)
    * striped (bool) - Striped style
    * animated (bool) - Animated stripes
    * segments (array) - For stacked: {value, color, label}
    * arialabel (string) - ARIA label
    * size (string) - Size: sm, md, lg

    Example context (json):
    {
        "value": 75,
        "color": "success",
        "showpercent": true,
        "striped": true
    }
}}
{{#segments}}
{{! Stacked Progress Bar }}
<div class="progress jb-progress-stacked {{#size}}jb-progress-{{size}}{{/size}}"
     {{#height}}style="height: {{height}}px;"{{/height}}
     role="progressbar"
     aria-label="{{#arialabel}}{{arialabel}}{{/arialabel}}{{^arialabel}}{{#str}}progress, local_jobboard{{/str}}{{/arialabel}}">
    {{#segments}}
    <div class="progress-bar jb-bg-{{color}}{{#striped}} progress-bar-striped{{/striped}}{{#animated}} progress-bar-animated{{/animated}}"
         style="width: {{value}}%;"
         role="presentation"
         title="{{label}}: {{value}}%">
        {{#showlabel}}{{label}}{{/showlabel}}
        {{#showvalue}}{{value}}%{{/showvalue}}
    </div>
    {{/segments}}
</div>
{{#legend}}
<div class="d-flex flex-wrap gap-3 mt-2 small">
    {{#segments}}
    <span class="d-flex align-items-center">
        <span class="badge jb-badge-{{color}} me-1" style="width: 12px; height: 12px; padding: 0;"></span>
        {{label}}: <strong class="ms-1">{{value}}%</strong>
    </span>
    {{/segments}}
</div>
{{/legend}}
{{/segments}}

{{^segments}}
{{! Single Progress Bar }}
<div class="jb-progress-wrapper">
    {{#toplabel}}
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="small text-muted">{{toplabel}}</span>
        {{#showpercent}}<span class="small fw-medium">{{value}}%</span>{{/showpercent}}
    </div>
    {{/toplabel}}
    <div class="progress {{#size}}jb-progress-{{size}}{{/size}}"
         {{#height}}style="height: {{height}}px;"{{/height}}
         role="progressbar"
         aria-valuenow="{{value}}"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-label="{{#arialabel}}{{arialabel}}{{/arialabel}}{{^arialabel}}{{#str}}progress, local_jobboard{{/str}}{{/arialabel}}">
        <div class="progress-bar jb-bg-{{color}}{{#striped}} progress-bar-striped{{/striped}}{{#animated}} progress-bar-animated{{/animated}} {{#pulse}}jb-pulse{{/pulse}}"
             style="width: {{value}}%;">
            {{^toplabel}}{{#showpercent}}{{value}}%{{/showpercent}}{{/toplabel}}
            {{#label}}{{label}}{{/label}}
        </div>
    </div>
    {{#bottomlabel}}
    <div class="small text-muted mt-1">{{bottomlabel}}</div>
    {{/bottomlabel}}
</div>
{{/segments}}
