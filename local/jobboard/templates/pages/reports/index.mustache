{{!
    @template local_jobboard/pages/reports/index

    Reports page template with tabs, filters and multiple report types.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle (string) - Page title
    * reporttypes (array) - Report type tabs
    * currentreport (string) - Current active report type
    * filteraction (string) - Form action URL
    * convocatorias (array) - Convocatoria options for filter
    * selectedconvocatoriaid (number) - Selected convocatoria ID
    * selectedconvocatoria (string) - Selected convocatoria name
    * noconvocatoriaselected (bool) - No convocatoria selected
    * vacancies (array) - Vacancy options for filter
    * datefrom (string) - Date from value
    * dateto (string) - Date to value
    * exportlinks (array) - Export format links
    * hasdata (bool) - Has report data
    * dashboardurl (string) - URL to dashboard
    * caps (object) - User capabilities
    * loading (bool) - Show skeleton loading state

    Report-specific context (based on currentreport):
    * overview - Overview report data
    * applications - Applications by vacancy data
    * documents - Documents stats and breakdown
    * reviewers - Reviewer performance data
    * timeline - Daily application timeline data

    Example context (json):
    {
        "reporttypes": [{"type": "overview", "label": "Overview", "isactive": true}],
        "currentreport": "overview",
        "hasdata": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-reports" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton-title" style="width: 30%;"></div>
        <div class="d-flex gap-2">
            <div class="jb-skeleton-text" style="width: 80px; height: 36px;"></div>
            <div class="jb-skeleton-text" style="width: 80px; height: 36px;"></div>
        </div>
    </div>
    <div class="d-flex gap-2 mb-4">
        <div class="jb-skeleton-text" style="width: 100px; height: 40px;"></div>
        <div class="jb-skeleton-text" style="width: 100px; height: 40px;"></div>
        <div class="jb-skeleton-text" style="width: 100px; height: 40px;"></div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex gap-3">
                <div class="jb-skeleton-text" style="width: 200px; height: 40px;"></div>
                <div class="jb-skeleton-text" style="width: 150px; height: 40px;"></div>
                <div class="jb-skeleton-text" style="width: 150px; height: 40px;"></div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            {{> local_jobboard/components/table }}
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-reports" data-region="jobboard-reports">
    {{! Skip Link for Accessibility }}
    <a href="#reports-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 jb-fade-in">
        <h1 class="fs-3 mb-0">
            <i class="fa fa-chart-bar text-primary me-2" aria-hidden="true"></i>
            {{#str}}reports, local_jobboard{{/str}}
        </h1>
        {{#exportlinks.0}}
        <div class="btn-group" role="group" aria-label="{{#str}}exportoptions, local_jobboard{{/str}}">
            {{#exportlinks}}
            <a href="{{url}}" class="btn jb-btn-outline-{{color}} btn-sm jb-hover-lift">
                <i class="fa fa-{{icon}} me-1" aria-hidden="true"></i>
                {{label}}
            </a>
            {{/exportlinks}}
        </div>
        {{/exportlinks.0}}
    </header>

    {{! Report Type Tabs }}
    <nav class="mb-4 jb-fade-in" aria-label="{{#str}}reporttypes, local_jobboard{{/str}}" style="animation-delay: 0.05s;">
        <ul class="nav jb-nav-pills flex-wrap gap-1" role="tablist">
            {{#reporttypes}}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{#isactive}}jb-active{{/isactive}}" href="{{url}}"
                   role="tab" aria-selected="{{#isactive}}true{{/isactive}}{{^isactive}}false{{/isactive}}"
                   {{#isactive}}aria-current="page"{{/isactive}}>
                    <i class="fa fa-{{icon}} me-2" aria-hidden="true"></i>
                    {{label}}
                </a>
            </li>
            {{/reporttypes}}
        </ul>
    </nav>

    {{! Convocatoria Selection Card - Required before viewing reports }}
    {{#noconvocatoriaselected}}
    <section class="card shadow-sm mb-4 border-warning jb-fade-in-up" aria-labelledby="convocatoria-select-heading" style="animation-delay: 0.1s;">
        <div class="card-header bg-warning text-dark">
            <h2 class="fs-5 mb-0" id="convocatoria-select-heading">
                <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
                {{#str}}selectconvocatoria_required, local_jobboard{{/str}}
            </h2>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">{{#str}}selectconvocatoria_required_desc, local_jobboard{{/str}}</p>
            <form method="get" action="{{filteraction}}">
                <input type="hidden" name="view" value="reports">
                <input type="hidden" name="report" value="{{currentreport}}">
                <div class="mb-3 mb-3">
                    <label class="form-label fw-bold" for="filter-convocatoria-main">
                        {{#str}}convocatoria, local_jobboard{{/str}} <span class="text-danger" aria-label="{{#str}}required{{/str}}">*</span>
                    </label>
                    <select name="convocatoriaid" id="filter-convocatoria-main" class="form-select" required aria-required="true">
                        <option value="">-- {{#str}}selectconvocatoria, local_jobboard{{/str}} --</option>
                        {{#convocatorias}}
                        <option value="{{id}}">{{label}}</option>
                        {{/convocatorias}}
                    </select>
                </div>
                <button type="submit" class="btn btn-warning jb-hover-lift">
                    <i class="fa fa-check me-2" aria-hidden="true"></i>
                    {{#str}}continue, local_jobboard{{/str}}
                </button>
            </form>
        </div>
    </section>
    {{/noconvocatoriaselected}}

    {{^noconvocatoriaselected}}
    {{! Current Convocatoria Banner }}
    {{#selectedconvocatoriaid}}
    <div class="alert alert-info d-flex align-items-center mb-4 jb-fade-in-up" role="status" style="animation-delay: 0.1s;">
        <i class="fa fa-calendar-days me-3 fs-4" aria-hidden="true"></i>
        <div class="flex-grow-1">
            <strong>{{#str}}currentconvocatoria, local_jobboard{{/str}}:</strong>
            <span class="ms-1">{{selectedconvocatoria}}</span>
        </div>
        <a href="{{filteraction}}?view=reports" class="btn btn-sm btn-outline-info jb-hover-lift">
            <i class="fa fa-right-left me-1" aria-hidden="true"></i>
            {{#str}}changeconvocatoria, local_jobboard{{/str}}
        </a>
    </div>
    {{/selectedconvocatoriaid}}

    {{! Filter Card }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="filters-heading" style="animation-delay: 0.15s;">
        <div class="card-body">
            <form class="jb-filter-form" method="get" action="{{filteraction}}" role="search" aria-label="{{#str}}filterreports, local_jobboard{{/str}}">
                <input type="hidden" name="view" value="reports">
                <input type="hidden" name="report" value="{{currentreport}}">
                <input type="hidden" name="convocatoriaid" value="{{selectedconvocatoriaid}}">

                <div class="row align-items-end">
                    {{! Vacancy Filter }}
                    <div class="col-lg-3 col-md-6 mb-2">
                        <label class="form-label small text-muted" for="filter-vacancy">
                            {{#str}}vacancy, local_jobboard{{/str}}
                        </label>
                        <select name="vacancyid" id="filter-vacancy" class="form-select form-select-sm">
                            <option value="0">{{#str}}allvacancies, local_jobboard{{/str}}</option>
                            {{#vacancies}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/vacancies}}
                        </select>
                    </div>

                    {{! Date From }}
                    <div class="col-lg-3 col-md-6 mb-2">
                        <label class="form-label small text-muted" for="filter-datefrom">
                            {{#str}}datefrom, local_jobboard{{/str}}
                        </label>
                        <input type="date" name="datefrom" id="filter-datefrom"
                               class="form-control form-control-sm" value="{{datefrom}}">
                    </div>

                    {{! Date To }}
                    <div class="col-lg-3 col-md-6 mb-2">
                        <label class="form-label small text-muted" for="filter-dateto">
                            {{#str}}dateto, local_jobboard{{/str}}
                        </label>
                        <input type="date" name="dateto" id="filter-dateto"
                               class="form-control form-control-sm" value="{{dateto}}">
                    </div>

                    <div class="col-lg-3 col-md-6 mb-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="fa fa-filter me-1" aria-hidden="true"></i>
                            {{#str}}filter{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
    {{/noconvocatoriaselected}}

    {{! Report Content }}
    <main id="reports-main-content">
        {{#hasdata}}
        <div class="jb-report-content" data-report="{{currentreport}}">

            {{! ================================================================== }}
            {{! OVERVIEW REPORT }}
            {{! ================================================================== }}
            {{#isoverview}}
            {{! Stats Row }}
            <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
                {{#overview.stats}}
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-{{icon}} fa-2x text-{{color}} mb-2" aria-hidden="true"></i>
                            <div class="fs-3 fw-bold text-dark">{{value}}</div>
                            <div class="small text-muted">{{label}}</div>
                        </div>
                    </div>
                </div>
                {{/overview.stats}}
            </section>

            {{! Status Breakdown Card }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="status-breakdown-heading" style="animation-delay: 0.25s;">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h2 class="fs-5 mb-0" id="status-breakdown-heading">
                        <i class="fa fa-chart-bar text-primary me-2" aria-hidden="true"></i>
                        {{#str}}applicationsbystatus, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{#overview.hasstatusdata}}
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="{{#str}}applicationsbystatus, local_jobboard{{/str}}">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">{{#str}}status, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}count, local_jobboard{{/str}}</th>
                                    <th scope="col">{{#str}}percentage, local_jobboard{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#overview.statusdata}}
                                <tr>
                                    <td>
                                        <span class="badge jb-badge-{{color}}">{{statuslabel}}</span>
                                    </td>
                                    <td class="text-center">
                                        <strong>{{count}}</strong>
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px;" role="progressbar" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{statuslabel}}: {{percentage}}%">
                                            <div class="progress-bar jb-bg-{{color}}" style="width: {{percentage}}%;">
                                                {{percentage}}%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {{/overview.statusdata}}
                            </tbody>
                        </table>
                    </div>
                    {{/overview.hasstatusdata}}
                    {{^overview.hasstatusdata}}
                    <div class="jb-empty-state text-center py-4" role="status">
                        <i class="fa fa-chart-bar fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <p class="text-muted mb-0">{{#str}}nodata, local_jobboard{{/str}}</p>
                    </div>
                    {{/overview.hasstatusdata}}
                </div>
            </section>
            {{/isoverview}}

            {{! ================================================================== }}
            {{! APPLICATIONS REPORT }}
            {{! ================================================================== }}
            {{#isapplications}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="applications-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="applications-heading">
                        <i class="fa fa-briefcase text-primary me-2" aria-hidden="true"></i>
                        {{#str}}applicationsbyvacancy, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{#applications.hasdata}}
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="{{#str}}applicationsbyvacancy, local_jobboard{{/str}}">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">{{#str}}vacancy, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}total{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}selected, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}rejected, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}pending, local_jobboard{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#applications.rows}}
                                <tr>
                                    <td>
                                        <code class="text-primary fw-bold">{{code}}</code>
                                        <span class="text-muted ms-1">{{title}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill">{{total}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success rounded-pill">{{selected}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger rounded-pill">{{rejected}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark rounded-pill">{{pending}}</span>
                                    </td>
                                </tr>
                                {{/applications.rows}}
                            </tbody>
                        </table>
                    </div>
                    {{/applications.hasdata}}
                    {{^applications.hasdata}}
                    <div class="jb-empty-state text-center py-4" role="status">
                        <i class="fa fa-briefcase fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <p class="text-muted mb-0">{{#str}}nodata, local_jobboard{{/str}}</p>
                    </div>
                    {{/applications.hasdata}}
                </div>
            </section>
            {{/isapplications}}

            {{! ================================================================== }}
            {{! DOCUMENTS REPORT }}
            {{! ================================================================== }}
            {{#isdocuments}}
            {{! Stats Row }}
            <section class="row mb-4" role="region" aria-label="{{#str}}documentstats, local_jobboard{{/str}}">
                {{#documents.stats}}
                <div class="col-lg-3 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
                    <div class="card shadow-sm h-100 jb-hover-lift">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-{{icon}} fa-2x text-{{color}} mb-2" aria-hidden="true"></i>
                            <div class="fs-3 fw-bold text-dark">{{value}}</div>
                            <div class="small text-muted">{{label}}</div>
                        </div>
                    </div>
                </div>
                {{/documents.stats}}
            </section>

            <div class="row">
                {{! Rejection Reasons Card }}
                <div class="col-lg-6 mb-4 jb-fade-in-up" style="animation-delay: 0.25s;">
                    <section class="card shadow-sm h-100" aria-labelledby="rejection-reasons-heading">
                        <div class="card-header bg-white">
                            <h2 class="fs-5 mb-0" id="rejection-reasons-heading">
                                <i class="fa fa-triangle-exclamation text-warning me-2" aria-hidden="true"></i>
                                {{#str}}rejectionreasons, local_jobboard{{/str}}
                            </h2>
                        </div>
                        <div class="card-body">
                            {{#documents.hasrejections}}
                            <ul class="list-group list-group-flush">
                                {{#documents.rejectionreasons}}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>{{reason}}</span>
                                    <span class="badge bg-danger rounded-pill">{{count}}</span>
                                </li>
                                {{/documents.rejectionreasons}}
                            </ul>
                            {{/documents.hasrejections}}
                            {{^documents.hasrejections}}
                            <p class="text-muted mb-0 text-center py-3">
                                <i class="fa fa-circle-check text-success me-2" aria-hidden="true"></i>
                                {{#str}}norejections, local_jobboard{{/str}}
                            </p>
                            {{/documents.hasrejections}}
                        </div>
                    </section>
                </div>

                {{! Pending by Type Card }}
                <div class="col-lg-6 mb-4 jb-fade-in-up" style="animation-delay: 0.3s;">
                    <section class="card shadow-sm h-100" aria-labelledby="pending-type-heading">
                        <div class="card-header bg-white">
                            <h2 class="fs-5 mb-0" id="pending-type-heading">
                                <i class="fa fa-clock text-info me-2" aria-hidden="true"></i>
                                {{#str}}pendingbytype, local_jobboard{{/str}}
                            </h2>
                        </div>
                        <div class="card-body">
                            {{#documents.haspending}}
                            <ul class="list-group list-group-flush">
                                {{#documents.pendingbytype}}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>{{typename}}</span>
                                    <span class="badge bg-warning text-dark rounded-pill">{{pending}}</span>
                                </li>
                                {{/documents.pendingbytype}}
                            </ul>
                            {{/documents.haspending}}
                            {{^documents.haspending}}
                            <p class="text-muted mb-0 text-center py-3">
                                <i class="fa fa-circle-check text-success me-2" aria-hidden="true"></i>
                                {{#str}}nodata, local_jobboard{{/str}}
                            </p>
                            {{/documents.haspending}}
                        </div>
                    </section>
                </div>
            </div>

            {{! By Document Type Table }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="bytype-heading" style="animation-delay: 0.35s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="bytype-heading">
                        <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                        {{#str}}bydocumenttype, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{#documents.hasbytypedata}}
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="{{#str}}bydocumenttype, local_jobboard{{/str}}">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">{{#str}}documenttype, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}total{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}validated, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}rejected, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}pending, local_jobboard{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#documents.bytype}}
                                <tr>
                                    <td><strong>{{typename}}</strong></td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary rounded-pill">{{total}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success rounded-pill">{{validated}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger rounded-pill">{{rejected}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark rounded-pill">{{pending}}</span>
                                    </td>
                                </tr>
                                {{/documents.bytype}}
                            </tbody>
                        </table>
                    </div>
                    {{/documents.hasbytypedata}}
                </div>
            </section>
            {{/isdocuments}}

            {{! ================================================================== }}
            {{! REVIEWERS REPORT }}
            {{! ================================================================== }}
            {{#isreviewers}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="reviewers-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="reviewers-heading">
                        <i class="fa fa-users text-primary me-2" aria-hidden="true"></i>
                        {{#str}}reviewerperformance, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{#reviewers.hasdata}}
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="{{#str}}reviewerperformance, local_jobboard{{/str}}">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">{{#str}}reviewer, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}currentworkload, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}reviewed, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}validated, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}rejected, local_jobboard{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}avgtime, local_jobboard{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#reviewers.rows}}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="jb-avatar jb-avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                <i class="fa fa-user text-muted" aria-hidden="true"></i>
                                            </div>
                                            <strong>{{fullname}}</strong>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge jb-badge-{{workloadcolor}} rounded-pill">{{workload}}</span>
                                    </td>
                                    <td class="text-center">{{reviewed}}</td>
                                    <td class="text-center">
                                        <span class="text-success fw-bold">{{validated}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-danger fw-bold">{{rejected}}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark">{{avgtime}}h</span>
                                    </td>
                                </tr>
                                {{/reviewers.rows}}
                            </tbody>
                        </table>
                    </div>
                    {{/reviewers.hasdata}}
                    {{^reviewers.hasdata}}
                    <div class="jb-empty-state text-center py-4" role="status">
                        <i class="fa fa-users fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <p class="text-muted mb-0">{{#str}}noreviewers, local_jobboard{{/str}}</p>
                    </div>
                    {{/reviewers.hasdata}}
                </div>
            </section>
            {{/isreviewers}}

            {{! ================================================================== }}
            {{! TIMELINE REPORT }}
            {{! ================================================================== }}
            {{#istimeline}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="timeline-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0" id="timeline-heading">
                        <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                        {{#str}}dailyapplications, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    {{#timeline.hasdata}}
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="{{#str}}dailyapplications, local_jobboard{{/str}}">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">{{#str}}date{{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}}applications, local_jobboard{{/str}}</th>
                                    <th scope="col" style="width: 50%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#timeline.rows}}
                                <tr>
                                    <td><code class="text-muted">{{day}}</code></td>
                                    <td class="text-center"><strong>{{count}}</strong></td>
                                    <td>
                                        <div class="progress" style="height: 20px;" role="progressbar" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{day}}: {{count}} applications">
                                            <div class="progress-bar bg-primary" style="width: {{percentage}}%;"></div>
                                        </div>
                                    </td>
                                </tr>
                                {{/timeline.rows}}
                            </tbody>
                        </table>
                    </div>
                    {{/timeline.hasdata}}
                    {{^timeline.hasdata}}
                    <div class="jb-empty-state text-center py-4" role="status">
                        <i class="fa fa-calendar-xmark fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <p class="text-muted mb-0">{{#str}}nodata, local_jobboard{{/str}}</p>
                    </div>
                    {{/timeline.hasdata}}
                </div>
            </section>
            {{/istimeline}}

        </div>
        {{/hasdata}}

        {{! Empty State - No Data }}
        {{^hasdata}}
        <div class="text-center py-5 jb-fade-in-up" role="status">
            <i class="fa fa-chart-bar fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
            <h2 class="fs-4 text-muted mb-2">{{#str}}nodata, local_jobboard{{/str}}</h2>
            <p class="text-muted mb-0">{{#str}}trydifferentfilters, local_jobboard{{/str}}</p>
        </div>
        {{/hasdata}}
    </main>

    {{! Navigation Footer }}
    <nav class="jb-navigation-footer d-flex flex-wrap justify-content-center gap-2 mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-gauge me-2" aria-hidden="true"></i>
            {{#str}}dashboard, local_jobboard{{/str}}
        </a>
        {{#caps.viewallapplications}}
        <a href="{{manageurl}}" class="btn btn-outline-primary">
            <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
            {{#str}}managevacancies, local_jobboard{{/str}}
        </a>
        {{/caps.viewallapplications}}
        {{#caps.reviewdocuments}}
        <a href="{{bulkvalidateurl}}" class="btn btn-outline-success">
            <i class="fa fa-check-double me-2" aria-hidden="true"></i>
            {{#str}}bulkvalidation, local_jobboard{{/str}}
        </a>
        {{/caps.reviewdocuments}}
    </nav>
</div>
{{/loading}}
