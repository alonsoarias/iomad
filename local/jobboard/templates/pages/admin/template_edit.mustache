{{!
    @template local_jobboard/pages/admin_template_edit

    Email template edit form page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pagetitle - string - Page title
    * backurl - string - Back URL
    * templatename - string - Template display name
    * templatecode - string - Template code
    * hasdescription - bool - Has description
    * description - string - Template description
    * formhtml - string - Rendered form HTML
    * navfooter - object - Navigation footer data
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "pagetitle": "Edit Template",
        "templatename": "Application Received",
        "templatecode": "application_received"
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-local-jobboard-templates" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between mb-4">
        <div class="jb-skeleton-title" style="width: 180px;"></div>
        <div class="jb-skeleton-text" style="width: 150px; height: 38px;"></div>
    </div>
    <div class="card mb-4">
        <div class="card-header bg-primary">
            <div class="jb-skeleton-text" style="width: 200px; height: 24px;"></div>
        </div>
        <div class="card-body">
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 80px;"></div>
            <div class="jb-skeleton-text" style="height: 300px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-local-jobboard-templates" data-region="jobboard-template-edit">
    {{! Skip Link for Accessibility }}
    <a href="#template-edit-form" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h3 class="mb-0">
            <i class="fa fa-envelope text-primary me-2" aria-hidden="true"></i>
            {{str.email_templates}}
        </h3>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{str.back_to_templates}}
        </a>
    </header>

    {{! Template Edit Card }}
    <main id="template-edit-form">
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.05s;" aria-labelledby="template-edit-heading">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center" id="template-edit-heading">
                    <i class="fa fa-pen-to-square fa-lg text-primary me-3" aria-hidden="true"></i>
                    {{str.edit_template}}: {{templatename}}
                </h5>
                <code class="badge bg-light text-primary">{{templatecode}}</code>
            </div>
            <div class="card-body">
                {{! Template Description }}
                {{#hasdescription}}
                <div class="alert alert-info jb-alert-info d-flex align-items-start mb-4" role="note">
                    <i class="fa fa-circle-info fa-lg text-info me-3 mt-1" aria-hidden="true"></i>
                    <div>
                        <strong class="d-block mb-1">{{#str}}templatedescription, local_jobboard{{/str}}</strong>
                        <p class="mb-0">{{description}}</p>
                    </div>
                </div>
                {{/hasdescription}}

                {{! Form }}
                {{{formhtml}}}
            </div>
        </section>
    </main>

    {{! Placeholder Help }}
    <aside class="card shadow-sm mb-4 jb-fade-in" style="animation-delay: 0.1s;">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-code fa-lg text-secondary me-3" aria-hidden="true"></i>
            <h6 class="mb-0">
                {{#str}}availableplaceholders, local_jobboard{{/str}}
            </h6>
        </div>
        <div class="card-body">
            <div class="row small">
                <div class="col-md-4 mb-2">
                    <code class="text-primary">{user_fullname}</code>
                    <span class="text-muted ms-1">- {{#str}}placeholder_username, local_jobboard{{/str}}</span>
                </div>
                <div class="col-md-4 mb-2">
                    <code class="text-primary">{vacancy_title}</code>
                    <span class="text-muted ms-1">- {{#str}}placeholder_vacancytitle, local_jobboard{{/str}}</span>
                </div>
                <div class="col-md-4 mb-2">
                    <code class="text-primary">{site_name}</code>
                    <span class="text-muted ms-1">- {{#str}}placeholder_sitename, local_jobboard{{/str}}</span>
                </div>
            </div>
        </div>
    </aside>

    {{! Navigation Footer }}
    <footer class="card shadow-sm bg-light jb-fade-in" style="animation-delay: 0.15s;">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-center gap-2">
            <a href="{{navfooter.dashboardurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{str.dashboard}}
            </a>
            <a href="{{navfooter.doctypesurl}}" class="btn btn-outline-primary jb-hover-lift">
                <i class="fa fa-file-lines me-2" aria-hidden="true"></i>
                {{str.doctypes}}
            </a>
            <a href="{{navfooter.rolesurl}}" class="btn btn-outline-info jb-hover-lift">
                <i class="fa fa-user-tag me-2" aria-hidden="true"></i>
                {{str.manageroles}}
            </a>
            <a href="{{navfooter.settingsurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gear me-2" aria-hidden="true"></i>
                {{str.pluginsettings}}
            </a>
        </div>
    </footer>
</div>
{{/loading}}
