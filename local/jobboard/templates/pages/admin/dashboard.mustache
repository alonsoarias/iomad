{{!
    @template local_jobboard/pages/admin/dashboard

    Main dashboard page template - Ultra minimalist design with jb-* pattern.
    Provides role-based views for admins, reviewers, and applicants.

    Context variables:
    * isadmin (bool) - User is admin/manager
    * isreviewer (bool) - User can review
    * isapplicant (bool) - User can apply
    * isvieweronly (bool) - User can only view
    * welcome (object) - Welcome section {username, rolelabel, message, greeting}
    * showpubliclink (bool) - Show public page link
    * publicurl (string) - URL to public page
    * applicationsurl (string) - URL to applications
    * stats (array) - Admin stat cards
    * applicantstats (array) - Applicant stat cards
    * adminsections (array) - Admin section cards
    * workflowsections (array) - Workflow cards
    * reportsections (array) - Report cards
    * configsections (array) - Config cards
    * applicantsections (array) - Applicant section cards
    * reviewersection (object) - Reviewer section data
    * alerts (array) - Alert messages
    * hasnextconvocatoria (bool) - Has upcoming deadline
    * nextconvocatoria (object) - Next convocatoria data
    * hasrecentactivity (bool) - Has recent activity
    * recentactivity (array) - Recent activity items
}}
<div class="jb-dashboard" id="jobboard-dashboard">
    {{! Header }}
    <div class="jb-header">
        <div class="jb-header__top">
            {{#showpubliclink}}
            <a href="{{publicurl}}" class="jb-link">
                <i class="fa fa-globe"></i> {{#str}}viewpublicpage, local_jobboard{{/str}}
            </a>
            {{/showpubliclink}}
            <div class="jb-header__actions">
                {{#isapplicant}}
                <a href="{{applicationsurl}}" class="jb-btn jb-btn--outline jb-btn--sm">
                    <i class="fa fa-folder-open"></i> {{#str}}myapplications, local_jobboard{{/str}}
                </a>
                {{/isapplicant}}
                {{#isadmin}}
                <a href="{{manageurl}}" class="jb-btn jb-btn--primary jb-btn--sm">
                    <i class="fa fa-gears"></i> {{#str}}managevacancies, local_jobboard{{/str}}
                </a>
                {{/isadmin}}
            </div>
        </div>
        <h1 class="jb-header__title">{{#str}}dashboard, local_jobboard{{/str}}</h1>
        {{#welcome.rolelabel}}<span class="jb-badge jb-badge--muted">{{welcome.rolelabel}}</span>{{/welcome.rolelabel}}
    </div>

    {{! Alerts }}
    {{#alerts.0}}
    <div class="jb-alerts">
        {{#alerts}}
        <div class="jb-alert jb-alert--{{type}}">
            <i class="fa fa-{{icon}}"></i>
            <div class="jb-alert__body">
                {{#title}}<strong>{{title}}</strong> {{/title}}{{message}}
            </div>
            {{#actionurl}}<a href="{{actionurl}}" class="jb-btn jb-btn--sm jb-btn--{{type}}">{{actionlabel}}</a>{{/actionurl}}
        </div>
        {{/alerts}}
    </div>
    {{/alerts.0}}

    {{! Deadline Banner }}
    {{#hasnextconvocatoria}}
    <div class="jb-banner jb-banner--{{nextconvocatoria.alertclass}}">
        <div class="jb-banner__content">
            <span class="jb-badge jb-badge--{{nextconvocatoria.alertclass}}">
                {{#nextconvocatoria.iscritical}}<i class="fa fa-fire"></i> {{#str}}critical, local_jobboard{{/str}}{{/nextconvocatoria.iscritical}}
                {{^nextconvocatoria.iscritical}}<i class="fa fa-clock"></i> {{nextconvocatoria.daysremaining}} {{#str}}days, local_jobboard{{/str}}{{/nextconvocatoria.iscritical}}
            </span>
            <span class="jb-banner__text"><strong>{{nextconvocatoria.code}}</strong> {{nextconvocatoria.name}}</span>
        </div>
        <a href="{{nextconvocatoria.url}}" class="jb-link">{{#str}}viewdetails, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i></a>
    </div>
    {{/hasnextconvocatoria}}

    {{! Admin Section }}
    {{#isadmin}}
    {{#stats.0}}
    <div class="jb-stats">
        {{#stats}}
        <a href="{{url}}" class="jb-stat jb-stat--{{color}}">
            <span class="jb-stat__value">{{value}}</span>
            <span class="jb-stat__label">{{label}}</span>
        </a>
        {{/stats}}
    </div>
    {{/stats.0}}

    <div class="jb-section">
        <h2 class="jb-section__title">{{#str}}administracion, local_jobboard{{/str}}</h2>
        {{#adminsections.0}}
        <div class="jb-cards">
            {{#adminsections}}
            <a href="{{url}}" class="jb-card jb-card--{{color}}">
                <div class="jb-card__icon"><i class="fa fa-{{#icon}}{{icon}}{{/icon}}{{^icon}}folder{{/icon}}"></i></div>
                <div class="jb-card__content">
                    <h3>{{title}}</h3>
                    <p>{{description}}</p>
                </div>
                <i class="fa fa-chevron-right jb-card__arrow"></i>
            </a>
            {{/adminsections}}
        </div>
        {{/adminsections.0}}
    </div>

    {{#workflowsections.0}}
    <div class="jb-section">
        <h2 class="jb-section__title">{{#str}}workflowmanagement, local_jobboard{{/str}}</h2>
        <div class="jb-cards jb-cards--compact">
            {{#workflowsections}}
            <a href="{{url}}" class="jb-card jb-card--mini">
                <i class="fa fa-{{#icon}}{{icon}}{{/icon}}{{^icon}}list-check{{/icon}} jb-card__icon--{{color}}"></i>
                <span>{{title}}</span>
            </a>
            {{/workflowsections}}
        </div>
    </div>
    {{/workflowsections.0}}

    {{#reportsections.0}}
    <div class="jb-section">
        <h2 class="jb-section__title">{{#str}}reportsanddata, local_jobboard{{/str}}</h2>
        <div class="jb-cards jb-cards--compact">
            {{#reportsections}}
            <a href="{{url}}" class="jb-card jb-card--mini">
                <i class="fa fa-{{#icon}}{{icon}}{{/icon}}{{^icon}}chart-pie{{/icon}} jb-card__icon--{{color}}"></i>
                <span>{{title}}</span>
            </a>
            {{/reportsections}}
        </div>
    </div>
    {{/reportsections.0}}

    {{#configsections.0}}
    <div class="jb-section">
        <h2 class="jb-section__title">{{#str}}systemconfiguration, local_jobboard{{/str}}</h2>
        <div class="jb-cards jb-cards--compact">
            {{#configsections}}
            <a href="{{url}}" class="jb-card jb-card--mini">
                <i class="fa fa-{{#icon}}{{icon}}{{/icon}}{{^icon}}gear{{/icon}} jb-card__icon--{{color}}"></i>
                <span>{{title}}</span>
            </a>
            {{/configsections}}
        </div>
    </div>
    {{/configsections.0}}
    {{/isadmin}}

    {{! Reviewer Section }}
    {{#isreviewer}}
    <div class="jb-section">
        <h2 class="jb-section__title">{{#str}}reviewertasks, local_jobboard{{/str}}</h2>
        <div class="jb-review-box">
            <div class="jb-review-box__main">
                <div class="jb-review-box__header">
                    <span>{{#str}}myreviews, local_jobboard{{/str}}</span>
                    {{#reviewersection.pendingcount}}
                    <span class="jb-badge jb-badge--warning">{{reviewersection.pendingcount}} {{#str}}pending, local_jobboard{{/str}}</span>
                    {{/reviewersection.pendingcount}}
                </div>
                <p>{{#str}}myreviews_desc, local_jobboard{{/str}}</p>
                <a href="{{reviewersection.url}}" class="jb-btn jb-btn--primary">
                    {{#str}}viewmyreviews, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i>
                </a>
            </div>
            <div class="jb-review-box__stat">
                <span class="jb-review-box__value">{{reviewersection.completedcount}}</span>
                <span class="jb-review-box__label">{{#str}}completedreviews, local_jobboard{{/str}}</span>
            </div>
        </div>
    </div>
    {{/isreviewer}}

    {{! Applicant Section }}
    {{#isapplicant}}
    {{#applicantstats.0}}
    <div class="jb-stats">
        {{#applicantstats}}
        <a href="{{#url}}{{url}}{{/url}}{{^url}}#{{/url}}" class="jb-stat jb-stat--{{color}}">
            <span class="jb-stat__value">{{value}}</span>
            <span class="jb-stat__label">{{label}}</span>
        </a>
        {{/applicantstats}}
    </div>
    {{/applicantstats.0}}

    {{#applicantsections.0}}
    <div class="jb-section">
        <h2 class="jb-section__title">{{#str}}myapplications, local_jobboard{{/str}}</h2>
        <div class="jb-cards">
            {{#applicantsections}}
            <a href="{{url}}" class="jb-card jb-card--{{color}}">
                <div class="jb-card__icon"><i class="fa fa-{{#icon}}{{icon}}{{/icon}}{{^icon}}file-lines{{/icon}}"></i></div>
                <div class="jb-card__content">
                    <h3>{{title}}</h3>
                    <p>{{description}}</p>
                    {{#alert}}<span class="jb-card__alert jb-card__alert--{{alerttype}}">{{alert}}</span>{{/alert}}
                </div>
                <i class="fa fa-chevron-right jb-card__arrow"></i>
            </a>
            {{/applicantsections}}
        </div>
    </div>
    {{/applicantsections.0}}
    {{/isapplicant}}

    {{! Viewer Only }}
    {{#isvieweronly}}
    <div class="jb-empty">
        <i class="fa fa-eye"></i>
        <h3>{{#str}}vieweronly_title, local_jobboard{{/str}}</h3>
        <p>{{#str}}vieweronly_desc, local_jobboard{{/str}}</p>
        {{#showpubliclink}}
        <a href="{{publicurl}}" class="jb-btn jb-btn--primary">
            <i class="fa fa-globe"></i> {{#str}}viewpublicpage, local_jobboard{{/str}}
        </a>
        {{/showpubliclink}}
    </div>
    {{/isvieweronly}}

    {{! Recent Activity }}
    {{#hasrecentactivity}}
    <div class="jb-section">
        <div class="jb-section__header">
            <h2 class="jb-section__title">{{#str}}recentactivity, local_jobboard{{/str}}</h2>
            {{#viewallactivityurl}}
            <a href="{{viewallactivityurl}}" class="jb-link jb-link--sm">{{#str}}viewall, local_jobboard{{/str}}</a>
            {{/viewallactivityurl}}
        </div>
        <ul class="jb-activity">
            {{#recentactivity}}
            <li>
                <i class="fa fa-{{icon}} jb-activity__icon--{{color}}"></i>
                <a href="{{url}}" class="jb-activity__label">{{label}}</a>
                <span class="jb-activity__time">{{timecreated}}</span>
            </li>
            {{/recentactivity}}
        </ul>
    </div>
    {{/hasrecentactivity}}
</div>

<style>
/* Dashboard - Ultra Minimalist */
.jb-dashboard {
    max-width: 1200px;
    padding: 1rem;
}

/* Header */
.jb-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-header__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.jb-header__actions {
    display: flex;
    gap: 0.5rem;
}

.jb-header__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: var(--iser-negro, #1a1a1a);
}

/* Links */
.jb-link {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
    font-size: 0.8125rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
}

.jb-link:hover { color: var(--iser-verde-dark, #157a6a); }
.jb-link--sm { font-size: 0.75rem; }

/* Alerts */
.jb-alerts { margin-bottom: 1rem; }

.jb-alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
}

.jb-alert > i { font-size: 1rem; }
.jb-alert__body { flex: 1; }
.jb-alert--info { background: rgba(13, 110, 253, 0.08); color: #0d6efd; }
.jb-alert--warning { background: rgba(255, 193, 7, 0.12); color: #856404; }
.jb-alert--danger { background: rgba(220, 53, 69, 0.08); color: #c41e3a; }
.jb-alert--success { background: rgba(40, 167, 69, 0.08); color: #28a745; }

/* Banner */
.jb-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
}

.jb-banner__content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.jb-banner__text { font-size: 0.875rem; }
.jb-banner--warning { background: rgba(255, 193, 7, 0.12); color: #856404; }
.jb-banner--danger { background: rgba(220, 53, 69, 0.08); color: #c41e3a; }

/* Stats */
.jb-stats {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.jb-stat {
    flex: 1;
    min-width: 120px;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
}

.jb-stat:hover {
    border-color: var(--iser-verde, #1b9e88);
    text-decoration: none;
}

.jb-stat__value {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
}

.jb-stat__label {
    font-size: 0.6875rem;
    color: var(--iser-gris-medio, #666);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
}

.jb-stat--primary .jb-stat__value { color: var(--iser-verde, #1b9e88); }
.jb-stat--info .jb-stat__value { color: #0d6efd; }
.jb-stat--success .jb-stat__value { color: #28a745; }
.jb-stat--warning .jb-stat__value { color: #e0a800; }
.jb-stat--danger .jb-stat__value { color: #dc3545; }

/* Sections */
.jb-section {
    margin-bottom: 1.5rem;
}

.jb-section__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.jb-section__title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* Cards */
.jb-cards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.jb-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
}

.jb-card:hover {
    border-color: var(--iser-verde, #1b9e88);
    background: #fafafa;
    text-decoration: none;
}

.jb-card__icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}

.jb-card--primary .jb-card__icon { background: rgba(27, 158, 136, 0.1); color: var(--iser-verde, #1b9e88); }
.jb-card--success .jb-card__icon { background: rgba(40, 167, 69, 0.1); color: #28a745; }
.jb-card--warning .jb-card__icon { background: rgba(255, 193, 7, 0.15); color: #856404; }
.jb-card--info .jb-card__icon { background: rgba(13, 110, 253, 0.1); color: #0d6efd; }
.jb-card--secondary .jb-card__icon { background: #f0f0f0; color: #6c757d; }

.jb-card__content {
    flex: 1;
    min-width: 0;
}

.jb-card__content h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-card__content p {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0.125rem 0 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.jb-card__alert {
    display: inline-block;
    font-size: 0.75rem;
    margin-top: 0.25rem;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
}

.jb-card__alert--warning { background: rgba(255, 193, 7, 0.15); color: #856404; }
.jb-card__alert--info { background: rgba(13, 110, 253, 0.1); color: #0d6efd; }

.jb-card__arrow {
    color: #ccc;
    font-size: 0.75rem;
}

.jb-card:hover .jb-card__arrow {
    color: var(--iser-verde, #1b9e88);
}

/* Compact Cards */
.jb-cards--compact {
    flex-direction: row;
    flex-wrap: wrap;
}

.jb-card--mini {
    flex: 0 0 auto;
    padding: 0.625rem 1rem;
    gap: 0.5rem;
}

.jb-card--mini i {
    font-size: 0.875rem;
}

.jb-card--mini span {
    font-size: 0.8125rem;
    color: var(--iser-negro, #1a1a1a);
}

.jb-card__icon--primary { color: var(--iser-verde, #1b9e88); }
.jb-card__icon--success { color: #28a745; }
.jb-card__icon--warning { color: #e0a800; }
.jb-card__icon--info { color: #0d6efd; }
.jb-card__icon--secondary { color: #6c757d; }
.jb-card__icon--dark { color: #343a40; }

/* Review Box */
.jb-review-box {
    display: flex;
    gap: 1rem;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    overflow: hidden;
}

.jb-review-box__main {
    flex: 1;
    padding: 1rem;
}

.jb-review-box__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.jb-review-box__main p {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 0.75rem;
}

.jb-review-box__stat {
    width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0d6efd;
    color: #fff;
    text-align: center;
    padding: 1rem;
}

.jb-review-box__value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
}

.jb-review-box__label {
    font-size: 0.6875rem;
    opacity: 0.9;
    margin-top: 0.25rem;
}

/* Activity */
.jb-activity {
    list-style: none;
    padding: 0;
    margin: 0;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
}

.jb-activity li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.875rem;
}

.jb-activity li:last-child { border-bottom: none; }

.jb-activity__icon--primary { color: var(--iser-verde, #1b9e88); }
.jb-activity__icon--success { color: #28a745; }
.jb-activity__icon--warning { color: #ffc107; }
.jb-activity__icon--info { color: #0d6efd; }
.jb-activity__icon--secondary { color: #6c757d; }

.jb-activity__label {
    flex: 1;
    color: var(--iser-negro, #1a1a1a);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.jb-activity__label:hover { color: var(--iser-verde, #1b9e88); }

.jb-activity__time {
    font-size: 0.75rem;
    color: var(--iser-gris-medio, #666);
}

/* Empty */
.jb-empty {
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
}

.jb-empty > i {
    font-size: 2.5rem;
    color: #d1d5db;
    margin-bottom: 0.75rem;
}

.jb-empty h3 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
}

.jb-empty p {
    font-size: 0.875rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 1rem;
}

/* Buttons */
.jb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s;
}

.jb-btn--sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }
.jb-btn--primary { background: var(--iser-verde, #1b9e88); color: #fff; }
.jb-btn--primary:hover { background: var(--iser-verde-dark, #157a6a); color: #fff; }
.jb-btn--outline { background: transparent; border-color: #d1d5db; color: var(--iser-gris-oscuro, #333); }
.jb-btn--outline:hover { border-color: var(--iser-verde, #1b9e88); color: var(--iser-verde, #1b9e88); }
.jb-btn--info { background: #0d6efd; color: #fff; }
.jb-btn--warning { background: #ffc107; color: #1a1a1a; }
.jb-btn--danger { background: #dc3545; color: #fff; }
.jb-btn--success { background: #28a745; color: #fff; }

/* Badges */
.jb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
}

.jb-badge--muted { background: #f0f0f0; color: var(--iser-gris-medio, #666); }
.jb-badge--primary { background: rgba(27, 158, 136, 0.15); color: var(--iser-verde-dark, #157a6a); }
.jb-badge--success { background: rgba(40, 167, 69, 0.15); color: #1e7e34; }
.jb-badge--warning { background: rgba(255, 193, 7, 0.2); color: #856404; }
.jb-badge--danger { background: rgba(220, 53, 69, 0.15); color: #c41e3a; }
.jb-badge--info { background: rgba(13, 110, 253, 0.15); color: #0d6efd; }
.jb-badge--secondary { background: #e9ecef; color: #6c757d; }

/* Mobile */
@media (max-width: 768px) {
    .jb-header__top { flex-direction: column; align-items: flex-start; }
    .jb-stats { flex-direction: column; }
    .jb-stat { min-width: 100%; }
    .jb-cards--compact { flex-direction: column; }
    .jb-review-box { flex-direction: column; }
    .jb-review-box__stat { width: 100%; padding: 1rem; flex-direction: row; gap: 0.5rem; justify-content: center; }
    .jb-banner { flex-direction: column; align-items: flex-start; }
}

/* Print */
@media print {
    .jb-btn, .jb-header__actions { display: none; }
}
</style>

