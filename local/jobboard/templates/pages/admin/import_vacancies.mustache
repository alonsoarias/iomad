{{!
    @template local_jobboard/pages/import_vacancies

    Import vacancies form page - Clean design with jb-* pattern.

    Context variables:
    * pagetitle - Page title
    * backurl - Back URL
    * backtext - Back button text
    * csvcolumns - CSV column documentation
    * csvexample - CSV example content
    * formhtml - Rendered form HTML
    * str - Language strings
}}
<div class="jb-import" id="jobboard-import">
    {{! Header }}
    <div class="jb-import-header">
        <div class="jb-import-header__nav">
            <a href="{{backurl}}" class="jb-link">
                <i class="fa fa-arrow-left"></i> {{str.backtoconvocatorias}}
            </a>
        </div>
        <h1 class="jb-import-header__title">
            <i class="fa fa-file-import"></i> {{str.importvacancies}}
        </h1>
        <p class="jb-import-header__subtitle">{{#str}}importvacancies_desc, local_jobboard{{/str}}</p>
    </div>

    {{! CSV Format Documentation }}
    <div class="jb-card jb-card--info">
        <div class="jb-card__header">
            <div class="jb-card__header-icon jb-card__header-icon--info">
                <i class="fa fa-file-csv"></i>
            </div>
            <h2 class="jb-card__title">{{str.csvformat}}</h2>
        </div>
        <div class="jb-card__body">
            <p class="jb-card__desc">{{str.csvformatdesc}}</p>

            {{! Column Documentation Table }}
            <table class="jb-table jb-table--compact">
                <thead>
                    <tr>
                        <th><i class="fa fa-columns"></i> {{str.column}}</th>
                        <th><i class="fa fa-circle-info"></i> {{str.description}}</th>
                        <th class="jb-text-center"><i class="fa fa-asterisk"></i> {{str.required}}</th>
                        <th class="jb-hide-mobile"><i class="fa fa-code"></i> {{str.example}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#csvcolumns}}
                    <tr>
                        <td><code class="jb-code">{{name}}</code></td>
                        <td>{{description}}</td>
                        <td class="jb-text-center">
                            {{#isrequired}}
                            <span class="jb-badge jb-badge--danger">{{#str}}yes{{/str}}</span>
                            {{/isrequired}}
                            {{^isrequired}}
                            <span class="jb-badge jb-badge--secondary">{{#str}}no{{/str}}</span>
                            {{/isrequired}}
                        </td>
                        <td class="jb-hide-mobile"><code class="jb-code jb-code--muted">{{example}}</code></td>
                    </tr>
                    {{/csvcolumns}}
                </tbody>
            </table>
        </div>
    </div>

    {{! CSV Example }}
    <div class="jb-card">
        <div class="jb-card__header">
            <div class="jb-card__header-icon">
                <i class="fa fa-code"></i>
            </div>
            <h2 class="jb-card__title">{{str.csvexample}}</h2>
        </div>
        <div class="jb-card__body">
            <p class="jb-card__desc">{{str.csvexampledesc}}</p>
            <div class="jb-code-block">
                <pre><code>{{csvexample}}</code></pre>
            </div>
            <div class="jb-alert jb-alert--warning jb-alert--compact">
                <i class="fa fa-lightbulb"></i>
                <span>{{str.csvexampletip}}</span>
            </div>
        </div>
    </div>

    {{! Import Form }}
    <div class="jb-card jb-card--primary">
        <div class="jb-card__header">
            <div class="jb-card__header-icon jb-card__header-icon--primary">
                <i class="fa fa-upload"></i>
            </div>
            <h2 class="jb-card__title">{{#str}}uploadcsv, local_jobboard{{/str}}</h2>
        </div>
        <div class="jb-card__body">
            <div class="jb-form-container">
                {{{formhtml}}}
            </div>
        </div>
    </div>

    {{! Tips Section }}
    <div class="jb-tips">
        <div class="jb-tips__header">
            <i class="fa fa-circle-info"></i>
            <h3>{{#str}}importtips, local_jobboard{{/str}}</h3>
        </div>
        <ul class="jb-tips__list">
            <li><i class="fa fa-check"></i> {{#str}}importtip1, local_jobboard{{/str}}</li>
            <li><i class="fa fa-check"></i> {{#str}}importtip2, local_jobboard{{/str}}</li>
            <li><i class="fa fa-check"></i> {{#str}}importtip3, local_jobboard{{/str}}</li>
        </ul>
    </div>

    {{! Footer Navigation }}
    <div class="jb-footer-nav">
        <a href="{{backurl}}" class="jb-btn jb-btn--outline">
            <i class="fa fa-arrow-left"></i> {{str.backtoconvocatorias}}
        </a>
    </div>
</div>

<style>
/* Import Page - Clean jb-* Design */
.jb-import { max-width: 900px; padding: 1rem; }

/* Header */
.jb-import-header { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #e5e5e5; }
.jb-import-header__nav { margin-bottom: 1rem; }
.jb-import-header__title { font-size: 1.5rem; font-weight: 600; margin: 0 0 0.25rem; color: var(--iser-negro, #1a1a1a); display: flex; align-items: center; gap: 0.75rem; }
.jb-import-header__title i { color: var(--iser-verde, #1b9e88); }
.jb-import-header__subtitle { font-size: 1rem; color: var(--iser-gris-medio, #666); margin: 0; }

/* Links */
.jb-link { color: var(--iser-verde, #1b9e88); text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem; }
.jb-link:hover { color: var(--iser-verde-dark, #157a6a); }

/* Cards */
.jb-card { background: #fff; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden; margin-bottom: 1.5rem; }
.jb-card--primary { border-top: 3px solid var(--iser-verde, #1b9e88); }
.jb-card--info { border-top: 3px solid #17a2b8; }
.jb-card__header { padding: 0.75rem 1rem; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; gap: 0.75rem; }
.jb-card__header-icon { width: 32px; height: 32px; border-radius: 8px; background: rgba(27, 158, 136, 0.15); color: var(--iser-verde, #1b9e88); display: flex; align-items: center; justify-content: center; font-size: 0.875rem; }
.jb-card__header-icon--primary { background: rgba(27, 158, 136, 0.15); color: var(--iser-verde, #1b9e88); }
.jb-card__header-icon--info { background: rgba(23, 162, 184, 0.15); color: #17a2b8; }
.jb-card__title { font-size: 1rem; font-weight: 600; margin: 0; flex: 1; color: var(--iser-negro, #1a1a1a); }
.jb-card__body { padding: 1rem; }
.jb-card__desc { font-size: 0.875rem; color: var(--iser-gris-medio, #666); margin: 0 0 1rem; line-height: 1.5; }

/* Table */
.jb-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.jb-table--compact { font-size: 0.8125rem; }
.jb-table th { padding: 0.625rem 0.75rem; text-align: left; font-weight: 600; color: var(--iser-gris-oscuro, #333); background: #f9fafb; border-bottom: 1px solid #e5e5e5; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.025em; }
.jb-table th i { margin-right: 0.375rem; opacity: 0.7; }
.jb-table td { padding: 0.625rem 0.75rem; border-bottom: 1px solid #f0f0f0; color: var(--iser-gris-oscuro, #333); }
.jb-table tbody tr:hover { background: #f9fafb; }
.jb-table tbody tr:last-child td { border-bottom: none; }

/* Code */
.jb-code { font-family: 'Monaco', 'Consolas', monospace; font-size: 0.75rem; color: var(--iser-verde, #1b9e88); background: rgba(27, 158, 136, 0.1); padding: 0.125rem 0.375rem; border-radius: 4px; }
.jb-code--muted { color: var(--iser-gris-medio, #666); background: #f1f5f9; }

/* Code Block */
.jb-code-block { background: #1e293b; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; overflow-x: auto; }
.jb-code-block pre { margin: 0; }
.jb-code-block code { font-family: 'Monaco', 'Consolas', monospace; font-size: 0.75rem; color: #e2e8f0; white-space: pre; }

/* Text Utilities */
.jb-text-center { text-align: center; }
.jb-hide-mobile { display: table-cell; }

/* Badges */
.jb-badge { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.25rem 0.5rem; border-radius: 10px; font-size: 0.6875rem; font-weight: 500; }
.jb-badge--danger { background: rgba(220, 53, 69, 0.15); color: #dc3545; }
.jb-badge--secondary { background: #e9ecef; color: #6c757d; }

/* Alerts */
.jb-alert { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 8px; }
.jb-alert > i { font-size: 1rem; margin-top: 0.125rem; }
.jb-alert > span { font-size: 0.8125rem; line-height: 1.5; }
.jb-alert--warning { background: rgba(255, 193, 7, 0.15); border: 1px solid rgba(255, 193, 7, 0.3); color: #856404; }
.jb-alert--compact { padding: 0.75rem; }

/* Form Container */
.jb-form-container { }
.jb-form-container .form-group { margin-bottom: 1rem; }

/* Tips Section */
.jb-tips { background: #f9fafb; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; }
.jb-tips__header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
.jb-tips__header i { font-size: 1.125rem; color: #17a2b8; }
.jb-tips__header h3 { font-size: 0.9375rem; font-weight: 600; margin: 0; color: var(--iser-negro, #1a1a1a); }
.jb-tips__list { list-style: none; padding: 0; margin: 0; }
.jb-tips__list li { font-size: 0.8125rem; color: var(--iser-gris-medio, #666); padding: 0.375rem 0; display: flex; align-items: flex-start; gap: 0.625rem; }
.jb-tips__list li i { color: var(--iser-verde, #1b9e88); font-size: 0.75rem; margin-top: 0.25rem; }

/* Buttons */
.jb-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; padding: 0.5rem 1rem; border: 1px solid transparent; border-radius: 6px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; text-decoration: none; transition: all 0.15s; }
.jb-btn--outline { background: transparent; border-color: #d1d5db; color: var(--iser-gris-oscuro, #333); }
.jb-btn--outline:hover { border-color: var(--iser-verde, #1b9e88); color: var(--iser-verde, #1b9e88); }

/* Footer Nav */
.jb-footer-nav { display: flex; justify-content: flex-start; padding: 1.5rem 0; margin-top: 1rem; border-top: 1px solid #e5e5e5; }

/* Mobile */
@media (max-width: 768px) {
    .jb-import-header__title { font-size: 1.25rem; }
    .jb-hide-mobile { display: none; }
    .jb-table--compact th, .jb-table--compact td { padding: 0.5rem; }
}
@media print { .jb-btn, .jb-footer-nav { display: none; } }
</style>
