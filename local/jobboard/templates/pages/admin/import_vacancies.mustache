{{!
    @template local_jobboard/pages/import_vacancies

    Import vacancies form page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pagetitle - string - Page title
    * breadcrumbs - array - Breadcrumb items
    * backurl - string - Back URL
    * backtext - string - Back button text
    * csvcolumns - array - CSV column documentation
    * csvexample - string - CSV example content
    * formhtml - string - Rendered form HTML
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "pagetitle": "Import Vacancies",
        "backurl": "/local/jobboard/index.php?view=convocatorias"
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-import-vacancies" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="mb-4">
        <div class="jb-skeleton-text" style="width: 180px; height: 38px;"></div>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <div class="jb-skeleton-text" style="width: 150px;"></div>
        </div>
        <div class="card-body">
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 200px;"></div>
            <div class="jb-skeleton-text" style="width: 100%; height: 80px;"></div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="jb-skeleton-text" style="width: 100%; height: 150px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-import-vacancies" data-region="jobboard-import-vacancies">
    {{! Skip Link for Accessibility }}
    <a href="#import-form-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h3 class="mb-0">
            <i class="fa fa-file-import text-primary me-2" aria-hidden="true"></i>
            {{str.importvacancies}}
        </h3>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{str.backtoconvocatorias}}
        </a>
    </header>

    {{! CSV Format Help Card }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.05s;" aria-labelledby="csv-format-heading">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-file-csv fa-lg text-info me-3" aria-hidden="true"></i>
            <h5 class="mb-0" id="csv-format-heading">
                {{str.csvformat}}
            </h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">{{str.csvformatdesc}}</p>

            {{! Column Documentation Table }}
            <div class="table-responsive mb-4">
                <table class="table jb-table-sm table-bordered table-striped" aria-describedby="csv-format-heading">
                    <thead class="jb-thead-dark">
                        <tr>
                            <th scope="col">
                                <i class="fa fa-columns me-1" aria-hidden="true"></i>
                                {{str.column}}
                            </th>
                            <th scope="col">
                                <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
                                {{str.description}}
                            </th>
                            <th scope="col" class="text-center">
                                <i class="fa fa-asterisk me-1" aria-hidden="true"></i>
                                {{str.required}}
                            </th>
                            <th scope="col">
                                <i class="fa fa-code me-1" aria-hidden="true"></i>
                                {{str.example}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#csvcolumns}}
                        <tr class="jb-fade-in" style="animation-delay: calc(0.1s + {{@index}} * 0.02s);">
                            <td><code class="text-primary">{{name}}</code></td>
                            <td>{{description}}</td>
                            <td class="text-center">
                                {{#isrequired}}
                                <span class="badge bg-danger">{{#str}}yes{{/str}}</span>
                                {{/isrequired}}
                                {{^isrequired}}
                                <span class="badge bg-secondary">{{#str}}no{{/str}}</span>
                                {{/isrequired}}
                            </td>
                            <td><code class="text-muted">{{example}}</code></td>
                        </tr>
                        {{/csvcolumns}}
                    </tbody>
                </table>
            </div>

            {{! CSV Example }}
            <div class="card bg-light mb-0">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-code fa-lg text-secondary me-3" aria-hidden="true"></i>
                    <h6 class="mb-0">
                        {{str.csvexample}}
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">{{str.csvexampledesc}}</p>
                    <pre class="bg-dark text-light p-3 rounded small jb-code-block mb-3"><code>{{csvexample}}</code></pre>
                    <div class="alert alert-warning d-flex align-items-center mb-0" role="note">
                        <i class="fa fa-lightbulb me-2" aria-hidden="true"></i>
                        <small>{{str.csvexampletip}}</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{! Import Form Card }}
    <main id="import-form-content">
        <section class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="import-form-heading">
            <div class="card-header bg-white d-flex align-items-center">
                <i class="fa fa-upload fa-lg text-primary me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="import-form-heading">
                    {{#str}}uploadcsv, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </section>
    </main>

    {{! Help Tips }}
    <aside class="mt-4 jb-fade-in" style="animation-delay: 0.15s;">
        <div class="alert jb-alert-light d-flex align-items-start">
            <i class="fa fa-circle-info text-info me-3 mt-1" aria-hidden="true"></i>
            <div>
                <strong class="d-block mb-1">{{#str}}importtips, local_jobboard{{/str}}</strong>
                <ul class="mb-0 small text-muted jb-pl-3">
                    <li>{{#str}}importtip1, local_jobboard{{/str}}</li>
                    <li>{{#str}}importtip2, local_jobboard{{/str}}</li>
                    <li>{{#str}}importtip3, local_jobboard{{/str}}</li>
                </ul>
            </div>
        </div>
    </aside>
</div>
{{/loading}}
