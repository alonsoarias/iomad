{{!
    @template local_jobboard/pages/admin_templates

    Email Templates administration page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pageurl - string - Base page URL
    * stats - object - Statistics (total, enabled, disabled, categories)
    * categories - array - Available categories for tabs
    * currentcategory - string - Currently selected category
    * hastemplates - boolean - Whether there are templates
    * templates - array - List of templates
    * installurl - string - URL to install defaults
    * dashboardurl - string - Dashboard URL
    * doctypesurl - string - Doctypes admin URL
    * rolesurl - string - Roles admin URL
    * settingsurl - string - Plugin settings URL
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "pageurl": "/local/jobboard/admin/templates.php",
        "stats": {
            "total": 10,
            "enabled": 8,
            "disabled": 2,
            "categories": 5
        },
        "hastemplates": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-admin-templates" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between mb-4">
        <div class="jb-skeleton-title" style="width: 200px;"></div>
        <div class="d-flex gap-2">
            <div class="jb-skeleton-text" style="width: 100px; height: 38px;"></div>
            <div class="jb-skeleton-text" style="width: 120px; height: 38px;"></div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-3"><div class="jb-skeleton-text" style="height: 80px;"></div></div>
        <div class="col-md-3"><div class="jb-skeleton-text" style="height: 80px;"></div></div>
        <div class="col-md-3"><div class="jb-skeleton-text" style="height: 80px;"></div></div>
        <div class="col-md-3"><div class="jb-skeleton-text" style="height: 80px;"></div></div>
    </div>
    <div class="card">
        <div class="card-header"><div class="jb-skeleton-text" style="width: 300px;"></div></div>
        <div class="card-body"><div class="jb-skeleton-text" style="height: 300px;"></div></div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-admin-templates" data-region="jobboard-admin-templates">
    {{! Skip Link for Accessibility }}
    <a href="#templates-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 jb-fade-in">
        <h2 class="jb-page-title mb-0">
            <i class="fa fa-envelope text-primary me-2" aria-hidden="true"></i>
            {{str.emailtemplates}}
        </h2>
        <nav class="jb-header-actions" aria-label="{{#str}}actions{{/str}}">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary me-2 jb-hover-lift">
                <i class="fa fa-gauge me-1" aria-hidden="true"></i>
                {{str.dashboard}}
            </a>
            <a href="{{installurl}}" class="btn btn-success jb-hover-lift">
                <i class="fa fa-download me-1" aria-hidden="true"></i>
                {{str.installdefaults}}
            </a>
        </nav>
    </header>

    {{! Statistics Cards }}
    <section class="row mb-4" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card shadow-sm jb-stat-card bg-primary text-white h-100 jb-fade-in-up" style="animation-delay: 0.05s;">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <i class="fa fa-envelope fa-2x mb-2 opacity-75" aria-hidden="true"></i>
                    <div class="jb-stat-number fs-2 fw-bold">{{stats.total}}</div>
                    <div class="jb-stat-label small">{{str.totaltemplates}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card shadow-sm jb-stat-card bg-success text-white h-100 jb-fade-in-up" style="animation-delay: 0.1s;">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <i class="fa fa-circle-check fa-2x mb-2 opacity-75" aria-hidden="true"></i>
                    <div class="jb-stat-number fs-2 fw-bold">{{stats.enabled}}</div>
                    <div class="jb-stat-label small">{{str.templatesenabled}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card shadow-sm jb-stat-card bg-warning text-dark h-100 jb-fade-in-up" style="animation-delay: 0.15s;">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <i class="fa fa-circle-pause fa-2x mb-2 opacity-75" aria-hidden="true"></i>
                    <div class="jb-stat-number fs-2 fw-bold">{{stats.disabled}}</div>
                    <div class="jb-stat-label small">{{str.templatesdisabled}}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card shadow-sm jb-stat-card bg-info text-white h-100 jb-fade-in-up" style="animation-delay: 0.2s;">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <i class="fa fa-folder fa-2x mb-2 opacity-75" aria-hidden="true"></i>
                    <div class="jb-stat-number fs-2 fw-bold">{{stats.categories}}</div>
                    <div class="jb-stat-label small">{{str.templatecategories}}</div>
                </div>
            </div>
        </div>
    </section>

    {{! Category Filter Tabs and Templates Table }}
    <main id="templates-content">
        <div class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.25s;">
            <div class="card-header bg-white p-0">
                <nav aria-label="{{#str}}templatecategories, local_jobboard{{/str}}">
                    <ul class="nav nav-tabs jb-nav-fill card-header-tabs mb-0">
                        <li class="nav-item">
                            <a href="{{pageurl}}" class="nav-link {{^currentcategory}}jb-active{{/currentcategory}}"
                               {{^currentcategory}}aria-current="page"{{/currentcategory}}>
                                <i class="fa fa-list me-1" aria-hidden="true"></i>
                                {{str.all}}
                                <span class="badge bg-primary ms-1">{{stats.total}}</span>
                            </a>
                        </li>
                        {{#categories}}
                        <li class="nav-item">
                            <a href="{{url}}" class="nav-link {{#isactive}}jb-active{{/isactive}}"
                               {{#isactive}}aria-current="page"{{/isactive}}>
                                {{name}}
                                <span class="badge bg-secondary ms-1">{{count}}</span>
                            </a>
                        </li>
                        {{/categories}}
                    </ul>
                </nav>
            </div>

            <div class="card-body">
                {{^hastemplates}}
                {{! Empty State }}
                <div class="jb-empty-state text-center py-5">
                    <div class="jb-empty-state-icon mb-3">
                        <i class="fa fa-envelope-open fa-4x text-muted" aria-hidden="true"></i>
                    </div>
                    <h5 class="text-muted mb-2">{{str.notemplates}}</h5>
                    <p class="text-muted small mb-4">{{#str}}notemplates_desc, local_jobboard{{/str}}</p>
                    <a href="{{installurl}}" class="btn btn-primary jb-hover-lift">
                        <i class="fa fa-download me-2" aria-hidden="true"></i>
                        {{str.installdefaults}}
                    </a>
                </div>
                {{/hastemplates}}

                {{#hastemplates}}
                {{! Templates Table }}
                <div class="table-responsive">
                    <table class="table table-hover table-striped" aria-label="{{str.emailtemplates}}">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">
                                    <i class="fa fa-tag me-1" aria-hidden="true"></i>
                                    {{str.templatename}}
                                </th>
                                <th scope="col">
                                    <i class="fa fa-code me-1" aria-hidden="true"></i>
                                    {{str.templatecode}}
                                </th>
                                <th scope="col">
                                    <i class="fa fa-folder me-1" aria-hidden="true"></i>
                                    {{str.templatecategory}}
                                </th>
                                <th scope="col">
                                    <i class="fa fa-heading me-1" aria-hidden="true"></i>
                                    {{str.subject}}
                                </th>
                                <th scope="col" class="text-center">{{str.status}}</th>
                                <th scope="col" class="text-center">{{str.actions}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#templates}}
                            <tr class="{{#isdisabled}}jb-table-secondary{{/isdisabled}} jb-fade-in" style="animation-delay: calc(0.3s + {{@index}} * 0.03s);">
                                <td>
                                    <strong>{{name}}</strong>
                                    {{#isdefault}}
                                    <span class="badge bg-light text-dark ms-1">
                                        <i class="fa fa-star text-warning me-1" aria-hidden="true"></i>
                                        {{str.default}}
                                    </span>
                                    {{/isdefault}}
                                </td>
                                <td>
                                    <code class="text-primary">{{code}}</code>
                                </td>
                                <td>
                                    <span class="badge {{categorybadgeclass}}">
                                        <i class="fa fa-folder me-1" aria-hidden="true"></i>
                                        {{categoryname}}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 200px;" title="{{subjectfull}}">
                                        {{subjectpreview}}
                                    </span>
                                </td>
                                <td class="text-center">
                                    {{#enabled}}
                                    <span class="badge bg-success">
                                        <i class="fa fa-circle-check me-1" aria-hidden="true"></i>
                                        {{str.enabled}}
                                    </span>
                                    {{/enabled}}
                                    {{^enabled}}
                                    <span class="badge bg-secondary">
                                        <i class="fa fa-circle-xmark me-1" aria-hidden="true"></i>
                                        {{str.disabled}}
                                    </span>
                                    {{/enabled}}
                                </td>
                                <td class="text-center jb-action-buttons">
                                    <div class="btn-group" role="group" aria-label="{{#str}}actions{{/str}}">
                                        <a href="{{editurl}}" class="btn btn-sm btn-outline-primary" title="{{str.edit}}" aria-label="{{str.edit}} {{name}}">
                                            <i class="fa fa-pen-to-square" aria-hidden="true"></i>
                                        </a>
                                        {{#hassavedid}}
                                        <a href="{{toggleurl}}" class="btn btn-sm btn-outline-secondary" title="{{str.togglestatus}}" aria-label="{{str.togglestatus}} {{name}}">
                                            <i class="fa {{toggleicon}}" aria-hidden="true"></i>
                                        </a>
                                        {{/hassavedid}}
                                        {{#canreset}}
                                        <a href="{{reseturl}}" class="btn btn-sm btn-outline-warning" title="{{str.resettodefault}}" aria-label="{{str.resettodefault}} {{name}}"
                                           onclick="return confirm('{{str.confirmreset}}');">
                                            <i class="fa fa-rotate-left" aria-hidden="true"></i>
                                        </a>
                                        {{/canreset}}
                                    </div>
                                </td>
                            </tr>
                            {{/templates}}
                        </tbody>
                    </table>
                </div>
                {{/hastemplates}}
            </div>
        </div>
    </main>

    {{! Help Section }}
    <aside class="card shadow-sm mb-4 jb-fade-in" style="animation-delay: 0.35s;">
        <div class="card-header bg-secondary text-white">
            <h6 class="mb-0">
                <i class="fa fa-circle-question me-2" aria-hidden="true"></i>
                {{str.templatehelptitle}}
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-start">
                        <div class="jb-icon-circle bg-primary text-white me-3 flex-shrink-0">
                            <i class="fa fa-code" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">{{str.placeholders}}</h6>
                            <small class="text-muted">{{str.templatehelpplaceholders}}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-start">
                        <div class="jb-icon-circle bg-warning text-dark me-3 flex-shrink-0">
                            <i class="fa fa-html5" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">{{str.htmlsupport}}</h6>
                            <small class="text-muted">{{str.templatehelphtml}}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="jb-icon-circle bg-info text-white me-3 flex-shrink-0">
                            <i class="fa fa-building" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h6 class="mb-1">{{str.multitenant}}</h6>
                            <small class="text-muted">{{str.templatehelptenant}}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    {{! Navigation Footer }}
    <footer class="card shadow-sm bg-light jb-fade-in" style="animation-delay: 0.4s;">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-center gap-2">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{str.dashboard}}
            </a>
            <a href="{{doctypesurl}}" class="btn btn-outline-primary jb-hover-lift">
                <i class="fa fa-file-lines me-2" aria-hidden="true"></i>
                {{str.doctypes}}
            </a>
            <a href="{{rolesurl}}" class="btn btn-outline-info jb-hover-lift">
                <i class="fa fa-user-tag me-2" aria-hidden="true"></i>
                {{str.manageroles}}
            </a>
            <a href="{{settingsurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gear me-2" aria-hidden="true"></i>
                {{str.pluginsettings}}
            </a>
        </div>
    </footer>
</div>
{{/loading}}
