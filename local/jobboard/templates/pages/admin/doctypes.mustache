{{!
    @template local_jobboard/pages/admin/doctypes

    Document types management page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle (string) - Page title
    * stats (object) - Statistics {total, enabled, required, conditional}
    * doctypes (array) - Array of document types
    * hasdoctypes (bool) - Has doctypes
    * totalcount (number) - Total count
    * addurl (string) - URL to add new doctype
    * dashboardurl (string) - URL to dashboard
    * templatesurl (string) - URL to email templates
    * abouttitle (string) - About section title
    * aboutdesc (string) - About section description
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "pagetitle": "Manage Document Types",
        "stats": {"total": 10, "enabled": 8, "required": 5, "conditional": 3}
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-admin-doctypes" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton-title" style="width: 40%;"></div>
        <div class="d-flex gap-2">
            <div class="jb-skeleton-text" style="width: 120px; height: 40px;"></div>
            <div class="jb-skeleton-text" style="width: 120px; height: 40px;"></div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            {{> local_jobboard/components/table }}
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-admin-doctypes" data-region="jobboard-admin-doctypes">
    {{! Skip Link - Hidden until focused (Bootstrap 5 native) }}
    <a href="#doctypes-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header - Breadcrumbs handled by Moodle via $PAGE->navbar }}
    <header class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h1 class="h4 mb-0">
            <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h1>
        <div class="btn-group" role="group" aria-label="{{#str}}doctypeactions, local_jobboard{{/str}}">
            <a href="{{addurl}}" class="btn btn-primary">
                <i class="fa fa-plus me-2" aria-hidden="true"></i>
                {{#str}}adddoctype, local_jobboard{{/str}}
            </a>
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
        </div>
    </header>

    {{! Statistics Cards }}
    <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fa fa-folder fa-2x text-primary mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.total}}</div>
                    <div class="small text-muted">{{#str}}totaldoctypes, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fa fa-circle-check fa-2x text-success mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.enabled}}</div>
                    <div class="small text-muted">{{#str}}enableddoctypes, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fa fa-star fa-2x text-info mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.required}}</div>
                    <div class="small text-muted">{{#str}}requireddoctypes, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <i class="fa fa-filter fa-2x text-warning mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.conditional}}</div>
                    <div class="small text-muted">{{#str}}conditionaldoctypes, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
    </section>

    {{! Help Info }}
    <div class="alert alert-info d-flex align-items-start mb-4" role="alert">
        <i class="fa fa-circle-info fa-lg me-3 mt-1" aria-hidden="true"></i>
        <div>
            <strong class="d-block mb-1">{{abouttitle}}</strong>
            <p class="mb-0 small">{{aboutdesc}}</p>
        </div>
    </div>

    {{! Main Content }}
    <main id="doctypes-main-content">
        {{! Document Types List }}
        {{#hasdoctypes}}
        <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="doctypes-heading" style="animation-delay: 0.3s;">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="fs-5 mb-0" id="doctypes-heading">
                    <i class="fa fa-list text-primary me-2" aria-hidden="true"></i>
                    {{#str}}doctypelist, local_jobboard{{/str}}
                </h2>
                <span class="badge bg-secondary rounded-pill">
                    {{totalcount}} {{#str}}items, local_jobboard{{/str}}
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" aria-label="{{#str}}doctypelist, local_jobboard{{/str}}">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center" style="width: 60px;">
                                    <span class="text-muted">#</span>
                                </th>
                                <th scope="col">{{#str}}code, local_jobboard{{/str}}</th>
                                <th scope="col">{{#str}}name{{/str}}</th>
                                <th scope="col" class="d-none jb-d-lg-table-cell">{{#str}}category, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center">{{#str}}required, local_jobboard{{/str}}</th>
                                <th scope="col" class="d-none d-md-table-cell">{{#str}}conditions, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center">{{#str}}status{{/str}}</th>
                                <th scope="col" class="text-end" style="min-width: 180px;">{{#str}}actions{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#doctypes}}
                            <tr data-doctype-id="{{id}}" class="{{^enabled}}jb-table-secondary opacity-75{{/enabled}}">
                                <td class="text-center">
                                    <span class="badge bg-light text-dark fw-normal">{{sortorder}}</span>
                                </td>
                                <td>
                                    <code class="text-primary fw-bold">{{code}}</code>
                                </td>
                                <td>
                                    <strong>{{displayname}}</strong>
                                    {{#description}}
                                    <br><small class="text-muted">{{description}}</small>
                                    {{/description}}
                                </td>
                                <td class="d-none jb-d-lg-table-cell">
                                    {{#categoryname}}
                                    <span class="badge jb-badge-outline-secondary">{{categoryname}}</span>
                                    {{/categoryname}}
                                </td>
                                <td class="text-center">{{{requiredbadge}}}</td>
                                <td class="d-none d-md-table-cell">{{{conditionshtml}}}</td>
                                <td class="text-center">{{{statusbadge}}}</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}doctypeactions, local_jobboard{{/str}}">
                                        {{#canmoveup}}
                                        <a href="{{moveupurl}}" class="btn btn-outline-secondary" title="{{#str}}moveup{{/str}}">
                                            <i class="fa fa-arrow-up" aria-hidden="true"></i>
                                            <span class="visually-hidden">{{#str}}moveup{{/str}}</span>
                                        </a>
                                        {{/canmoveup}}
                                        {{^canmoveup}}
                                        <span class="btn btn-outline-secondary disabled" aria-disabled="true">
                                            <i class="fa fa-arrow-up" aria-hidden="true"></i>
                                        </span>
                                        {{/canmoveup}}
                                        {{#canmovedown}}
                                        <a href="{{movedownurl}}" class="btn btn-outline-secondary" title="{{#str}}movedown{{/str}}">
                                            <i class="fa fa-arrow-down" aria-hidden="true"></i>
                                            <span class="visually-hidden">{{#str}}movedown{{/str}}</span>
                                        </a>
                                        {{/canmovedown}}
                                        {{^canmovedown}}
                                        <span class="btn btn-outline-secondary disabled" aria-disabled="true">
                                            <i class="fa fa-arrow-down" aria-hidden="true"></i>
                                        </span>
                                        {{/canmovedown}}
                                        <a href="{{editurl}}" class="btn btn-outline-primary" title="{{#str}}edit{{/str}}">
                                            <i class="fa fa-pen-to-square" aria-hidden="true"></i>
                                            <span class="visually-hidden">{{#str}}edit{{/str}}</span>
                                        </a>
                                        <a href="{{toggleurl}}" class="btn jb-btn-outline-{{#enabled}}warning{{/enabled}}{{^enabled}}success{{/enabled}}" title="{{toggletitle}}">
                                            <i class="fa {{toggleicon}}" aria-hidden="true"></i>
                                            <span class="visually-hidden">{{toggletitle}}</span>
                                        </a>
                                        <a href="{{deleteurl}}" class="btn btn-outline-danger" title="{{#str}}delete{{/str}}" onclick="return confirm('{{#str}}confirmdeletedoctype, local_jobboard{{/str}}');">
                                            <i class="fa fa-trash-can" aria-hidden="true"></i>
                                            <span class="visually-hidden">{{#str}}delete{{/str}}</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{/doctypes}}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        {{/hasdoctypes}}

        {{! Empty State }}
        {{^hasdoctypes}}
        <div class="text-center py-5" role="status">
            <i class="fa fa-folder-open fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
            <h2 class="h5 text-muted mb-2">{{#str}}nodoctypes, local_jobboard{{/str}}</h2>
            <p class="text-muted mb-4">{{#str}}nodoctypesdesc, local_jobboard{{/str}}</p>
            <a href="{{addurl}}" class="btn btn-primary">
                <i class="fa fa-plus me-2" aria-hidden="true"></i>
                {{#str}}adddoctype, local_jobboard{{/str}}
            </a>
        </div>
        {{/hasdoctypes}}
    </main>

    {{! Navigation Footer }}
    <nav class="jb-navigation-footer d-flex flex-wrap justify-content-center gap-2 mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-gauge me-2" aria-hidden="true"></i>
            {{#str}}dashboard, local_jobboard{{/str}}
        </a>
        <a href="{{templatesurl}}" class="btn btn-outline-primary">
            <i class="fa fa-envelope me-2" aria-hidden="true"></i>
            {{#str}}emailtemplates, local_jobboard{{/str}}
        </a>
    </nav>
</div>
{{/loading}}
