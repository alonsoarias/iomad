{{!
    @template local_jobboard/pages/committee

    Selection committee management page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle - Page title string
    * islistview - Boolean if showing committees list
    * iscompanyview - Boolean if showing company committee
    * isvacancyview - Boolean if showing legacy vacancy committee
    * stats - Statistics data (totalcommittees, activecommittees, totalmembers)
    * companies - Available companies for filter
    * selectedcompanyid - Currently selected company ID
    * committees - All committees for list view
    * hascommittees - Boolean if has committees
    * companieswithoutcommittee - Companies without committees
    * hascompanieswithoutcommittee - Boolean if has companies without
    * company - Current company data (when iscompanyview)
    * existingcommittee - Existing committee for company/vacancy
    * hasexistingcommittee - Boolean if has committee
    * memberroles - Role definitions array
    * availableusers - Users available for assignment
    * hasavailableusers - Boolean if has available users
    * usersearch - Current user search string
    * facultyvacancies - Vacancies in current faculty
    * hasfacultyvacancies - Boolean if has vacancies
    * vacancy - Current vacancy data (when isvacancyview)
    * filterformurl - URL for filter form
    * backurl - URL to go back
    * dashboardurl - URL to dashboard
    * rolesurl - URL to roles management
    * reviewurl - URL to review applications

    Example context (json):
    {
        "islistview": true,
        "stats": {"totalcommittees": 5, "activecommittees": 4}
    }
}}
<div class="jb-committee-management" data-region="jobboard-committee">
    {{! Skip Link for Accessibility }}
    <a href="#committee-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h1 class="fs-3 mb-0">
            <i class="fa fa-users text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h1>
        <div class="btn-group">
            <a href="{{rolesurl}}" class="btn btn-outline-primary">
                <i class="fa fa-user-tag me-2" aria-hidden="true"></i>
                {{#str}}manageroles, local_jobboard{{/str}}
            </a>
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
        </div>
    </header>

    {{! Statistics Cards }}
    <section class="row mb-4" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
        <div class="col-lg-4 col-md-4 mb-3">
            <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.05s;">
                <div class="card-body text-center py-3">
                    <i class="fa fa-users fa-2x text-primary mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.totalcommittees}}</div>
                    <div class="small text-muted">{{#str}}totalcommittees, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 mb-3">
            <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.1s;">
                <div class="card-body text-center py-3">
                    <i class="fa fa-users-gear fa-2x text-success mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.activecommittees}}</div>
                    <div class="small text-muted">{{#str}}activecommittees, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 mb-3">
            <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.15s;">
                <div class="card-body text-center py-3">
                    <i class="fa fa-user-group fa-2x text-info mb-2" aria-hidden="true"></i>
                    <div class="fs-3 fw-bold text-dark">{{stats.totalmembers}}</div>
                    <div class="small text-muted">{{#str}}totalcommmembers, local_jobboard{{/str}}</div>
                </div>
            </div>
        </div>
    </section>

    {{! Faculty Filter Form }}
    <section class="card shadow-sm mb-4" aria-label="{{#str}}filter{{/str}}">
        <div class="card-body">
            <form method="get" action="{{filterformurl}}" class="jb-form-inline">
                <div class="mb-3 me-3">
                    <label class="visually-hidden" for="companyid">{{#str}}faculty, local_jobboard{{/str}}</label>
                    <select name="companyid" id="companyid" class="form-control" onchange="this.form.submit()">
                        <option value="0">{{#str}}selectfaculty, local_jobboard{{/str}}</option>
                        {{#companies}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/companies}}
                    </select>
                </div>
            </form>
        </div>
    </section>

    <main id="committee-main-content">
    {{#islistview}}
    {{! ================================================================== }}
    {{! LIST VIEW - All Committees }}
    {{! ================================================================== }}

    {{! All Committees Table }}
    <section class="card shadow-sm mb-4" aria-labelledby="committees-heading">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0" id="committees-heading">
                <i class="fa fa-users text-primary me-2" aria-hidden="true"></i>
                {{#str}}allcommittees, local_jobboard{{/str}}
            </h5>
        </div>
        <div class="card-body">
            {{#hascommittees}}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>{{#str}}faculty, local_jobboard{{/str}}</th>
                            <th>{{#str}}committeename, local_jobboard{{/str}}</th>
                            <th class="text-center">{{#str}}members, local_jobboard{{/str}}</th>
                            <th class="text-center">{{#str}}status{{/str}}</th>
                            <th class="text-center">{{#str}}actions{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#committees}}
                        <tr>
                            <td>
                                <a href="{{manageurl}}" class="text-decoration-none">
                                    <i class="fa fa-building text-primary me-2" aria-hidden="true"></i>
                                    {{entityname}}
                                </a>
                            </td>
                            <td>{{name}}</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">{{membercount}}</span>
                            </td>
                            <td class="text-center">
                                {{#isactive}}
                                <span class="badge bg-success">{{#str}}active, local_jobboard{{/str}}</span>
                                {{/isactive}}
                                {{^isactive}}
                                <span class="badge bg-secondary">{{status}}</span>
                                {{/isactive}}
                            </td>
                            <td class="text-center">
                                <a href="{{manageurl}}" class="btn btn-sm btn-outline-primary"
                                   title="{{#str}}manage, local_jobboard{{/str}}">
                                    <i class="fa fa-pen-to-square" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                        {{/committees}}
                    </tbody>
                </table>
            </div>
            {{/hascommittees}}
            {{^hascommittees}}
            <div class="text-center py-5" role="status">
                <i class="fa fa-users fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
                <p class="text-muted">{{#str}}nocommittees, local_jobboard{{/str}}</p>
            </div>
            {{/hascommittees}}
        </div>
    </section>

    {{! Faculties Without Committee }}
    {{#hascompanieswithoutcommittee}}
    <section class="card shadow-sm mb-4 border-warning" aria-labelledby="nocommittee-heading">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-triangle-exclamation fa-lg text-warning me-3" aria-hidden="true"></i>
            <h6 class="mb-0" id="nocommittee-heading">
                {{#str}}facultieswithoutcommittee, local_jobboard{{/str}}
            </h6>
        </div>
        <div class="card-body">
            <ul class="list-group">
                {{#companieswithoutcommittee}}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fa fa-building text-warning me-2" aria-hidden="true"></i>
                        {{name}}
                    </span>
                    <a href="{{createurl}}" class="btn btn-sm btn-warning">
                        <i class="fa fa-plus me-1" aria-hidden="true"></i>
                        {{#str}}createcommittee, local_jobboard{{/str}}
                    </a>
                </li>
                {{/companieswithoutcommittee}}
            </ul>
        </div>
    </section>
    {{/hascompanieswithoutcommittee}}
    {{/islistview}}

    {{#iscompanyview}}
    {{! ================================================================== }}
    {{! COMPANY VIEW - Faculty Committee Management }}
    {{! ================================================================== }}

    {{! Back Button }}
    <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
        {{#str}}backtolist, local_jobboard{{/str}}
    </a>

    {{! Faculty Header }}
    <section class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fa fa-building fa-lg text-primary me-3" aria-hidden="true"></i>
                <h5 class="mb-0">
                    {{company.name}}
                </h5>
            </div>
            <span class="badge bg-primary">{{company.vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}</span>
        </div>
    </section>

    {{#hasexistingcommittee}}
    {{! Existing Committee Display }}
    <section class="card shadow-sm mb-4" aria-labelledby="committee-heading">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fa fa-users fa-lg text-success me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="committee-heading">
                    {{existingcommittee.name}}
                </h5>
            </div>
            <span class="badge bg-success">{{existingcommittee.membercount}} {{#str}}members, local_jobboard{{/str}}</span>
        </div>
        <div class="card-body">
            {{#existingcommittee.hasmembers}}
            <div class="row">
                {{#existingcommittee.members}}
                <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body text-center">
                            {{! Avatar }}
                            <i class="fa fa-{{roleicon}} fa-2x text-{{rolecolor}} mb-2" aria-hidden="true"></i>

                            {{! Name }}
                            <h6 class="mb-1">{{fullname}}</h6>

                            {{! Username }}
                            <small class="d-block text-info mb-1">@{{username}}</small>

                            {{! Role Badge }}
                            <span class="badge jb-badge-{{rolecolor}} mb-2">{{rolename}}</span>

                            {{! Email }}
                            <small class="d-block text-muted mb-2">{{email}}</small>

                            {{! Actions }}
                            <div class="btn-group btn-group-sm">
                                {{! Change Role Dropdown }}
                                <div class="jb-dropdown">
                                    <button class="btn btn-sm btn-outline-secondary jb-dropdown-toggle"
                                            type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                                            title="{{#str}}changerole, local_jobboard{{/str}}">
                                        <i class="fa fa-right-left" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu jb-dropdown-menu">
                                        {{#availableroles}}
                                        <li><a href="{{changeurl}}" class="dropdown-item jb-dropdown-item">{{name}}</a></li>
                                        {{/availableroles}}
                                    </ul>
                                </div>

                                {{! Remove Button }}
                                <a href="{{removeurl}}" class="btn btn-sm btn-outline-danger"
                                   title="{{#str}}removemember, local_jobboard{{/str}}"
                                   onclick="return confirm('{{#str}}confirmremovemember, local_jobboard{{/str}}');">
                                    <i class="fa fa-user-minus" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/existingcommittee.members}}
            </div>
            {{/existingcommittee.hasmembers}}
            {{^existingcommittee.hasmembers}}
            <div class="text-center py-5" role="status">
                <i class="fa fa-user-plus fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
                <p class="text-muted">{{#str}}nomembers, local_jobboard{{/str}}</p>
            </div>
            {{/existingcommittee.hasmembers}}
        </div>
    </section>

    {{! Add Member Form }}
    <section class="card shadow-sm mb-4 border-primary" aria-labelledby="addmember-heading">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-user-plus fa-lg text-primary me-3" aria-hidden="true"></i>
            <h6 class="mb-0" id="addmember-heading">
                {{#str}}addmember, local_jobboard{{/str}}
            </h6>
        </div>
        <div class="card-body">
            {{! User Search Form }}
            <form method="get" action="{{filterformurl}}" class="mb-3">
                <input type="hidden" name="companyid" value="{{company.id}}">
                <div class="input-group">
                    <input type="text" name="usersearch" class="form-control"
                           placeholder="{{#str}}searchbyusername, local_jobboard{{/str}}"
                           value="{{usersearch}}">
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </form>

            {{! Add Member Form }}
            <form method="post" action="{{addmemberformurl}}" class="jb-form-inline">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="addmember">
                <input type="hidden" name="id" value="{{existingcommittee.id}}">

                <div class="mb-3 me-2 mb-2">
                    <label class="visually-hidden" for="userid">{{#str}}selectuser, local_jobboard{{/str}}</label>
                    <select name="userid" id="userid" class="form-control" required>
                        <option value="">{{#str}}selectuser, local_jobboard{{/str}}</option>
                        {{#availableusers}}
                        <option value="{{id}}">{{fullname}} (@{{username}}) - {{email}}</option>
                        {{/availableusers}}
                    </select>
                </div>

                <div class="mb-3 me-2 mb-2">
                    <label class="visually-hidden" for="memberrole">{{#str}}role{{/str}}</label>
                    <select name="memberrole" id="memberrole" class="form-control" required>
                        {{#memberroles}}
                        <option value="{{code}}">{{name}}</option>
                        {{/memberroles}}
                    </select>
                </div>

                <button type="submit" class="btn btn-primary mb-2">
                    <i class="fa fa-user-plus me-1" aria-hidden="true"></i>
                    {{#str}}addmember, local_jobboard{{/str}}
                </button>
            </form>
        </div>
    </section>

    {{! Faculty Vacancies }}
    {{#hasfacultyvacancies}}
    <section class="card shadow-sm mb-4" aria-labelledby="vacancies-heading">
        <div class="card-header bg-white">
            <h5 class="mb-0" id="vacancies-heading">
                <i class="fa fa-briefcase text-primary me-2" aria-hidden="true"></i>
                {{#str}}facultyvacancies, local_jobboard{{/str}}
            </h5>
        </div>
        <div class="card-body">
            <ul class="list-group">
                {{#facultyvacancies}}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fa fa-briefcase text-info me-2" aria-hidden="true"></i>
                        {{code}} - {{title}}
                    </span>
                    <span class="badge jb-badge-{{statuscolor}}">{{statuslabel}}</span>
                </li>
                {{/facultyvacancies}}
            </ul>
        </div>
    </section>
    {{/hasfacultyvacancies}}

    {{/hasexistingcommittee}}

    {{^hasexistingcommittee}}
    {{! Create Committee Form }}
    <section class="card shadow-sm mb-4 jb-border-success" aria-labelledby="create-heading">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-users fa-lg text-success me-3" aria-hidden="true"></i>
            <h5 class="mb-0" id="create-heading">
                {{#str}}createcommittee, local_jobboard{{/str}}
            </h5>
        </div>
        <div class="card-body">
            {{! User Search Form }}
            <form method="get" action="{{filterformurl}}" class="mb-3">
                <input type="hidden" name="companyid" value="{{company.id}}">
                <div class="input-group">
                    <input type="text" name="usersearch" class="form-control"
                           placeholder="{{#str}}searchbyusername, local_jobboard{{/str}}"
                           value="{{usersearch}}">
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </form>

            {{! Create Form }}
            <form method="post" action="{{createformurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="create">
                <input type="hidden" name="companyid" value="{{company.id}}">

                {{! Committee Name }}
                <div class="mb-3 mb-3">
                    <label class="form-label" for="name">{{#str}}committeename, local_jobboard{{/str}}</label>
                    <input type="text" name="name" id="name" class="form-control"
                           value="{{defaultcommitteename}}" required>
                </div>

                {{! Chair (Required) }}
                <div class="mb-3 mb-3">
                    <label class="form-label" for="chair">
                        <i class="fa fa-user-tie text-danger me-1" aria-hidden="true"></i>
                        {{#str}}role_chair, local_jobboard{{/str}}
                        <span class="text-danger">*</span>
                    </label>
                    <select name="chair" id="chair" class="form-control" required>
                        <option value="">{{#str}}selectuser, local_jobboard{{/str}}</option>
                        {{#availableusers}}
                        <option value="{{id}}">{{fullname}} (@{{username}}) - {{email}}</option>
                        {{/availableusers}}
                    </select>
                    <small class="form-text text-muted">{{#str}}chairhelp, local_jobboard{{/str}}</small>
                </div>

                {{! Secretary (Optional) }}
                <div class="mb-3 mb-3">
                    <label class="form-label" for="secretary">
                        <i class="fa fa-user-pen text-primary me-1" aria-hidden="true"></i>
                        {{#str}}role_secretary, local_jobboard{{/str}}
                    </label>
                    <select name="secretary" id="secretary" class="form-control">
                        <option value="">{{#str}}nosecretaryoptional, local_jobboard{{/str}}</option>
                        {{#availableusers}}
                        <option value="{{id}}">{{fullname}} (@{{username}}) - {{email}}</option>
                        {{/availableusers}}
                    </select>
                </div>

                {{! Evaluators (Optional Multiple) }}
                <div class="mb-3 mb-3">
                    <label class="form-label" for="evaluators">
                        <i class="fa fa-user-check text-success me-1" aria-hidden="true"></i>
                        {{#str}}role_evaluator, local_jobboard{{/str}}
                        ({{#str}}optional, local_jobboard{{/str}})
                    </label>
                    <select name="evaluators[]" id="evaluators" class="form-control" multiple size="5">
                        {{#availableusers}}
                        <option value="{{id}}">{{fullname}} (@{{username}}) - {{email}}</option>
                        {{/availableusers}}
                    </select>
                    <small class="form-text text-muted">{{#str}}evaluatorshelp, local_jobboard{{/str}}</small>
                </div>

                {{! Info Alert }}
                <div class="alert alert-info mb-3">
                    <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
                    {{#str}}committeeautoroleassign, local_jobboard{{/str}}
                </div>

                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fa fa-check me-2" aria-hidden="true"></i>
                    {{#str}}createcommittee, local_jobboard{{/str}}
                </button>
            </form>
        </div>
    </section>
    {{/hasexistingcommittee}}

    {{/iscompanyview}}

    {{#isvacancyview}}
    {{! ================================================================== }}
    {{! VACANCY VIEW - Legacy Support }}
    {{! ================================================================== }}

    {{! Back Button }}
    <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
        {{#str}}backtolist, local_jobboard{{/str}}
    </a>

    {{! Legacy Warning }}
    <div class="alert alert-warning mb-3">
        <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
        {{#str}}legacyvacancycommittee, local_jobboard{{/str}}
    </div>

    {{! Vacancy Header }}
    <section class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fa fa-briefcase fa-lg text-primary me-3" aria-hidden="true"></i>
                <h5 class="mb-0">
                    {{vacancy.code}} - {{vacancy.title}}
                </h5>
            </div>
            <span class="badge jb-badge-{{vacancy.statuscolor}}">{{vacancy.statuslabel}}</span>
        </div>
    </section>

    {{#hasexistingcommittee}}
    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <p>{{#str}}existingvacancycommittee, local_jobboard{{/str}}: <strong>{{existingcommittee.name}}</strong></p>
            <p>{{#str}}membercount, local_jobboard{{/str}}: <span class="badge bg-info text-dark">{{existingcommittee.membercount}}</span></p>
        </div>
    </section>
    {{/hasexistingcommittee}}

    {{^hasexistingcommittee}}
    <div class="text-center py-5" role="status">
        <i class="fa fa-users fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
        <p class="text-muted">{{#str}}nocommitteeforthisvacancy, local_jobboard{{/str}}</p>
    </div>
    {{/hasexistingcommittee}}

    {{/isvacancyview}}
    </main>

    {{! Navigation Footer }}
    <footer class="card shadow-sm mt-4 bg-light jb-fade-in" style="animation-delay: 0.2s;">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-center gap-2">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-gauge me-2" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
            <a href="{{rolesurl}}" class="btn btn-outline-primary jb-hover-lift">
                <i class="fa fa-user-tag me-2" aria-hidden="true"></i>
                {{#str}}manageroles, local_jobboard{{/str}}
            </a>
            <a href="{{reviewurl}}" class="btn btn-outline-info jb-hover-lift">
                <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                {{#str}}reviewapplications, local_jobboard{{/str}}
            </a>
        </div>
    </footer>
</div>
