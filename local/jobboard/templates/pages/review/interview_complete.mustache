{{!
    @template local_jobboard/pages/interview_complete_form

    Interview completion form page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pagetitle - string - Page title
    * applicantname - string - Applicant full name
    * vacancytitle - string - Vacancy title
    * vacancycode - string - Vacancy code
    * interviewdate - string - Formatted interview date
    * interviewtype - string - Interview type
    * interviewlocation - string - Interview location
    * formhtml - string - Rendered form HTML
    * backurl - string - Back URL
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "pagetitle": "Complete Interview",
        "applicantname": "John Doe",
        "vacancytitle": "Professor of Mathematics",
        "interviewdate": "December 15, 2025 at 10:00 AM"
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-local-jobboard-interview-complete" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton-title mb-4" style="width: 200px;"></div>
    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 100px;"></div>
    <div class="card">
        <div class="card-body">
            <div class="jb-skeleton-text" style="height: 300px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-local-jobboard-interview-complete" data-region="jobboard-interview-complete">
    {{! Skip Link for Accessibility }}
    <a href="#interview-complete-form" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h2 class="mb-0">
            <i class="fa fa-clipboard-check text-success me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h2>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}back, local_jobboard{{/str}}
        </a>
    </header>

    {{! Interview Info Card }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.05s;" aria-labelledby="interview-info-heading">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0" id="interview-info-heading">
                <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
                {{#str}}interviewdetails, local_jobboard{{/str}}
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-user fa-lg text-primary me-3" aria-hidden="true"></i>
                        <div>
                            <small class="text-muted d-block">{{str.applicant}}</small>
                            <strong>{{applicantname}}</strong>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa fa-briefcase fa-lg text-secondary me-3" aria-hidden="true"></i>
                        <div>
                            <small class="text-muted d-block">{{str.vacancy}}</small>
                            <strong>{{vacancycode}} - {{vacancytitle}}</strong>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-calendar fa-lg text-success me-3" aria-hidden="true"></i>
                        <div>
                            <small class="text-muted d-block">{{str.interviewdate}}</small>
                            <strong>{{interviewdate}}</strong>
                        </div>
                    </div>
                    {{#interviewlocation}}
                    <div class="d-flex align-items-center">
                        <i class="fa fa-location-dot fa-lg text-warning me-3" aria-hidden="true"></i>
                        <div>
                            <small class="text-muted d-block">{{#str}}location{{/str}}</small>
                            <strong>{{interviewlocation}}</strong>
                        </div>
                    </div>
                    {{/interviewlocation}}
                </div>
            </div>
        </div>
    </section>

    {{! Completion Form }}
    <main id="interview-complete-form">
        <section class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="complete-form-heading">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0" id="complete-form-heading">
                    <i class="fa fa-circle-check me-2" aria-hidden="true"></i>
                    {{#str}}completeinterview, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </section>
    </main>

    {{! Rating Guide }}
    <aside class="mt-4 jb-fade-in" style="animation-delay: 0.15s;">
        <div class="card shadow-sm bg-light">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0">
                    <i class="fa fa-star me-2" aria-hidden="true"></i>
                    {{#str}}ratingguide, local_jobboard{{/str}}
                </h6>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col">
                        <span class="badge bg-danger jb-badge-lg">1</span>
                        <small class="d-block mt-1">{{#str}}rating1, local_jobboard{{/str}}</small>
                    </div>
                    <div class="col">
                        <span class="badge bg-warning text-dark jb-badge-lg">2</span>
                        <small class="d-block mt-1">{{#str}}rating2, local_jobboard{{/str}}</small>
                    </div>
                    <div class="col">
                        <span class="badge bg-info text-dark jb-badge-lg">3</span>
                        <small class="d-block mt-1">{{#str}}rating3, local_jobboard{{/str}}</small>
                    </div>
                    <div class="col">
                        <span class="badge bg-primary jb-badge-lg">4</span>
                        <small class="d-block mt-1">{{#str}}rating4, local_jobboard{{/str}}</small>
                    </div>
                    <div class="col">
                        <span class="badge bg-success jb-badge-lg">5</span>
                        <small class="d-block mt-1">{{#str}}rating5, local_jobboard{{/str}}</small>
                    </div>
                </div>
            </div>
        </div>
    </aside>
</div>
{{/loading}}
