{{!
    @template local_jobboard/pages/review/index

    Document review page - Simplified design.

    Context variables:
    * pagetitle - Page title
    * dashboardurl - Dashboard URL
    * myreviewsurl - My reviews URL
    * backurl - Back URL
    * stats - Statistics cards array
    * filterform - Filter form data
    * hasapplications - Boolean for queue mode
    * applications - Applications array for queue mode
    * selectedapplication - Selected application for single review mode
    * documents - Documents to review
    * initialpreview - First document data for initial preview
    * hasinitialpreview - Boolean if initial preview available
    * pagination - Pagination HTML

    Example context (json):
    {
        "pagetitle": "Review Documents",
        "hasapplications": true
    }
}}
<div class="jb-review-page" id="jobboard-review-page">
    {{! ========== SINGLE APPLICATION REVIEW MODE ========== }}
    {{#selectedapplication}}
    {{! Quick Info Bar }}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div class="d-flex align-items-center gap-2">
            <code class="badge bg-light text-dark">{{selectedapplication.vacancycode}}</code>
            <span class="badge bg-{{selectedapplication.statuscolor}}">{{selectedapplication.statuslabel}}</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            {{#shownav}}
            <div class="btn-group btn-group-sm">
                {{#prevurl}}
                <a href="{{prevurl}}" class="btn btn-outline-secondary"><i class="fa fa-chevron-left"></i></a>
                {{/prevurl}}
                {{^prevurl}}
                <button class="btn btn-outline-secondary" disabled><i class="fa fa-chevron-left"></i></button>
                {{/prevurl}}
                <span class="btn btn-outline-secondary disabled">{{navposition}}/{{navtotal}}</span>
                {{#nexturl}}
                <a href="{{nexturl}}" class="btn btn-outline-secondary"><i class="fa fa-chevron-right"></i></a>
                {{/nexturl}}
                {{^nexturl}}
                <button class="btn btn-outline-secondary" disabled><i class="fa fa-chevron-right"></i></button>
                {{/nexturl}}
            </div>
            {{/shownav}}
            <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left me-1"></i>{{#str}}back{{/str}}
            </a>
        </div>
    </div>

    {{! Sequential Review Progress }}
    {{#haspending}}
    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
        <i class="fa fa-list-check me-3"></i>
        <div class="flex-grow-1">
            <strong>{{#str}}sequentialreview, local_jobboard{{/str}}</strong>
            <span class="d-block small">{{#str}}reviewingdocument, local_jobboard{{/str}} {{currentdocposition}} {{#str}}of, local_jobboard{{/str}} {{totaldocs}}</span>
        </div>
        <span class="badge bg-primary">{{currentdocposition}} / {{totaldocs}}</span>
    </div>
    {{/haspending}}

    {{! All Reviewed Success }}
    {{#allreviewed}}
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <i class="fa fa-check-circle me-3"></i>
        <div>
            <strong>{{#str}}alldocsreviewed, local_jobboard{{/str}}</strong>
            <span class="d-block small">{{#str}}readytosubmit, local_jobboard{{/str}}</span>
        </div>
    </div>
    {{/allreviewed}}

    <div class="row g-4">
        {{! Main Content - Document Preview }}
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fa fa-file-lines text-primary me-2"></i>
                        <span data-region="preview-title">
                            {{#hasinitialpreview}}{{initialpreview.filename}}{{/hasinitialpreview}}
                            {{^hasinitialpreview}}{{#str}}selectdocument, local_jobboard{{/str}}{{/hasinitialpreview}}
                        </span>
                        {{#hasinitialpreview}}
                        <small class="d-block text-muted" data-region="preview-subtitle">{{initialpreview.typename}}</small>
                        {{/hasinitialpreview}}
                    </h6>
                    <div class="btn-group btn-group-sm">
                        {{#hasinitialpreview}}
                        <a href="{{initialpreview.downloadurl}}" class="btn btn-outline-secondary" target="_blank" data-region="download-btn">
                            <i class="fa fa-download me-1"></i>{{#str}}download{{/str}}
                        </a>
                        <button type="button" class="btn btn-outline-secondary" onclick="document.querySelector('[data-region=preview-frame]').classList.toggle('jb-preview-fullscreen')" title="{{#str}}fullscreen, local_jobboard{{/str}}">
                            <i class="fa fa-expand"></i>
                        </button>
                        {{/hasinitialpreview}}
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="jb-preview-content bg-light position-relative" data-region="preview-frame" style="min-height: 500px;">
                        {{#hasinitialpreview}}
                        {{#initialpreview.ispdf}}
                        <iframe src="{{initialpreview.previewurl}}" class="w-100 h-100 border-0" style="min-height: 500px;"></iframe>
                        {{/initialpreview.ispdf}}
                        {{#initialpreview.isimage}}
                        <div class="d-flex align-items-center justify-content-center h-100 p-4" style="min-height: 500px;">
                            <img src="{{initialpreview.previewurl}}" alt="{{initialpreview.filename}}" class="img-fluid shadow rounded" style="max-height: 480px;">
                        </div>
                        {{/initialpreview.isimage}}
                        {{^initialpreview.canpreview}}
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;">
                            <i class="fa fa-file fa-4x mb-3"></i>
                            <p class="mb-3">{{#str}}previewnotavailable, local_jobboard{{/str}}</p>
                            <a href="{{initialpreview.downloadurl}}" class="btn btn-primary btn-sm" target="_blank">
                                <i class="fa fa-download me-2"></i>{{#str}}download{{/str}}
                            </a>
                        </div>
                        {{/initialpreview.canpreview}}
                        {{/hasinitialpreview}}
                        {{^hasinitialpreview}}
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;">
                            <i class="fa fa-file-circle-question fa-4x mb-3"></i>
                            <p>{{#str}}selectdocumenttopreview, local_jobboard{{/str}}</p>
                        </div>
                        {{/hasinitialpreview}}
                    </div>
                </div>
            </div>
        </div>

        {{! Sidebar }}
        <div class="col-lg-4">
            {{! Applicant Info Card }}
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0"><i class="fa fa-user text-primary me-2"></i>{{#str}}applicantinfo, local_jobboard{{/str}}</h6>
                </div>
                <div class="card-body py-3">
                    <h6 class="mb-2">{{selectedapplication.applicantname}}</h6>
                    <p class="small text-muted mb-1">
                        <i class="fa fa-envelope me-2"></i>
                        <a href="mailto:{{selectedapplication.email}}">{{selectedapplication.email}}</a>
                    </p>
                    <p class="small text-muted mb-0">
                        <i class="fa fa-briefcase me-2"></i>{{selectedapplication.vacancytitle}}
                    </p>
                </div>
            </div>

            {{! Documents List Card }}
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fa fa-folder-open text-info me-2"></i>{{#str}}documents, local_jobboard{{/str}}</h6>
                    {{#canvalidateall}}
                    <a href="{{validateallurl}}" class="btn btn-success btn-sm">
                        <i class="fa fa-check-double me-1"></i>{{#str}}validateall, local_jobboard{{/str}}
                    </a>
                    {{/canvalidateall}}
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush jb-documents-list" data-region="documents-list" style="max-height: 350px; overflow-y: auto;">
                        {{#documents}}
                        <div class="list-group-item jb-doc-item py-2 {{#iscurrent}}active bg-primary-subtle{{/iscurrent}} {{#islocked}}disabled opacity-50{{/islocked}}"
                             data-document-id="{{id}}"
                             data-preview-url="{{previewurl}}"
                             data-mimetype="{{mimetype}}"
                             data-is-pdf="{{ispdf}}"
                             data-is-image="{{isimage}}"
                             data-can-preview="{{canpreview}}"
                             data-typename="{{typename}}"
                             data-filename="{{filename}}"
                             data-download-url="{{downloadurl}}"
                             {{^islocked}}onclick="jobboardPreviewDocument(this)" style="cursor: pointer;"{{/islocked}}
                             {{#islocked}}style="cursor: not-allowed;"{{/islocked}}>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center flex-grow-1 min-width-0 me-2">
                                    <span class="badge rounded-pill {{#iscurrent}}bg-primary{{/iscurrent}}{{#isreviewed}}bg-{{statuscolor}}{{/isreviewed}}{{#islocked}}bg-secondary{{/islocked}} me-2 flex-shrink-0">{{docindex}}</span>
                                    <i class="fa fa-{{statusicon}} text-{{statuscolor}} me-2 flex-shrink-0"></i>
                                    <div class="min-width-0">
                                        <div class="fw-medium text-truncate small">{{typename}}</div>
                                        <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">{{filename}}</small>
                                    </div>
                                </div>
                                <span class="badge bg-{{statuscolor}} small flex-shrink-0">{{statuslabel}}</span>
                            </div>

                            {{#rejectreason}}
                            <div class="small text-danger mt-1"><i class="fa fa-circle-exclamation me-1"></i>{{rejectreason}}</div>
                            {{/rejectreason}}

                            {{#iscurrent}}
                            <div class="mt-2 pt-2 border-top" onclick="event.stopPropagation();">
                                <textarea name="doc_observation_{{id}}" id="doc_observation_{{id}}"
                                          class="form-control form-control-sm jb-doc-observation mb-2"
                                          rows="2" data-document-id="{{id}}" data-application-id="{{applicationid}}"
                                          placeholder="{{#str}}documentobservation_placeholder, local_jobboard{{/str}}">{{{observation}}}</textarea>
                                <div class="d-flex gap-2">
                                    <a href="{{validateurl}}" class="btn btn-success btn-sm flex-grow-1">
                                        <i class="fa fa-check me-1"></i>{{#str}}approve, local_jobboard{{/str}}
                                    </a>
                                    <button type="button" class="btn btn-danger btn-sm flex-grow-1" data-bs-toggle="modal" data-bs-target="#rejectModal{{id}}">
                                        <i class="fa fa-xmark me-1"></i>{{#str}}reject, local_jobboard{{/str}}
                                    </button>
                                </div>
                            </div>
                            {{/iscurrent}}

                            {{#isreviewed}}{{#observation}}
                            <div class="mt-1 small text-muted"><i class="fa fa-comment me-1"></i>{{{observation}}}</div>
                            {{/observation}}{{/isreviewed}}
                        </div>
                        {{/documents}}
                    </div>
                </div>
                <div class="card-footer bg-light py-2 text-end">
                    <button type="button" class="btn btn-sm btn-primary" id="saveAndSendBtn" onclick="jobboardSaveAndSendObservations()">
                        <i class="fa fa-paper-plane me-1"></i>{{#str}}saveandsend, local_jobboard{{/str}}
                    </button>
                </div>
            </div>

            {{! Review Progress Card }}
            <div class="card shadow-sm">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0"><i class="fa fa-chart-pie text-success me-2"></i>{{#str}}reviewprogress, local_jobboard{{/str}}</h6>
                </div>
                <div class="card-body py-3">
                    <div class="d-flex justify-content-around text-center mb-3">
                        <div>
                            <div class="h5 mb-0 text-success">{{approvedcount}}</div>
                            <small class="text-muted">{{#str}}docstatus:approved, local_jobboard{{/str}}</small>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-danger">{{rejectedcount}}</div>
                            <small class="text-muted">{{#str}}docstatus:rejected, local_jobboard{{/str}}</small>
                        </div>
                        <div>
                            <div class="h5 mb-0 text-warning">{{pendingcount}}</div>
                            <small class="text-muted">{{#str}}docstatus:pending, local_jobboard{{/str}}</small>
                        </div>
                    </div>
                    <div class="progress mb-3" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: {{approvedpercent}}%;"></div>
                        <div class="progress-bar bg-danger" style="width: {{rejectedpercent}}%;"></div>
                    </div>

                    {{#allreviewed}}
                    <form method="post" action="{{submitreviewurl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="markreviewed">
                        <input type="hidden" name="applicationid" value="{{selectedapplication.id}}">
                        <input type="hidden" name="view" value="review">
                        <div class="mb-2">
                            <textarea name="observations" id="observations" class="form-control form-control-sm" rows="2" placeholder="{{#str}}reviewobservations_placeholder, local_jobboard{{/str}}"></textarea>
                        </div>
                        <button type="submit" class="btn btn-{{completebtncolor}} btn-sm w-100">
                            <i class="fa fa-clipboard-check me-2"></i>{{#str}}submitreview, local_jobboard{{/str}}
                        </button>
                    </form>
                    {{/allreviewed}}
                </div>
            </div>
        </div>
    </div>

    {{! Rejection Modals - Outside the card structure }}
    {{#documents}}
    {{#iscurrent}}
    <div class="modal fade" id="rejectModal{{id}}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="{{rejecturl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="view" value="review">
                    <input type="hidden" name="applicationid" value="{{applicationid}}">
                    <input type="hidden" name="documentid" value="{{id}}">
                    <input type="hidden" name="action" value="reject">
                    <div class="modal-header bg-danger text-white py-2">
                        <h6 class="modal-title"><i class="fa fa-triangle-exclamation me-2"></i>{{#str}}rejectdocument, local_jobboard{{/str}}</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3"><i class="fa fa-file me-2"></i>{{typename}}</p>
                        <div class="mb-3">
                            <label for="reason{{id}}" class="form-label small fw-bold">{{#str}}rejectreason, local_jobboard{{/str}} *</label>
                            <textarea name="reason" id="reason{{id}}" class="form-control form-control-sm" rows="3" required placeholder="{{#str}}rejectreason_placeholder, local_jobboard{{/str}}"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">{{#str}}cancel{{/str}}</button>
                        <button type="submit" class="btn btn-danger btn-sm"><i class="fa fa-xmark me-1"></i>{{#str}}reject, local_jobboard{{/str}}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {{/iscurrent}}
    {{/documents}}
    {{/selectedapplication}}

    {{! ========== APPLICATIONS QUEUE MODE ========== }}
    {{^selectedapplication}}
    {{! Quick Actions Bar }}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div class="d-flex align-items-center gap-2">
            {{#stats}}
            <span class="badge bg-{{color}} px-3 py-2">
                <span class="fw-bold">{{value}}</span> {{label}}
            </span>
            {{/stats}}
        </div>
        <div class="btn-group btn-group-sm">
            <a href="{{myreviewsurl}}" class="btn btn-outline-primary">
                <i class="fa fa-clipboard-list me-1"></i>{{#str}}myreviews, local_jobboard{{/str}}
            </a>
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-home me-1"></i>{{#str}}dashboard, local_jobboard{{/str}}
            </a>
        </div>
    </div>

    {{! Filter Form }}
    {{#filterform}}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0"><i class="fa fa-filter me-2 text-muted"></i>{{#str}}filter, local_jobboard{{/str}}</h6>
        </div>
        <div class="card-body py-3">
            <form method="get" action="{{action}}">
                {{#hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="row align-items-end g-2">
                    {{#fields}}
                    <div class="col-md-4">
                        <label for="filter-{{name}}" class="form-label small text-muted mb-1">{{label}}</label>
                        <select name="{{name}}" id="filter-{{name}}" class="form-select form-select-sm">
                            {{#options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                    </div>
                    {{/fields}}
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa fa-search me-1"></i>{{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! Applications List }}
    {{#hasapplications}}
    {{#applications}}
    <div class="card shadow-sm mb-3 {{#isurgent}}border-danger{{/isurgent}}">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h6 class="mb-0">{{applicantname}}</h6>
                        {{#isurgent}}
                        <span class="badge bg-danger"><i class="fa fa-triangle-exclamation me-1"></i>{{#str}}urgent, local_jobboard{{/str}}</span>
                        {{/isurgent}}
                    </div>
                    <p class="text-muted small mb-1"><i class="fa fa-envelope me-2"></i>{{email}}</p>
                    <div class="d-flex flex-wrap gap-2 align-items-center small">
                        <code class="badge bg-light text-dark">{{vacancycode}}</code>
                        <span class="text-muted">{{vacancytitle}}</span>
                    </div>
                </div>
                <div class="col-md-3 text-md-center my-2 my-md-0">
                    <span class="badge bg-secondary me-1">{{doccount}} {{#str}}documents, local_jobboard{{/str}}</span>
                    {{#pendingcount}}
                    <span class="badge bg-warning text-dark">{{pendingcount}} {{#str}}pending, local_jobboard{{/str}}</span>
                    {{/pendingcount}}
                    {{^pendingcount}}
                    <span class="badge bg-success">{{#str}}allvalidated, local_jobboard{{/str}}</span>
                    {{/pendingcount}}
                    <div class="small text-muted mt-1"><i class="fa fa-calendar me-1"></i>{{datesubmitted}}</div>
                </div>
                <div class="col-md-3 text-md-end">
                    <a href="{{reviewurl}}" class="btn btn-primary btn-sm me-1">
                        <i class="fa fa-magnifying-glass me-1"></i>{{#str}}review, local_jobboard{{/str}}
                    </a>
                    <a href="{{viewurl}}" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-eye"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/applications}}
    {{/hasapplications}}

    {{! Empty State }}
    {{^hasapplications}}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa fa-circle-check fa-3x text-success mb-3"></i>
            <h5 class="text-muted">{{#str}}nodocumentstoreview, local_jobboard{{/str}}</h5>
            <p class="text-muted">{{#str}}allcaughtup, local_jobboard{{/str}}</p>
        </div>
    </div>
    {{/hasapplications}}

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-4">{{{pagination}}}</nav>
    {{/pagination}}
    {{/selectedapplication}}
</div>

{{! Document Preview JavaScript }}
<script>
function jobboardPreviewDocument(element) {
    const previewUrl = element.dataset.previewUrl;
    const isPdf = element.dataset.isPdf === 'true' || element.dataset.isPdf === '1';
    const isImage = element.dataset.isImage === 'true' || element.dataset.isImage === '1';
    const typename = element.dataset.typename;
    const filename = element.dataset.filename;
    const downloadUrl = element.dataset.downloadUrl;

    document.querySelectorAll('[data-region="documents-list"] .list-group-item').forEach(item => {
        item.classList.remove('active', 'bg-primary-subtle');
    });
    element.classList.add('active', 'bg-primary-subtle');

    const titleEl = document.querySelector('[data-region="preview-title"]');
    if (titleEl) titleEl.textContent = filename;

    let subtitleEl = document.querySelector('[data-region="preview-subtitle"]');
    if (subtitleEl) {
        subtitleEl.textContent = typename;
    } else {
        subtitleEl = document.createElement('small');
        subtitleEl.className = 'd-block text-muted';
        subtitleEl.dataset.region = 'preview-subtitle';
        subtitleEl.textContent = typename;
        if (titleEl && titleEl.parentNode) titleEl.parentNode.appendChild(subtitleEl);
    }

    const downloadBtn = document.querySelector('[data-region="download-btn"]');
    if (downloadBtn && downloadUrl) downloadBtn.href = downloadUrl;

    const previewFrame = document.querySelector('[data-region="preview-frame"]');
    if (!previewFrame) return;

    if (previewUrl && (isPdf || isImage)) {
        if (isPdf) {
            previewFrame.innerHTML = '<iframe src="' + previewUrl + '" class="w-100 h-100 border-0" style="min-height: 500px;"></iframe>';
        } else if (isImage) {
            previewFrame.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 p-4" style="min-height: 500px;"><img src="' + previewUrl + '" alt="' + filename + '" class="img-fluid shadow rounded" style="max-height: 480px;"></div>';
        }
    } else {
        previewFrame.innerHTML = '<div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;"><i class="fa fa-file fa-4x mb-3"></i><p class="mb-3">{{#str}}previewnotavailable, local_jobboard{{/str}}</p>' + (downloadUrl ? '<a href="' + downloadUrl + '" class="btn btn-primary btn-sm" target="_blank"><i class="fa fa-download me-2"></i>{{#str}}download{{/str}}</a>' : '') + '</div>';
    }
}
</script>

<style>
.jb-review-page .card { border-radius: 0.5rem; }
.jb-review-page .min-width-0 { min-width: 0; }
.jb-preview-fullscreen {
    position: fixed !important;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9999;
    background: white;
}
.jb-preview-fullscreen iframe, .jb-preview-fullscreen img { max-height: 100vh !important; }
.jb-doc-item.active { background-color: rgba(13, 110, 253, 0.1) !important; }
.jb-documents-list { scrollbar-width: thin; }
.jb-documents-list::-webkit-scrollbar { width: 6px; }
.jb-documents-list::-webkit-scrollbar-thumb { background-color: #dee2e6; border-radius: 3px; }
</style>

{{! JavaScript for document observations }}
{{#selectedapplication}}
{{#js}}
require(['jquery', 'core/ajax', 'core/notification'], function($, Ajax, Notification) {
    window.jobboardSaveAndSendObservations = function() {
        var observations = [];
        $('.jb-doc-observation').each(function() {
            var docId = $(this).data('document-id');
            var text = $(this).val();
            if (docId) observations.push({documentid: docId, observation: text});
        });

        var btn = $('#saveAndSendBtn');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> {{#str}}saving, local_jobboard{{/str}}');

        Ajax.call([{
            methodname: 'local_jobboard_save_document_observations',
            args: { applicationid: {{selectedapplication.id}}, observations: JSON.stringify(observations) },
            done: function() {
                btn.html('<i class="fa fa-spinner fa-spin me-1"></i> {{#str}}sending, local_jobboard{{/str}}');
                Ajax.call([{
                    methodname: 'local_jobboard_send_observations_email',
                    args: { applicationid: {{selectedapplication.id}}, observations: JSON.stringify(observations) },
                    done: function() {
                        btn.prop('disabled', false).html('<i class="fa fa-check me-1"></i> {{#str}}sent, local_jobboard{{/str}}');
                        setTimeout(function() { window.location.reload(); }, 1000);
                    },
                    fail: function(error) {
                        btn.prop('disabled', false).html('<i class="fa fa-exclamation-triangle me-1"></i> {{#str}}emailerror, local_jobboard{{/str}}');
                        Notification.exception(error);
                        setTimeout(function() { window.location.reload(); }, 3000);
                    }
                }]);
            },
            fail: function(error) {
                btn.prop('disabled', false).html('<i class="fa fa-paper-plane me-1"></i> {{#str}}saveandsend, local_jobboard{{/str}}');
                Notification.exception(error);
            }
        }]);
    };

    $(document).on('blur', '.jb-doc-observation', function() {
        var $textarea = $(this);
        var docId = $textarea.data('document-id');
        var text = $textarea.val();

        Ajax.call([{
            methodname: 'local_jobboard_save_document_observations',
            args: { applicationid: {{selectedapplication.id}}, observations: JSON.stringify([{documentid: docId, observation: text}]) },
            done: function() {
                $textarea.addClass('border-success');
                setTimeout(function() { $textarea.removeClass('border-success'); }, 1000);
            },
            fail: function() {}
        }]);
    });
});
{{/js}}
{{/selectedapplication}}
