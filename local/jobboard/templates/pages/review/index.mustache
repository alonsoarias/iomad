{{! JavaScript for document observations with Moodle editor }}
{{#selectedapplication}}
{{#js}}
require(['jquery', 'core/ajax', 'core/notification', 'core/str'], function($, Ajax, Notification, Str) {
    // Helper function to get editor content (supports Atto, TinyMCE, and plain textarea)
    // Moodle editors are initialized via PHP using use_editor()
    function getEditorContent(elementId) {
        var textarea = document.getElementById(elementId);
        if (!textarea) return '';

        // For Atto editor, update textarea from editable div first
        var attoContent = document.querySelector('#' + elementId + 'editable');
        if (attoContent) {
            textarea.value = attoContent.innerHTML;
        }

        // Check for TinyMCE
        if (typeof tinyMCE !== 'undefined' && tinyMCE.get(elementId)) {
            return tinyMCE.get(elementId).getContent();
        }

        return textarea.value || '';
    }

    // Save observations via AJAX
    window.jobboardSaveObservations = function() {
        var observations = [];
        $('.jb-doc-observation').each(function() {
            var docId = $(this).data('document-id');
            var elementId = $(this).attr('id');
            var text = getEditorContent(elementId);
            if (docId) {
                observations.push({
                    documentid: docId,
                    observation: text
                });
            }
        });

        if (observations.length === 0) {
            return;
        }

        var btn = $('#saveObservationsBtn');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> {{#str}}saving, admin{{/str}}');

        Ajax.call([{
            methodname: 'local_jobboard_save_document_observations',
            args: {
                applicationid: {{selectedapplication.id}},
                observations: JSON.stringify(observations)
            },
            done: function(response) {
                btn.prop('disabled', false).html('<i class="fa fa-check me-1"></i> {{#str}}changessaved{{/str}}');
                setTimeout(function() {
                    btn.html('<i class="fa fa-save me-1"></i> {{#str}}savechanges{{/str}}');
                }, 2000);
            },
            fail: function(error) {
                btn.prop('disabled', false).html('<i class="fa fa-save me-1"></i> {{#str}}savechanges{{/str}}');
                Notification.exception(error);
            }
        }]);
    };

    // Send observations email
    window.jobboardSendObservationsEmail = function() {
        var observations = [];
        var hasObservations = false;

        $('.jb-doc-observation').each(function() {
            var docId = $(this).data('document-id');
            var elementId = $(this).attr('id');
            var text = getEditorContent(elementId);
            // Strip HTML to check if there's actual content
            var textContent = text.replace(/<[^>]*>/g, '').trim();
            if (docId && textContent) {
                hasObservations = true;
                observations.push({
                    documentid: docId,
                    observation: text
                });
            }
        });

        if (!hasObservations) {
            Str.get_string('noobservationstosend', 'local_jobboard').then(function(str) {
                Notification.alert('', str);
            });
            return;
        }

        var btn = $('#sendObservationsBtn');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> {{#str}}sending, admin{{/str}}');

        Ajax.call([{
            methodname: 'local_jobboard_send_observations_email',
            args: {
                applicationid: {{selectedapplication.id}},
                observations: JSON.stringify(observations)
            },
            done: function(response) {
                Str.get_string('observationsemailsent', 'local_jobboard').then(function(str) {
                    btn.prop('disabled', false).html('<i class="fa fa-check me-1"></i> ' + str);
                    setTimeout(function() {
                        Str.get_string('sendobservationsemail', 'local_jobboard').then(function(str2) {
                            btn.html('<i class="fa fa-paper-plane me-1"></i> ' + str2);
                        });
                    }, 3000);
                });
            },
            fail: function(error) {
                Str.get_string('sendobservationsemail', 'local_jobboard').then(function(str) {
                    btn.prop('disabled', false).html('<i class="fa fa-paper-plane me-1"></i> ' + str);
                });
                Notification.exception(error);
            }
        }]);
    };

    // Auto-save observations on blur (debounced for Moodle editors)
    var saveTimeout = null;
    $(document).on('blur', '.jb-doc-observation, .editor_atto_content', function(e) {
        var $target = $(e.target);
        var $textarea = $target.hasClass('jb-doc-observation') ? $target : $target.closest('.jb-observation-editor-wrapper').find('.jb-doc-observation');

        if (!$textarea.length) return;

        var docId = $textarea.data('document-id');
        var elementId = $textarea.attr('id');

        // Debounce the save
        clearTimeout(saveTimeout);
        saveTimeout = setTimeout(function() {
            var text = getEditorContent(elementId);

            Ajax.call([{
                methodname: 'local_jobboard_save_document_observations',
                args: {
                    applicationid: {{selectedapplication.id}},
                    observations: JSON.stringify([{documentid: docId, observation: text}])
                },
                done: function() {
                    $textarea.addClass('border-success');
                    setTimeout(function() {
                        $textarea.removeClass('border-success');
                    }, 1000);
                },
                fail: function() {
                    // Silent fail for auto-save
                }
            }]);
        }, 500);
    });
});
{{/js}}
{{/selectedapplication}}
