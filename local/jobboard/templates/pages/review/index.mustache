{{!
    @template local_jobboard/pages/review/index

    Document review page - Redesigned following apply.mustache pattern.
    Supports both queue mode (list of applications) and single application review mode.

    Context variables:
    * pagetitle - Page title
    * dashboardurl - Dashboard URL
    * myreviewsurl - My reviews URL
    * backurl - Back URL
    * stats - Statistics cards array
    * filterform - Filter form data
    * hasapplications - Boolean for queue mode
    * applications - Applications array for queue mode
    * selectedapplication - Selected application for single review mode
    * documents - Documents to review
    * initialpreview - First document data for initial preview
    * hasinitialpreview - Boolean if initial preview available
    * pagination - Pagination HTML

    Example context (json):
    {
        "pagetitle": "Review Documents",
        "hasapplications": true
    }
}}
<div class="jb-review-page" id="jobboard-review-page">
    <div class="container-fluid px-0">
        {{! ========== SINGLE APPLICATION REVIEW MODE ========== }}
        {{#selectedapplication}}
        <div class="row g-4">
            {{! Main Content - Document Preview }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{backurl}}">{{#str}}reviewdocuments, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{selectedapplication.applicantname}}</li>
                        </ol>
                    </nav>
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h1 class="h3 mb-1">{{#str}}reviewapplication, local_jobboard{{/str}}</h1>
                            <p class="text-muted mb-0">
                                <code class="badge bg-light text-dark me-2">{{selectedapplication.vacancycode}}</code>
                                {{selectedapplication.vacancytitle}}
                            </p>
                        </div>
                        {{#shownav}}
                        <div class="btn-group btn-group-sm">
                            {{#prevurl}}
                            <a href="{{prevurl}}" class="btn btn-outline-secondary"><i class="fa fa-chevron-left"></i></a>
                            {{/prevurl}}
                            {{^prevurl}}
                            <button class="btn btn-outline-secondary" disabled><i class="fa fa-chevron-left"></i></button>
                            {{/prevurl}}
                            <span class="btn btn-outline-secondary disabled">{{navposition}}/{{navtotal}}</span>
                            {{#nexturl}}
                            <a href="{{nexturl}}" class="btn btn-outline-secondary"><i class="fa fa-chevron-right"></i></a>
                            {{/nexturl}}
                            {{^nexturl}}
                            <button class="btn btn-outline-secondary" disabled><i class="fa fa-chevron-right"></i></button>
                            {{/nexturl}}
                        </div>
                        {{/shownav}}
                    </div>
                </div>

                {{! Sequential Review Progress }}
                {{#haspending}}
                <div class="alert alert-info jb-alert-info d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-list-check fa-lg me-3"></i>
                    <div class="flex-grow-1">
                        <strong>{{#str}}sequentialreview, local_jobboard{{/str}}</strong>
                        <span class="d-block small">{{#str}}reviewingdocument, local_jobboard{{/str}} {{currentdocposition}} {{#str}}of, local_jobboard{{/str}} {{totaldocs}}</span>
                    </div>
                    <span class="badge bg-primary">{{currentdocposition}} / {{totaldocs}}</span>
                </div>
                {{/haspending}}

                {{! All Reviewed Success }}
                {{#allreviewed}}
                <div class="alert alert-success jb-alert-success d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-check-circle fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}alldocsreviewed, local_jobboard{{/str}}</strong>
                        <span class="d-block small">{{#str}}readytosubmit, local_jobboard{{/str}}</span>
                    </div>
                </div>
                {{/allreviewed}}

                {{! Document Preview Card }}
                <div class="card shadow-sm">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fa fa-file-lines text-primary me-2"></i>
                            <span data-region="preview-title">
                                {{#hasinitialpreview}}{{initialpreview.filename}}{{/hasinitialpreview}}
                                {{^hasinitialpreview}}{{#str}}selectdocument, local_jobboard{{/str}}{{/hasinitialpreview}}
                            </span>
                            {{#hasinitialpreview}}
                            <small class="d-block text-muted" data-region="preview-subtitle">{{initialpreview.typename}}</small>
                            {{/hasinitialpreview}}
                        </h5>
                        <div class="btn-group btn-group-sm">
                            {{#hasinitialpreview}}
                            <a href="{{initialpreview.downloadurl}}" class="btn btn-outline-secondary" target="_blank" data-region="download-btn">
                                <i class="fa fa-download me-1"></i>{{#str}}download{{/str}}
                            </a>
                            <button type="button" class="btn btn-outline-secondary" onclick="document.querySelector('[data-region=preview-frame]').classList.toggle('jb-preview-fullscreen')" title="{{#str}}fullscreen, local_jobboard{{/str}}">
                                <i class="fa fa-expand"></i>
                            </button>
                            {{/hasinitialpreview}}
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="jb-preview-content bg-light position-relative" data-region="preview-frame" style="min-height: 500px;">
                            {{#hasinitialpreview}}
                            {{#initialpreview.ispdf}}
                            <iframe src="{{initialpreview.previewurl}}" class="w-100 h-100 border-0" style="min-height: 500px;"></iframe>
                            {{/initialpreview.ispdf}}
                            {{#initialpreview.isimage}}
                            <div class="d-flex align-items-center justify-content-center h-100 p-4" style="min-height: 500px;">
                                <img src="{{initialpreview.previewurl}}" alt="{{initialpreview.filename}}" class="img-fluid shadow rounded" style="max-height: 480px;">
                            </div>
                            {{/initialpreview.isimage}}
                            {{#initialpreview.istext}}
                            <div class="p-4" style="min-height: 500px; overflow-y: auto;">
                                <div class="card">
                                    <div class="card-header bg-info text-white">
                                        <i class="fa fa-file-alt me-2"></i>{{initialpreview.typename}}
                                    </div>
                                    <div class="card-body">
                                        <div class="text-content" style="white-space: pre-wrap;">{{{initialpreview.textcontent}}}</div>
                                    </div>
                                </div>
                            </div>
                            {{/initialpreview.istext}}
                            {{^initialpreview.canpreview}}{{^initialpreview.istext}}
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;">
                                <i class="fa fa-file fa-4x mb-3"></i>
                                <p class="mb-3">{{#str}}previewnotavailable, local_jobboard{{/str}}</p>
                                <a href="{{initialpreview.downloadurl}}" class="btn btn-primary jb-btn-primary btn-sm" target="_blank">
                                    <i class="fa fa-download me-2"></i>{{#str}}download{{/str}}
                                </a>
                            </div>
                            {{/initialpreview.istext}}{{/initialpreview.canpreview}}
                            {{/hasinitialpreview}}
                            {{^hasinitialpreview}}
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;">
                                <i class="fa fa-file-circle-question fa-4x mb-3"></i>
                                <p>{{#str}}selectdocumenttopreview, local_jobboard{{/str}}</p>
                            </div>
                            {{/hasinitialpreview}}
                        </div>
                    </div>
                </div>
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Applicant Info Card }}
                    <div class="card shadow-sm mb-4 border-primary">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-user text-primary me-2"></i>
                                {{#str}}applicantinfo, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <h6 class="mb-2">
                                <a href="{{selectedapplication.profileurl}}" class="text-decoration-none" target="_blank" title="{{#str}}viewprofile, local_jobboard{{/str}}">
                                    {{selectedapplication.applicantname}}
                                    <i class="fa fa-external-link-alt fa-xs ms-1 text-muted"></i>
                                </a>
                            </h6>
                            <p class="small text-muted mb-1">
                                <i class="fa fa-envelope me-2"></i>
                                <a href="mailto:{{selectedapplication.email}}">{{selectedapplication.email}}</a>
                            </p>
                            <p class="small text-muted mb-2">
                                <i class="fa fa-briefcase me-2"></i>{{selectedapplication.vacancytitle}}
                            </p>
                            <span class="badge bg-{{selectedapplication.statuscolor}}">{{selectedapplication.statuslabel}}</span>
                        </div>
                    </div>

                    {{! Documents List Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="fa fa-folder-open text-info me-2"></i>
                                {{#str}}documents, local_jobboard{{/str}}
                            </h6>
                            {{#canvalidateall}}
                            <a href="{{validateallurl}}" class="btn btn-success jb-btn-success btn-sm">
                                <i class="fa fa-check-double me-1"></i>{{#str}}validateall, local_jobboard{{/str}}
                            </a>
                            {{/canvalidateall}}
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush jb-documents-list" data-region="documents-list" style="max-height: 350px; overflow-y: auto;">
                                {{#documents}}
                                <div class="list-group-item jb-doc-item py-2 {{#iscurrent}}active bg-primary-subtle{{/iscurrent}} {{#islocked}}disabled opacity-50{{/islocked}}"
                                     data-document-id="{{id}}"
                                     data-preview-url="{{previewurl}}"
                                     data-mimetype="{{mimetype}}"
                                     data-is-pdf="{{ispdf}}"
                                     data-is-image="{{isimage}}"
                                     data-is-text="{{istext}}"
                                     data-can-preview="{{canpreview}}"
                                     data-typename="{{typename}}"
                                     data-filename="{{filename}}"
                                     data-download-url="{{downloadurl}}"
                                     {{#istext}}data-text-content="{{textcontent}}"{{/istext}}
                                     {{^islocked}}onclick="jobboardPreviewDocument(this)" style="cursor: pointer;"{{/islocked}}
                                     {{#islocked}}style="cursor: not-allowed;"{{/islocked}}>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center flex-grow-1 min-width-0 me-2">
                                            <span class="badge rounded-pill bg-{{statuscolor}} me-2 flex-shrink-0">{{docindex}}</span>
                                            <i class="fa fa-{{statusicon}} text-{{statuscolor}} me-2 flex-shrink-0"></i>
                                            <div class="min-width-0">
                                                <div class="fw-medium text-truncate small">{{typename}}</div>
                                                <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">{{filename}}</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-{{statuscolor}} small flex-shrink-0">{{statuslabel}}</span>
                                    </div>

                                    {{#rejectreason}}
                                    <div class="small text-danger mt-1"><i class="fa fa-circle-exclamation me-1"></i>{{rejectreason}}</div>
                                    {{/rejectreason}}

                                    {{#iscurrent}}
                                    <div class="mt-2 pt-2 border-top jb-doc-actions" data-document-id="{{id}}" data-application-id="{{applicationid}}">
                                        <label for="doc_observation_{{id}}" class="form-label small fw-bold mb-1">
                                            {{#str}}documentobservation, local_jobboard{{/str}}
                                            <span class="text-danger" title="{{#str}}required_for_rejection, local_jobboard{{/str}}">*</span>
                                        </label>
                                        <textarea name="doc_observation_{{id}}" id="doc_observation_{{id}}"
                                                  class="form-control form-control-sm jb-doc-observation mb-2"
                                                  rows="2" data-document-id="{{id}}" data-application-id="{{applicationid}}"
                                                  placeholder="{{#str}}documentobservation_placeholder, local_jobboard{{/str}}">{{{observation}}}</textarea>
                                        <div class="d-flex gap-2">
                                            {{! Approve: Pure AJAX button }}
                                            <button type="button" class="btn btn-success jb-btn-success btn-sm flex-grow-1 jb-approve-btn"
                                               data-document-id="{{id}}"
                                               data-application-id="{{applicationid}}"
                                               title="{{#str}}approve, local_jobboard{{/str}}">
                                                <i class="fa fa-check me-1"></i>{{#str}}approve, local_jobboard{{/str}}
                                            </button>
                                            {{! Reject: Pure AJAX button }}
                                            <button type="button" class="btn btn-danger jb-btn-danger btn-sm flex-grow-1 jb-reject-btn"
                                                    data-document-id="{{id}}"
                                                    data-application-id="{{applicationid}}"
                                                    title="{{#str}}reject, local_jobboard{{/str}}">
                                                <i class="fa fa-xmark me-1"></i>{{#str}}reject, local_jobboard{{/str}}
                                            </button>
                                        </div>
                                        <small class="text-muted d-block mt-1">
                                            <i class="fa fa-info-circle me-1"></i>{{#str}}observation_required_for_rejection, local_jobboard{{/str}}
                                        </small>
                                    </div>
                                    {{/iscurrent}}

                                    {{#isreviewed}}{{#observation}}
                                    <div class="mt-1 small text-muted"><i class="fa fa-comment me-1"></i>{{{observation}}}</div>
                                    {{/observation}}{{/isreviewed}}
                                </div>
                                {{/documents}}
                            </div>
                        </div>
                        <div class="card-footer bg-light py-2 d-flex justify-content-between align-items-center">
                            <a href="{{downloadzipurl}}" class="btn btn-sm btn-outline-secondary" title="{{#str}}downloadallzip, local_jobboard{{/str}}">
                                <i class="fa fa-file-zipper me-1"></i>{{#str}}downloadzip, local_jobboard{{/str}}
                            </a>
                            <button type="button" class="btn btn-sm btn-primary jb-btn-primary" id="saveAndSendBtn">
                                <i class="fa fa-paper-plane me-1"></i>{{#str}}saveandsend, local_jobboard{{/str}}
                            </button>
                        </div>
                    </div>

                    {{! Review Progress Card }}
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-chart-pie text-success me-2"></i>
                                {{#str}}reviewprogress, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-around text-center mb-3">
                                <div>
                                    <div class="h5 mb-0 text-success">{{approvedcount}}</div>
                                    <small class="text-muted">{{#str}}docstatus:approved, local_jobboard{{/str}}</small>
                                </div>
                                <div>
                                    <div class="h5 mb-0 text-danger">{{rejectedcount}}</div>
                                    <small class="text-muted">{{#str}}docstatus:rejected, local_jobboard{{/str}}</small>
                                </div>
                                <div>
                                    <div class="h5 mb-0 text-warning">{{pendingcount}}</div>
                                    <small class="text-muted">{{#str}}docstatus:pending, local_jobboard{{/str}}</small>
                                </div>
                            </div>
                            <div class="progress mb-3" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: {{approvedpercent}}%;"></div>
                                <div class="progress-bar bg-danger" style="width: {{rejectedpercent}}%;"></div>
                            </div>

                            {{#allreviewed}}
                            <form method="post" action="{{submitreviewurl}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="markreviewed">
                                <input type="hidden" name="applicationid" value="{{selectedapplication.id}}">
                                <input type="hidden" name="view" value="review">
                                <div class="mb-2">
                                    <textarea name="observations" id="observations" class="form-control form-control-sm" rows="2" placeholder="{{#str}}reviewobservations_placeholder, local_jobboard{{/str}}"></textarea>
                                </div>
                                <button type="submit" class="btn btn-{{completebtncolor}} btn-sm w-100">
                                    <i class="fa fa-clipboard-check me-2"></i>{{#str}}submitreview, local_jobboard{{/str}}
                                </button>
                            </form>
                            {{/allreviewed}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top">
                    <a href="{{backurl}}" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{#str}}back{{/str}}
                    </a>
                    <a href="{{myreviewsurl}}" class="btn btn-link text-muted">
                        {{#str}}myreviews, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        {{! Rejection is now handled inline via observation field }}
        {{/selectedapplication}}

        {{! ========== APPLICATIONS QUEUE MODE ========== }}
        {{^selectedapplication}}
        {{! Page Header with Breadcrumb }}
        <div class="jb-page-header mb-4">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">{{#str}}reviewdocuments, local_jobboard{{/str}}</li>
                </ol>
            </nav>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h1 class="h3 mb-1">{{#str}}reviewdocuments, local_jobboard{{/str}}</h1>
                    <p class="text-muted mb-0">{{#str}}reviewqueue_desc, local_jobboard{{/str}}</p>
                </div>
                {{! Quick Actions - Desktop }}
                <div class="btn-group d-none d-md-flex" role="group" aria-label="{{#str}}quickactions, local_jobboard{{/str}}">
                    <a href="{{myreviewsurl}}" class="btn btn-outline-primary jb-btn-outline-primary btn-sm">
                        <i class="fa fa-clipboard-list me-1"></i>
                        {{#str}}myreviews, local_jobboard{{/str}}
                    </a>
                    <a href="{{dashboardurl}}" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-home me-1"></i>
                        {{#str}}dashboard, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
        </div>

        {{! Stats Bar - Compact Horizontal }}
        {{#stats.0}}
        <div class="card shadow-sm mb-4 border-0 bg-light">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap align-items-center justify-content-start gap-3 gap-md-4">
                    <span class="text-muted small fw-medium">
                        <i class="fa fa-chart-pie me-1"></i>
                        {{#str}}statistics, local_jobboard{{/str}}:
                    </span>
                    {{#stats}}
                    <div class="d-flex align-items-center gap-2 jb-stat-item">
                        <span class="badge bg-{{color}} rounded-pill px-3 py-2">
                            <span class="h6 mb-0 me-1">{{value}}</span>
                        </span>
                        <small class="text-muted">{{label}}</small>
                    </div>
                    {{/stats}}
                </div>
            </div>
        </div>
        {{/stats.0}}

        {{! Filter Bar - Horizontal Full Width }}
        {{#filterform}}
        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">
                <form method="get" action="{{action}}" role="search" aria-label="{{#str}}filter, local_jobboard{{/str}}" class="jb-filter-form">
                    {{#hiddenfields}}
                    <input type="hidden" name="{{name}}" value="{{value}}">
                    {{/hiddenfields}}
                    <div class="row align-items-end g-3">
                        {{#fields}}
                        <div class="col-12 col-md-8 col-lg-6">
                            <label for="filter-{{name}}" class="form-label small fw-medium mb-1">
                                <i class="fa fa-filter text-warning me-1"></i>
                                {{#str}}filterbyvacancy, local_jobboard{{/str}}
                            </label>
                            <select name="{{name}}" id="filter-{{name}}"
                                    class="form-select jb-vacancy-filter"
                                    aria-describedby="filter-{{name}}-help"
                                    onchange="this.form.submit()">
                                {{#options}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}} title="{{label}}">{{label}}</option>
                                {{/options}}
                            </select>
                            <div id="filter-{{name}}-help" class="form-text small mt-1 d-none d-md-block">
                                {{#str}}selectvacancytofilter, local_jobboard{{/str}}
                            </div>
                        </div>
                        {{/fields}}
                        <div class="col-12 col-md-4 col-lg-auto">
                            <button type="submit" class="btn btn-primary jb-btn-primary w-100 w-md-auto">
                                <i class="fa fa-search me-1"></i>
                                <span class="d-none d-sm-inline">{{#str}}applyfilters, local_jobboard{{/str}}</span>
                                <span class="d-sm-none">{{#str}}filter, local_jobboard{{/str}}</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        {{/filterform}}

        {{! Applications Table - Full Width }}
        {{#hasapplications}}
        <div class="card shadow-sm mb-4 jb-table-card">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0">
                    <i class="fa fa-list text-primary me-2"></i>
                    {{#str}}pendingreviews, local_jobboard{{/str}}
                </h5>
                <span class="badge bg-primary rounded-pill fs-6">{{applicationcount}} {{#str}}total{{/str}}</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 jb-table" role="grid" aria-label="{{#str}}pendingreviews, local_jobboard{{/str}}">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3" style="min-width: 200px;">{{#str}}applicant, local_jobboard{{/str}}</th>
                                <th scope="col" style="min-width: 250px;">{{#str}}vacancy, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center" style="width: 120px;">{{#str}}documents, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center" style="width: 110px;">{{#str}}date, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-end pe-3" style="width: 140px;">{{#str}}actions, local_jobboard{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#applications}}
                            <tr class="{{#isurgent}}table-danger{{/isurgent}}" {{#isurgent}}aria-label="{{#str}}urgent, local_jobboard{{/str}}"{{/isurgent}}>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 40px; height: 40px;">
                                            <i class="fa fa-user"></i>
                                        </div>
                                        <div class="min-width-0">
                                            <div class="fw-semibold text-truncate">
                                                <a href="{{profileurl}}" class="text-decoration-none text-dark" target="_blank" title="{{#str}}viewprofile, local_jobboard{{/str}}">
                                                    {{applicantname}}
                                                </a>
                                                {{#isurgent}}
                                                <span class="badge bg-danger ms-1" title="{{#str}}urgent, local_jobboard{{/str}}">
                                                    <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                                                    <span class="visually-hidden">{{#str}}urgent, local_jobboard{{/str}}</span>
                                                </span>
                                                {{/isurgent}}
                                            </div>
                                            <a href="mailto:{{email}}" class="small text-muted text-decoration-none text-truncate d-block" style="max-width: 180px;">{{email}}</a>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column min-width-0">
                                        <code class="badge bg-light text-dark border mb-1 align-self-start" style="font-size: 0.7rem;">{{vacancycode}}</code>
                                        <span class="small text-muted jb-text-truncate-2" title="{{vacancytitle}}">{{vacancytitle}}</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <span class="badge bg-secondary rounded-pill" title="{{#str}}totaldocuments, local_jobboard{{/str}}">
                                            <i class="fa fa-file me-1" aria-hidden="true"></i>{{doccount}}
                                        </span>
                                        {{#pendingcount}}
                                        <span class="badge bg-warning text-dark rounded-pill" title="{{#str}}pendingdocuments, local_jobboard{{/str}}">
                                            <i class="fa fa-clock me-1" aria-hidden="true"></i>{{pendingcount}}
                                        </span>
                                        {{/pendingcount}}
                                        {{^pendingcount}}
                                        <span class="badge bg-success rounded-pill" title="{{#str}}allreviewed, local_jobboard{{/str}}">
                                            <i class="fa fa-check" aria-hidden="true"></i>
                                        </span>
                                        {{/pendingcount}}
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="small text-muted" title="{{#str}}datesubmitted, local_jobboard{{/str}}">
                                        <i class="fa fa-calendar me-1 text-muted d-none d-lg-inline" aria-hidden="true"></i>{{datesubmitted}}
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group" role="group" aria-label="{{#str}}actions, local_jobboard{{/str}}">
                                        <a href="{{reviewurl}}" class="btn btn-primary btn-sm jb-btn-primary"
                                           title="{{#str}}review, local_jobboard{{/str}}"
                                           aria-label="{{#str}}review, local_jobboard{{/str}} - {{applicantname}}">
                                            <i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>
                                            <span class="d-none d-lg-inline">{{#str}}review, local_jobboard{{/str}}</span>
                                        </a>
                                        <a href="{{downloadzipurl}}" class="btn btn-outline-info btn-sm"
                                           title="{{#str}}downloadallzip, local_jobboard{{/str}}"
                                           aria-label="{{#str}}downloadallzip, local_jobboard{{/str}} - {{applicantname}}">
                                            <i class="fa fa-file-zipper" aria-hidden="true"></i>
                                        </a>
                                        <a href="{{viewurl}}" class="btn btn-outline-secondary btn-sm"
                                           title="{{#str}}viewapplication, local_jobboard{{/str}}"
                                           aria-label="{{#str}}viewapplication, local_jobboard{{/str}} - {{applicantname}}">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{/applications}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {{! Pagination }}
        {{#pagination}}
        <nav class="mt-4" aria-label="{{#str}}pagination, local_jobboard{{/str}}">{{{pagination}}}</nav>
        {{/pagination}}
        {{/hasapplications}}

        {{! Empty State }}
        {{^hasapplications}}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="jb-empty-state">
                    <i class="fa fa-circle-check jb-empty-state-icon text-success"></i>
                    <h5 class="jb-empty-state-title">{{#str}}nodocumentstoreview, local_jobboard{{/str}}</h5>
                    <p class="text-muted mb-4">{{#str}}allcaughtup, local_jobboard{{/str}}</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="{{myreviewsurl}}" class="btn btn-outline-primary jb-btn-outline-primary btn-sm">
                            <i class="fa fa-clipboard-list me-1"></i>
                            {{#str}}myreviews, local_jobboard{{/str}}
                        </a>
                        <a href="{{dashboardurl}}" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-home me-1"></i>
                            {{#str}}dashboard, local_jobboard{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/hasapplications}}

        {{! Quick Actions - Mobile Only }}
        <div class="card shadow-sm mt-4 d-md-none">
            <div class="card-body py-3">
                <div class="d-flex gap-2">
                    <a href="{{myreviewsurl}}" class="btn btn-outline-primary jb-btn-outline-primary btn-sm flex-fill">
                        <i class="fa fa-clipboard-list me-1"></i>
                        {{#str}}myreviews, local_jobboard{{/str}}
                    </a>
                    <a href="{{dashboardurl}}" class="btn btn-outline-secondary btn-sm flex-fill">
                        <i class="fa fa-home me-1"></i>
                        {{#str}}dashboard, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="d-flex justify-content-between align-items-center py-3 mt-4 border-top">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left me-1"></i>
                <span class="d-none d-sm-inline">{{#str}}dashboard, local_jobboard{{/str}}</span>
            </a>
            <a href="{{myreviewsurl}}" class="btn btn-link text-muted btn-sm">
                {{#str}}myreviews, local_jobboard{{/str}}
                <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>
        {{/selectedapplication}}
    </div>
</div>

