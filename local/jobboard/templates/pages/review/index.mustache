{{!
    @template local_jobboard/pages/review

    Document review page template with enhanced UX.
    Uses jb-* CSS classes for consistent styling.
    Supports both queue view and single application review modes.

    Context variables:
    * breadcrumbs - Array of breadcrumb items
    * stats - Review queue stats
    * filterform - Filter form data
    * hasapplications - Boolean
    * applications - Array of applications pending review
    * selectedapplication - Selected application for review (if any)
    * documents - Documents to review
    * pagination - Pagination HTML
    * loading - Show skeleton loading state

    Example context (json):
    {
        "hasapplications": true,
        "applications": [{"id": 1, "applicantname": "John Doe"}]
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-review" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-page-header mb-4">
        <div class="jb-skeleton-text" style="width: 200px; height: 1em;"></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="jb-skeleton-title" style="width: 40%;"></div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-text" style="width: 80%;"></div>
                    <div class="jb-skeleton-text" style="width: 100%;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-text" style="width: 80%;"></div>
                    <div class="jb-skeleton-text" style="width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-review" data-region="jobboard-review">
    {{! Skip Link for Accessibility }}
    <a href="#review-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header mb-4 jb-fade-in">
        <nav aria-label="{{#str}}breadcrumb, local_jobboard{{/str}}" class="mb-3">
            <ol class="breadcrumb">
                {{#breadcrumbs}}
                <li class="breadcrumb-item {{#active}}jb-active{{/active}}">
                    {{#url}}<a href="{{url}}">{{label}}</a>{{/url}}
                    {{^url}}<span aria-current="page">{{label}}</span>{{/url}}
                </li>
                {{/breadcrumbs}}
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="fs-4 mb-0">
                <i class="fa fa-clipboard-check text-primary me-2" aria-hidden="true"></i>
                {{pagetitle}}
            </h1>
            {{#headeractions}}
            <div class="btn-group" role="group">
                {{#headeractions}}
                <a href="{{url}}" class="btn jb-btn-{{class}}">
                    <i class="fa fa-{{icon}} me-1" aria-hidden="true"></i>
                    {{label}}
                </a>
                {{/headeractions}}
            </div>
            {{/headeractions}}
        </div>
    </header>

    {{! Statistics Row }}
    {{#stats.0}}
    <section class="row mb-4" role="region" aria-label="{{#str}}reviewstatistics, local_jobboard{{/str}}">
        {{#stats}}
        <div class="col-lg-3 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
            {{> local_jobboard/components/stat_card }}
        </div>
        {{/stats}}
    </section>
    {{/stats.0}}

    <div id="review-main-content">
        {{! ========== SINGLE APPLICATION REVIEW MODE ========== }}
        {{#selectedapplication}}

        {{! Previous/Next Navigation }}
        {{#shownav}}
        <nav class="jb-review-navigation d-flex justify-content-between align-items-center p-3 bg-light rounded mb-4 jb-fade-in-up" aria-label="{{#str}}reviewnavigation, local_jobboard{{/str}}">
            {{#prevurl}}
            <a href="{{prevurl}}" class="btn btn-outline-primary">
                <i class="fa fa-chevron-left me-2" aria-hidden="true"></i>
                <span class="d-none jb-d-sm-inline">{{#str}}previousapplication, local_jobboard{{/str}}</span>
                <span class="jb-d-sm-none">{{#str}}prev{{/str}}</span>
            </a>
            {{/prevurl}}
            {{^prevurl}}
            <span class="btn btn-outline-secondary disabled" aria-disabled="true">
                <i class="fa fa-chevron-left me-2" aria-hidden="true"></i>
                <span class="d-none jb-d-sm-inline">{{#str}}previousapplication, local_jobboard{{/str}}</span>
            </span>
            {{/prevurl}}

            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6" aria-label="{{#str}}position, local_jobboard{{/str}}: {{navposition}} {{#str}}of, local_jobboard{{/str}} {{navtotal}}">
                {{navposition}} / {{navtotal}}
            </span>

            {{#nexturl}}
            <a href="{{nexturl}}" class="btn btn-outline-primary">
                <span class="d-none jb-d-sm-inline">{{#str}}nextapplication, local_jobboard{{/str}}</span>
                <span class="jb-d-sm-none">{{#str}}next{{/str}}</span>
                <i class="fa fa-chevron-right ms-2" aria-hidden="true"></i>
            </a>
            {{/nexturl}}
            {{^nexturl}}
            <span class="btn btn-outline-secondary disabled" aria-disabled="true">
                <span class="d-none jb-d-sm-inline">{{#str}}nextapplication, local_jobboard{{/str}}</span>
                <i class="fa fa-chevron-right ms-2" aria-hidden="true"></i>
            </span>
            {{/nexturl}}
        </nav>
        {{/shownav}}

        <div class="row">
            {{! Documents Column }}
            <main class="col-lg-8">
                {{! Documents Card }}
                <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="documents-review-heading">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                            <h2 class="fs-5 mb-0" id="documents-review-heading">
                                {{#str}}documentlist, local_jobboard{{/str}}
                            </h2>
                        </div>
                        {{#canvalidateall}}
                        <a href="{{validateallurl}}" class="btn btn-success btn-sm jb-hover-lift">
                            <i class="fa fa-check-double me-1" aria-hidden="true"></i>
                            {{#str}}validateall, local_jobboard{{/str}}
                        </a>
                        {{/canvalidateall}}
                    </div>

                    {{#hasdocuments}}
                    <ul class="list-group list-group-flush" role="list" aria-label="{{#str}}documentstoreview, local_jobboard{{/str}}">
                        {{#documents}}
                        <li class="list-group-item jb-doc-item jb-doc-{{status}}" data-document-id="{{id}}" role="listitem">
                            <div class="d-flex justify-content-between align-items-start">
                                {{! Document Info }}
                                <div class="d-flex align-items-start flex-grow-1">
                                    <div class="flex-shrink-0 me-3 mt-1">
                                        <i class="fa fa-{{statusicon}} fa-lg jb-text-{{statuscolor}}" aria-hidden="true"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h3 class="fs-6 mb-1 fw-bold">{{typename}}</h3>
                                        <small class="text-muted d-block mb-2">{{filename}}</small>
                                        <div class="d-flex flex-wrap gap-2 align-items-center">
                                            <span class="badge jb-badge-{{statuscolor}}">
                                                {{statuslabel}}
                                            </span>
                                            {{#reviewedby}}
                                            <small class="text-muted">
                                                <i class="fa fa-user-check me-1" aria-hidden="true"></i>
                                                {{reviewedby}} - {{reviewedat}}
                                            </small>
                                            {{/reviewedby}}
                                        </div>
                                        {{#rejectreason}}
                                        <div class="alert alert-danger mt-2 mb-0 py-2 small" role="alert">
                                            <i class="fa fa-circle-exclamation me-1" aria-hidden="true"></i>
                                            {{rejectreason}}
                                        </div>
                                        {{/rejectreason}}
                                    </div>
                                </div>

                                {{! Actions }}
                                <div class="btn-group-vertical ms-3" role="group" aria-label="{{#str}}documentactions, local_jobboard{{/str}}">
                                    {{#downloadurl}}
                                    <a href="{{downloadurl}}" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener noreferrer" title="{{#str}}download{{/str}}">
                                        <i class="fa fa-download" aria-hidden="true"></i>
                                        <span class="visually-hidden">{{#str}}download{{/str}} {{typename}}</span>
                                    </a>
                                    {{/downloadurl}}

                                    {{#ispending}}
                                    <a href="{{validateurl}}" class="btn btn-sm btn-success" title="{{#str}}approve, local_jobboard{{/str}}">
                                        <i class="fa fa-check" aria-hidden="true"></i>
                                        <span class="visually-hidden">{{#str}}approve, local_jobboard{{/str}} {{typename}}</span>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#rejectModal{{id}}" title="{{#str}}reject, local_jobboard{{/str}}">
                                        <i class="fa fa-xmark" aria-hidden="true"></i>
                                        <span class="visually-hidden">{{#str}}reject, local_jobboard{{/str}} {{typename}}</span>
                                    </button>
                                    {{/ispending}}
                                </div>
                            </div>
                        </li>

                        {{! Reject Modal }}
                        {{#ispending}}
                        <div class="modal fade" id="rejectModal{{id}}" tabindex="-1" role="dialog" aria-labelledby="rejectModalLabel{{id}}" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <form method="post" action="{{rejecturl}}">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <div class="modal-header bg-danger text-white">
                                            <h4 class="modal-title fs-5 d-flex align-items-center" id="rejectModalLabel{{id}}">
                                                <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
                                                {{#str}}rejectdocument, local_jobboard{{/str}}
                                            </h4>
                                            <button type="button" class="close text-white" data-dismiss="modal" aria-label="{{#str}}close, local_jobboard{{/str}}">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="text-muted mb-3">
                                                <i class="fa fa-file me-2" aria-hidden="true"></i>
                                                {{typename}}
                                            </p>
                                            <div class="mb-3">
                                                <label for="reason{{id}}" class="form-label fw-bold">
                                                    {{#str}}rejectreason, local_jobboard{{/str}}
                                                    <span class="text-danger" aria-hidden="true">*</span>
                                                </label>
                                                <textarea name="reason" id="reason{{id}}" class="form-control" rows="3" required aria-required="true" placeholder="{{#str}}rejectreason_placeholder, local_jobboard{{/str}}"></textarea>
                                                <small class="form-text text-muted">{{#str}}rejectreason_help, local_jobboard{{/str}}</small>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">
                                                {{#str}}cancel{{/str}}
                                            </button>
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fa fa-xmark me-1" aria-hidden="true"></i>
                                                {{#str}}reject, local_jobboard{{/str}}
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {{/ispending}}
                        {{/documents}}
                    </ul>
                    {{/hasdocuments}}

                    {{^hasdocuments}}
                    <div class="card-body text-center py-5" role="status">
                        <i class="fa fa-file fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <p class="text-muted mb-0">{{#str}}nodocumentstoreview, local_jobboard{{/str}}</p>
                    </div>
                    {{/hasdocuments}}
                </section>
            </main>

            {{! Sidebar }}
            <aside class="col-lg-4">
                <div class="jb-sticky-sidebar">
                    {{! Applicant Info }}
                    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="applicant-heading">
                        <div class="card-header bg-secondary text-white d-flex align-items-center">
                            <i class="fa fa-user me-2" aria-hidden="true"></i>
                            <h2 class="fs-5 mb-0" id="applicant-heading">
                                {{#str}}applicantinfo, local_jobboard{{/str}}
                            </h2>
                        </div>
                        <div class="card-body">
                            <h3 class="fs-5 mb-2">{{selectedapplication.applicantname}}</h3>
                            <p class="mb-2">
                                <i class="fa fa-envelope text-muted me-2" aria-hidden="true"></i>
                                <a href="mailto:{{selectedapplication.email}}" class="jb-text-break">{{selectedapplication.email}}</a>
                            </p>
                            <small class="text-muted">
                                <i class="fa fa-calendar-days me-1" aria-hidden="true"></i>
                                {{#str}}dateapplied, local_jobboard{{/str}}: {{selectedapplication.dateapplied}}
                            </small>
                        </div>
                    </section>

                    {{! Vacancy Info }}
                    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.2s;" aria-labelledby="vacancy-heading">
                        <div class="card-header bg-info text-white d-flex align-items-center">
                            <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                            <h2 class="fs-5 mb-0" id="vacancy-heading">
                                {{#str}}vacancy, local_jobboard{{/str}}
                            </h2>
                        </div>
                        <div class="card-body">
                            <span class="badge bg-secondary mb-2">{{selectedapplication.vacancycode}}</span>
                            <h3 class="fs-5 mb-2">{{selectedapplication.vacancytitle}}</h3>
                            <span class="badge jb-badge-{{selectedapplication.statuscolor}}">{{selectedapplication.statuslabel}}</span>
                        </div>
                    </section>

                    {{! Review Progress }}
                    <section class="card shadow-sm mb-4 border-primary jb-fade-in-up" style="animation-delay: 0.25s;" aria-labelledby="progress-heading">
                        <div class="card-header bg-primary text-white d-flex align-items-center">
                            <i class="fa fa-list-check me-2" aria-hidden="true"></i>
                            <h2 class="fs-5 mb-0" id="progress-heading">
                                {{#str}}reviewprogress, local_jobboard{{/str}}
                            </h2>
                        </div>
                        <div class="card-body">
                            {{! Stacked Progress Bar }}
                            <div class="progress mb-3" style="height: 25px;" role="progressbar" aria-label="{{#str}}reviewprogress, local_jobboard{{/str}}">
                                <div class="progress-bar bg-success" style="width: {{approvedpercent}}%;" title="{{approvedcount}} {{#str}}docstatus:approved, local_jobboard{{/str}}">
                                    {{#approvedcount}}{{approvedcount}}{{/approvedcount}}
                                </div>
                                <div class="progress-bar bg-danger" style="width: {{rejectedpercent}}%;" title="{{rejectedcount}} {{#str}}docstatus:rejected, local_jobboard{{/str}}">
                                    {{#rejectedcount}}{{rejectedcount}}{{/rejectedcount}}
                                </div>
                                <div class="progress-bar bg-warning" style="width: {{pendingpercent}}%;" title="{{pendingcount}} {{#str}}docstatus:pending, local_jobboard{{/str}}">
                                    {{#pendingcount}}{{pendingcount}}{{/pendingcount}}
                                </div>
                            </div>

                            {{! Legend }}
                            <div class="d-flex flex-wrap gap-3 small">
                                <span class="d-flex align-items-center">
                                    <span class="badge bg-success me-1">{{approvedcount}}</span>
                                    {{#str}}docstatus:approved, local_jobboard{{/str}}
                                </span>
                                <span class="d-flex align-items-center">
                                    <span class="badge bg-danger me-1">{{rejectedcount}}</span>
                                    {{#str}}docstatus:rejected, local_jobboard{{/str}}
                                </span>
                                <span class="d-flex align-items-center">
                                    <span class="badge bg-warning text-dark me-1">{{pendingcount}}</span>
                                    {{#str}}docstatus:pending, local_jobboard{{/str}}
                                </span>
                            </div>
                        </div>

                        {{! All Reviewed State }}
                        {{#allreviewed}}
                        <footer class="card-footer bg-success-light text-center">
                            <div class="text-success mb-3" role="status">
                                <i class="fa fa-circle-check fa-2x mb-2" aria-hidden="true"></i>
                                <div class="fw-bold">{{#str}}alldocsreviewed, local_jobboard{{/str}}</div>
                            </div>
                            <form method="post" action="{{submitreviewurl}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="markreviewed">
                                <input type="hidden" name="applicationid" value="{{selectedapplication.id}}">
                                <input type="hidden" name="view" value="review">
                                <div class="mb-3 mb-3">
                                    <label for="observations" class="form-label small fw-bold text-start d-block">
                                        {{#str}}reviewobservations, local_jobboard{{/str}}
                                    </label>
                                    <textarea name="observations" id="observations" class="form-control" rows="2" placeholder="{{#str}}reviewobservations_placeholder, local_jobboard{{/str}}"></textarea>
                                </div>
                                <button type="submit" class="btn jb-btn-{{completebtncolor}} btn-lg w-100 jb-hover-lift">
                                    <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                                    {{#str}}submitreview, local_jobboard{{/str}}
                                </button>
                            </form>
                        </footer>
                        {{/allreviewed}}

                        {{! Pending State }}
                        {{#haspending}}
                        <footer class="card-footer bg-warning-light text-center">
                            <div class="mb-2">
                                <i class="fa fa-clock fa-2x text-warning mb-2" aria-hidden="true"></i>
                                <div class="text-warning fw-bold">{{#str}}needsattention, local_jobboard{{/str}}</div>
                            </div>
                            <p class="text-muted small mb-0">
                                {{#str}}documentsremaining, local_jobboard{{/str}}: <strong>{{pendingcount}}</strong>
                            </p>
                        </footer>
                        {{/haspending}}
                    </section>
                </div>
            </aside>
        </div>

        {{! Navigation Footer for Single Review }}
        <nav class="jb-navigation-footer d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
            <a href="{{backurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtoreviewlist, local_jobboard{{/str}}
            </a>
            <a href="{{dashboardurl}}" class="btn btn-link text-muted">
                {{#str}}backtodashboard, local_jobboard{{/str}}
                <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
            </a>
        </nav>
        {{/selectedapplication}}

        {{! ========== APPLICATIONS QUEUE MODE ========== }}
        {{^selectedapplication}}

        {{! Filter Form }}
        {{#filterform}}
        <form method="get" action="{{action}}" class="card mb-4 jb-fade-in-up" role="search" aria-label="{{#str}}filterapplications, local_jobboard{{/str}}">
            <div class="card-body">
                {{#hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="row align-items-end">
                    {{#fields}}
                    <div class="col-md-4 mb-2">
                        <label for="filter-{{name}}" class="form-label small text-muted">{{label}}</label>
                        <select name="{{name}}" id="filter-{{name}}" class="form-select">
                            {{#options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                    </div>
                    {{/fields}}
                    <div class="col-md-4 mb-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa fa-filter me-1" aria-hidden="true"></i>
                            {{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </form>
        {{/filterform}}

        {{! Applications Queue List }}
        {{#hasapplications}}
        <section class="row" aria-label="{{#str}}applicationsqueue, local_jobboard{{/str}}">
            {{#applications}}
            <div class="col-lg-6 mb-4">
                <article class="card h-100 shadow-sm jb-hover-lift jb-fade-in-up {{#isurgent}}jb-border-danger{{/isurgent}}"
                         aria-labelledby="queue-app-{{id}}"
                         style="animation-delay: {{animdelay}}s;">
                    <div class="card-header d-flex justify-content-between align-items-center
                         {{#haspendingdocs}}bg-warning text-dark{{/haspendingdocs}}{{^haspendingdocs}}bg-success text-white{{/haspendingdocs}}">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark">{{vacancycode}}</span>
                            <span class="small fw-medium">{{statuslabel}}</span>
                        </div>
                        {{#isurgent}}
                        <span class="badge bg-danger" role="status">
                            <i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>
                            {{#str}}urgent, local_jobboard{{/str}}
                        </span>
                        {{/isurgent}}
                    </div>
                    <div class="card-body">
                        <h2 class="card-title fs-5 mb-2" id="queue-app-{{id}}">
                            <i class="fa fa-user text-muted me-2" aria-hidden="true"></i>
                            {{applicantname}}
                        </h2>
                        <p class="small mb-2">
                            <i class="fa fa-envelope text-muted me-2" aria-hidden="true"></i>
                            <a href="mailto:{{email}}" class="text-muted">{{email}}</a>
                        </p>
                        <div class="small text-muted mb-3">
                            <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                            {{vacancytitle}}
                        </div>

                        {{! Document Stats }}
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                            <span class="small text-muted">
                                <i class="fa fa-file-lines me-1" aria-hidden="true"></i>
                                {{#str}}documents, local_jobboard{{/str}}:
                            </span>
                            <span class="badge bg-secondary">{{doccount}}</span>
                            {{#pendingcount}}
                            <span class="badge bg-warning text-dark">
                                {{pendingcount}} {{#str}}pending, local_jobboard{{/str}}
                            </span>
                            {{/pendingcount}}
                            {{^pendingcount}}
                            <span class="badge bg-success">
                                <i class="fa fa-check me-1" aria-hidden="true"></i>
                                {{#str}}allvalidated, local_jobboard{{/str}}
                            </span>
                            {{/pendingcount}}
                        </div>

                        <div class="small text-muted">
                            <i class="fa fa-calendar-days me-2" aria-hidden="true"></i>
                            {{#str}}datesubmitted, local_jobboard{{/str}}: {{datesubmitted}}
                        </div>
                    </div>
                    <footer class="card-footer bg-white">
                        <div class="d-flex justify-content-between gap-2">
                            <a href="{{reviewurl}}" class="btn btn-primary btn-sm flex-grow-1">
                                <i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>
                                {{#str}}reviewdocuments, local_jobboard{{/str}}
                            </a>
                            <a href="{{viewurl}}" class="btn btn-outline-secondary btn-sm" title="{{#str}}viewapplication, local_jobboard{{/str}}">
                                <i class="fa fa-eye" aria-hidden="true"></i>
                                <span class="visually-hidden">{{#str}}viewapplication, local_jobboard{{/str}}</span>
                            </a>
                        </div>
                    </footer>
                </article>
            </div>
            {{/applications}}
        </section>
        {{/hasapplications}}

        {{! Empty State }}
        {{^hasapplications}}
        <div class="jb-empty-state text-center py-5 jb-fade-in-up" role="status" aria-live="polite">
            <div class="jb-empty-icon-wrapper d-inline-flex align-items-center justify-content-center rounded-circle bg-success-light mb-4" style="width: 100px; height: 100px;">
                <i class="fa fa-circle-check fa-3x text-success" aria-hidden="true"></i>
            </div>
            <h2 class="fs-4 text-muted mb-2">{{#str}}nodocumentstoreview, local_jobboard{{/str}}</h2>
            <p class="text-muted">{{#str}}allcaughtup, local_jobboard{{/str}}</p>
        </div>
        {{/hasapplications}}

        {{! Pagination }}
        {{#pagination}}
        <nav class="mt-4 jb-fade-in" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
            {{{pagination}}}
        </nav>
        {{/pagination}}

        {{! Navigation Footer for Queue }}
        <nav class="jb-navigation-footer d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtodashboard, local_jobboard{{/str}}
            </a>
            {{#myreviewsurl}}
            <a href="{{myreviewsurl}}" class="btn btn-link text-muted">
                {{#str}}myreviews, local_jobboard{{/str}}
                <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
            </a>
            {{/myreviewsurl}}
        </nav>
        {{/selectedapplication}}
    </div>
</div>
{{/loading}}
