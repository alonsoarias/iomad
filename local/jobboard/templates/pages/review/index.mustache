{{! JavaScript for document observations with Moodle editor }}
{{#selectedapplication}}
{{#js}}
require(['jquery', 'core/ajax', 'core/notification', 'core/str', 'editor_tiny/editor'], function($, Ajax, Notification, Str, TinyEditor) {
    // Editors are initialized via PHP's use_editor() method.
    // This JS helper function retrieves content from TinyMCE editors.

    // Helper function to get editor content from TinyMCE
    function getEditorContent(elementId) {
        // Try to get TinyMCE instance for this element
        var editor = TinyEditor.getInstanceForElementId(elementId);
        if (editor) {
            return editor.getContent();
        }

        // Fallback to textarea value
        var textarea = document.getElementById(elementId);
        return textarea ? textarea.value : '';
    }

    // Save observations via AJAX and reload page to continue workflow
    window.jobboardSaveObservations = function() {
        var observations = [];
        $('.jb-doc-observation').each(function() {
            var docId = $(this).data('document-id');
            var elementId = $(this).attr('id');
            var text = getEditorContent(elementId);
            if (docId) {
                observations.push({
                    documentid: docId,
                    observation: text
                });
            }
        });

        // If no observations to save, just reload to refresh the view
        if (observations.length === 0) {
            window.location.reload();
            return;
        }

        var btn = $('#saveObservationsBtn');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> {{#str}}saving, local_jobboard{{/str}}');

        Ajax.call([{
            methodname: 'local_jobboard_save_document_observations',
            args: {
                applicationid: {{selectedapplication.id}},
                observations: JSON.stringify(observations)
            },
            done: function(response) {
                btn.prop('disabled', false).html('<i class="fa fa-check me-1"></i> {{#str}}changessaved{{/str}}');
                // Reload page after brief delay to show success message and refresh view
                setTimeout(function() {
                    window.location.reload();
                }, 800);
            },
            fail: function(error) {
                btn.prop('disabled', false).html('<i class="fa fa-save me-1"></i> {{#str}}savechanges{{/str}}');
                Notification.exception(error);
            }
        }]);
    };

    // Send observations email and reload page
    window.jobboardSendObservationsEmail = function() {
        var observations = [];
        var hasObservations = false;

        $('.jb-doc-observation').each(function() {
            var docId = $(this).data('document-id');
            var elementId = $(this).attr('id');
            var text = getEditorContent(elementId);
            // Strip HTML to check if there's actual content
            var textContent = text.replace(/<[^>]*>/g, '').trim();
            if (docId && textContent) {
                hasObservations = true;
                observations.push({
                    documentid: docId,
                    observation: text
                });
            }
        });

        if (!hasObservations) {
            Str.get_string('noobservationstosend', 'local_jobboard').then(function(str) {
                Notification.alert('', str);
            });
            return;
        }

        var btn = $('#sendObservationsBtn');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> {{#str}}sending, local_jobboard{{/str}}');

        Ajax.call([{
            methodname: 'local_jobboard_send_observations_email',
            args: {
                applicationid: {{selectedapplication.id}},
                observations: JSON.stringify(observations)
            },
            done: function(response) {
                Str.get_string('observationsemailsent', 'local_jobboard').then(function(str) {
                    btn.prop('disabled', false).html('<i class="fa fa-check me-1"></i> ' + str);
                    // Reload page after showing success message
                    setTimeout(function() {
                        window.location.reload();
                    }, 1500);
                });
            },
            fail: function(error) {
                Str.get_string('sendobservationsemail', 'local_jobboard').then(function(str) {
                    btn.prop('disabled', false).html('<i class="fa fa-paper-plane me-1"></i> ' + str);
                });
                Notification.exception(error);
            }
        }]);
    };

    // Auto-save observations when TinyMCE editor loses focus
    // TinyMCE fires a blur event and saves content to textarea automatically
    var saveTimeout = null;

    // Function to setup auto-save for a TinyMCE editor
    function setupAutoSaveForEditor(elementId) {
        var editor = TinyEditor.getInstanceForElementId(elementId);
        if (editor) {
            editor.on('blur', function() {
                var $textarea = $('#' + elementId);
                var docId = $textarea.data('document-id');

                clearTimeout(saveTimeout);
                saveTimeout = setTimeout(function() {
                    var text = getEditorContent(elementId);

                    Ajax.call([{
                        methodname: 'local_jobboard_save_document_observations',
                        args: {
                            applicationid: {{selectedapplication.id}},
                            observations: JSON.stringify([{documentid: docId, observation: text}])
                        },
                        done: function() {
                            // Visual feedback that save was successful
                            var editorContainer = editor.getContainer();
                            if (editorContainer) {
                                $(editorContainer).addClass('border-success');
                                setTimeout(function() {
                                    $(editorContainer).removeClass('border-success');
                                }, 1000);
                            }
                        },
                        fail: function() {
                            // Silent fail for auto-save
                        }
                    }]);
                }, 500);
            });
        }
    }

    // Wait for editors to be initialized, then set up auto-save
    // Check periodically for editor instances
    var setupAttempts = 0;
    var maxAttempts = 20; // 10 seconds max
    var setupInterval = setInterval(function() {
        setupAttempts++;
        var allEditorsReady = true;

        $('.jb-doc-observation').each(function() {
            var elementId = $(this).attr('id');
            var editor = TinyEditor.getInstanceForElementId(elementId);
            if (!editor) {
                allEditorsReady = false;
            } else {
                // Setup auto-save for this editor if not already done
                if (!$(this).data('autosave-setup')) {
                    setupAutoSaveForEditor(elementId);
                    $(this).data('autosave-setup', true);
                }
            }
        });

        if (allEditorsReady || setupAttempts >= maxAttempts) {
            clearInterval(setupInterval);
        }
    }, 500);

    // Fallback: auto-save on plain textarea blur (if editor doesn't load)
    $(document).on('blur', '.jb-doc-observation', function(e) {
        var $textarea = $(this);
        var editor = TinyEditor.getInstanceForElementId($textarea.attr('id'));

        // Only handle if TinyMCE is not active for this textarea
        if (editor) return;

        var docId = $textarea.data('document-id');
        var elementId = $textarea.attr('id');

        clearTimeout(saveTimeout);
        saveTimeout = setTimeout(function() {
            var text = $textarea.val();

            Ajax.call([{
                methodname: 'local_jobboard_save_document_observations',
                args: {
                    applicationid: {{selectedapplication.id}},
                    observations: JSON.stringify([{documentid: docId, observation: text}])
                },
                done: function() {
                    $textarea.addClass('border-success');
                    setTimeout(function() {
                        $textarea.removeClass('border-success');
                    }, 1000);
                },
                fail: function() {
                    // Silent fail for auto-save
                }
            }]);
        }, 500);
    });
});
{{/js}}
{{/selectedapplication}}
