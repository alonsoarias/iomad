{{!
    @template local_jobboard/pages/review/index

    Document review page - Clean and professional design.
    Follows the same pattern as the vacancy detail page.

    Context variables:
    * pagetitle - Page title
    * breadcrumbs - Array of breadcrumb items
    * dashboardurl - Dashboard URL
    * myreviewsurl - My reviews URL
    * stats - Statistics cards array
    * filterform - Filter form data
    * hasapplications - Boolean for queue mode
    * applications - Applications array for queue mode
    * selectedapplication - Selected application for single review mode
    * documents - Documents to review
    * initialpreview - First document data for initial preview
    * hasinitialpreview - Boolean if initial preview available
    * pagination - Pagination HTML
    * headeractions - Header action buttons

    Example context (json):
    {
        "pagetitle": "Review Documents",
        "hasapplications": true
    }
}}
<div class="jb-review-page" id="jobboard-review-page">
    <div class="container-fluid px-0">
        {{! ========== SINGLE APPLICATION REVIEW MODE ========== }}
        {{#selectedapplication}}
        <div class="row g-4">
            {{! Main Content - Document Preview }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{backurl}}">{{#str}}reviewdocuments, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{selectedapplication.applicantname}}</li>
                        </ol>
                    </nav>
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h1 class="h3 mb-1">{{#str}}reviewapplication, local_jobboard{{/str}}</h1>
                            <div class="d-flex align-items-center gap-2">
                                <code class="small">{{selectedapplication.vacancycode}}</code>
                                <span class="badge bg-{{selectedapplication.statuscolor}}">{{selectedapplication.statuslabel}}</span>
                            </div>
                        </div>
                        {{#shownav}}
                        <div class="btn-group" role="group">
                            {{#prevurl}}
                            <a href="{{prevurl}}" class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-chevron-left"></i>
                            </a>
                            {{/prevurl}}
                            {{^prevurl}}
                            <button class="btn btn-outline-secondary btn-sm" disabled>
                                <i class="fa fa-chevron-left"></i>
                            </button>
                            {{/prevurl}}
                            <span class="btn btn-outline-secondary btn-sm disabled">{{navposition}}/{{navtotal}}</span>
                            {{#nexturl}}
                            <a href="{{nexturl}}" class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-chevron-right"></i>
                            </a>
                            {{/nexturl}}
                            {{^nexturl}}
                            <button class="btn btn-outline-secondary btn-sm" disabled>
                                <i class="fa fa-chevron-right"></i>
                            </button>
                            {{/nexturl}}
                        </div>
                        {{/shownav}}
                    </div>
                </div>

                {{! Pending Documents Warning }}
                {{#haspending}}
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-clock fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}pendingdocuments, local_jobboard{{/str}}</strong>
                        <span class="d-block">{{pendingcount}} {{#str}}documentsremaining, local_jobboard{{/str}}</span>
                    </div>
                </div>
                {{/haspending}}

                {{! All Reviewed Success }}
                {{#allreviewed}}
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-check-circle fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}alldocsreviewed, local_jobboard{{/str}}</strong>
                        <span class="d-block">{{#str}}readytosubmit, local_jobboard{{/str}}</span>
                    </div>
                </div>
                {{/allreviewed}}

                {{! Document Preview Card }}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fa fa-file-lines text-primary me-2"></i>
                            <span data-region="preview-title">
                                {{#hasinitialpreview}}{{initialpreview.filename}}{{/hasinitialpreview}}
                                {{^hasinitialpreview}}{{#str}}selectdocument, local_jobboard{{/str}}{{/hasinitialpreview}}
                            </span>
                            {{#hasinitialpreview}}
                            <small class="d-block text-muted" data-region="preview-subtitle">{{initialpreview.typename}}</small>
                            {{/hasinitialpreview}}
                        </h5>
                        <div class="btn-group btn-group-sm">
                            {{#hasinitialpreview}}
                            <a href="{{initialpreview.downloadurl}}" class="btn btn-outline-secondary" target="_blank" data-region="download-btn">
                                <i class="fa fa-download me-1"></i>
                                {{#str}}download{{/str}}
                            </a>
                            <button type="button" class="btn btn-outline-secondary" onclick="document.querySelector('[data-region=preview-frame]').classList.toggle('jb-preview-fullscreen')" title="{{#str}}fullscreen, local_jobboard{{/str}}">
                                <i class="fa fa-expand"></i>
                            </button>
                            {{/hasinitialpreview}}
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="jb-preview-content bg-light position-relative" data-region="preview-frame" style="min-height: 500px;">
                            {{#hasinitialpreview}}
                            {{#initialpreview.ispdf}}
                            <iframe src="{{initialpreview.previewurl}}" class="w-100 h-100 border-0" style="min-height: 500px;"></iframe>
                            {{/initialpreview.ispdf}}
                            {{#initialpreview.isimage}}
                            <div class="d-flex align-items-center justify-content-center h-100 p-4" style="min-height: 500px;">
                                <img src="{{initialpreview.previewurl}}" alt="{{initialpreview.filename}}" class="img-fluid shadow rounded" style="max-height: 480px;">
                            </div>
                            {{/initialpreview.isimage}}
                            {{^initialpreview.canpreview}}
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;">
                                <i class="fa fa-file fa-4x mb-3"></i>
                                <p class="mb-3">{{#str}}previewnotavailable, local_jobboard{{/str}}</p>
                                <a href="{{initialpreview.downloadurl}}" class="btn btn-primary" target="_blank">
                                    <i class="fa fa-download me-2"></i>
                                    {{#str}}download{{/str}}
                                </a>
                            </div>
                            {{/initialpreview.canpreview}}
                            {{/hasinitialpreview}}
                            {{^hasinitialpreview}}
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" style="min-height: 500px;">
                                <i class="fa fa-file-circle-question fa-4x mb-3"></i>
                                <p>{{#str}}selectdocumenttopreview, local_jobboard{{/str}}</p>
                            </div>
                            {{/hasinitialpreview}}
                        </div>
                    </div>
                </div>
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Applicant Info Card }}
                    <div class="card shadow-sm mb-4 border-primary">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-user text-primary me-2"></i>
                                {{#str}}applicantinfo, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <h5 class="mb-2">{{selectedapplication.applicantname}}</h5>
                            <p class="small text-muted mb-2">
                                <i class="fa fa-envelope me-2"></i>
                                <a href="mailto:{{selectedapplication.email}}">{{selectedapplication.email}}</a>
                            </p>
                            <p class="small text-muted mb-0">
                                <i class="fa fa-briefcase me-2"></i>
                                {{selectedapplication.vacancytitle}}
                            </p>
                        </div>
                    </div>

                    {{! Documents List Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="fa fa-folder-open text-info me-2"></i>
                                {{#str}}documents, local_jobboard{{/str}}
                            </h6>
                            {{#canvalidateall}}
                            <a href="{{validateallurl}}" class="btn btn-success btn-sm">
                                <i class="fa fa-check-double me-1"></i>
                                {{#str}}validateall, local_jobboard{{/str}}
                            </a>
                            {{/canvalidateall}}
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush jb-documents-list" data-region="documents-list" style="max-height: 350px; overflow-y: auto;">
                                {{#documents}}
                                <div class="list-group-item list-group-item-action jb-doc-item {{#ispending}}border-start border-warning border-3{{/ispending}}"
                                     data-document-id="{{id}}"
                                     data-preview-url="{{previewurl}}"
                                     data-mimetype="{{mimetype}}"
                                     data-is-pdf="{{ispdf}}"
                                     data-is-image="{{isimage}}"
                                     data-can-preview="{{canpreview}}"
                                     data-typename="{{typename}}"
                                     data-filename="{{filename}}"
                                     data-download-url="{{downloadurl}}"
                                     onclick="jobboardPreviewDocument(this)"
                                     style="cursor: pointer;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center flex-grow-1 min-width-0 me-2">
                                            <i class="fa fa-{{statusicon}} text-{{statuscolor}} me-2 flex-shrink-0"></i>
                                            <div class="min-width-0">
                                                <div class="fw-medium text-truncate small">{{typename}}</div>
                                                <small class="text-muted text-truncate d-block" title="{{filename}}">{{filename}}</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-{{statuscolor}} flex-shrink-0">{{statuslabel}}</span>
                                    </div>
                                    {{#rejectreason}}
                                    <div class="small text-danger mt-1">
                                        <i class="fa fa-circle-exclamation me-1"></i>
                                        {{rejectreason}}
                                    </div>
                                    {{/rejectreason}}
                                    {{! Observations using Moodle HTML editor }}
                                    <div class="mt-2 jb-observation-editor-wrapper" onclick="event.stopPropagation();">
                                        <label for="doc_observation_{{id}}" class="form-label small text-muted mb-1">
                                            <i class="fa fa-comment-dots me-1"></i>
                                            {{#str}}documentobservation, local_jobboard{{/str}}
                                        </label>
                                        {{! Textarea for Moodle editor }}
                                        <textarea name="doc_observation_{{id}}"
                                                  id="doc_observation_{{id}}"
                                                  class="form-control jb-doc-observation jb-moodle-editor"
                                                  rows="3"
                                                  data-document-id="{{id}}"
                                                  data-application-id="{{applicationid}}"
                                                  placeholder="{{#str}}documentobservation_placeholder, local_jobboard{{/str}}">{{{observation}}}</textarea>
                                    </div>
                                    {{! Action buttons }}
                                    <div class="d-flex gap-1 mt-2" onclick="event.stopPropagation();">
                                        {{#ispending}}
                                        <a href="{{validateurl}}" class="btn btn-success btn-sm flex-grow-1">
                                            <i class="fa fa-check me-1"></i>
                                            {{#str}}approve, local_jobboard{{/str}}
                                        </a>
                                        <button type="button" class="btn btn-danger btn-sm flex-grow-1" data-bs-toggle="modal" data-bs-target="#rejectModal{{id}}">
                                            <i class="fa fa-xmark me-1"></i>
                                            {{#str}}reject, local_jobboard{{/str}}
                                        </button>
                                        {{/ispending}}
                                    </div>
                                </div>

                                {{! Reject Modal }}
                                {{#ispending}}
                                <div class="modal fade" id="rejectModal{{id}}" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" action="{{rejecturl}}">
                                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                                <input type="hidden" name="view" value="review">
                                                <input type="hidden" name="applicationid" value="{{../selectedapplication.id}}">
                                                <input type="hidden" name="documentid" value="{{id}}">
                                                <input type="hidden" name="action" value="reject">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title">
                                                        <i class="fa fa-triangle-exclamation me-2"></i>
                                                        {{#str}}rejectdocument, local_jobboard{{/str}}
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="text-muted mb-3">
                                                        <i class="fa fa-file me-2"></i>{{typename}}
                                                    </p>
                                                    <div class="mb-3">
                                                        <label for="reason{{id}}" class="form-label fw-bold">
                                                            {{#str}}rejectreason, local_jobboard{{/str}} *
                                                        </label>
                                                        <textarea name="reason" id="reason{{id}}" class="form-control" rows="3" required placeholder="{{#str}}rejectreason_placeholder, local_jobboard{{/str}}"></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}}cancel{{/str}}</button>
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="fa fa-xmark me-1"></i>
                                                        {{#str}}reject, local_jobboard{{/str}}
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                {{/ispending}}
                                {{/documents}}
                            </div>
                        </div>
                        {{! Observations Actions Footer }}
                        <div class="card-footer bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <small class="text-muted">
                                <i class="fa fa-info-circle me-1"></i>
                                {{#str}}documentobservation_help, local_jobboard{{/str}}
                            </small>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-primary" id="saveObservationsBtn" onclick="jobboardSaveObservations()">
                                    <i class="fa fa-save me-1"></i>
                                    {{#str}}savechanges{{/str}}
                                </button>
                                <button type="button" class="btn btn-sm btn-warning" id="sendObservationsBtn" onclick="jobboardSendObservationsEmail()">
                                    <i class="fa fa-paper-plane me-1"></i>
                                    {{#str}}sendobservationsemail, local_jobboard{{/str}}
                                </button>
                            </div>
                        </div>
                    </div>

                    {{! Review Progress Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-chart-pie text-success me-2"></i>
                                {{#str}}reviewprogress, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="h4 mb-0 text-success">{{approvedcount}}</div>
                                    <small class="text-muted">{{#str}}docstatus:approved, local_jobboard{{/str}}</small>
                                </div>
                                <div class="col-4">
                                    <div class="h4 mb-0 text-danger">{{rejectedcount}}</div>
                                    <small class="text-muted">{{#str}}docstatus:rejected, local_jobboard{{/str}}</small>
                                </div>
                                <div class="col-4">
                                    <div class="h4 mb-0 text-warning">{{pendingcount}}</div>
                                    <small class="text-muted">{{#str}}docstatus:pending, local_jobboard{{/str}}</small>
                                </div>
                            </div>
                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: {{approvedpercent}}%;"></div>
                                <div class="progress-bar bg-danger" style="width: {{rejectedpercent}}%;"></div>
                            </div>

                            {{#allreviewed}}
                            <form method="post" action="{{submitreviewurl}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="markreviewed">
                                <input type="hidden" name="applicationid" value="{{selectedapplication.id}}">
                                <input type="hidden" name="view" value="review">
                                <div class="mb-3">
                                    <label for="observations" class="form-label small fw-bold">
                                        {{#str}}reviewobservations, local_jobboard{{/str}}
                                    </label>
                                    <textarea name="observations" id="observations" class="form-control form-control-sm" rows="2" placeholder="{{#str}}reviewobservations_placeholder, local_jobboard{{/str}}"></textarea>
                                </div>
                                <button type="submit" class="btn btn-{{completebtncolor}} w-100">
                                    <i class="fa fa-clipboard-check me-2"></i>
                                    {{#str}}submitreview, local_jobboard{{/str}}
                                </button>
                            </form>
                            {{/allreviewed}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top">
                    <a href="{{backurl}}" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{#str}}backtoreviewlist, local_jobboard{{/str}}
                    </a>
                    <a href="{{dashboardurl}}" class="btn btn-link text-muted">
                        {{#str}}backtodashboard, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        {{/selectedapplication}}

        {{! ========== APPLICATIONS QUEUE MODE ========== }}
        {{^selectedapplication}}
        <div class="row g-4">
            {{! Main Content }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{#str}}reviewdocuments, local_jobboard{{/str}}</li>
                        </ol>
                    </nav>
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h1 class="h3 mb-1">{{pagetitle}}</h1>
                            <p class="text-muted mb-0">{{#str}}reviewdocuments_desc, local_jobboard{{/str}}</p>
                        </div>
                        {{#headeractions}}
                        <div class="btn-group">
                            {{#headeractions}}
                            <a href="{{url}}" class="btn btn-{{class}}">
                                <i class="fa fa-{{icon}} me-1"></i>
                                {{label}}
                            </a>
                            {{/headeractions}}
                        </div>
                        {{/headeractions}}
                    </div>
                </div>

                {{! Filter Form Card }}
                {{#filterform}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-filter text-secondary me-2"></i>
                            {{#str}}filter, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="get" action="{{action}}">
                            {{#hiddenfields}}
                            <input type="hidden" name="{{name}}" value="{{value}}">
                            {{/hiddenfields}}
                            <div class="row align-items-end">
                                {{#fields}}
                                <div class="col-md-6 mb-3">
                                    <label for="filter-{{name}}" class="form-label small text-muted">{{label}}</label>
                                    <select name="{{name}}" id="filter-{{name}}" class="form-select">
                                        {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/options}}
                                    </select>
                                </div>
                                {{/fields}}
                                <div class="col-md-6 mb-3">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa fa-search me-1"></i>
                                        {{#str}}filter, local_jobboard{{/str}}
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                {{/filterform}}

                {{! Applications List }}
                {{#hasapplications}}
                {{#applications}}
                <div class="card shadow-sm mb-3 {{#isurgent}}border-danger{{/isurgent}}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <h5 class="mb-0">
                                        <i class="fa fa-user text-muted me-2"></i>
                                        {{applicantname}}
                                    </h5>
                                    {{#isurgent}}
                                    <span class="badge bg-danger">
                                        <i class="fa fa-triangle-exclamation me-1"></i>
                                        {{#str}}urgent, local_jobboard{{/str}}
                                    </span>
                                    {{/isurgent}}
                                </div>
                                <p class="text-muted small mb-2">
                                    <i class="fa fa-envelope me-2"></i>{{email}}
                                </p>
                                <div class="d-flex flex-wrap gap-2 align-items-center small">
                                    <span class="badge bg-secondary">{{vacancycode}}</span>
                                    <span class="text-muted">{{vacancytitle}}</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-secondary">{{doccount}} {{#str}}documents, local_jobboard{{/str}}</span>
                                    {{#pendingcount}}
                                    <span class="badge bg-warning text-dark">{{pendingcount}} {{#str}}pending, local_jobboard{{/str}}</span>
                                    {{/pendingcount}}
                                    {{^pendingcount}}
                                    <span class="badge bg-success">{{#str}}allvalidated, local_jobboard{{/str}}</span>
                                    {{/pendingcount}}
                                </div>
                                <small class="text-muted">
                                    <i class="fa fa-calendar me-1"></i>
                                    {{datesubmitted}}
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between">
                        <a href="{{reviewurl}}" class="btn btn-primary btn-sm">
                            <i class="fa fa-magnifying-glass me-1"></i>
                            {{#str}}reviewdocuments, local_jobboard{{/str}}
                        </a>
                        <a href="{{viewurl}}" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-eye me-1"></i>
                            {{#str}}viewapplication, local_jobboard{{/str}}
                        </a>
                    </div>
                </div>
                {{/applications}}
                {{/hasapplications}}

                {{! Empty State }}
                {{^hasapplications}}
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fa fa-circle-check fa-4x text-success opacity-50 mb-3"></i>
                        <h4 class="text-muted mb-2">{{#str}}nodocumentstoreview, local_jobboard{{/str}}</h4>
                        <p class="text-muted">{{#str}}allcaughtup, local_jobboard{{/str}}</p>
                    </div>
                </div>
                {{/hasapplications}}

                {{! Pagination }}
                {{#pagination}}
                <nav class="mt-4">
                    {{{pagination}}}
                </nav>
                {{/pagination}}
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Statistics Cards }}
                    {{#stats}}
                    <div class="card shadow-sm mb-3 border-start border-{{color}} border-4">
                        <div class="card-body d-flex align-items-center">
                            <div class="flex-shrink-0 me-3">
                                <i class="fa fa-{{icon}} fa-2x text-{{color}}"></i>
                            </div>
                            <div>
                                <div class="h3 mb-0 text-{{color}}">{{value}}</div>
                                <small class="text-muted">{{label}}</small>
                            </div>
                        </div>
                    </div>
                    {{/stats}}

                    {{! Quick Actions Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-bolt text-warning me-2"></i>
                                {{#str}}quickactions, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
