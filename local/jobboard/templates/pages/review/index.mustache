{{!
    @template local_jobboard/pages/review/index

    Document review page - Clean minimal design following apply.mustache pattern.
    Supports both queue mode (list of applications) and single application review mode.

    Context variables:
    * pagetitle - Page title
    * dashboardurl - Dashboard URL
    * myreviewsurl - My reviews URL
    * backurl - Back URL
    * stats - Statistics cards array
    * filterform - Filter form data
    * hasapplications - Boolean for queue mode
    * applications - Applications array for queue mode
    * selectedapplication - Selected application for single review mode
    * documents - Documents to review
    * initialpreview - First document data for initial preview
    * hasinitialpreview - Boolean if initial preview available
    * pagination - Pagination HTML
}}
<div class="jb-review" id="jobboard-review-page">
    {{! ========== SINGLE APPLICATION REVIEW MODE ========== }}
    {{#selectedapplication}}
    {{! Header }}
    <div class="jb-public-header">
        <div class="jb-public-header__nav">
            <a href="{{backurl}}" class="jb-public-header__back">
                <i class="fa fa-arrow-left"></i>
                {{#str}}reviewdocuments, local_jobboard{{/str}}
            </a>
            {{#shownav}}
            <div class="jb-pager">
                {{#prevurl}}<a href="{{prevurl}}" class="jb-pager-btn"><i class="fa fa-chevron-left"></i></a>{{/prevurl}}
                {{^prevurl}}<span class="jb-pager-btn jb-pager-btn--disabled"><i class="fa fa-chevron-left"></i></span>{{/prevurl}}
                <span class="jb-pager-count">{{navposition}}/{{navtotal}}</span>
                {{#nexturl}}<a href="{{nexturl}}" class="jb-pager-btn"><i class="fa fa-chevron-right"></i></a>{{/nexturl}}
                {{^nexturl}}<span class="jb-pager-btn jb-pager-btn--disabled"><i class="fa fa-chevron-right"></i></span>{{/nexturl}}
            </div>
            {{/shownav}}
        </div>
        <h1 class="jb-public-header__title">
            <i class="fa fa-clipboard-check"></i> {{#str}}reviewapplication, local_jobboard{{/str}}
        </h1>
        <p class="jb-public-header__subtitle">
            <span class="jb-code">{{selectedapplication.vacancycode}}</span>
            {{selectedapplication.vacancytitle}}
        </p>
    </div>

    {{! Alerts }}
    {{#is_admin}}
    {{#haspending}}
    <div class="jb-alert jb-alert--warning">
        <i class="fa fa-shield-halved"></i>
        <span>{{#str}}admin_review_mode, local_jobboard{{/str}}</span>
    </div>
    {{/haspending}}
    {{/is_admin}}
    {{#is_dean}}
    <div class="jb-alert jb-alert--info">
        <i class="fa fa-user-tie"></i>
        <span>{{#str}}dean_review_mode, local_jobboard{{/str}}</span>
    </div>
    {{/is_dean}}
    {{#is_hr}}
    {{#haspending}}
    <div class="jb-alert jb-alert--info">
        <i class="fa fa-list-check"></i>
        <span>{{#str}}sequentialreview, local_jobboard{{/str}}: {{currentdocposition}}/{{totaldocs}}</span>
    </div>
    {{/haspending}}
    {{/is_hr}}

    {{#allreviewed}}
    <div class="jb-alert jb-alert--success">
        <i class="fa fa-check-circle"></i>
        <span>{{#str}}alldocsreviewed, local_jobboard{{/str}}</span>
    </div>
    {{/allreviewed}}

    {{! Content Layout }}
    <div class="jb-review-content">
        {{! Document Preview }}
        <div class="jb-review-main">
            <div class="jb-card">
                <div class="jb-card__header">
                    <span>
                        <i class="fa fa-file-lines"></i>
                        <span data-region="preview-title">
                            {{#hasinitialpreview}}{{initialpreview.filename}}{{/hasinitialpreview}}
                            {{^hasinitialpreview}}{{#str}}selectdocument, local_jobboard{{/str}}{{/hasinitialpreview}}
                        </span>
                    </span>
                    {{#hasinitialpreview}}
                    <div class="jb-header-actions">
                        <a href="{{initialpreview.downloadurl}}" class="jb-btn-icon" target="_blank" data-region="download-btn" title="{{#str}}download{{/str}}">
                            <i class="fa fa-download"></i>
                        </a>
                        <button type="button" class="jb-btn-icon" onclick="document.querySelector('[data-region=preview-frame]').classList.toggle('jb-preview-fullscreen')" title="{{#str}}fullscreen, local_jobboard{{/str}}">
                            <i class="fa fa-expand"></i>
                        </button>
                    </div>
                    {{/hasinitialpreview}}
                </div>
                <div class="jb-preview" data-region="preview-frame">
                    {{#hasinitialpreview}}
                        {{#initialpreview.haspreviewurl}}
                            {{#initialpreview.ispdf}}
                            <iframe src="{{initialpreview.previewurl}}" class="jb-preview__iframe"></iframe>
                            {{/initialpreview.ispdf}}
                            {{#initialpreview.isimage}}
                            <div class="jb-preview__image">
                                <img src="{{initialpreview.previewurl}}" alt="{{initialpreview.filename}}">
                            </div>
                            {{/initialpreview.isimage}}
                        {{/initialpreview.haspreviewurl}}
                        {{#initialpreview.istext}}{{#initialpreview.hastextcontent}}
                        <div class="jb-preview__text">
                            <div class="jb-text-content">{{{initialpreview.textcontent}}}</div>
                        </div>
                        {{/initialpreview.hastextcontent}}{{/initialpreview.istext}}
                        {{^initialpreview.canpreview}}{{^initialpreview.istext}}
                        <div class="jb-preview__empty">
                            <i class="fa fa-file"></i>
                            <p>{{#str}}previewnotavailable, local_jobboard{{/str}}</p>
                            <a href="{{initialpreview.downloadurl}}" class="jb-btn jb-btn--primary" target="_blank">
                                <i class="fa fa-download"></i> {{#str}}download{{/str}}
                            </a>
                        </div>
                        {{/initialpreview.istext}}{{/initialpreview.canpreview}}
                    {{/hasinitialpreview}}
                    {{^hasinitialpreview}}
                    <div class="jb-preview__empty">
                        <i class="fa fa-file-circle-question"></i>
                        <p>{{#str}}nodocumentstoreview, local_jobboard{{/str}}</p>
                    </div>
                    {{/hasinitialpreview}}
                </div>
            </div>
        </div>

        {{! Sidebar }}
        <aside class="jb-review-sidebar">
            {{! Applicant Info }}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--accent">
                    <i class="fa fa-user"></i>
                    {{#str}}applicantinfo, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}name, local_jobboard{{/str}}</span>
                        <a href="{{selectedapplication.profileurl}}" class="jb-info-value jb-link" target="_blank">
                            {{selectedapplication.applicantname}} <i class="fa fa-external-link-alt fa-xs"></i>
                        </a>
                    </div>
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}email{{/str}}</span>
                        <span class="jb-info-value">{{selectedapplication.email}}</span>
                    </div>
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}status, local_jobboard{{/str}}</span>
                        <span class="jb-badge jb-badge--{{selectedapplication.statuscolor}}">{{selectedapplication.statuslabel}}</span>
                    </div>
                </div>
            </div>

            {{! Documents List }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <span><i class="fa fa-folder-open"></i> {{#str}}documents, local_jobboard{{/str}}</span>
                    <span class="jb-badge">{{approvedcount}}/{{totaldocs}}</span>
                </div>
                <div class="jb-progress" style="--progress: {{approvedpercent}}%;"></div>
                <div class="jb-documents-list" data-region="documents-list">
                    {{#documents}}
                    <div class="jb-doc-item {{#iscurrent}}jb-doc-item--active{{/iscurrent}} {{#islocked}}jb-doc-item--locked{{/islocked}}"
                         data-document-id="{{id}}"
                         data-preview-url="{{previewurl}}"
                         data-mimetype="{{mimetype}}"
                         data-is-pdf="{{ispdf}}"
                         data-is-image="{{isimage}}"
                         data-is-text="{{istext}}"
                         data-can-preview="{{canpreview}}"
                         data-typename="{{typename}}"
                         data-filename="{{filename}}"
                         data-download-url="{{downloadurl}}"
                         {{#istext}}data-text-content-encoded="{{textcontentencoded}}"{{/istext}}
                         {{^islocked}}onclick="jobboardPreviewDocument(this)"{{/islocked}}>
                        <div class="jb-doc-item__header">
                            <span class="jb-doc-item__index jb-doc-item__index--{{statuscolor}}">{{docindex}}</span>
                            <div class="jb-doc-item__info">
                                <span class="jb-doc-item__name">{{typename}}</span>
                                <span class="jb-doc-item__file">{{filename}}</span>
                            </div>
                            <span class="jb-doc-item__status jb-doc-item__status--{{statuscolor}}">
                                <i class="fa fa-{{statusicon}}"></i>
                            </span>
                        </div>

                        {{! Show document action buttons only if user can validate documents (HR/Admin, not Dean) }}
                        {{#showactions}}
                        <div class="jb-doc-item__actions" data-document-id="{{id}}" data-application-id="{{applicationid}}">
                            <textarea name="doc_observation_{{id}}" id="doc_observation_{{id}}"
                                      class="jb-textarea jb-doc-observation"
                                      rows="2" data-document-id="{{id}}" data-application-id="{{applicationid}}"
                                      placeholder="{{#str}}documentobservation_placeholder, local_jobboard{{/str}}">{{{observation}}}</textarea>
                            <div class="jb-doc-item__buttons">
                                <button type="button" class="jb-btn jb-btn--success jb-approve-btn"
                                        data-document-id="{{id}}" data-application-id="{{applicationid}}">
                                    <i class="fa fa-check"></i> {{#str}}approve, local_jobboard{{/str}}
                                </button>
                                <button type="button" class="jb-btn jb-btn--danger jb-reject-btn"
                                        data-document-id="{{id}}" data-application-id="{{applicationid}}">
                                    <i class="fa fa-xmark"></i> {{#str}}reject, local_jobboard{{/str}}
                                </button>
                            </div>
                        </div>
                        {{/showactions}}

                        {{#rejectreason}}
                        <div class="jb-doc-item__reason"><i class="fa fa-exclamation-circle"></i> {{rejectreason}}</div>
                        {{/rejectreason}}
                    </div>
                    {{/documents}}
                </div>
                <div class="jb-card__footer">
                    <a href="{{downloadzipurl}}" class="jb-link"><i class="fa fa-file-zipper"></i> {{#str}}downloadzip, local_jobboard{{/str}}</a>
                    <div class="jb-footer-actions">
                        {{#canvalidateall}}
                        <a href="{{validateallurl}}" class="jb-btn jb-btn--success jb-btn--sm">
                            <i class="fa fa-check-double"></i> {{#str}}validateall, local_jobboard{{/str}}
                        </a>
                        {{/canvalidateall}}
                        <button type="button" class="jb-btn jb-btn--primary jb-btn--sm" id="saveAndSendBtn">
                            <i class="fa fa-paper-plane"></i> {{#str}}saveandsend, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </div>

            {{! Review Progress }}
            {{#allreviewed}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--success">
                    <i class="fa fa-clipboard-check"></i>
                    {{#str}}reviewprogress, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <form method="post" action="{{submitreviewurl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="markreviewed">
                        <input type="hidden" name="applicationid" value="{{selectedapplication.id}}">
                        <input type="hidden" name="view" value="review">
                        <textarea name="observations" class="jb-textarea" rows="2" placeholder="{{#str}}reviewobservations_placeholder, local_jobboard{{/str}}"></textarea>
                        <button type="submit" class="jb-btn jb-btn--{{completebtncolor}} jb-btn--full">
                            <i class="fa fa-check-double"></i> {{#str}}submitreview, local_jobboard{{/str}}
                        </button>
                    </form>
                </div>
            </div>
            {{/allreviewed}}
        </aside>
    </div>

    {{! Footer Navigation }}
    <div class="jb-review-footer">
        <a href="{{backurl}}" class="jb-link"><i class="fa fa-arrow-left"></i> {{#str}}back{{/str}}</a>
        <a href="{{myreviewsurl}}" class="jb-link">{{#str}}myreviews, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i></a>
    </div>
    {{/selectedapplication}}

    {{! ========== APPLICATIONS QUEUE MODE ========== }}
    {{^selectedapplication}}
    {{! Header }}
    <div class="jb-public-header">
        <div class="jb-public-header__nav">
            <a href="{{dashboardurl}}" class="jb-public-header__back">
                <i class="fa fa-arrow-left"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
            <a href="{{myreviewsurl}}" class="jb-btn jb-btn--outline">
                <i class="fa fa-clipboard-list"></i>
                {{#str}}myreviews, local_jobboard{{/str}}
            </a>
        </div>
        <h1 class="jb-public-header__title">
            <i class="fa fa-file-lines"></i> {{#str}}reviewdocuments, local_jobboard{{/str}}
        </h1>
        <p class="jb-public-header__subtitle">{{#str}}reviewqueue_desc, local_jobboard{{/str}}</p>
    </div>

    {{! Stats }}
    {{#stats.0}}
    <div class="jb-stats">
        {{#stats}}
        <div class="jb-stat jb-stat--{{color}}">
            <span class="jb-stat__value">{{value}}</span>
            <span class="jb-stat__label">{{label}}</span>
        </div>
        {{/stats}}
    </div>
    {{/stats.0}}

    {{! Filters }}
    {{#filterform}}
    <div class="jb-card jb-filter-card">
        <div class="jb-card__header">
            <span><i class="fa fa-filter"></i> {{#str}}filter, local_jobboard{{/str}}</span>
            {{#hasfilters}}
            <a href="{{clearfiltersurl}}" class="jb-link jb-link--muted"><i class="fa fa-times"></i> {{#str}}clearfilters, local_jobboard{{/str}}</a>
            {{/hasfilters}}
        </div>
        <div class="jb-card__body">
            <form method="get" action="{{action}}" class="jb-filter-form" id="jb-review-filter-form">
                {{#hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="jb-filter-grid">
                    <div class="jb-filter-item jb-filter-item--wide">
                        <label class="jb-filter-label"><i class="fa fa-search"></i> {{#str}}search{{/str}}</label>
                        <input type="text" name="search" class="jb-input" value="{{searchvalue}}" placeholder="{{#str}}filter_search_placeholder, local_jobboard{{/str}}">
                    </div>
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-circle-info"></i> {{#str}}status, local_jobboard{{/str}}</label>
                        <select name="status" class="jb-select">
                            {{#statusoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/statusoptions}}
                        </select>
                    </div>
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-hashtag"></i> {{#str}}code, local_jobboard{{/str}}</label>
                        <input type="text" name="code" class="jb-input" value="{{codevalue}}" placeholder="{{#str}}filter_code_placeholder, local_jobboard{{/str}}">
                    </div>
                    {{#showcontractfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-file-contract"></i> {{#str}}contracttype, local_jobboard{{/str}}</label>
                        <select name="contracttype" class="jb-select">
                            <option value="">{{#str}}allcontracttypes, local_jobboard{{/str}}</option>
                            {{#contractoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/contractoptions}}
                        </select>
                    </div>
                    {{/showcontractfilter}}
                    {{#showdepartmentfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-building"></i> {{#str}}department, local_jobboard{{/str}}</label>
                        <select name="department" class="jb-select">
                            <option value="">{{#str}}alldepartments, local_jobboard{{/str}}</option>
                            {{#departmentoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/departmentoptions}}
                        </select>
                    </div>
                    {{/showdepartmentfilter}}
                    {{#showlocationfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-location-dot"></i> {{#str}}location, local_jobboard{{/str}}</label>
                        <select name="location" class="jb-select">
                            <option value="">{{#str}}alllocations, local_jobboard{{/str}}</option>
                            {{#locationoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/locationoptions}}
                        </select>
                    </div>
                    {{/showlocationfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-calendar"></i> {{#str}}datefrom, local_jobboard{{/str}}</label>
                        <input type="date" name="datefrom" class="jb-input" value="{{datefromvalue}}">
                    </div>
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-calendar-check"></i> {{#str}}dateto, local_jobboard{{/str}}</label>
                        <input type="date" name="dateto" class="jb-input" value="{{datetovalue}}">
                    </div>
                    <div class="jb-filter-item jb-filter-item--narrow">
                        <label class="jb-filter-label"><i class="fa fa-list-ol"></i> {{#str}}perpage, local_jobboard{{/str}}</label>
                        <select name="perpage" class="jb-select">
                            {{#perpageoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/perpageoptions}}
                        </select>
                    </div>
                    <div class="jb-filter-item jb-filter-item--action">
                        <button type="submit" class="jb-btn jb-btn--primary jb-btn--full">
                            <i class="fa fa-filter"></i> {{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! Results Container - for AJAX filtering }}
    <div data-region="filter-results" id="jb-review-results">
    {{! Bulk Actions }}
    <div class="jb-bulk-bar d-none" id="jb-bulk-actions-bar">
        <span><strong id="jb-selected-count">0</strong> {{#str}}applicationsselected, local_jobboard{{/str}}</span>
        <div class="jb-bulk-bar__actions">
            <button type="button" class="jb-btn jb-btn--outline" id="jb-download-selected-btn" data-url="{{bulkdownloadurl}}">
                <i class="fa fa-file-zipper"></i> {{#str}}downloadselected, local_jobboard{{/str}}
            </button>
            <button type="button" class="jb-btn jb-btn--ghost" id="jb-clear-selection-btn">
                <i class="fa fa-times"></i>
            </button>
        </div>
    </div>

    {{! Applications List }}
    {{#hasapplications}}
    <div class="jb-card">
        <div class="jb-card__header">
            <span><i class="fa fa-list"></i> {{#str}}pendingreviews, local_jobboard{{/str}}</span>
            <span class="jb-badge jb-badge--primary">{{applicationcount}}</span>
        </div>
        <div class="jb-table-wrap">
            <table class="jb-table" id="jb-applications-table">
                <thead>
                    <tr>
                        <th class="jb-table__check">
                            <input type="checkbox" id="jb-select-all" class="jb-checkbox">
                        </th>
                        <th>{{#str}}applicant, local_jobboard{{/str}}</th>
                        <th>{{#str}}vacancy, local_jobboard{{/str}}</th>
                        <th class="jb-table__center">{{#str}}status, local_jobboard{{/str}}</th>
                        <th class="jb-table__center">{{#str}}documents, local_jobboard{{/str}}</th>
                        <th class="jb-table__center">{{#str}}date, local_jobboard{{/str}}</th>
                        <th class="jb-table__actions">{{#str}}actions, local_jobboard{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#applications}}
                    <tr class="{{#isurgent}}jb-table__row--urgent{{/isurgent}}" data-application-id="{{id}}">
                        <td class="jb-table__check">
                            <input type="checkbox" class="jb-checkbox jb-application-checkbox" value="{{id}}">
                        </td>
                        <td>
                            <div class="jb-applicant">
                                <div class="jb-applicant__avatar"><i class="fa fa-user"></i></div>
                                <div class="jb-applicant__info">
                                    <a href="{{profileurl}}" class="jb-applicant__name" target="_blank">
                                        {{applicantname}}
                                        {{#isurgent}}<i class="fa fa-exclamation-triangle jb-text-danger"></i>{{/isurgent}}
                                    </a>
                                    <span class="jb-applicant__email">{{email}}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="jb-code">{{vacancycode}}</span>
                            <span class="jb-vacancy-title">{{vacancytitle}}</span>
                        </td>
                        <td class="jb-table__center">
                            <span class="jb-badge jb-badge--{{statuscolor}}">{{statuslabel}}</span>
                        </td>
                        <td class="jb-table__center">
                            <span class="jb-doc-count">
                                <i class="fa fa-file"></i> {{doccount}}
                                {{#pendingcount}}<span class="jb-doc-pending">{{pendingcount}}</span>{{/pendingcount}}
                            </span>
                        </td>
                        <td class="jb-table__center">
                            <span class="jb-date">{{datesubmitted}}</span>
                        </td>
                        <td class="jb-table__actions">
                            <a href="{{reviewurl}}" class="jb-btn jb-btn--primary jb-btn--sm" title="{{#str}}review, local_jobboard{{/str}}">
                                <i class="fa fa-magnifying-glass"></i>
                            </a>
                            <a href="{{downloadzipurl}}" class="jb-btn jb-btn--ghost jb-btn--sm" title="{{#str}}downloadallzip, local_jobboard{{/str}}">
                                <i class="fa fa-file-zipper"></i>
                            </a>
                            <a href="{{viewurl}}" class="jb-btn jb-btn--ghost jb-btn--sm" title="{{#str}}viewapplication, local_jobboard{{/str}}">
                                <i class="fa fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                    {{/applications}}
                </tbody>
            </table>
        </div>
    </div>

    {{! Pagination }}
    {{#pagination}}
    <nav class="jb-pagination">{{{pagination}}}</nav>
    {{/pagination}}
    {{/hasapplications}}

    {{! Empty State }}
    {{^hasapplications}}
    <div class="jb-empty">
        <i class="fa fa-circle-check"></i>
        <h3>{{#str}}nodocumentstoreview, local_jobboard{{/str}}</h3>
        <p>{{#str}}allcaughtup, local_jobboard{{/str}}</p>
        <div class="jb-empty__actions">
            <a href="{{myreviewsurl}}" class="jb-btn jb-btn--outline"><i class="fa fa-clipboard-list"></i> {{#str}}myreviews, local_jobboard{{/str}}</a>
            <a href="{{dashboardurl}}" class="jb-btn jb-btn--ghost"><i class="fa fa-home"></i> {{#str}}dashboard, local_jobboard{{/str}}</a>
        </div>
    </div>
    {{/hasapplications}}
    </div>{{! End data-region="filter-results" }}

    {{! Footer -->}}
    <div class="jb-review-footer">
        <a href="{{dashboardurl}}" class="jb-link"><i class="fa fa-arrow-left"></i> {{#str}}dashboard, local_jobboard{{/str}}</a>
        <a href="{{myreviewsurl}}" class="jb-link">{{#str}}myreviews, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i></a>
    </div>
    {{/selectedapplication}}
</div>

<style>
/* ================================================================
   REVIEW PAGE - CLEAN MINIMAL DESIGN
   Following apply.mustache pattern
   ================================================================ */
.jb-review {
    max-width: 1200px;
    padding: 1rem;
}

/* Header - Same as public/index */
.jb-public-header { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #e5e5e5; }
.jb-public-header__nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
.jb-public-header__back { color: var(--iser-verde, #1b9e88); text-decoration: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem; }
.jb-public-header__back:hover { color: var(--iser-verde-dark, #157a6a); }
.jb-public-header__title { font-size: 1.5rem; font-weight: 600; margin: 0 0 0.25rem 0; color: var(--iser-negro, #1a1a1a); display: flex; align-items: center; gap: 0.75rem; }
.jb-public-header__title i { color: var(--iser-verde, #1b9e88); }
