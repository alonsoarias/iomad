{{!
    @template local_jobboard/pages/review

    Document review page template with document preview panel.
    Similar to mod_assign grading interface.

    Context variables:
    * breadcrumbs - Array of breadcrumb items
    * stats - Review queue stats
    * filterform - Filter form data
    * hasapplications - Boolean
    * applications - Array of applications pending review
    * selectedapplication - Selected application for review (if any)
    * documents - Documents to review with preview info
    * initialpreview - First document data for initial preview
    * hasinitialpreview - Boolean if initial preview available
    * pagination - Pagination HTML

    Example context (json):
    {
        "hasapplications": true,
        "applications": [{"id": 1, "applicantname": "John Doe"}]
    }
}}
<div class="local-jobboard-review" data-region="jobboard-review">
    {{! Page Header }}
    <header class="jb-page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="fs-4 mb-0">
                <i class="fa fa-clipboard-check text-primary me-2" aria-hidden="true"></i>
                {{pagetitle}}
            </h1>
            {{#headeractions}}
            <div class="btn-group" role="group">
                {{#headeractions}}
                <a href="{{url}}" class="btn btn-{{class}}">
                    <i class="fa fa-{{icon}} me-1" aria-hidden="true"></i>
                    {{label}}
                </a>
                {{/headeractions}}
            </div>
            {{/headeractions}}
        </div>
    </header>

    {{! Statistics Row }}
    {{#stats.0}}
    <section class="row mb-4" role="region" aria-label="{{#str}}reviewstatistics, local_jobboard{{/str}}">
        {{#stats}}
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm h-100 border-start border-{{color}} border-4">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <i class="fa fa-{{icon}} fa-2x text-{{color}}" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold text-{{color}}">{{value}}</div>
                        <div class="small text-muted">{{label}}</div>
                    </div>
                </div>
            </div>
        </div>
        {{/stats}}
    </section>
    {{/stats.0}}

    <div id="review-main-content">
        {{! ========== SINGLE APPLICATION REVIEW MODE ========== }}
        {{#selectedapplication}}

        {{! Previous/Next Navigation }}
        {{#shownav}}
        <nav class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-4" aria-label="{{#str}}reviewnavigation, local_jobboard{{/str}}">
            {{#prevurl}}
            <a href="{{prevurl}}" class="btn btn-outline-primary">
                <i class="fa fa-chevron-left me-2" aria-hidden="true"></i>
                {{#str}}prev{{/str}}
            </a>
            {{/prevurl}}
            {{^prevurl}}
            <span class="btn btn-outline-secondary disabled">
                <i class="fa fa-chevron-left me-2" aria-hidden="true"></i>
                {{#str}}prev{{/str}}
            </span>
            {{/prevurl}}

            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
                {{navposition}} / {{navtotal}}
            </span>

            {{#nexturl}}
            <a href="{{nexturl}}" class="btn btn-outline-primary">
                {{#str}}next{{/str}}
                <i class="fa fa-chevron-right ms-2" aria-hidden="true"></i>
            </a>
            {{/nexturl}}
            {{^nexturl}}
            <span class="btn btn-outline-secondary disabled">
                {{#str}}next{{/str}}
                <i class="fa fa-chevron-right ms-2" aria-hidden="true"></i>
            </span>
            {{/nexturl}}
        </nav>
        {{/shownav}}

        {{! Split Panel Layout - Similar to mod_assign }}
        <div class="jb-review-container row g-0" style="min-height: 70vh;">
            {{! Left Panel - Document Preview }}
            <div class="col-lg-7 col-md-6 d-flex flex-column border-end" data-region="preview-panel">
                <div class="jb-preview-header bg-light border-bottom p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                        <span class="fw-bold" data-region="preview-title">
                            {{#hasinitialpreview}}{{initialpreview.typename}}{{/hasinitialpreview}}
                            {{^hasinitialpreview}}{{#str}}selectdocument, local_jobboard{{/str}}{{/hasinitialpreview}}
                        </span>
                    </div>
                    <div class="btn-group btn-group-sm" data-region="preview-actions">
                        {{#hasinitialpreview}}
                        <a href="{{initialpreview.downloadurl}}" class="btn btn-outline-secondary" target="_blank" data-region="download-btn">
                            <i class="fa fa-download me-1" aria-hidden="true"></i>
                            {{#str}}download{{/str}}
                        </a>
                        <button type="button" class="btn btn-outline-secondary" onclick="document.querySelector('[data-region=preview-frame]').classList.toggle('jb-preview-fullscreen')" title="{{#str}}fullscreen, local_jobboard{{/str}}">
                            <i class="fa fa-expand" aria-hidden="true"></i>
                        </button>
                        {{/hasinitialpreview}}
                    </div>
                </div>

                <div class="jb-preview-content flex-grow-1 bg-secondary bg-opacity-10 position-relative" data-region="preview-frame" style="min-height: 500px;">
                    {{#hasinitialpreview}}
                    {{#initialpreview.ispdf}}
                    <iframe src="{{initialpreview.previewurl}}" class="w-100 h-100 border-0" data-region="preview-iframe" style="min-height: 500px;"></iframe>
                    {{/initialpreview.ispdf}}
                    {{#initialpreview.isimage}}
                    <div class="d-flex align-items-center justify-content-center h-100 p-3">
                        <img src="{{initialpreview.previewurl}}" alt="{{initialpreview.filename}}" class="img-fluid shadow" style="max-height: 100%;" data-region="preview-image">
                    </div>
                    {{/initialpreview.isimage}}
                    {{^initialpreview.canpreview}}
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                        <i class="fa fa-file fa-4x mb-3" aria-hidden="true"></i>
                        <p class="mb-2">{{#str}}previewnotavailable, local_jobboard{{/str}}</p>
                        <a href="{{initialpreview.downloadurl}}" class="btn btn-primary" target="_blank">
                            <i class="fa fa-download me-2" aria-hidden="true"></i>
                            {{#str}}download{{/str}}
                        </a>
                    </div>
                    {{/initialpreview.canpreview}}
                    {{/hasinitialpreview}}
                    {{^hasinitialpreview}}
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" data-region="no-preview">
                        <i class="fa fa-file-circle-question fa-4x mb-3" aria-hidden="true"></i>
                        <p>{{#str}}selectdocumenttopreview, local_jobboard{{/str}}</p>
                    </div>
                    {{/hasinitialpreview}}
                </div>
            </div>

            {{! Right Panel - Documents List & Actions }}
            <div class="col-lg-5 col-md-6 d-flex flex-column" data-region="documents-panel">
                {{! Applicant Info Header }}
                <div class="bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-user-circle fa-2x me-3" aria-hidden="true"></i>
                        <div>
                            <h2 class="fs-5 mb-0">{{selectedapplication.applicantname}}</h2>
                            <small class="opacity-75">{{selectedapplication.email}}</small>
                        </div>
                    </div>
                    <div class="mt-2 small">
                        <span class="badge bg-light text-dark me-2">{{selectedapplication.vacancycode}}</span>
                        <span class="badge bg-{{selectedapplication.statuscolor}}">{{selectedapplication.statuslabel}}</span>
                    </div>
                </div>

                {{! Documents List }}
                <div class="flex-grow-1 overflow-auto" style="max-height: 400px;">
                    <div class="list-group list-group-flush" data-region="documents-list">
                        {{#documents}}
                        <div class="list-group-item list-group-item-action jb-doc-item {{#ispending}}border-start border-warning border-3{{/ispending}}"
                             data-document-id="{{id}}"
                             data-preview-url="{{previewurl}}"
                             data-mimetype="{{mimetype}}"
                             data-is-pdf="{{ispdf}}"
                             data-is-image="{{isimage}}"
                             data-can-preview="{{canpreview}}"
                             data-typename="{{typename}}"
                             data-download-url="{{downloadurl}}"
                             onclick="jobboardPreviewDocument(this)"
                             style="cursor: pointer;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex align-items-start flex-grow-1">
                                    <div class="flex-shrink-0 me-3 mt-1">
                                        <i class="fa fa-{{statusicon}} fa-lg text-{{statuscolor}}" aria-hidden="true"></i>
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <h6 class="mb-1 fw-bold text-truncate">{{typename}}</h6>
                                        <small class="text-muted d-block text-truncate">{{filename}}</small>
                                        <span class="badge bg-{{statuscolor}} mt-1">{{statuslabel}}</span>
                                        {{#rejectreason}}
                                        <div class="text-danger small mt-1">
                                            <i class="fa fa-circle-exclamation me-1" aria-hidden="true"></i>
                                            {{rejectreason}}
                                        </div>
                                        {{/rejectreason}}
                                    </div>
                                </div>

                                {{! Action Buttons }}
                                <div class="btn-group-vertical btn-group-sm ms-2" onclick="event.stopPropagation();">
                                    {{#downloadurl}}
                                    <a href="{{downloadurl}}" class="btn btn-outline-primary btn-sm" target="_blank" title="{{#str}}download{{/str}}">
                                        <i class="fa fa-download" aria-hidden="true"></i>
                                    </a>
                                    {{/downloadurl}}
                                    {{#ispending}}
                                    <a href="{{validateurl}}" class="btn btn-success btn-sm" title="{{#str}}approve, local_jobboard{{/str}}">
                                        <i class="fa fa-check" aria-hidden="true"></i>
                                    </a>
                                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal{{id}}" title="{{#str}}reject, local_jobboard{{/str}}">
                                        <i class="fa fa-xmark" aria-hidden="true"></i>
                                    </button>
                                    {{/ispending}}
                                </div>
                            </div>
                        </div>

                        {{! Reject Modal }}
                        {{#ispending}}
                        <div class="modal fade" id="rejectModal{{id}}" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form method="post" action="{{rejecturl}}">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <input type="hidden" name="view" value="review">
                                        <input type="hidden" name="applicationid" value="{{../selectedapplication.id}}">
                                        <input type="hidden" name="documentid" value="{{id}}">
                                        <input type="hidden" name="action" value="reject">
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title">
                                                <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
                                                {{#str}}rejectdocument, local_jobboard{{/str}}
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="text-muted mb-3">
                                                <i class="fa fa-file me-2" aria-hidden="true"></i>
                                                {{typename}}
                                            </p>
                                            <div class="mb-3">
                                                <label for="reason{{id}}" class="form-label fw-bold">
                                                    {{#str}}rejectreason, local_jobboard{{/str}} *
                                                </label>
                                                <textarea name="reason" id="reason{{id}}" class="form-control" rows="3" required placeholder="{{#str}}rejectreason_placeholder, local_jobboard{{/str}}"></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}}cancel{{/str}}</button>
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fa fa-xmark me-1" aria-hidden="true"></i>
                                                {{#str}}reject, local_jobboard{{/str}}
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {{/ispending}}
                        {{/documents}}
                    </div>
                </div>

                {{! Review Progress & Actions }}
                <div class="border-top p-3 bg-light">
                    {{! Progress Bar }}
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>{{#str}}reviewprogress, local_jobboard{{/str}}</span>
                            <span>
                                <span class="text-success">{{approvedcount}}</span> /
                                <span class="text-danger">{{rejectedcount}}</span> /
                                <span class="text-warning">{{pendingcount}}</span>
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: {{approvedpercent}}%;"></div>
                            <div class="progress-bar bg-danger" style="width: {{rejectedpercent}}%;"></div>
                        </div>
                    </div>

                    {{! Quick Actions }}
                    <div class="d-flex gap-2 mb-3">
                        {{#canvalidateall}}
                        <a href="{{validateallurl}}" class="btn btn-success btn-sm flex-grow-1">
                            <i class="fa fa-check-double me-1" aria-hidden="true"></i>
                            {{#str}}validateall, local_jobboard{{/str}}
                        </a>
                        {{/canvalidateall}}
                    </div>

                    {{! Submit Review }}
                    {{#allreviewed}}
                    <div class="alert alert-success mb-3 py-2">
                        <i class="fa fa-circle-check me-2" aria-hidden="true"></i>
                        {{#str}}alldocsreviewed, local_jobboard{{/str}}
                    </div>
                    <form method="post" action="{{submitreviewurl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="markreviewed">
                        <input type="hidden" name="applicationid" value="{{selectedapplication.id}}">
                        <input type="hidden" name="view" value="review">
                        <div class="mb-3">
                            <label for="observations" class="form-label small fw-bold">
                                {{#str}}reviewobservations, local_jobboard{{/str}}
                            </label>
                            <textarea name="observations" id="observations" class="form-control form-control-sm" rows="2" placeholder="{{#str}}reviewobservations_placeholder, local_jobboard{{/str}}"></textarea>
                        </div>
                        <button type="submit" class="btn btn-{{completebtncolor}} w-100">
                            <i class="fa fa-clipboard-check me-2" aria-hidden="true"></i>
                            {{#str}}submitreview, local_jobboard{{/str}}
                        </button>
                    </form>
                    {{/allreviewed}}

                    {{#haspending}}
                    <div class="alert alert-warning mb-0 py-2">
                        <i class="fa fa-clock me-2" aria-hidden="true"></i>
                        {{#str}}documentsremaining, local_jobboard{{/str}}: <strong>{{pendingcount}}</strong>
                    </div>
                    {{/haspending}}
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <nav class="d-flex justify-content-between align-items-center mt-4 py-3 border-top">
            <a href="{{backurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtoreviewlist, local_jobboard{{/str}}
            </a>
            <a href="{{dashboardurl}}" class="btn btn-link text-muted">
                {{#str}}backtodashboard, local_jobboard{{/str}}
                <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
            </a>
        </nav>
        {{/selectedapplication}}

        {{! ========== APPLICATIONS QUEUE MODE ========== }}
        {{^selectedapplication}}

        {{! Filter Form }}
        {{#filterform}}
        <form method="get" action="{{action}}" class="card mb-4">
            <div class="card-body">
                {{#hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="row align-items-end">
                    {{#fields}}
                    <div class="col-md-4 mb-2">
                        <label for="filter-{{name}}" class="form-label small text-muted">{{label}}</label>
                        <select name="{{name}}" id="filter-{{name}}" class="form-select">
                            {{#options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                    </div>
                    {{/fields}}
                    <div class="col-md-4 mb-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa fa-filter me-1" aria-hidden="true"></i>
                            {{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </form>
        {{/filterform}}

        {{! Applications Queue List }}
        {{#hasapplications}}
        <section class="row">
            {{#applications}}
            <div class="col-lg-6 mb-4">
                <article class="card h-100 shadow-sm {{#isurgent}}border-danger{{/isurgent}}">
                    <div class="card-header d-flex justify-content-between align-items-center
                         {{#haspendingdocs}}bg-warning text-dark{{/haspendingdocs}}{{^haspendingdocs}}bg-success text-white{{/haspendingdocs}}">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark">{{vacancycode}}</span>
                            <span class="small fw-medium">{{statuslabel}}</span>
                        </div>
                        {{#isurgent}}
                        <span class="badge bg-danger">
                            <i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>
                            {{#str}}urgent, local_jobboard{{/str}}
                        </span>
                        {{/isurgent}}
                    </div>
                    <div class="card-body">
                        <h2 class="card-title fs-5 mb-2">
                            <i class="fa fa-user text-muted me-2" aria-hidden="true"></i>
                            {{applicantname}}
                        </h2>
                        <p class="small mb-2">
                            <i class="fa fa-envelope text-muted me-2" aria-hidden="true"></i>
                            <a href="mailto:{{email}}" class="text-muted">{{email}}</a>
                        </p>
                        <div class="small text-muted mb-3">
                            <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                            {{vacancytitle}}
                        </div>

                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                            <span class="small text-muted">
                                <i class="fa fa-file-lines me-1" aria-hidden="true"></i>
                                {{#str}}documents, local_jobboard{{/str}}:
                            </span>
                            <span class="badge bg-secondary">{{doccount}}</span>
                            {{#pendingcount}}
                            <span class="badge bg-warning text-dark">
                                {{pendingcount}} {{#str}}pending, local_jobboard{{/str}}
                            </span>
                            {{/pendingcount}}
                        </div>

                        <div class="small text-muted">
                            <i class="fa fa-calendar-days me-2" aria-hidden="true"></i>
                            {{#str}}datesubmitted, local_jobboard{{/str}}: {{datesubmitted}}
                        </div>
                    </div>
                    <footer class="card-footer bg-white">
                        <div class="d-flex justify-content-between gap-2">
                            <a href="{{reviewurl}}" class="btn btn-primary btn-sm flex-grow-1">
                                <i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>
                                {{#str}}reviewdocuments, local_jobboard{{/str}}
                            </a>
                            <a href="{{viewurl}}" class="btn btn-outline-secondary btn-sm" title="{{#str}}viewapplication, local_jobboard{{/str}}">
                                <i class="fa fa-eye" aria-hidden="true"></i>
                            </a>
                        </div>
                    </footer>
                </article>
            </div>
            {{/applications}}
        </section>
        {{/hasapplications}}

        {{! Empty State }}
        {{^hasapplications}}
        <div class="text-center py-5">
            <i class="fa fa-circle-check fa-4x text-success opacity-50 mb-3" aria-hidden="true"></i>
            <h2 class="h5 text-muted mb-2">{{#str}}nodocumentstoreview, local_jobboard{{/str}}</h2>
            <p class="text-muted">{{#str}}allcaughtup, local_jobboard{{/str}}</p>
        </div>
        {{/hasapplications}}

        {{! Pagination }}
        {{#pagination}}
        <nav class="mt-4">
            {{{pagination}}}
        </nav>
        {{/pagination}}

        {{! Navigation Footer for Queue }}
        <nav class="d-flex justify-content-between align-items-center mt-4 py-3 border-top">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtodashboard, local_jobboard{{/str}}
            </a>
            {{#myreviewsurl}}
            <a href="{{myreviewsurl}}" class="btn btn-link text-muted">
                {{#str}}myreviews, local_jobboard{{/str}}
                <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
            </a>
            {{/myreviewsurl}}
        </nav>
        {{/selectedapplication}}
    </div>
</div>

{{! Document Preview JavaScript }}
<script>
function jobboardPreviewDocument(element) {
    const previewUrl = element.dataset.previewUrl;
    const mimetype = element.dataset.mimetype;
    const isPdf = element.dataset.isPdf === 'true' || element.dataset.isPdf === '1';
    const isImage = element.dataset.isImage === 'true' || element.dataset.isImage === '1';
    const canPreview = element.dataset.canPreview === 'true' || element.dataset.canPreview === '1';
    const typename = element.dataset.typename;
    const downloadUrl = element.dataset.downloadUrl;

    // Update active state
    document.querySelectorAll('[data-region="documents-list"] .list-group-item').forEach(item => {
        item.classList.remove('active');
    });
    element.classList.add('active');

    // Update title
    const titleEl = document.querySelector('[data-region="preview-title"]');
    if (titleEl) titleEl.textContent = typename;

    // Update download button
    const downloadBtn = document.querySelector('[data-region="download-btn"]');
    if (downloadBtn && downloadUrl) {
        downloadBtn.href = downloadUrl;
    }

    // Update preview content
    const previewFrame = document.querySelector('[data-region="preview-frame"]');
    if (!previewFrame) return;

    if (previewUrl && (isPdf || isImage)) {
        if (isPdf) {
            previewFrame.innerHTML = '<iframe src="' + previewUrl + '" class="w-100 h-100 border-0" style="min-height: 500px;"></iframe>';
        } else if (isImage) {
            previewFrame.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 p-3">' +
                '<img src="' + previewUrl + '" alt="' + typename + '" class="img-fluid shadow" style="max-height: 100%;">' +
                '</div>';
        }
    } else {
        previewFrame.innerHTML = '<div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">' +
            '<i class="fa fa-file fa-4x mb-3"></i>' +
            '<p class="mb-2">{{#str}}previewnotavailable, local_jobboard{{/str}}</p>' +
            (downloadUrl ? '<a href="' + downloadUrl + '" class="btn btn-primary" target="_blank"><i class="fa fa-download me-2"></i>{{#str}}download{{/str}}</a>' : '') +
            '</div>';
    }
}
</script>

{{! Styles for Document Preview }}
<style>
.jb-review-container {
    border: 1px solid #dee2e6;
    border-radius: 0.5rem;
    overflow: hidden;
}
.jb-preview-fullscreen {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: white;
}
.jb-preview-fullscreen iframe,
.jb-preview-fullscreen img {
    max-height: 100vh !important;
}
.jb-doc-item.active {
    background-color: #e7f1ff;
    border-left-color: #0d6efd !important;
}
.jb-doc-item:hover:not(.active) {
    background-color: #f8f9fa;
}
[data-region="documents-list"] {
    scrollbar-width: thin;
}
[data-region="documents-list"]::-webkit-scrollbar {
    width: 6px;
}
[data-region="documents-list"]::-webkit-scrollbar-thumb {
    background-color: #dee2e6;
    border-radius: 3px;
}
</style>
