{{!
    @template local_jobboard/pages/program_reviewers

    Program reviewers management page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle - Page title string
    * islistview - Boolean if showing programs list
    * isprogramview - Boolean if showing single program
    * program - Current program data (when isprogramview)
    * stats - Statistics data (when islistview)
    * programswithreviewers - Programs with assigned reviewers
    * allcategories - All course categories for selection
    * reviewers - Assigned reviewers for program
    * hasreviewers - Boolean if has reviewers
    * availableusers - Users available for assignment
    * hasavailableusers - Boolean if has available users
    * dashboardurl - URL to dashboard
    * backurl - URL to go back
    * loading - bool - Show skeleton loading state

    Example context (json):
    {
        "islistview": true,
        "stats": {"total": 5, "active": 4}
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-program-reviewers" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between mb-4">
        <div class="jb-skeleton-title" style="width: 200px;"></div>
        <div class="jb-skeleton-text" style="width: 100px; height: 38px;"></div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-lg-3 col-md-6 mb-3"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
    </div>
    <div class="jb-skeleton-text mb-4" style="height: 250px;"></div>
    <div class="jb-skeleton-text" style="height: 200px;"></div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-program-reviewers" data-region="jobboard-program-reviewers">
    {{! Skip Link for Accessibility }}
    <a href="#program-reviewers-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h1 class="fs-3 mb-0">
            <i class="fa fa-user-check text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h1>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-{{backicon}} me-2" aria-hidden="true"></i>
            {{backlabel}}
        </a>
    </header>

    <main id="program-reviewers-content">
        {{#islistview}}
        {{! ================================================================== }}
        {{! LIST VIEW - Programs Overview }}
        {{! ================================================================== }}

        {{! Statistics Cards }}
        <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.05s;">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-users fa-2x text-primary mb-2" aria-hidden="true"></i>
                        <div class="fs-3 fw-bold text-dark">{{stats.totalreviewers}}</div>
                        <div class="small text-muted">{{#str}}totalreviewers, local_jobboard{{/str}}</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-circle-check fa-2x text-success mb-2" aria-hidden="true"></i>
                        <div class="fs-3 fw-bold text-dark">{{stats.active}}</div>
                        <div class="small text-muted">{{#str}}activereviewers, local_jobboard{{/str}}</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.15s;">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-star fa-2x text-warning mb-2" aria-hidden="true"></i>
                        <div class="fs-3 fw-bold text-dark">{{stats.leadreviewers}}</div>
                        <div class="small text-muted">{{#str}}leadreviewers, local_jobboard{{/str}}</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm h-100 jb-fade-in-up" style="animation-delay: 0.2s;">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-graduation-cap fa-2x text-info mb-2" aria-hidden="true"></i>
                        <div class="fs-3 fw-bold text-dark">{{stats.programswithreviewers}}</div>
                        <div class="small text-muted">{{#str}}programswithreviewers, local_jobboard{{/str}}</div>
                    </div>
                </div>
            </div>
        </section>

        {{! Programs with Reviewers Table }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.25s;" aria-labelledby="programs-heading">
            <div class="card-header bg-white d-flex align-items-center">
                <i class="fa fa-graduation-cap fa-lg text-primary me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="programs-heading">
                    {{#str}}programswithreviewers, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body p-0">
                {{#hasprogramswithreviewers}}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">{{#str}}program, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center">{{#str}}reviewers, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center">{{#str}}leadreviewers, local_jobboard{{/str}}</th>
                                <th scope="col" class="text-center">{{#str}}actions{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#programswithreviewers}}
                            <tr class="jb-fade-in" style="animation-delay: calc(0.3s + {{@index}} * 0.03s);">
                                <td>
                                    <i class="fa fa-folder text-warning me-2" aria-hidden="true"></i>
                                    {{name}}
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">{{reviewercount}}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark">{{leadcount}}</span>
                                </td>
                                <td class="text-center">
                                    <a href="{{manageurl}}" class="btn btn-sm btn-primary jb-hover-lift">
                                        <i class="fa fa-users me-1" aria-hidden="true"></i>
                                        {{#str}}manage{{/str}}
                                    </a>
                                </td>
                            </tr>
                            {{/programswithreviewers}}
                        </tbody>
                    </table>
                </div>
                {{/hasprogramswithreviewers}}
                {{^hasprogramswithreviewers}}
                <div class="text-center py-5" role="status">
                    <i class="fa fa-graduation-cap fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
                    <p class="text-muted mb-0">{{#str}}noprogramswithreviewers, local_jobboard{{/str}}</p>
                </div>
                {{/hasprogramswithreviewers}}
            </div>
        </section>

        {{! All Categories List }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.3s;" aria-labelledby="addreviewers-heading">
            <div class="card-header bg-white d-flex align-items-center">
                <i class="fa fa-circle-plus fa-lg text-secondary me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="addreviewers-heading">
                    {{#str}}addreviewerstoprogram, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body p-0">
                {{#hasallcategories}}
                <ul class="list-group list-group-flush">
                    {{#allcategories}}
                    <li class="list-group-item list-group-item-action jb-fade-in" style="animation-delay: calc(0.35s + {{@index}} * 0.02s);">
                        <a href="{{selecturl}}" class="d-flex justify-content-between align-items-center text-decoration-none text-dark">
                            <span>
                                {{{indent}}}
                                <i class="fa fa-{{icon}} me-2" aria-hidden="true"></i>
                                {{name}}
                            </span>
                            {{#hasreviewers}}
                            <span class="badge bg-success">{{reviewercount}}</span>
                            {{/hasreviewers}}
                        </a>
                    </li>
                    {{/allcategories}}
                </ul>
                {{/hasallcategories}}
            </div>
        </section>
        {{/islistview}}

        {{#isprogramview}}
        {{! ================================================================== }}
        {{! PROGRAM VIEW - Single Program Reviewers }}
        {{! ================================================================== }}

        {{! Add Reviewer Form }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.05s;" aria-labelledby="add-reviewer-heading">
            <div class="card-header bg-white d-flex align-items-center">
                <i class="fa fa-user-plus fa-lg text-success me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="add-reviewer-heading">
                    {{#str}}addreviewer, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body">
                {{#hasavailableusers}}
                <form method="post" action="{{addformurl}}" class="jb-form-inline d-flex flex-wrap align-items-end">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="add">
                    <input type="hidden" name="categoryid" value="{{program.id}}">

                    <div class="mb-3 me-3 mb-2">
                        <label class="visually-hidden" for="userid">{{#str}}selectuser, local_jobboard{{/str}}</label>
                        <select name="userid" id="userid" class="form-control">
                            <option value="">{{#str}}selectuser, local_jobboard{{/str}}</option>
                            {{#availableusers}}
                            <option value="{{id}}">{{fullname}} ({{email}})</option>
                            {{/availableusers}}
                        </select>
                    </div>

                    <div class="mb-3 me-3 mb-2">
                        <label class="visually-hidden" for="role">{{#str}}role{{/str}}</label>
                        <select name="role" id="role" class="form-control">
                            <option value="reviewer">{{#str}}role_reviewer, local_jobboard{{/str}}</option>
                            <option value="lead">{{#str}}role_lead_reviewer, local_jobboard{{/str}}</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success mb-2 jb-hover-lift">
                        <i class="fa fa-plus me-1" aria-hidden="true"></i>
                        {{#str}}add{{/str}}
                    </button>
                </form>
                {{/hasavailableusers}}
                {{^hasavailableusers}}
                <div class="alert alert-info mb-0">
                    <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
                    {{#str}}nousersavailable, local_jobboard{{/str}}
                </div>
                {{/hasavailableusers}}
            </div>
        </section>

        {{! Current Reviewers Table }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="reviewers-heading">
            <div class="card-header bg-white d-flex align-items-center">
                <i class="fa fa-users fa-lg text-primary me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="reviewers-heading">
                    {{#str}}assignedreviewers, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body p-0">
                {{#hasreviewers}}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">{{#str}}user{{/str}}</th>
                                <th scope="col">{{#str}}email{{/str}}</th>
                                <th scope="col">{{#str}}role{{/str}}</th>
                                <th scope="col">{{#str}}status{{/str}}</th>
                                <th scope="col" class="text-center">{{#str}}actions{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#reviewers}}
                            <tr class="{{#isinactive}}bg-light{{/isinactive}} jb-fade-in" style="animation-delay: calc(0.15s + {{@index}} * 0.03s);">
                                <td>
                                    <strong>{{fullname}}</strong>
                                </td>
                                <td class="text-muted">{{email}}</td>
                                <td>
                                    {{#islead}}
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-star me-1" aria-hidden="true"></i>
                                        {{#str}}role_lead_reviewer, local_jobboard{{/str}}
                                    </span>
                                    {{/islead}}
                                    {{^islead}}
                                    <span class="badge bg-info text-dark">{{#str}}role_reviewer, local_jobboard{{/str}}</span>
                                    {{/islead}}
                                </td>
                                <td>
                                    {{#isactive}}
                                    <span class="badge bg-success">{{#str}}active{{/str}}</span>
                                    {{/isactive}}
                                    {{^isactive}}
                                    <span class="badge bg-secondary">{{#str}}inactive, local_jobboard{{/str}}</span>
                                    {{/isactive}}
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a href="{{changeroleurl}}" class="btn btn-sm btn-outline-info"
                                           title="{{#str}}changerole, local_jobboard{{/str}}">
                                            <i class="fa fa-right-left" aria-hidden="true"></i>
                                        </a>
                                        <a href="{{togglestatusurl}}" class="btn btn-sm btn-outline-secondary"
                                           title="{{togglestatustitle}}">
                                            <i class="fa {{togglestatusicon}}" aria-hidden="true"></i>
                                        </a>
                                        <a href="{{removeurl}}" class="btn btn-sm btn-outline-danger"
                                           title="{{#str}}remove{{/str}}"
                                           onclick="return confirm('{{#str}}confirmremovereviewer, local_jobboard{{/str}}');">
                                            <i class="fa fa-trash-can" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {{/reviewers}}
                        </tbody>
                    </table>
                </div>
                {{/hasreviewers}}
                {{^hasreviewers}}
                <div class="text-center py-5" role="status">
                    <i class="fa fa-user-plus fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
                    <p class="text-muted mb-0">{{#str}}noreviewersforprogram, local_jobboard{{/str}}</p>
                </div>
                {{/hasreviewers}}
            </div>
        </section>
        {{/isprogramview}}
    </main>

    {{! Help Section }}
    <aside class="card shadow-sm bg-light mb-4 jb-fade-in" style="animation-delay: 0.35s;" aria-labelledby="help-heading">
        <div class="card-body">
            <h6 class="mb-3" id="help-heading">
                <i class="fa fa-circle-info text-info me-2" aria-hidden="true"></i>
                {{#str}}help{{/str}}
            </h6>
            <p class="text-muted mb-0">{{#str}}programreviewerhelp, local_jobboard{{/str}}</p>
        </div>
    </aside>
</div>
{{/loading}}
