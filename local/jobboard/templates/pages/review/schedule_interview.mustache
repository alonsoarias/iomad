{{!
    @template local_jobboard/pages/schedule_interview

    Interview scheduling page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle - Page title string
    * applicant - Applicant data (fullname, email)
    * vacancy - Vacancy data (code, title)
    * application - Application data (id, status, statustext)
    * interviews - Existing interviews list
    * hasinterviews - Boolean if has interviews
    * formhtml - Rendered moodle form HTML
    * backurl - URL to go back
    * loading - bool - Show skeleton loading state

    Example context (json):
    {
        "applicant": {"fullname": "John Doe", "email": "john@example.com"}
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-schedule-interview" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton-title mb-4" style="width: 250px;"></div>
    <div class="card mb-4">
        <div class="card-header"><div class="jb-skeleton-text" style="width: 150px;"></div></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6"><div class="jb-skeleton-text" style="height: 80px;"></div></div>
                <div class="col-md-6"><div class="jb-skeleton-text" style="height: 80px;"></div></div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><div class="jb-skeleton-text" style="width: 200px;"></div></div>
        <div class="card-body"><div class="jb-skeleton-text" style="height: 200px;"></div></div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-schedule-interview" data-region="jobboard-schedule-interview">
    {{! Skip Link for Accessibility }}
    <a href="#interview-form-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h1 class="fs-3 mb-0">
            <i class="fa fa-calendar-plus text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h1>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}back, local_jobboard{{/str}}
        </a>
    </header>

    {{! Applicant Info Card }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.05s;" aria-labelledby="applicant-heading">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-user fa-lg text-info me-3" aria-hidden="true"></i>
            <h5 class="mb-0" id="applicant-heading">
                {{#str}}applicantinfo, local_jobboard{{/str}}
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="d-flex align-items-start">
                        <i class="fa fa-user fa-lg text-info me-3 mt-1" aria-hidden="true"></i>
                        <div>
                            <h6 class="mb-1">{{applicant.fullname}}</h6>
                            <a href="mailto:{{applicant.email}}" class="text-muted small">
                                <i class="fa fa-envelope me-1" aria-hidden="true"></i>
                                {{applicant.email}}
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-start">
                        <i class="fa fa-briefcase fa-lg text-primary me-3 mt-1" aria-hidden="true"></i>
                        <div>
                            <h6 class="mb-1">{{vacancy.code}} - {{vacancy.title}}</h6>
                            <span class="badge bg-primary">{{application.statustext}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{! Existing Interviews }}
    {{#hasinterviews}}
    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="interviews-heading">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fa fa-calendar-check fa-lg text-success me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="interviews-heading">
                    {{#str}}scheduledinterviews, local_jobboard{{/str}}
                </h5>
            </div>
            <span class="badge bg-success">{{interviewcount}}</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" aria-describedby="interviews-heading">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">
                                <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                {{#str}}dateandtime, local_jobboard{{/str}}
                            </th>
                            <th scope="col">{{#str}}type{{/str}}</th>
                            <th scope="col">{{#str}}location{{/str}}</th>
                            <th scope="col" class="text-center">{{#str}}status{{/str}}</th>
                            <th scope="col" class="text-center">{{#str}}result, local_jobboard{{/str}}</th>
                            <th scope="col" class="text-center">{{#str}}actions{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#interviews}}
                        <tr class="jb-fade-in" style="animation-delay: calc(0.15s + {{@index}} * 0.05s);">
                            <td>
                                <strong>{{datetime}}</strong>
                                <br>
                                <small class="text-muted">
                                    <i class="fa fa-hourglass-half me-1" aria-hidden="true"></i>
                                    {{duration}} {{#str}}minutes{{/str}}
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">{{typename}}</span>
                            </td>
                            <td>
                                <i class="fa fa-location-dot text-muted me-1" aria-hidden="true"></i>
                                {{location}}
                            </td>
                            <td class="text-center">
                                <span class="badge jb-badge-{{statuscolor}}">{{statustext}}</span>
                            </td>
                            <td class="text-center">
                                {{#hasresult}}
                                <span class="badge jb-badge-{{resultcolor}}">{{resulttext}}</span>
                                <br>
                                <small class="text-muted">
                                    <i class="fa fa-star text-warning me-1" aria-hidden="true"></i>
                                    {{rating}}/5
                                </small>
                                {{/hasresult}}
                                {{^hasresult}}
                                <span class="text-muted">-</span>
                                {{/hasresult}}
                            </td>
                            <td class="text-center">
                                {{#canact}}
                                <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}actions{{/str}}">
                                    <a href="{{completeurl}}" class="btn btn-success jb-btn-success" title="{{#str}}complete{{/str}}">
                                        <i class="fa fa-check" aria-hidden="true"></i>
                                    </a>
                                    <a href="{{noshowurl}}" class="btn btn-warning jb-btn-warning"
                                       title="{{#str}}noshow, local_jobboard{{/str}}"
                                       onclick="return confirm('{{#str}}confirmnoshow, local_jobboard{{/str}}')">
                                        <i class="fa fa-user-xmark" aria-hidden="true"></i>
                                    </a>
                                    <a href="{{cancelurl}}" class="btn btn-danger jb-btn-danger"
                                       title="{{#str}}cancel{{/str}}"
                                       onclick="return confirm('{{#str}}confirmcancel, local_jobboard{{/str}}')">
                                        <i class="fa fa-xmark" aria-hidden="true"></i>
                                    </a>
                                </div>
                                {{/canact}}
                                {{^canact}}
                                <span class="text-muted">-</span>
                                {{/canact}}
                            </td>
                        </tr>
                        {{/interviews}}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    {{/hasinterviews}}

    {{! New Interview Form }}
    <main id="interview-form-content">
        <section class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="newinterview-heading">
            <div class="card-header bg-white d-flex align-items-center">
                <i class="fa fa-circle-plus fa-lg text-primary me-3" aria-hidden="true"></i>
                <h5 class="mb-0" id="newinterview-heading">
                    {{#str}}schedulenewinterview, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </section>
    </main>

    {{! Help Tips }}
    <aside class="mt-4 jb-fade-in" style="animation-delay: 0.2s;">
        <div class="alert jb-alert-light d-flex align-items-start">
            <i class="fa fa-lightbulb text-warning me-3 mt-1" aria-hidden="true"></i>
            <div>
                <strong class="d-block mb-1">{{#str}}interviewtips, local_jobboard{{/str}}</strong>
                <p class="mb-0 small text-muted">{{#str}}interviewtipsdesc, local_jobboard{{/str}}</p>
            </div>
        </div>
    </aside>
</div>
{{/loading}}
