{{!
    @template local_jobboard/pages/review/assign_reviewer

    Assign reviewer to applications page template.
    Simplified design following apply.mustache pattern.

    Context variables:
    * pagetitle - Page title string
    * stats - Statistics object (unassigned, reviewers, assigned, avgworkload)
    * vacancies - Vacancies for filter dropdown
    * selectedvacancyid - Currently selected vacancy ID
    * reviewers - Available reviewers with workload
    * hasreviewers - Boolean if has reviewers
    * unassigned - Unassigned applications list
    * hasunassigned - Boolean if has unassigned
    * filterformurl - URL for filter form
    * actionformurl - URL for action form
    * dashboardurl - URL to dashboard
    * reviewurl - URL to review applications
    * bulkvalidateurl - URL to bulk validation
    * sesskey - Session key

    Example context (json):
    {
        "pagetitle": "Assign Reviewer",
        "stats": {"unassigned": 10, "reviewers": 5, "assigned": 25, "avgworkload": 5.0}
    }
}}
<div class="jb-assign-reviewer" data-region="jobboard-assign-reviewer">
    {{! Quick Actions Bar }}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div class="btn-group btn-group-sm">
            <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-gauge me-1" aria-hidden="true"></i>
                {{#str}}dashboard, local_jobboard{{/str}}
            </a>
            <a href="{{reviewurl}}" class="btn btn-outline-primary">
                <i class="fa fa-clipboard-check me-1" aria-hidden="true"></i>
                {{#str}}reviewapplications, local_jobboard{{/str}}
            </a>
        </div>
    </div>

    {{! Statistics Cards }}
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-2">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="h3 text-warning mb-0">{{stats.unassigned}}</div>
                    <small class="text-muted">{{#str}}unassignedapplications, local_jobboard{{/str}}</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-2">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="h3 text-primary mb-0">{{stats.reviewers}}</div>
                    <small class="text-muted">{{#str}}availablereviewers, local_jobboard{{/str}}</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-2">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="h3 text-success mb-0">{{stats.assigned}}</div>
                    <small class="text-muted">{{#str}}totalassigned, local_jobboard{{/str}}</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-2">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="h3 text-info mb-0">{{stats.avgworkload}}</div>
                    <small class="text-muted">{{#str}}avgworkload, local_jobboard{{/str}}</small>
                </div>
            </div>
        </div>
    </div>

    {{! Vacancy Filter }}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0"><i class="fa fa-filter me-2 text-muted"></i>{{#str}}filter{{/str}}</h6>
        </div>
        <div class="card-body py-3">
            <form method="get" action="{{filterformurl}}" class="d-flex flex-wrap align-items-center gap-2">
                <select name="vacancyid" id="vacancyid" class="form-select form-select-sm" style="max-width: 300px;">
                    <option value="0">{{#str}}allvacancies, local_jobboard{{/str}}</option>
                    {{#vacancies}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/vacancies}}
                </select>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-filter me-1" aria-hidden="true"></i>
                    {{#str}}filter{{/str}}
                </button>
            </form>
        </div>
    </div>

    {{! Reviewer Workload Summary }}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fa fa-users me-2 text-muted"></i>{{#str}}reviewerworkload, local_jobboard{{/str}}</h6>
            <span class="badge bg-secondary">{{stats.reviewers}} {{#str}}reviewers, local_jobboard{{/str}}</span>
        </div>
        <div class="card-body py-3">
            {{#hasreviewers}}
            <div class="row">
                {{#reviewers}}
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="card h-100 border-start border-{{workloadcolor}} border-3">
                        <div class="card-body py-2">
                            <h6 class="mb-1">
                                <i class="fa fa-user text-muted me-2" aria-hidden="true"></i>
                                {{fullname}}
                            </h6>
                            <span class="badge bg-{{workloadcolor}} mb-2">
                                {{workload}} {{#str}}activeassignments, local_jobboard{{/str}}
                            </span>
                            {{#hasstats}}
                            <div class="small text-muted">
                                <i class="fa fa-check me-1" aria-hidden="true"></i>
                                {{#str}}reviewed, local_jobboard{{/str}}: <strong>{{stats.reviewed}}</strong>
                                <span class="mx-2">|</span>
                                <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                {{#str}}avgtime, local_jobboard{{/str}}: <strong>{{stats.avgtime}}h</strong>
                            </div>
                            {{/hasstats}}
                        </div>
                    </div>
                </div>
                {{/reviewers}}
            </div>
            {{/hasreviewers}}
            {{^hasreviewers}}
            <div class="text-center py-4">
                <i class="fa fa-users fa-3x text-muted mb-3" aria-hidden="true"></i>
                <p class="text-muted mb-0">{{#str}}noreviewers, local_jobboard{{/str}}</p>
            </div>
            {{/hasreviewers}}
        </div>
    </div>

    {{! Auto-Assign Section }}
    <div class="card shadow-sm mb-4 border-info">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0">
                <i class="fa fa-wand-magic-sparkles me-2 text-info" aria-hidden="true"></i>
                {{#str}}autoassign, local_jobboard{{/str}}
            </h6>
        </div>
        <div class="card-body py-3">
            <form method="post" action="{{actionformurl}}" class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="autoassign">
                <input type="hidden" name="vacancyid" value="{{selectedvacancyid}}">
                <label for="maxperreviewer" class="form-label mb-0 small">{{#str}}maxperreviewer, local_jobboard{{/str}}</label>
                <input type="number" name="maxperreviewer" id="maxperreviewer" value="20"
                       min="1" max="100" class="form-control form-control-sm" style="width: 80px;">
                <button type="submit" class="btn btn-info btn-sm">
                    <i class="fa fa-wand-magic-sparkles me-1" aria-hidden="true"></i>
                    {{#str}}autoassignall, local_jobboard{{/str}}
                </button>
            </form>
            <small class="text-muted mt-2 d-block">
                <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
                {{#str}}autoassignhelp, local_jobboard{{/str}}
            </small>
        </div>
    </div>

    {{! Manual Assignment Section }}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fa fa-hand-pointer me-2 text-muted"></i>{{#str}}manualassign, local_jobboard{{/str}}</h6>
            <span class="badge bg-warning text-dark">{{stats.unassigned}} {{#str}}pendingassignment, local_jobboard{{/str}}</span>
        </div>
        <div class="card-body py-3">
            {{#hasunassigned}}
            <form method="post" action="{{actionformurl}}" id="manual-assign-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="assign">
                <input type="hidden" name="vacancyid" value="{{selectedvacancyid}}">

                {{! Reviewer Selection }}
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label for="reviewerid" class="form-label small fw-bold">
                            <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                            {{#str}}assignto, local_jobboard{{/str}}
                        </label>
                        <select name="reviewerid" id="reviewerid" class="form-select form-select-sm" required>
                            <option value="">{{#str}}selectreviewer, local_jobboard{{/str}}</option>
                            {{#reviewers}}
                            <option value="{{id}}">{{fullname}} ({{workload}} {{#str}}assigned, local_jobboard{{/str}}){{workloadindicator}}</option>
                            {{/reviewers}}
                        </select>
                    </div>
                </div>

                {{! Select All Checkbox }}
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="selectallapp">
                    <label class="form-check-label fw-bold" for="selectallapp">{{#str}}selectall{{/str}}</label>
                </div>

                {{! Applications Table }}
                <div class="table-responsive">
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 40px;"></th>
                                <th scope="col">{{#str}}applicant, local_jobboard{{/str}}</th>
                                <th scope="col">{{#str}}vacancy, local_jobboard{{/str}}</th>
                                <th scope="col">{{#str}}status{{/str}}</th>
                                <th scope="col">{{#str}}dateapplied, local_jobboard{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#unassigned}}
                            <tr>
                                <td>
                                    <input type="checkbox" name="applications[]" value="{{id}}" class="form-check-input app-checkbox">
                                </td>
                                <td><strong>{{applicantname}}</strong></td>
                                <td><code class="text-primary small">{{vacancycode}}</code></td>
                                <td><span class="badge bg-{{statuscolor}}">{{statustext}}</span></td>
                                <td class="text-muted small">{{dateapplied}}</td>
                            </tr>
                            {{/unassigned}}
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                        {{#str}}assignselected, local_jobboard{{/str}}
                    </button>
                </div>
            </form>
            {{/hasunassigned}}
            {{^hasunassigned}}
            <div class="text-center py-4">
                <i class="fa fa-circle-check fa-3x text-success mb-3" aria-hidden="true"></i>
                <h6 class="text-success mb-2">{{#str}}alldone, local_jobboard{{/str}}</h6>
                <p class="text-muted mb-0">{{#str}}nounassignedapplications, local_jobboard{{/str}}</p>
            </div>
            {{/hasunassigned}}
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}

{{! JavaScript for select all }}
{{#hasunassigned}}
{{#js}}
(function() {
    var selectAll = document.getElementById('selectallapp');
    if (selectAll) {
        selectAll.addEventListener('change', function() {
            var checkboxes = document.querySelectorAll('.app-checkbox');
            var checked = this.checked;
            checkboxes.forEach(function(cb) {
                cb.checked = checked;
            });
        });
    }
})();
{{/js}}
{{/hasunassigned}}
