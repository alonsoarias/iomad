{{!
    @template local_jobboard/pages/convocatorias/list

    Convocatorias management list page.
    Simplified design following apply.mustache pattern.

    Context variables:
    * dashboardurl - URL to dashboard
    * createurl - URL to create new convocatoria
    * importurl - URL to import vacancies
    * cancreate - Boolean if can create
    * helptext - Help text message
    * stats - Statistics cards array
    * filterform - Filter form data
    * showinginfo - Showing X-Y of Z text
    * hasconvocatorias - Boolean
    * convocatorias - Array of convocatoria data
    * pagination - Pagination HTML

    Example context (json):
    {
        "hasconvocatorias": true,
        "convocatorias": [{"id": 1, "name": "Call 2025", "code": "CONV-2025-001"}]
    }
}}
<div class="jb-convocatorias-list" data-region="jobboard-convocatorias">
    {{! Page Header }}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div class="btn-group">
            <a href="{{importurl}}" class="btn btn-outline-secondary jb-btn-outline-secondary">
                <i class="fa fa-file-csv me-1" aria-hidden="true"></i>
                {{#str}}importvacancies, local_jobboard{{/str}}
            </a>
            {{#cancreate}}
            <a href="{{createurl}}" class="btn btn-primary jb-btn-primary jb-hover-lift">
                <i class="fa fa-plus me-1" aria-hidden="true"></i>
                {{#str}}addconvocatoria, local_jobboard{{/str}}
            </a>
            {{/cancreate}}
        </div>
    </div>

    {{! Statistics Row }}
    {{#stats.0}}
    <div class="row mb-4">
        {{#stats}}
        <div class="col-lg-3 col-md-6 mb-2">
            <div class="card shadow-sm h-100 jb-stat-card jb-card-accent-{{color}}">
                <div class="card-body text-center py-3">
                    <div class="h3 text-{{color}} mb-0 jb-stat-value">{{value}}</div>
                    <small class="text-muted jb-stat-label">{{label}}</small>
                </div>
            </div>
        </div>
        {{/stats}}
    </div>
    {{/stats.0}}

    {{! Filter Form }}
    {{#filterform}}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0"><i class="fa fa-filter me-2 text-muted"></i>{{#str}}filterconvocatorias, local_jobboard{{/str}}</h6>
        </div>
        <div class="card-body py-3">
            <form method="get" action="{{filterform.action}}" class="jb-filter-form">
                {{#filterform.hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/filterform.hiddenfields}}
                <div class="row align-items-end">
                    {{#filterform.fields}}
                    <div class="{{col}} mb-2">
                        {{#isselect}}
                        <label for="filter-{{name}}" class="form-label small text-muted mb-1">{{label}}</label>
                        <select name="{{name}}" id="filter-{{name}}" class="form-select form-select-sm">
                            {{#options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                        {{/isselect}}
                        {{#istext}}
                        <label for="filter-{{name}}" class="form-label small text-muted mb-1">{{label}}</label>
                        <input type="text" name="{{name}}" id="filter-{{name}}" class="form-control form-control-sm" value="{{value}}" placeholder="{{placeholder}}">
                        {{/istext}}
                    </div>
                    {{/filterform.fields}}
                    <div class="col-auto mb-2">
                        <button type="submit" class="btn btn-primary btn-sm jb-btn-primary">
                            <i class="fa fa-search me-1" aria-hidden="true"></i>
                            {{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! Results Info }}
    {{#showinginfo}}
    <p class="text-muted small mb-3">
        <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
        {{showinginfo}}
    </p>
    {{/showinginfo}}

    {{! Convocatorias List }}
    {{#hasconvocatorias}}
    <div class="row">
        {{#convocatorias}}
        <div class="col-lg-6 mb-4">
            <div class="card h-100 shadow-sm" data-convocatoria-id="{{id}}">
                {{! Card Header }}
                <div class="card-header bg-{{statuscolor}} text-white py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <code class="badge bg-light text-dark">{{code}}</code>
                            <span class="fw-bold small">{{statuslabel}}</span>
                        </div>
                        {{#isending}}
                        <span class="badge bg-warning text-dark">
                            <i class="fa fa-clock me-1" aria-hidden="true"></i>
                            {{daysremaining}} {{#str}}days, local_jobboard{{/str}}
                        </span>
                        {{/isending}}
                    </div>
                </div>

                {{! Card Body }}
                <div class="card-body">
                    <h6 class="card-title mb-2">
                        <a href="{{editurl}}" class="text-decoration-none text-dark">{{name}}</a>
                    </h6>

                    {{#description}}
                    <p class="text-muted small mb-3">{{{description}}}</p>
                    {{/description}}

                    {{! Dates }}
                    <div class="row mb-3 small">
                        <div class="col-6">
                            <span class="text-muted">{{#str}}startdate, local_jobboard{{/str}}:</span>
                            <span class="ms-1">{{startdateformatted}}</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted">{{#str}}enddate, local_jobboard{{/str}}:</span>
                            <span class="ms-1 {{#isending}}text-warning fw-bold{{/isending}}">{{enddateformatted}}</span>
                        </div>
                    </div>

                    {{! Stats Row }}
                    <div class="d-flex justify-content-around text-center py-2 bg-light rounded small">
                        <div>
                            <div class="fw-bold text-primary">{{vacancycount}}</div>
                            <div class="text-muted">{{#str}}vacancies, local_jobboard{{/str}}</div>
                        </div>
                        <div class="border-start border-end px-3">
                            <div class="fw-bold text-info">{{applicationcount}}</div>
                            <div class="text-muted">{{#str}}applications, local_jobboard{{/str}}</div>
                        </div>
                        <div>
                            <div class="fw-bold text-success">{{selectedcount}}</div>
                            <div class="text-muted">{{#str}}appstatus:selected, local_jobboard{{/str}}</div>
                        </div>
                    </div>
                </div>

                {{! Card Footer }}
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        {{! Quick Actions }}
                        <div class="btn-group btn-group-sm">
                            <a href="{{editurl}}" class="btn btn-outline-primary jb-btn-outline-primary" title="{{#str}}edit{{/str}}">
                                <i class="fa fa-pen-to-square" aria-hidden="true"></i>
                            </a>
                            {{#isdraft}}
                            <a href="{{addvacancyurl}}" class="btn btn-outline-success jb-btn-outline-success" title="{{#str}}addvacancy, local_jobboard{{/str}}">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                            </a>
                            {{/isdraft}}
                            {{#hasvacancies}}
                            <a href="{{vacanciesurl}}" class="btn btn-outline-info jb-btn-outline-info" title="{{#str}}viewvacancies, local_jobboard{{/str}}">
                                <i class="fa fa-briefcase" aria-hidden="true"></i>
                                <span class="badge bg-info text-dark ms-1">{{vacancycount}}</span>
                            </a>
                            {{/hasvacancies}}
                        </div>

                        {{! Status Actions - Direct buttons }}
                        {{#hasstatusactions}}
                        <div class="btn-group btn-group-sm">
                            {{#statusactions}}
                            <a href="{{url}}" class="btn {{#isdanger}}btn-outline-danger{{/isdanger}}{{^isdanger}}btn-outline-secondary{{/isdanger}}" title="{{label}}" {{#confirm}}onclick="return confirm('{{confirm}}');"{{/confirm}}>
                                <i class="fa fa-{{icon}}" aria-hidden="true"></i>
                                <span class="d-none d-xl-inline ms-1">{{label}}</span>
                            </a>
                            {{/statusactions}}
                        </div>
                        {{/hasstatusactions}}
                    </div>
                </div>
            </div>
        </div>
        {{/convocatorias}}
    </div>
    {{/hasconvocatorias}}

    {{! Empty State }}
    {{^hasconvocatorias}}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <div class="jb-empty-state">
                <i class="fa fa-folder-open jb-empty-state-icon" aria-hidden="true"></i>
                <h5 class="jb-empty-state-title">{{#str}}noconvocatorias, local_jobboard{{/str}}</h5>
                <p class="jb-empty-state-description">{{#str}}noconvocatoriasdesc, local_jobboard{{/str}}</p>
                {{#cancreate}}
                <div class="jb-empty-state-actions">
                    <a href="{{createurl}}" class="btn btn-primary jb-btn-primary">
                        <i class="fa fa-plus me-2" aria-hidden="true"></i>
                        {{#str}}addconvocatoria, local_jobboard{{/str}}
                    </a>
                </div>
                {{/cancreate}}
            </div>
        </div>
    </div>
    {{/hasconvocatorias}}

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-4 d-flex justify-content-center">
        {{{pagination}}}
    </nav>
    {{/pagination}}
</div>

{{! Styles consolidated in styles.css }}
