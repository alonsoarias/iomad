{{!
    @template local_jobboard/pages/convocatorias/browse

    Browse convocatorias page template.
    Simplified design following apply.mustache pattern.

    Context variables:
    * dashboardurl - URL to dashboard
    * vacanciesurl - URL to vacancies list
    * stats - Array of stat cards
    * tabs - Array of filter tabs
    * showinginfo - Showing X-Y of Z text
    * hasconvocatorias - Boolean
    * convocatorias - Array of convocatoria card data
    * pagination - Pagination HTML

    Example context (json):
    {
        "hasconvocatorias": true,
        "convocatorias": [{"id": 1, "name": "2024 Call", "code": "CONV-001"}]
    }
}}
<div class="jb-browse-convocatorias" data-region="jobboard-browse-convocatorias">
    {{! Page Header }}
    <header class="jb-page-header mb-4">
        <h1 class="h4 mb-2">
            <i class="fa fa-folder-open text-primary me-2" aria-hidden="true"></i>
            {{#str}}browseconvocatorias, local_jobboard{{/str}}
        </h1>
        <p class="text-muted mb-0">{{#str}}browseconvocatorias_desc, local_jobboard{{/str}}</p>
    </header>

    {{! Statistics Row }}
    {{#stats.0}}
    <div class="row mb-4">
        {{#stats}}
        <div class="col-lg-3 col-md-6 mb-2">
            <div class="card shadow-sm h-100 jb-stat-card jb-card-accent-{{color}}">
                <div class="card-body text-center py-3">
                    <div class="h3 text-{{color}} mb-0 jb-stat-value">{{value}}</div>
                    <small class="text-muted jb-stat-label">{{label}}</small>
                </div>
            </div>
        </div>
        {{/stats}}
    </div>
    {{/stats.0}}

    {{! Filter Tabs }}
    {{#tabs.0}}
    <ul class="nav nav-tabs mb-4">
        {{#tabs}}
        <li class="nav-item">
            <a href="{{url}}" class="nav-link {{#active}}active{{/active}}">
                {{label}}
                <span class="badge bg-{{color}} ms-1">{{count}}</span>
            </a>
        </li>
        {{/tabs}}
    </ul>
    {{/tabs.0}}

    {{! Results Info }}
    {{#showinginfo}}
    <p class="text-muted small mb-3">
        <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
        {{showinginfo}}
    </p>
    {{/showinginfo}}

    {{! Convocatorias Grid }}
    <div data-region="filter-results">
    {{#hasconvocatorias}}
    <div class="row">
        {{#convocatorias}}
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm {{#isclosingsoon}}border-warning{{/isclosingsoon}}">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <code class="badge {{#isclosingsoon}}bg-warning text-dark{{/isclosingsoon}}{{^isclosingsoon}}{{#isopen}}bg-primary{{/isopen}}{{#isclosed}}bg-secondary{{/isclosed}}{{/isclosingsoon}}">{{code}}</code>
                    {{#isclosingsoon}}
                    <span class="badge bg-danger small">
                        <i class="fa fa-clock me-1" aria-hidden="true"></i>
                        {{daysremaining}} {{#str}}days, local_jobboard{{/str}}
                    </span>
                    {{/isclosingsoon}}
                    {{^isclosingsoon}}
                    {{#isopen}}
                    <span class="badge bg-success small">
                        <i class="fa fa-check-circle me-1" aria-hidden="true"></i>
                        {{#str}}convocatoria_status_open, local_jobboard{{/str}}
                    </span>
                    {{/isopen}}
                    {{#isclosed}}
                    <span class="badge bg-secondary small">
                        {{#str}}convocatoria_status_closed, local_jobboard{{/str}}
                    </span>
                    {{/isclosed}}
                    {{/isclosingsoon}}
                </div>
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title mb-3">
                        <a href="{{viewurl}}" class="text-decoration-none text-dark">{{name}}</a>
                    </h6>
                    {{#description}}
                    <p class="text-muted small mb-3">{{description}}</p>
                    {{/description}}
                    <div class="mt-auto">
                        <div class="small text-muted mb-2">
                            <i class="fa fa-calendar-check text-success me-2" aria-hidden="true"></i>
                            {{startdateformatted}} → {{enddateformatted}}
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa fa-briefcase text-primary me-2" aria-hidden="true"></i>
                            {{#hasvacancies}}
                            <span class="badge bg-primary">{{vacancycount}}</span>
                            <span class="ms-1 small">{{#str}}vacancies, local_jobboard{{/str}}</span>
                            {{/hasvacancies}}
                            {{^hasvacancies}}
                            <span class="text-muted small">{{#str}}novacancies, local_jobboard{{/str}}</span>
                            {{/hasvacancies}}
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    {{#hasvacancies}}
                    {{#isopen}}
                    <a href="{{viewurl}}" class="btn btn-primary jb-btn-primary btn-sm w-100">
                        <i class="fa fa-arrow-right me-2" aria-hidden="true"></i>
                        {{#str}}viewvacancies, local_jobboard{{/str}}
                    </a>
                    {{/isopen}}
                    {{^isopen}}
                    <a href="{{viewurl}}" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="fa fa-eye me-2" aria-hidden="true"></i>
                        {{#str}}viewconvocatoria, local_jobboard{{/str}}
                    </a>
                    {{/isopen}}
                    {{/hasvacancies}}
                    {{^hasvacancies}}
                    <span class="btn btn-outline-secondary btn-sm w-100 disabled">
                        {{#str}}novacancies, local_jobboard{{/str}}
                    </span>
                    {{/hasvacancies}}
                </div>
            </div>
        </div>
        {{/convocatorias}}
    </div>
    {{/hasconvocatorias}}

    {{! Empty State }}
    {{^hasconvocatorias}}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <div class="jb-empty-state">
                <i class="fa fa-calendar-xmark jb-empty-state-icon" aria-hidden="true"></i>
                <h5 class="jb-empty-state-title">{{#str}}noconvocatorias, local_jobboard{{/str}}</h5>
                <p class="jb-empty-state-description">{{#str}}noconvocatorias_desc, local_jobboard{{/str}}</p>
                <div class="jb-empty-state-actions">
                    <a href="{{dashboardurl}}" class="btn btn-primary jb-btn-primary">
                        <i class="fa fa-house me-2" aria-hidden="true"></i>
                        {{#str}}backtodashboard, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/hasconvocatorias}}

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-4 d-flex justify-content-center jb-fade-in" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
        {{{pagination}}}
    </nav>
    {{/pagination}}
    </div>{{! Close filter-results }}

    {{! Navigation Footer }}
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center py-3 border-top jb-fade-in">
                <a href="{{dashboardurl}}" class="btn btn-outline-secondary jb-btn-outline-secondary">
                    <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                    {{#str}}backtodashboard, local_jobboard{{/str}}
                </a>
                <a href="{{vacanciesurl}}" class="btn btn-link text-muted jb-hover-primary">
                    {{#str}}browsevacancies, local_jobboard{{/str}}
                    <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
