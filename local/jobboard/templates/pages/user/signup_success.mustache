{{!
    @template local_jobboard/pages/signup_success

    Signup success confirmation page - Clean minimal design following jb-* pattern

    Context variables:
    * useremail - string - The user's email address
    * backurl - string - URL to return to vacancies
    * loginurl - string - URL to login page
    * str - object - Language strings
}}
<div class="jb-signup-success" id="jobboard-signup-success" data-region="jobboard-signup-success">
    {{! Success Icon }}
    <div class="jb-success-icon">
        <i class="fa fa-circle-check"></i>
    </div>

    {{! Title }}
    <h1 class="jb-success-title">{{str.title}}</h1>

    {{! Message }}
    <p class="jb-success-message">{{str.message}}</p>

    {{! Email Badge }}
    <div class="jb-success-email">
        <span class="jb-badge jb-badge--primary jb-badge--lg">
            <i class="fa fa-envelope"></i>
            {{useremail}}
        </span>
    </div>

    {{! Instructions Card }}
    <div class="jb-card jb-success-instructions">
        <div class="jb-card__header">
            <i class="fa fa-envelope-open-text"></i>
            {{str.instructions_title}}
        </div>
        <div class="jb-card__body">
            <ol class="jb-instruction-list">
                <li class="jb-instruction-list__item">
                    <i class="fa fa-inbox"></i>
                    {{str.instruction_1}}
                </li>
                <li class="jb-instruction-list__item">
                    <i class="fa fa-mouse-pointer"></i>
                    {{str.instruction_2}}
                </li>
                <li class="jb-instruction-list__item">
                    <i class="fa fa-key"></i>
                    {{str.instruction_3}}
                </li>
            </ol>
        </div>
    </div>

    {{! Spam Notice }}
    <div class="jb-alert jb-alert--warning">
        <i class="fa fa-triangle-exclamation jb-alert__icon"></i>
        <span>{{str.check_spam}}</span>
    </div>

    {{! Action Buttons }}
    <div class="jb-success-actions">
        <a href="{{backurl}}" class="jb-btn jb-btn--primary jb-btn--lg">
            <i class="fa fa-briefcase"></i>
            {{str.back_to_vacancies}}
        </a>
        <a href="{{loginurl}}" class="jb-btn jb-btn--outline jb-btn--lg">
            <i class="fa fa-right-to-bracket"></i>
            {{str.login}}
        </a>
    </div>

    {{! Help Section }}
    <div class="jb-success-help">
        <i class="fa fa-circle-question"></i>
        {{#str}}emailnotreceived, local_jobboard{{/str}}
        <a href="{{backurl}}" class="jb-link">{{#str}}contactsupport, local_jobboard{{/str}}</a>
    </div>
</div>

<style>
/* ================================================================
   SIGNUP SUCCESS PAGE - CLEAN MINIMAL DESIGN
   Following jb-* pattern
   ================================================================ */
.jb-signup-success {
    max-width: 600px;
    margin: 2rem auto;
    padding: 2rem 1rem;
    text-align: center;
}

/* Success Icon */
.jb-success-icon {
    margin-bottom: 1.5rem;
}

.jb-success-icon i {
    font-size: 5rem;
    color: #28a745;
    animation: jb-scale-in 0.5s ease-out;
}

@keyframes jb-scale-in {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
}

/* Title */
.jb-success-title {
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    color: var(--iser-negro, #1a1a1a);
}

/* Message */
.jb-success-message {
    font-size: 1rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 1.5rem 0;
}

/* Email Badge */
.jb-success-email {
    margin-bottom: 1.5rem;
}

/* Badges */
.jb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8125rem;
    font-weight: 500;
}

.jb-badge--primary {
    background: var(--iser-verde, #1b9e88);
    color: #fff;
}

.jb-badge--lg {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
}

/* Instructions Card */
.jb-success-instructions {
    text-align: left;
    margin-bottom: 1.5rem;
}

/* Card */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i {
    color: #0d6efd;
}

.jb-card__body {
    padding: 1rem;
}

/* Instruction List */
.jb-instruction-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: instruction;
}

.jb-instruction-list__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.875rem;
    color: var(--iser-gris-oscuro, #333);
    counter-increment: instruction;
}

.jb-instruction-list__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.jb-instruction-list__item i {
    color: #0d6efd;
    flex-shrink: 0;
    margin-top: 0.125rem;
}

/* Alert */
.jb-alert {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
}

.jb-alert--warning {
    background: rgba(255, 193, 7, 0.15);
    border: 1px solid rgba(255, 193, 7, 0.3);
    color: #856404;
}

.jb-alert__icon {
    flex-shrink: 0;
}

/* Action Buttons */
.jb-success-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
}

/* Buttons */
.jb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
}

.jb-btn--lg {
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
}

.jb-btn--primary {
    background: var(--iser-verde, #1b9e88);
    color: #fff;
}

.jb-btn--primary:hover {
    background: var(--iser-verde-dark, #157a6a);
    color: #fff;
}

.jb-btn--outline {
    background: transparent;
    border-color: #d1d5db;
    color: var(--iser-gris-oscuro, #333);
}

.jb-btn--outline:hover {
    border-color: var(--iser-verde, #1b9e88);
    color: var(--iser-verde, #1b9e88);
}

/* Help Section */
.jb-success-help {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    padding-top: 1.5rem;
    border-top: 1px solid #e5e5e5;
}

.jb-success-help i {
    margin-right: 0.25rem;
}

/* Link */
.jb-link {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
}

.jb-link:hover {
    color: var(--iser-verde-dark, #157a6a);
    text-decoration: underline;
}

/* Mobile */
@media (max-width: 600px) {
    .jb-signup-success {
        padding: 1.5rem 1rem;
    }

    .jb-success-icon i {
        font-size: 4rem;
    }

    .jb-success-title {
        font-size: 1.5rem;
    }

    .jb-success-actions {
        flex-direction: column;
    }

    .jb-success-actions .jb-btn {
        width: 100%;
    }
}

/* Print */
@media print {
    .jb-success-actions { display: none; }
    .jb-success-help { display: none; }
}
</style>
