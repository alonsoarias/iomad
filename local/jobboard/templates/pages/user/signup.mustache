{{!
    @template local_jobboard/pages/user/signup

    Signup page template - Clean minimal design following jb-* pattern
    Multi-step registration form with progress indicator

    Context variables:
    * title (string) - Page title
    * intro (string) - Introduction text
    * vacancy (object) - Optional vacancy context {title, code, location}
    * applyingfortext (string) - "Applying for" label
    * codetext (string) - "Code" label
    * alreadyaccounttext (string) - Already have account text
    * loginurl (string) - Login URL
    * logintext (string) - Login button text
    * requiredfieldstext (string) - Required fields notice
    * formhtml (string) - Rendered form HTML
}}
<div class="jb-signup" id="jobboard-signup" data-region="jobboard-signup">
    {{! Skip Link for Accessibility }}
    <a href="#signup-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Header Section }}
    <div class="jb-signup-header">
        <div class="jb-signup-header__icon">
            <i class="fa fa-user-plus"></i>
        </div>
        <h1 class="jb-signup-header__title">{{title}}</h1>
        {{#intro}}
        <p class="jb-signup-header__intro">{{intro}}</p>
        {{/intro}}
    </div>

    {{! Content Layout }}
    <div class="jb-signup-content">
        {{! Main Column }}
        <div class="jb-signup-main">
            {{! Vacancy Info Card }}
            {{#vacancy}}
            <div class="jb-card jb-card--cta">
                <div class="jb-card__header">
                    <i class="fa fa-briefcase"></i>
                    {{applyingfortext}}
                </div>
                <div class="jb-card__body">
                    <h4 class="jb-vacancy-title">{{vacancy.title}}</h4>
                    <div class="jb-vacancy-meta">
                        <span class="jb-vacancy-meta__item">
                            <i class="fa fa-hashtag"></i>
                            <strong>{{vacancy.code}}</strong>
                        </span>
                        {{#vacancy.location}}
                        <span class="jb-vacancy-meta__item">
                            <i class="fa fa-location-dot"></i>
                            {{vacancy.location}}
                        </span>
                        {{/vacancy.location}}
                    </div>
                </div>
            </div>
            {{/vacancy}}

            {{! Already have account alert }}
            <div class="jb-alert jb-alert--info jb-alert--action">
                <div class="jb-alert__main">
                    <i class="fa fa-circle-info jb-alert__icon"></i>
                    <strong>{{alreadyaccounttext}}</strong>
                </div>
                <a href="{{loginurl}}" class="jb-btn jb-btn--primary jb-btn--sm">
                    <i class="fa fa-right-to-bracket"></i>
                    {{logintext}}
                </a>
            </div>

            {{! Required fields notice }}
            <p class="jb-required-notice">
                <span class="jb-required-notice__asterisk">*</span>
                {{requiredfieldstext}}
            </p>

            {{! Progress Steps - Container for JS-generated content }}
            <nav class="jb-progress-steps-container" id="jb-signup-progress" aria-label="{{#str}}signup_progress, local_jobboard{{/str}}">
                {{! JS will populate this with progress steps }}
            </nav>

            {{! Form Card }}
            <main id="signup-main-content">
                <div class="jb-card">
                    <div class="jb-card__body jb-card__body--form">
                        {{{formhtml}}}
                    </div>
                </div>
            </main>

            {{! Help Section }}
            <div class="jb-signup-help">
                <i class="fa fa-circle-question"></i>
                {{#str}}signup_help, local_jobboard{{/str}}
            </div>
        </div>

        {{! Sidebar }}
        <aside class="jb-signup-sidebar">
            {{! Benefits Card }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-star"></i>
                    {{#str}}signup_benefits_title, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--compact">
                    <ul class="jb-benefits">
                        <li class="jb-benefits__item">
                            <i class="fa fa-check-circle"></i>
                            {{#str}}signup_benefit_1, local_jobboard{{/str}}
                        </li>
                        <li class="jb-benefits__item">
                            <i class="fa fa-check-circle"></i>
                            {{#str}}signup_benefit_2, local_jobboard{{/str}}
                        </li>
                        <li class="jb-benefits__item">
                            <i class="fa fa-check-circle"></i>
                            {{#str}}signup_benefit_3, local_jobboard{{/str}}
                        </li>
                        <li class="jb-benefits__item">
                            <i class="fa fa-check-circle"></i>
                            {{#str}}signup_benefit_4, local_jobboard{{/str}}
                        </li>
                    </ul>
                </div>
            </div>

            {{! Security Card }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-shield-halved"></i>
                    {{#str}}signup_security_title, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <p class="jb-security-text">{{#str}}signup_security_text, local_jobboard{{/str}}</p>
                    <div class="jb-security-badges">
                        <span class="jb-security-badge">
                            <i class="fa fa-lock"></i> SSL
                        </span>
                        <span class="jb-security-badge">
                            <i class="fa fa-user-shield"></i> GDPR
                        </span>
                    </div>
                </div>
            </div>

            {{! Login CTA Card }}
            <div class="jb-card jb-card--cta-warning">
                <div class="jb-cta-card">
                    <i class="fa fa-right-to-bracket jb-cta-card__icon jb-cta-card__icon--primary"></i>
                    <h4 class="jb-cta-card__title">{{#str}}alreadyregistered, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}logintosubmit, local_jobboard{{/str}}</p>
                    <a href="{{loginurl}}" class="jb-btn jb-btn--primary jb-btn--block">
                        <i class="fa fa-right-to-bracket"></i> {{logintext}}
                    </a>
                </div>
            </div>
        </aside>
    </div>
</div>

<style>
/* ================================================================
   SIGNUP PAGE - CLEAN MINIMAL DESIGN
   Following jb-* pattern
   ================================================================ */
.jb-signup {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
}

/* Skip Link */
.jb-skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
}

.jb-skip-link:focus {
    position: static;
    width: auto;
    height: auto;
    margin: 0.5rem 0;
    padding: 0.5rem 1rem;
    background: var(--iser-verde, #1b9e88);
    color: #fff;
    text-decoration: none;
    display: inline-block;
    border-radius: 4px;
}

/* Header */
.jb-signup-header {
    text-align: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-signup-header__icon {
    width: 80px;
    height: 80px;
    background: var(--iser-verde, #1b9e88);
    color: #fff;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin-bottom: 1rem;
}

.jb-signup-header__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-signup-header__intro {
    font-size: 0.9375rem;
    color: var(--iser-gris-medio, #666);
    margin: 0;
}

/* Content Layout */
.jb-signup-content {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.5rem;
    align-items: start;
}

.jb-signup-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.jb-signup-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
}

/* Alert */
.jb-alert {
    display: flex;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    align-items: center;
}

.jb-alert--info {
    background: rgba(13, 110, 253, 0.1);
    border: 1px solid rgba(13, 110, 253, 0.2);
}

.jb-alert--action {
    justify-content: space-between;
    flex-wrap: wrap;
}

.jb-alert__main {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-alert__icon {
    font-size: 1.125rem;
    color: #0d6efd;
    flex-shrink: 0;
}

/* Required Notice */
.jb-required-notice {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0;
}

.jb-required-notice__asterisk {
    color: #dc3545;
    font-weight: bold;
}

/* ================================================================
   PROGRESS STEPS - Clean minimal design
   ================================================================ */

/* Outer container (nav element) */
.jb-progress-steps-container {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem 1rem;
    margin-bottom: 1.5rem;
}

/* Inner flex wrapper (JS-generated div) */
.jb-progress-steps-container > .jb-progress-steps {
    display: flex !important;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
}

/* Each step */
.jb-progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

/* Step number circle */
.jb-progress-step-number {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 8px;
    transition: all 0.2s ease;
}

/* Step label */
.jb-progress-step-label {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    max-width: 70px;
}

/* Active step */
.jb-progress-step-active .jb-progress-step-number {
    background: var(--iser-verde, #1b9e88);
    border: 2px solid var(--iser-verde, #1b9e88);
    color: #fff;
}

.jb-progress-step-active .jb-progress-step-label {
    color: var(--iser-verde, #1b9e88);
    font-weight: 600;
}

/* Completed step */
.jb-progress-step-completed .jb-progress-step-number {
    background: #10b981;
    border: 2px solid #10b981;
    color: #fff;
}

.jb-progress-step-completed .jb-progress-step-label {
    color: #10b981;
}

/* Disabled/pending step */
.jb-progress-step-disabled .jb-progress-step-number {
    background: #f3f4f6;
    border: 2px solid #e5e7eb;
    color: #9ca3af;
}

.jb-progress-step-disabled .jb-progress-step-label {
    color: #9ca3af;
}

/* Connector line between steps */
.jb-progress-connector {
    flex: 1;
    height: 2px;
    background: #e5e7eb;
    margin: 22px 8px 0 8px;
    max-width: 60px;
    min-width: 20px;
}

.jb-progress-connector-completed {
    background: #10b981;
}

/* ================================================================
   END PROGRESS STEPS
   ================================================================ */

/* Cards */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.jb-card--cta {
    border-color: var(--iser-verde, #1b9e88);
}

.jb-card--cta-warning {
    border-color: var(--iser-amarillo, #ffc107);
}

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i {
    color: var(--iser-verde, #1b9e88);
}

.jb-card__body {
    padding: 1rem;
}

.jb-card__body--form {
    padding: 1.25rem;
}

.jb-card__body--compact {
    padding: 0;
}

/* Vacancy Info */
.jb-vacancy-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-vacancy-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.jb-vacancy-meta__item {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    display: flex;
    align-items: center;
    gap: 0.375rem;
}

.jb-vacancy-meta__item i {
    color: var(--iser-verde, #1b9e88);
}

/* Benefits List */
.jb-benefits {
    list-style: none;
    margin: 0;
    padding: 0;
}

.jb-benefits__item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.8125rem;
    color: var(--iser-gris-oscuro, #333);
}

.jb-benefits__item:last-child {
    border-bottom: none;
}

.jb-benefits__item i {
    color: #28a745;
    flex-shrink: 0;
    margin-top: 0.125rem;
}

/* Security */
.jb-security-text {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 0.75rem 0;
}

.jb-security-badges {
    display: flex;
    gap: 0.5rem;
}

.jb-security-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: #f0f0f0;
    border-radius: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--iser-gris-medio, #666);
}

.jb-security-badge i {
    color: #28a745;
}

/* CTA Card */
.jb-cta-card {
    padding: 1.25rem;
    text-align: center;
}

.jb-cta-card__icon {
    font-size: 2rem;
    color: var(--iser-verde, #1b9e88);
    margin-bottom: 0.75rem;
}

.jb-cta-card__icon--primary {
    color: var(--iser-verde, #1b9e88);
}

.jb-cta-card__title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.375rem 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-cta-card__text {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 1rem 0;
}

/* Buttons */
.jb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
}

.jb-btn--sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }
.jb-btn--block { width: 100%; }
.jb-btn--primary { background: var(--iser-verde, #1b9e88); color: #fff; }
.jb-btn--primary:hover { background: var(--iser-verde-dark, #157a6a); color: #fff; }

/* Help Section */
.jb-signup-help {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    padding: 1rem 0;
}

.jb-signup-help i {
    margin-right: 0.375rem;
}

/* Form Overrides */
.jb-card__body--form .mform .fitem {
    margin-bottom: 1rem;
}

.jb-card__body--form .mform .form-control,
.jb-card__body--form .mform .custom-select {
    border-color: #d1d5db;
    border-radius: 6px;
    color: #1a1a1a;
}

.jb-card__body--form .mform .form-control:focus,
.jb-card__body--form .mform .custom-select:focus {
    border-color: var(--iser-verde, #1b9e88);
    box-shadow: 0 0 0 2px rgba(27, 158, 136, 0.1);
}

.jb-card__body--form .mform fieldset legend {
    font-size: 1rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
}

/* Mobile */
@media (max-width: 992px) {
    .jb-signup-content {
        grid-template-columns: 1fr;
    }

    .jb-signup-sidebar {
        position: static;
        order: -1;
    }
}

@media (max-width: 600px) {
    .jb-signup-header__title {
        font-size: 1.25rem;
    }

    .jb-signup-header__icon {
        width: 64px;
        height: 64px;
        font-size: 1.5rem;
    }

    /* Progress steps mobile */
    .jb-progress-steps-container {
        padding: 1rem 0.5rem;
    }

    .jb-progress-step-number {
        width: 36px;
        height: 36px;
        font-size: 0.875rem;
    }

    .jb-progress-step-label {
        font-size: 0.625rem;
        max-width: 55px;
    }

    .jb-progress-connector {
        margin-top: 18px;
        min-width: 12px;
        max-width: 40px;
    }

    .jb-alert--action {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .jb-alert--action .jb-btn {
        width: 100%;
    }
}

/* Print */
@media print {
    .jb-signup-sidebar { display: none; }
    .jb-signup-content { display: block; }
    .jb-progress-steps-container { display: none; }
}
</style>
