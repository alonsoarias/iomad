{{!
    @template local_jobboard/pages/public/convocatoria

    Public convocatoria detail page template.
    Simplified design following apply.mustache pattern.

    Context variables:
    * convocatoria (object) - Convocatoria data
    * isopen (bool) - Is open
    * isclosed (bool) - Is closed
    * isclosingsoon (bool) - Closing soon
    * daysremaining (number) - Days until close
    * totalvacancies (number) - Total vacancies
    * totalpositions (number) - Total positions
    * isloggedin (bool) - User is logged in
    * statuscolor (string) - Status color class
    * sharelinks (object) - Social sharing links
    * vacanciesurl (string) - View vacancies URL
    * loginurl (string) - Login URL
    * signupurl (string) - Signup URL
    * backurl (string) - Back URL

    Example context (json):
    {
        "convocatoria": {"id": 1, "name": "2024 Call", "code": "CONV-001"},
        "isopen": true,
        "totalvacancies": 5
    }
}}
<div class="jb-convocatoria-page" data-region="jobboard-public-convocatoria" data-convocatoria-id="{{convocatoria.id}}">
    <div class="container-fluid px-0">
        {{! Quick Info Bar }}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div class="d-flex align-items-center gap-2">
                <code class="badge bg-light text-dark">{{convocatoria.code}}</code>
                <span class="badge bg-{{convocatoria.statuscolor}}">{{convocatoria.statuslabel}}</span>
                {{#isclosingsoon}}
                <span class="badge bg-warning text-dark">
                    <i class="fa fa-clock me-1" aria-hidden="true"></i>
                    {{daysremaining}} {{#str}}days, local_jobboard{{/str}}
                </span>
                {{/isclosingsoon}}
            </div>
            {{#totalvacancies}}
            <a href="{{vacanciesurl}}" class="btn btn-primary jb-btn-primary btn-sm">
                <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                {{#str}}viewvacancies, local_jobboard{{/str}} ({{totalvacancies}})
            </a>
            {{/totalvacancies}}
        </div>

        <div class="row">
            {{! Main Content Column }}
            <div class="col-lg-8">
                {{! Description Card }}
                {{#convocatoria.description}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                            {{#str}}description, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{convocatoria.description}}}
                    </div>
                </div>
                {{/convocatoria.description}}

                {{! Terms Card }}
                {{#convocatoria.terms}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-gavel text-warning me-2" aria-hidden="true"></i>
                            {{#str}}convocatoriaterms, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{convocatoria.terms}}}
                    </div>
                </div>
                {{/convocatoria.terms}}

                {{! Attachments Card }}
                {{#convocatoria.hasattachments}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-paperclip text-info me-2" aria-hidden="true"></i>
                            {{#str}}attachments, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            {{#convocatoria.attachments}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="fa fa-file-{{icon}} text-muted me-2" aria-hidden="true"></i>
                                    {{name}}
                                </span>
                                <a href="{{url}}" class="btn btn-sm btn-outline-primary jb-btn-outline-primary" target="_blank">
                                    <i class="fa fa-download me-1" aria-hidden="true"></i>
                                    {{#str}}download{{/str}}
                                </a>
                            </li>
                            {{/convocatoria.attachments}}
                        </ul>
                    </div>
                </div>
                {{/convocatoria.hasattachments}}
            </div>

            {{! Sidebar Column }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 1rem;">
                    {{! Key Details Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-circle-info text-primary me-2" aria-hidden="true"></i>
                                {{#str}}details, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="mb-0">
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-briefcase me-2" aria-hidden="true"></i>
                                        {{#str}}vacancies, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0"><span class="badge bg-primary">{{totalvacancies}}</span></dd>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-users me-2" aria-hidden="true"></i>
                                        {{#str}}positions, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0"><span class="badge bg-success">{{totalpositions}}</span></dd>
                                </div>
                                <div class="d-flex justify-content-between py-2">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-flag me-2" aria-hidden="true"></i>
                                        {{#str}}status, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0"><span class="badge bg-{{convocatoria.statuscolor}}">{{convocatoria.statuslabel}}</span></dd>
                                </div>
                            </dl>
                        </div>
                    </div>

                    {{! Dates Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                                {{#str}}dates, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="mb-0">
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-play text-success me-2" aria-hidden="true"></i>
                                        {{#str}}startdate, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{convocatoria.startdateformatted}}</dd>
                                </div>
                                <div class="d-flex justify-content-between py-2">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-stop text-danger me-2" aria-hidden="true"></i>
                                        {{#str}}enddate, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 text-end">
                                        <span class="fw-bold {{#isclosingsoon}}text-warning{{/isclosingsoon}} {{#isclosed}}text-secondary{{/isclosed}}">{{convocatoria.enddateformatted}}</span>
                                        {{^isclosed}}
                                        <span class="d-block small {{#isclosingsoon}}text-warning{{/isclosingsoon}}{{^isclosingsoon}}text-muted{{/isclosingsoon}}">
                                            {{daysremaining}} {{#str}}days, local_jobboard{{/str}}
                                        </span>
                                        {{/isclosed}}
                                    </dd>
                                </div>
                            </dl>

                            {{! Progress Bar }}
                            {{^isclosed}}
                            <div class="mt-3 pt-3 border-top">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">{{#str}}deadlineprogress, local_jobboard{{/str}}</small>
                                    <small class="fw-bold">{{progresspercent}}%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                                </div>
                            </div>
                            {{/isclosed}}
                        </div>
                    </div>

                    {{! Share Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                                {{#str}}share, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{sharelinks.facebook}}" class="btn btn-outline-primary jb-btn-outline-primary" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                </a>
                                <a href="{{sharelinks.twitter}}" class="btn btn-outline-info jb-btn-outline-info" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                                    <i class="fab fa-twitter" aria-hidden="true"></i>
                                </a>
                                <a href="{{sharelinks.linkedin}}" class="btn btn-outline-primary jb-btn-outline-primary" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                    <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                                </a>
                                <a href="{{sharelinks.whatsapp}}" class="btn btn-outline-success jb-btn-outline-success" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                                    <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    {{! View Vacancies CTA }}
                    {{#totalvacancies}}
                    <div class="card shadow-sm mb-4 border-primary">
                        <div class="card-body text-center py-4">
                            <i class="fa fa-briefcase fa-2x text-primary mb-3" aria-hidden="true"></i>
                            <h6 class="mb-2">{{#str}}viewvacancies, local_jobboard{{/str}}</h6>
                            <p class="text-muted small mb-3">{{#str}}vacanciesavailable, local_jobboard, {{totalvacancies}}{{/str}}</p>
                            <a href="{{vacanciesurl}}" class="btn btn-primary jb-btn-primary w-100">
                                <i class="fa fa-arrow-right me-2" aria-hidden="true"></i>
                                {{#str}}viewvacancies, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>
                    {{/totalvacancies}}

                    {{! Login CTA }}
                    {{^isloggedin}}
                    <div class="card shadow-sm mb-4 border-warning">
                        <div class="card-body text-center py-4">
                            <i class="fa fa-circle-user fa-2x text-warning mb-3" aria-hidden="true"></i>
                            <h6 class="mb-2">{{#str}}wanttoapply, local_jobboard{{/str}}</h6>
                            <p class="text-muted small mb-3">{{#str}}loginrequiredtoapply, local_jobboard{{/str}}</p>
                            <a href="{{loginurl}}" class="btn btn-primary jb-btn-primary w-100 mb-2">
                                <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                                {{#str}}login{{/str}}
                            </a>
                            <a href="{{signupurl}}" class="btn btn-outline-primary jb-btn-outline-primary w-100">
                                <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                                {{#str}}createaccount{{/str}}
                            </a>
                        </div>
                    </div>
                    {{/isloggedin}}
                </div>
            </div>
        </div>

        {{! Back Navigation }}
        <div class="mt-4 pt-3 border-top">
            <a href="{{backurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtoconvocatorias, local_jobboard{{/str}}
            </a>
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
