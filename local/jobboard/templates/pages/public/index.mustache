{{!
    @template local_jobboard/pages/public

    Public page template with enhanced UX and dual mode support.
    Uses jb-* CSS classes for consistent styling.

    Modes:
    1. showconvocatorias=true: Shows all open convocatorias as cards
    2. showvacancies=true: Shows vacancies for a specific convocatoria

    Context variables:
    * mode - Current mode: 'convocatorias' or 'vacancies'
    * showconvocatorias - Boolean to show convocatorias list
    * showvacancies - Boolean to show vacancies for a convocatoria
    * pagetitle - Page title string
    * pagedescription - Page description HTML
    * stats - Array of statistic cards
    * isloggedin - Boolean if user is logged in
    * quickaccess - Quick access buttons for logged-in users
    * convocatoria - Current convocatoria data (for vacancies mode)
    * convocatorias - Array of convocatoria cards
    * vacancies - Array of vacancy cards
    * filterform - Filter form configuration
    * hasfilters - Boolean if filters are active
    * clearfiltersurl - URL to clear filters
    * pagination - Pagination HTML
    * sharelinks - Social sharing links
    * loginurl - Login URL
    * signupurl - Signup URL
    * loading - Show skeleton loading state

    Example context (json):
    {
        "showconvocatorias": true,
        "pagetitle": "Job Opportunities"
    }
}}
<div class="jb-public-page" data-region="jobboard-public">
    {{! Skip Link for Accessibility }}
    <a href="#main-content" class="jb-skip-link">
        {{#str}}skiptomain, local_jobboard{{/str}}
    </a>

    {{! ================================================================ }}
    {{! MODE: VACANCIES FOR SPECIFIC CONVOCATORIA }}
    {{! ================================================================ }}
    {{#showvacancies}}
    <main id="main-content">
        {{! Back Navigation }}
        <nav class="mb-4 jb-fade-in" aria-label="{{#str}}navigation{{/str}}">
            <a href="{{backtoconvocatoriasurl}}" class="btn btn-outline-secondary jb-hover-lift">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtoconvocatorias, local_jobboard{{/str}}
            </a>
        </nav>

        {{! Convocatoria Info Card }}
        {{#convocatoria}}
        <section class="card shadow-sm mb-4 {{#isurgent}}border-warning{{/isurgent}}{{^isurgent}}border-primary{{/isurgent}} jb-fade-in-up"
                 aria-labelledby="convocatoria-heading">
            <div class="card-header {{#isurgent}}bg-warning text-dark{{/isurgent}}{{^isurgent}}bg-primary text-white{{/isurgent}}">
                <div class="d-flex flex-column jb-flex-md-row justify-content-between align-items-start jb-align-items-md-center">
                    <div class="mb-2 mb-md-0">
                        <code class="badge bg-light text-dark me-2">{{code}}</code>
                        <h1 class="fs-5 d-inline mb-0" id="convocatoria-heading">{{name}}</h1>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-light text-dark">
                            <i class="fa fa-briefcase me-1" aria-hidden="true"></i>
                            {{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                        </span>
                        <span class="badge bg-light text-dark">
                            <i class="fa fa-users me-1" aria-hidden="true"></i>
                            {{totalpositions}} {{#str}}positions, local_jobboard{{/str}}
                        </span>
                        {{#isurgent}}
                        <span class="badge bg-danger jb-pulse">
                            <i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>
                            {{urgenttext}}
                        </span>
                        {{/isurgent}}
                    </div>
                </div>
            </div>
            <div class="card-body py-3">
                <div class="d-flex flex-column jb-flex-md-row justify-content-between align-items-start jb-align-items-md-center">
                    <div class="d-flex flex-wrap gap-3 mb-2 mb-md-0">
                        <span class="small d-flex align-items-center">
                            <i class="fa fa-calendar-check text-success me-2" aria-hidden="true"></i>
                            <span>{{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></span>
                        </span>
                        <span class="small d-flex align-items-center {{#isurgent}}text-danger fw-bold{{/isurgent}}">
                            <i class="fa fa-calendar-xmark {{#isurgent}}text-danger{{/isurgent}}{{^isurgent}}text-warning{{/isurgent}} me-2" aria-hidden="true"></i>
                            <span>{{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></span>
                        </span>
                        {{#daysremaining}}
                        <span class="badge jb-badge-{{#isurgent}}warning{{/isurgent}}{{^isurgent}}info{{/isurgent}}">
                            <i class="fa fa-clock me-1" aria-hidden="true"></i>
                            {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                        </span>
                        {{/daysremaining}}
                    </div>
                    <a href="{{detailsurl}}" class="btn btn-sm btn-outline-info jb-hover-lift">
                        <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
                        {{#str}}viewdetails, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
        </section>
        {{/convocatoria}}

        {{! Filters Section }}
        {{#filterform}}
        <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="filters-heading">
            <div class="card-header bg-light py-2">
                <h2 class="fs-6 mb-0" id="filters-heading">
                    <i class="fa fa-filter me-2 text-muted" aria-hidden="true"></i>
                    {{#str}}filtervacancies, local_jobboard{{/str}}
                </h2>
            </div>
            <div class="card-body py-3">
                <form method="get" action="{{action}}" class="jb-filter-form" role="search">
                    {{#hiddenfields}}
                    <input type="hidden" name="{{name}}" value="{{value}}">
                    {{/hiddenfields}}
                    <div class="row align-items-end gap-2">
                        {{! Search Input }}
                        <div class="col-lg-4 col-md-6 mb-2 mb-lg-0">
                            <label for="filter-search" class="small text-muted fw-medium">{{#str}}search{{/str}}</label>
                            <div class="position-relative">
                                <input type="search"
                                       name="search"
                                       id="filter-search"
                                       class="form-control form-control-sm jb-pl-4"
                                       value="{{searchvalue}}"
                                       placeholder="{{#str}}searchvacancies, local_jobboard{{/str}}"
                                       aria-describedby="search-hint">
                                <i class="fa fa-magnifying-glass position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%);" aria-hidden="true"></i>
                            </div>
                        </div>
                        {{! Contract Type }}
                        {{#showcontractfilter}}
                        <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                            <label for="filter-contracttype" class="small text-muted fw-medium">{{#str}}contracttype, local_jobboard{{/str}}</label>
                            <select name="contracttype" id="filter-contracttype" class="form-control form-control-sm">
                                <option value="">{{#str}}all{{/str}}</option>
                                {{#contractoptions}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/contractoptions}}
                            </select>
                        </div>
                        {{/showcontractfilter}}
                        {{! Location }}
                        {{#showlocationfilter}}
                        <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                            <label for="filter-location" class="small text-muted fw-medium">{{#str}}location, local_jobboard{{/str}}</label>
                            <select name="location" id="filter-location" class="form-control form-control-sm">
                                <option value="">{{#str}}all{{/str}}</option>
                                {{#locationoptions}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/locationoptions}}
                            </select>
                        </div>
                        {{/showlocationfilter}}
                        {{! Submit }}
                        <div class="col-lg-2 col-md-6 mb-2 mb-lg-0 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary btn-sm w-100 jb-hover-lift">
                                <i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>
                                {{#str}}filter, local_jobboard{{/str}}
                            </button>
                        </div>
                    </div>
                    {{#hasfilters}}
                    <div class="mt-3 pt-2 border-top">
                        <span class="small text-muted me-2">{{#str}}activefilters, local_jobboard{{/str}}:</span>
                        <a href="{{clearfiltersurl}}" class="btn btn-sm btn-outline-danger">
                            <i class="fa fa-xmark me-1" aria-hidden="true"></i>
                            {{#str}}clearfilters, local_jobboard{{/str}}
                        </a>
                    </div>
                    {{/hasfilters}}
                </form>
            </div>
        </section>
        {{/filterform}}

        {{! Results Header }}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fs-5 mb-0 d-flex align-items-center">
                <i class="fa fa-briefcase me-2 text-primary" aria-hidden="true"></i>
                {{#str}}vacancies, local_jobboard{{/str}}
            </h2>
            <p class="text-muted small mb-0" role="status" aria-live="polite">
                {{resultstext}}
            </p>
        </div>

        {{! Vacancies Grid }}
        {{#hasvacancies}}
        <div class="row">
            {{#vacancies}}
            <div class="col-lg-4 col-md-6 mb-4">
                <article class="card h-100 shadow-sm jb-vacancy-card jb-hover-lift jb-fade-in-up {{#isurgent}}border-warning{{/isurgent}}"
                         data-vacancy-id="{{id}}"
                         aria-labelledby="vacancy-{{id}}-title">
                    {{! Urgent Banner }}
                    {{#isurgent}}
                    <div class="jb-vacancy-urgent-banner bg-warning text-dark py-1 px-3 small text-center">
                        <i class="fa fa-clock me-1" aria-hidden="true"></i>
                        <strong>{{urgenttext}}</strong>
                    </div>
                    {{/isurgent}}
                    {{! Card Header }}
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                        <code class="small text-muted">{{code}}</code>
                        <span class="badge jb-badge-{{publicationtypecolor}}">{{publicationtypelabel}}</span>
                    </div>
                    {{! Card Body }}
                    <div class="card-body">
                        <h3 class="card-title fs-6 mb-3" id="vacancy-{{id}}-title">
                            <a href="{{viewurl}}" class="text-dark text-decoration-none">
                                {{title}}
                            </a>
                        </h3>
                        <div class="small d-flex flex-column gap-1">
                            {{#location}}
                            <div class="d-flex align-items-center">
                                <i class="fa fa-location-dot text-primary me-2" style="width: 16px;" aria-hidden="true"></i>
                                <span>{{location}}</span>
                            </div>
                            {{/location}}
                            {{#contracttypelabel}}
                            <div class="d-flex align-items-center">
                                <i class="fa fa-file-contract text-secondary me-2" style="width: 16px;" aria-hidden="true"></i>
                                <span>{{contracttypelabel}}</span>
                            </div>
                            {{/contracttypelabel}}
                            <div class="d-flex align-items-center">
                                <i class="fa fa-users text-success me-2" style="width: 16px;" aria-hidden="true"></i>
                                <span>{{positions}} {{#str}}positions, local_jobboard{{/str}}</span>
                            </div>
                        </div>
                    </div>
                    {{! Card Footer }}
                    <footer class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="d-flex align-items-center {{#isurgent}}text-warning fw-bold{{/isurgent}}{{^isurgent}}text-muted{{/isurgent}}">
                                <i class="fa fa-calendar-xmark me-1" aria-hidden="true"></i>
                                <time datetime="{{closedateiso}}">{{closedateformatted}}</time>
                            </small>
                        </div>
                        <div class="d-flex justify-content-between gap-2">
                            <a href="{{viewurl}}" class="btn btn-sm btn-outline-primary jb-flex-fill">
                                <i class="fa fa-eye me-1" aria-hidden="true"></i>
                                {{#str}}view{{/str}}
                            </a>
                            {{#hasapplied}}
                            <span class="btn btn-sm btn-success disabled jb-flex-fill" aria-disabled="true">
                                <i class="fa fa-check me-1" aria-hidden="true"></i>
                                {{#str}}applied, local_jobboard{{/str}}
                            </span>
                            {{/hasapplied}}
                            {{^hasapplied}}
                            {{#canapply}}
                            <a href="{{applyurl}}" class="btn btn-sm btn-primary jb-flex-fill jb-hover-lift">
                                <i class="fa fa-paper-plane me-1" aria-hidden="true"></i>
                                {{#str}}apply, local_jobboard{{/str}}
                            </a>
                            {{/canapply}}
                            {{^isloggedin}}
                            <a href="{{loginapplyurl}}" class="btn btn-sm btn-outline-secondary jb-flex-fill">
                                <i class="fa fa-right-to-bracket me-1" aria-hidden="true"></i>
                                {{#str}}login{{/str}}
                            </a>
                            {{/isloggedin}}
                            {{/hasapplied}}
                        </div>
                    </footer>
                </article>
            </div>
            {{/vacancies}}
        </div>
        {{/hasvacancies}}

        {{! Empty State for Vacancies }}
        {{^hasvacancies}}
        {{> local_jobboard/components/empty_state }}
        {{/hasvacancies}}

        {{! Pagination }}
        {{#pagination}}
        <nav class="mt-4 d-flex justify-content-center" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
            {{{pagination}}}
        </nav>
        {{/pagination}}

        {{! CTA for Non-Logged In }}
        {{^isloggedin}}
        {{#hasvacancies}}
        <aside class="card bg-primary text-white border-0 mt-5 jb-fade-in-up" aria-labelledby="cta-heading">
            <div class="card-body text-center py-5">
                <i class="fa fa-user-plus fa-3x opacity-75 mb-3" aria-hidden="true"></i>
                <h3 class="fs-4 mb-2" id="cta-heading">{{#str}}wanttoapply, local_jobboard{{/str}}</h3>
                <p class="mb-4 opacity-75">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="{{signupurl}}" class="btn btn-light btn-lg jb-hover-lift">
                        <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                        {{#str}}createaccount{{/str}}
                    </a>
                    <a href="{{loginurl}}" class="btn btn-outline-light btn-lg jb-hover-lift">
                        <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                        {{#str}}login{{/str}}
                    </a>
                </div>
            </div>
        </aside>
        {{/hasvacancies}}
        {{/isloggedin}}
    </main>
    {{/showvacancies}}

    {{! ================================================================ }}
    {{! MODE: CONVOCATORIAS LIST (DEFAULT) }}
    {{! ================================================================ }}
    {{#showconvocatorias}}
    {{! Welcome Header }}
    <header class="jb-welcome-section bg-primary text-white rounded p-4 mb-4 jb-fade-in">
        <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
                <h1 class="fs-3 mb-2 fw-bold">{{pagetitle}}</h1>
                {{#pagedescription}}
                <p class="mb-0 opacity-75 lead">{{{pagedescription}}}</p>
                {{/pagedescription}}

                {{! Quick Access for Logged-In Users }}
                {{#isloggedin}}
                {{#hasquickaccess}}
                <nav class="mt-3 pt-3 border-top border-light d-flex flex-wrap gap-2" aria-label="{{#str}}quickactions, local_jobboard{{/str}}">
                    {{#quickaccess}}
                    <a href="{{url}}" class="btn btn-light btn-sm jb-hover-lift">
                        <i class="fa fa-{{icon}} me-2" aria-hidden="true"></i>
                        {{label}}
                    </a>
                    {{/quickaccess}}
                </nav>
                {{/hasquickaccess}}
                {{/isloggedin}}
            </div>
            <div class="d-none d-md-block ms-4" aria-hidden="true">
                <i class="fa fa-briefcase fa-4x opacity-25"></i>
            </div>
        </div>
    </header>

    <main id="main-content">
        {{! Statistics Row }}
        {{#hasstats}}
        <section class="row mb-4" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
            {{#stats}}
            <div class="col-lg-3 col-md-6 mb-3">
                {{> local_jobboard/components/stat_card }}
            </div>
            {{/stats}}
        </section>
        {{/hasstats}}

        {{! Section Title }}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fs-5 mb-0">
                <i class="fa fa-folder-open me-2 text-primary" aria-hidden="true"></i>
                {{#str}}openconvocatorias, local_jobboard{{/str}}
            </h2>
            {{#hasconvocatorias}}
            <span class="badge bg-primary rounded-pill">
                {{convocatoriascount}} {{#str}}available, local_jobboard{{/str}}
            </span>
            {{/hasconvocatorias}}
        </div>

        {{! Convocatorias Grid }}
        {{#hasconvocatorias}}
        <div class="row">
            {{#convocatorias}}
            <div class="col-lg-4 col-md-6 mb-4">
                <article class="card h-100 shadow-sm jb-convocatoria-card jb-hover-lift jb-fade-in-up {{#isurgent}}border-warning{{/isurgent}}"
                         aria-labelledby="convocatoria-{{id}}-title">
                    {{! Card Header }}
                    <div class="card-header {{#isurgent}}bg-warning text-dark{{/isurgent}}{{^isurgent}}bg-primary text-white{{/isurgent}} py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <code class="badge bg-light text-dark">{{code}}</code>
                            {{#isurgent}}
                            <span class="badge bg-danger small jb-pulse">
                                <i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>
                                {{urgenttext}}
                            </span>
                            {{/isurgent}}
                            {{^isurgent}}
                            <span class="badge bg-light text-dark small">
                                <i class="fa fa-circle-check me-1" aria-hidden="true"></i>
                                {{#str}}convocatoria_status_open, local_jobboard{{/str}}
                            </span>
                            {{/isurgent}}
                        </div>
                    </div>
                    {{! Card Body }}
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title fs-5 mb-3" id="convocatoria-{{id}}-title">
                            <a href="{{detailsurl}}" class="text-dark text-decoration-none">
                                {{name}}
                            </a>
                        </h3>
                        {{#descriptionexcerpt}}
                        <p class="card-text text-muted small mb-3 text-truncate-3">{{descriptionexcerpt}}</p>
                        {{/descriptionexcerpt}}
                        {{! Stats Badges }}
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-light text-dark d-flex align-items-center">
                                <i class="fa fa-briefcase text-primary me-1" aria-hidden="true"></i>
                                {{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                            </span>
                            <span class="badge bg-light text-dark d-flex align-items-center">
                                <i class="fa fa-users text-info me-1" aria-hidden="true"></i>
                                {{totalpositions}} {{#str}}positions, local_jobboard{{/str}}
                            </span>
                        </div>
                        {{! Dates }}
                        <div class="small text-muted jb-mt-auto">
                            <div class="mb-1 d-flex align-items-center">
                                <i class="fa fa-calendar-check text-success me-2" style="width: 16px;" aria-hidden="true"></i>
                                <span>{{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></span>
                            </div>
                            <div class="d-flex align-items-center {{#isurgent}}text-danger fw-bold{{/isurgent}}">
                                <i class="fa fa-calendar-xmark {{#isurgent}}text-danger{{/isurgent}}{{^isurgent}}text-warning{{/isurgent}} me-2" style="width: 16px;" aria-hidden="true"></i>
                                <span>{{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></span>
                            </div>
                        </div>
                    </div>
                    {{! Card Footer }}
                    <footer class="card-footer bg-white border-top">
                        <div class="d-flex justify-content-between gap-2">
                            <a href="{{detailsurl}}" class="btn btn-sm btn-outline-info jb-flex-fill">
                                <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
                                {{#str}}details{{/str}}
                            </a>
                            <a href="{{vacanciesurl}}" class="btn btn-sm btn-primary jb-flex-fill jb-hover-lift">
                                <i class="fa fa-briefcase me-1" aria-hidden="true"></i>
                                {{#str}}viewvacancies, local_jobboard{{/str}}
                            </a>
                        </div>
                    </footer>
                </article>
            </div>
            {{/convocatorias}}
        </div>
        {{/hasconvocatorias}}

        {{! Empty State for Convocatorias }}
        {{^hasconvocatorias}}
        {{> local_jobboard/components/empty_state }}
        {{/hasconvocatorias}}

        {{! Social Share Section }}
        {{#hasconvocatorias}}
        {{#sharelinks}}
        <section class="card shadow-sm mt-4 mb-4 jb-fade-in-up" aria-labelledby="share-heading">
            <div class="card-body">
                <div class="d-flex flex-column jb-flex-md-row justify-content-between align-items-center">
                    <h3 class="fs-6 mb-3 mb-md-0" id="share-heading">
                        <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                        {{#str}}sharepage, local_jobboard{{/str}}
                    </h3>
                    <div class="d-flex gap-2">
                        <a href="{{facebookurl}}" class="btn btn-outline-primary rounded-circle jb-social-btn jb-hover-lift"
                           target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="{{#str}}shareon, local_jobboard{{/str}} Facebook">
                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                        </a>
                        <a href="{{twitterurl}}" class="btn btn-outline-info rounded-circle jb-social-btn jb-hover-lift"
                           target="_blank" rel="noopener noreferrer" title="Twitter" aria-label="{{#str}}shareon, local_jobboard{{/str}} Twitter">
                            <i class="fab fa-twitter" aria-hidden="true"></i>
                        </a>
                        <a href="{{linkedinurl}}" class="btn btn-outline-primary rounded-circle jb-social-btn jb-hover-lift"
                           target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="{{#str}}shareon, local_jobboard{{/str}} LinkedIn">
                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                        </a>
                        <a href="{{whatsappurl}}" class="btn btn-outline-success rounded-circle jb-social-btn jb-hover-lift"
                           target="_blank" rel="noopener noreferrer" title="WhatsApp" aria-label="{{#str}}shareon, local_jobboard{{/str}} WhatsApp">
                            <i class="fab fa-whatsapp" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>
        {{/sharelinks}}
        {{/hasconvocatorias}}

        {{! CTA for Non-Logged In Users }}
        {{^isloggedin}}
        {{#hasconvocatorias}}
        <aside class="card bg-primary text-white border-0 mt-4 jb-fade-in-up" aria-labelledby="main-cta-heading">
            <div class="card-body text-center py-5">
                <i class="fa fa-user-plus fa-3x opacity-75 mb-3" aria-hidden="true"></i>
                <h3 class="fs-4 mb-2" id="main-cta-heading">{{#str}}wanttoapply, local_jobboard{{/str}}</h3>
                <p class="mb-4 opacity-75 mx-auto" style="max-width: 500px;">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="{{signupurl}}" class="btn btn-light btn-lg jb-hover-lift">
                        <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                        {{#str}}createaccount{{/str}}
                    </a>
                    <a href="{{loginurl}}" class="btn btn-outline-light btn-lg jb-hover-lift">
                        <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                        {{#str}}login{{/str}}
                    </a>
                </div>
            </div>
        </aside>
        {{/hasconvocatorias}}
        {{/isloggedin}}
    </main>
    {{/showconvocatorias}}
</div>

{{#js}}
require(['local_jobboard/public_filters'], function(filters) {
    filters.init();
});
{{/js}}
