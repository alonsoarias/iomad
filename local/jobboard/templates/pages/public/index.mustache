{{!
    @template local_jobboard/pages/public/index

    Public page - Clean minimal design following apply.mustache pattern

    Context variables:
    * showconvocatorias - Boolean to show convocatorias list
    * showvacancies - Boolean to show vacancies for a convocatoria
    * pagetitle - Page title string
    * pagedescription - Page description HTML
    * stats - Array of statistic cards
    * isloggedin - Boolean if user is logged in
    * convocatoria - Current convocatoria data (for vacancies mode)
    * convocatorias - Array of convocatoria cards
    * vacancies - Array of vacancy cards
    * filterform - Filter form configuration
    * hasfilters - Boolean if filters are active
    * clearfiltersurl - URL to clear filters
    * pagination - Pagination HTML
    * loginurl - Login URL
    * signupurl - Signup URL
}}
<div class="jb-public" id="jobboard-public">
    {{! Support Banner }}
    {{#showsupport}}
    {{> local_jobboard/partials/support_button }}
    {{/showsupport}}

    {{! ================================================================ }}
    {{! HEADER SECTION }}
    {{! ================================================================ }}
    <div class="jb-public-header">
        <div class="jb-public-header__nav">
            {{#showvacancies}}
            <a href="{{backurl}}" class="jb-public-header__back">
                <i class="fa fa-arrow-left"></i>
                {{#str}}convocatorias, local_jobboard{{/str}}
            </a>
            {{/showvacancies}}
            {{^isloggedin}}
            <a href="{{signupurl}}" class="jb-btn jb-btn--primary">
                <i class="fa fa-user-plus"></i> {{#str}}createaccount{{/str}}
            </a>
            {{/isloggedin}}
        </div>
        <h1 class="jb-public-header__title">
            {{#showconvocatorias}}
            <i class="fa fa-folder-open"></i> {{#str}}openconvocatorias, local_jobboard{{/str}}
            {{/showconvocatorias}}
            {{#showvacancies}}
            <i class="fa fa-briefcase"></i> {{#str}}vacancies, local_jobboard{{/str}}
            {{/showvacancies}}
        </h1>
        <p class="jb-public-header__subtitle">
            {{#showconvocatorias}}{{#str}}browseconvocatorias_desc, local_jobboard{{/str}}{{/showconvocatorias}}
            {{#showvacancies}}{{#str}}browsevacancies_desc, local_jobboard{{/str}}{{/showvacancies}}
        </p>
    </div>

    {{! ================================================================ }}
    {{! MODE: VACANCIES FOR SPECIFIC CONVOCATORIA }}
    {{! ================================================================ }}
    {{#showvacancies}}
    {{! Convocatoria Info Card }}
    {{#convocatoria}}
    <div class="jb-card jb-convocatoria-info {{#isurgent}}jb-convocatoria-info--urgent{{/isurgent}}">
        <div class="jb-convocatoria-info__header">
            <div class="jb-convocatoria-info__title-row">
                <span class="jb-code jb-code--{{#isurgent}}warning{{/isurgent}}{{^isurgent}}primary{{/isurgent}}">{{code}}</span>
                <h2 class="jb-convocatoria-info__name">{{name}}</h2>
            </div>
            <div class="jb-convocatoria-info__badges">
                <span class="jb-badge jb-badge--primary">
                    <i class="fa fa-briefcase"></i> {{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                </span>
                <span class="jb-badge jb-badge--info">
                    <i class="fa fa-users"></i> {{totalpositions}} {{#str}}positions, local_jobboard{{/str}}
                </span>
                {{#isurgent}}
                <span class="jb-badge jb-badge--danger">
                    <i class="fa fa-exclamation-triangle"></i> {{urgenttext}}
                </span>
                {{/isurgent}}
            </div>
        </div>
        <div class="jb-convocatoria-info__footer">
            <div class="jb-convocatoria-info__dates">
                <span><i class="fa fa-calendar-check"></i> {{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></span>
                <span class="{{#isurgent}}jb-text-danger{{/isurgent}}"><i class="fa fa-calendar-xmark"></i> {{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></span>
                {{#daysremaining}}
                <span class="jb-badge jb-badge--{{#isurgent}}warning{{/isurgent}}{{^isurgent}}info{{/isurgent}}">{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
                {{/daysremaining}}
            </div>
            <a href="{{detailsurl}}" class="jb-link">
                <i class="fa fa-info-circle"></i> {{#str}}viewdetails, local_jobboard{{/str}}
            </a>
        </div>
    </div>
    {{/convocatoria}}

    {{! Filter Form }}
    {{#filterform}}
    <div class="jb-card jb-filter-card">
        <div class="jb-card__header">
            <span><i class="fa fa-filter"></i> {{#str}}filtervacancies, local_jobboard{{/str}}</span>
            <span class="jb-filter-loading d-none">
                <i class="fa fa-spinner fa-spin"></i> {{#str}}filtering, local_jobboard{{/str}}
            </span>
        </div>
        <div class="jb-card__body">
            <form method="get" action="{{action}}" class="jb-filter-form">
                {{#hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="jb-filter-grid">
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-hashtag"></i> {{#str}}code, local_jobboard{{/str}}</label>
                        <input type="text" name="code" class="jb-input" value="{{codevalue}}" placeholder="{{#str}}filterbycode, local_jobboard{{/str}}">
                    </div>
                    {{#showcontractfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-file-contract"></i> {{#str}}contracttype, local_jobboard{{/str}}</label>
                        <select name="contracttype" class="jb-select">
                            <option value="">{{#str}}all{{/str}}</option>
                            {{#contractoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/contractoptions}}
                        </select>
                    </div>
                    {{/showcontractfilter}}
                    {{#showdepartmentfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-graduation-cap"></i> {{#str}}department, local_jobboard{{/str}}</label>
                        <select name="department" class="jb-select">
                            <option value="">{{#str}}all{{/str}}</option>
                            {{#departmentoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/departmentoptions}}
                        </select>
                    </div>
                    {{/showdepartmentfilter}}
                    {{#showlocationfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-location-dot"></i> {{#str}}location, local_jobboard{{/str}}</label>
                        <select name="location" class="jb-select">
                            <option value="">{{#str}}all{{/str}}</option>
                            {{#locationoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/locationoptions}}
                        </select>
                    </div>
                    {{/showlocationfilter}}
                    {{#showmodalityfilter}}
                    <div class="jb-filter-item">
                        <label class="jb-filter-label"><i class="fa fa-laptop-house"></i> {{#str}}modality, local_jobboard{{/str}}</label>
                        <select name="modality" class="jb-select">
                            <option value="">{{#str}}all{{/str}}</option>
                            {{#modalityoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/modalityoptions}}
                        </select>
                    </div>
                    {{/showmodalityfilter}}
                    <div class="jb-filter-item jb-filter-item--wide">
                        <label class="jb-filter-label"><i class="fa fa-search"></i> {{#str}}search{{/str}}</label>
                        <input type="search" name="search" class="jb-input" value="{{searchvalue}}" placeholder="{{#str}}searchvacancies, local_jobboard{{/str}}">
                    </div>
                </div>
                {{#hasfilters}}
                <div class="jb-filter-actions">
                    <a href="{{clearfiltersurl}}" class="jb-link jb-link--muted" data-action="reset-filters">
                        <i class="fa fa-xmark"></i> {{#str}}clearfilters, local_jobboard{{/str}}
                    </a>
                </div>
                {{/hasfilters}}
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! AJAX Results Container }}
    <div data-region="filter-results">
        {{> local_jobboard/partials/public_vacancies_results }}
    </div>

    {{! CTA for Non-Logged In }}
    {{^isloggedin}}
    {{#hasvacancies}}
    <div class="jb-cta">
        <p class="jb-cta__text">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
        <div class="jb-cta__buttons">
            <a href="{{signupurl}}" class="jb-btn jb-btn--primary">
                <i class="fa fa-user-plus"></i> {{#str}}createaccount{{/str}}
            </a>
            <a href="{{loginurl}}" class="jb-btn jb-btn--outline">
                <i class="fa fa-sign-in-alt"></i> {{#str}}login{{/str}}
            </a>
        </div>
    </div>
    {{/hasvacancies}}
    {{/isloggedin}}
    {{/showvacancies}}

    {{! ================================================================ }}
    {{! MODE: CONVOCATORIAS LIST (DEFAULT) }}
    {{! ================================================================ }}
    {{#showconvocatorias}}
    {{! Statistics }}
    {{#hasstats}}
    <div class="jb-stats">
        {{#stats}}
        <div class="jb-stat jb-stat--{{color}}">
            <span class="jb-stat__value">{{value}}</span>
            <span class="jb-stat__label">{{label}}</span>
        </div>
        {{/stats}}
    </div>
    {{/hasstats}}

    {{! Section Title }}
    <div class="jb-section-header">
        <h3 class="jb-section-header__title">
            <i class="fa fa-folder-open"></i> {{#str}}openconvocatorias, local_jobboard{{/str}}
        </h3>
    </div>

    {{! Convocatorias Grid }}
    {{#hasconvocatorias}}
    <div class="jb-grid">
        {{#convocatorias}}
        <div class="jb-card jb-convocatoria-card {{#isurgent}}jb-convocatoria-card--urgent{{/isurgent}}">
            <div class="jb-convocatoria-card__header">
                <span class="jb-code jb-code--{{#isurgent}}warning{{/isurgent}}{{^isurgent}}primary{{/isurgent}}">{{code}}</span>
                {{#isurgent}}
                <span class="jb-badge jb-badge--danger"><i class="fa fa-exclamation-triangle"></i> {{urgenttext}}</span>
                {{/isurgent}}
                {{^isurgent}}
                <span class="jb-badge jb-badge--success"><i class="fa fa-check-circle"></i> {{#str}}convocatoria_status_open, local_jobboard{{/str}}</span>
                {{/isurgent}}
            </div>
            <div class="jb-convocatoria-card__body">
                <h4 class="jb-convocatoria-card__title">
                    <a href="{{detailsurl}}">{{name}}</a>
                </h4>
                {{#descriptionexcerpt}}<p class="jb-convocatoria-card__desc">{{descriptionexcerpt}}</p>{{/descriptionexcerpt}}
                <div class="jb-convocatoria-card__badges">
                    <span class="jb-badge jb-badge--primary"><i class="fa fa-briefcase"></i> {{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}</span>
                    <span class="jb-badge jb-badge--info"><i class="fa fa-users"></i> {{totalpositions}} {{#str}}positions, local_jobboard{{/str}}</span>
                </div>
                <div class="jb-convocatoria-card__dates">
                    <div><i class="fa fa-calendar-check"></i> {{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></div>
                    <div class="{{#isurgent}}jb-text-danger{{/isurgent}}"><i class="fa fa-calendar-xmark"></i> {{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></div>
                </div>
            </div>
            <div class="jb-convocatoria-card__footer">
                <a href="{{detailsurl}}" class="jb-btn jb-btn--outline jb-btn--sm">
                    <i class="fa fa-info-circle"></i> {{#str}}details{{/str}}
                </a>
                <a href="{{vacanciesurl}}" class="jb-btn jb-btn--primary jb-btn--sm">
                    <i class="fa fa-briefcase"></i> {{#str}}viewvacancies, local_jobboard{{/str}}
                </a>
            </div>
        </div>
        {{/convocatorias}}
    </div>
    {{/hasconvocatorias}}

    {{! Empty State }}
    {{^hasconvocatorias}}
    <div class="jb-empty">
        <i class="fa fa-folder-open"></i>
        <h3>{{#str}}noconvocatorias, local_jobboard{{/str}}</h3>
        <p>{{#str}}noconvocatorias_desc, local_jobboard{{/str}}</p>
    </div>
    {{/hasconvocatorias}}

    {{! CTA for Non-Logged In }}
    {{^isloggedin}}
    {{#hasconvocatorias}}
    <div class="jb-cta">
        <p class="jb-cta__text">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
        <div class="jb-cta__buttons">
            <a href="{{signupurl}}" class="jb-btn jb-btn--primary">
                <i class="fa fa-user-plus"></i> {{#str}}createaccount{{/str}}
            </a>
            <a href="{{loginurl}}" class="jb-btn jb-btn--outline">
                <i class="fa fa-sign-in-alt"></i> {{#str}}login{{/str}}
            </a>
        </div>
    </div>
    {{/hasconvocatorias}}
    {{/isloggedin}}
    {{/showconvocatorias}}
</div>

<style>
/* ================================================================
   PUBLIC PAGE - CLEAN MINIMAL DESIGN
   Following apply.mustache pattern
   ================================================================ */
.jb-public {
    max-width: 1200px;
    padding: 1rem;
}

/* Header */
.jb-public-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-public-header__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.jb-public-header__back {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-public-header__back:hover {
    color: var(--iser-verde-dark, #157a6a);
}

.jb-public-header__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    color: var(--iser-negro, #1a1a1a);
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.jb-public-header__title i {
    color: var(--iser-verde, #1b9e88);
}

.jb-public-header__subtitle {
    font-size: 1rem;
    color: var(--iser-gris-medio, #666);
    margin: 0;
}

/* Cards */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
}

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i { color: var(--iser-verde, #1b9e88); margin-right: 0.375rem; }
.jb-card__body { padding: 1rem; }

/* Convocatoria Info Card */
.jb-convocatoria-info {
    margin-bottom: 1.5rem;
}

.jb-convocatoria-info--urgent {
    border-left: 4px solid var(--iser-amarillo, #ffc107);
}

.jb-convocatoria-info__header {
    padding: 1rem 1.25rem;
    border-bottom: 2px solid var(--iser-verde, #1b9e88);
}

.jb-convocatoria-info__title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
}

.jb-convocatoria-info__name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--iser-rojo, #c41e3a);
    margin: 0;
}

.jb-convocatoria-info__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.jb-convocatoria-info__footer {
    padding: 0.75rem 1.25rem;
    background: #f9fafb;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.jb-convocatoria-info__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
}

.jb-convocatoria-info__dates i {
    margin-right: 0.375rem;
}

/* Filter Card */
.jb-filter-card .jb-card__body { padding: 1rem; }
.jb-filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
}
.jb-filter-item--wide { grid-column: span 2; }
.jb-filter-label { display: block; font-size: 0.75rem; color: var(--iser-gris-medio, #666); margin-bottom: 0.25rem; }
.jb-filter-label i { margin-right: 0.25rem; }
.jb-filter-actions { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid #e5e5e5; }

/* Inputs */
.jb-input, .jb-select {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.875rem;
    background: #fff;
    color: #1a1a1a;
    transition: border-color 0.15s;
}
.jb-input::placeholder { color: #888; opacity: 1; }
.jb-select option { color: #1a1a1a; background: #fff; }
.jb-input:focus, .jb-select:focus {
    border-color: var(--iser-verde, #1b9e88);
    outline: none;
    box-shadow: 0 0 0 2px rgba(27, 158, 136, 0.1);
}

/* Stats */
.jb-stats { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
.jb-stat {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 150px;
}
.jb-stat__value { font-size: 1.5rem; font-weight: 700; }
.jb-stat__label { font-size: 0.8125rem; color: var(--iser-gris-medio, #666); }
.jb-stat--primary .jb-stat__value { color: var(--iser-verde, #1b9e88); }
.jb-stat--verde .jb-stat__value { color: var(--iser-verde, #1b9e88); }
.jb-stat--amarillo .jb-stat__value { color: var(--iser-amarillo, #ffc107); }
.jb-stat--rojo .jb-stat__value { color: var(--iser-rojo, #c41e3a); }
.jb-stat--azul .jb-stat__value { color: var(--iser-azul, #0d6efd); }

/* Section Header */
.jb-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.jb-section-header__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--iser-rojo, #c41e3a);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-section-header__title i {
    color: var(--iser-verde, #1b9e88);
}

/* Grid */
.jb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
}

/* Convocatoria Card */
.jb-convocatoria-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
}

.jb-convocatoria-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}

.jb-convocatoria-card--urgent {
    border-top: 3px solid var(--iser-amarillo, #ffc107);
}

.jb-convocatoria-card__header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.jb-convocatoria-card__body {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.jb-convocatoria-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
}

.jb-convocatoria-card__title a {
    color: var(--iser-negro, #1a1a1a);
    text-decoration: none;
}

.jb-convocatoria-card__title a:hover {
    color: var(--iser-verde, #1b9e88);
}

.jb-convocatoria-card__desc {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
}

.jb-convocatoria-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
}

.jb-convocatoria-card__dates {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin-top: auto;
}

.jb-convocatoria-card__dates div {
    margin-bottom: 0.25rem;
}

.jb-convocatoria-card__dates i {
    margin-right: 0.375rem;
    width: 16px;
}

.jb-convocatoria-card__dates i.fa-calendar-check { color: var(--iser-verde, #1b9e88); }
.jb-convocatoria-card__dates i.fa-calendar-xmark { color: var(--iser-amarillo, #ffc107); }

.jb-convocatoria-card__footer {
    padding: 0.75rem 1rem;
    background: #f9fafb;
    border-top: 1px solid #f0f0f0;
    display: flex;
    gap: 0.5rem;
}

.jb-convocatoria-card__footer .jb-btn {
    flex: 1;
}

/* Buttons */
.jb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
}
.jb-btn--sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }
.jb-btn--primary { background: var(--iser-verde, #1b9e88); color: #fff; }
.jb-btn--primary:hover { background: var(--iser-verde-dark, #157a6a); color: #fff; }
.jb-btn--outline { background: transparent; border-color: #d1d5db; color: var(--iser-gris-oscuro, #333); }
.jb-btn--outline:hover { border-color: var(--iser-verde, #1b9e88); color: var(--iser-verde, #1b9e88); }
.jb-btn--success { background: #28a745; color: #fff; }
.jb-btn--ghost { background: transparent; color: var(--iser-gris-medio, #666); }
.jb-btn--ghost:hover { color: var(--iser-verde, #1b9e88); }

/* Links */
.jb-link { color: var(--iser-verde, #1b9e88); text-decoration: none; font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.375rem; }
.jb-link:hover { color: var(--iser-verde-dark, #157a6a); }
.jb-link--muted { color: var(--iser-gris-medio, #666); }

/* Badges */
.jb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
}
.jb-badge i { font-size: 0.625rem; }
