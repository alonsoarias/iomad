{{!
    @template local_jobboard/pages/public/index

    Public page - Clean and professional design.
    Follows the same pattern as the apply page.

    Context variables:
    * showconvocatorias - Boolean to show convocatorias list
    * showvacancies - Boolean to show vacancies for a convocatoria
    * pagetitle - Page title string
    * pagedescription - Page description HTML
    * stats - Array of statistic cards
    * isloggedin - Boolean if user is logged in
    * quickaccess - Quick access buttons for logged-in users
    * convocatoria - Current convocatoria data (for vacancies mode)
    * convocatorias - Array of convocatoria cards
    * vacancies - Array of vacancy cards
    * filterform - Filter form configuration
    * hasfilters - Boolean if filters are active
    * clearfiltersurl - URL to clear filters
    * pagination - Pagination HTML
    * loginurl - Login URL
    * signupurl - Signup URL

    Example context (json):
    {
        "showconvocatorias": true,
        "pagetitle": "Job Opportunities"
    }
}}
<div class="jb-public-page" id="jobboard-public">
    <div class="container-fluid px-0">
        {{! ================================================================ }}
        {{! MODE: VACANCIES FOR SPECIFIC CONVOCATORIA }}
        {{! ================================================================ }}
        {{#showvacancies}}
        {{! Convocatoria Info Card }}
        {{#convocatoria}}
        <div class="card shadow-sm mb-4 {{#isurgent}}border-warning{{/isurgent}}">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <code class="badge {{#isurgent}}bg-warning text-dark{{/isurgent}}{{^isurgent}}bg-primary{{/isurgent}} me-2">{{code}}</code>
                        <span class="h5 mb-0">{{name}}</span>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-light text-dark">
                            <i class="fa fa-briefcase me-1"></i>{{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                        </span>
                        <span class="badge bg-light text-dark">
                            <i class="fa fa-users me-1"></i>{{totalpositions}} {{#str}}positions, local_jobboard{{/str}}
                        </span>
                        {{#isurgent}}
                        <span class="badge bg-danger">
                            <i class="fa fa-exclamation-triangle me-1"></i>{{urgenttext}}
                        </span>
                        {{/isurgent}}
                    </div>
                </div>
            </div>
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small">
                    <div class="d-flex gap-3">
                        <span><i class="fa fa-calendar-check text-success me-1"></i> {{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></span>
                        <span class="{{#isurgent}}text-danger fw-bold{{/isurgent}}"><i class="fa fa-calendar-xmark text-warning me-1"></i> {{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></span>
                        {{#daysremaining}}
                        <span class="badge bg-{{#isurgent}}warning{{/isurgent}}{{^isurgent}}info{{/isurgent}}">{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
                        {{/daysremaining}}
                    </div>
                    <a href="{{detailsurl}}" class="btn btn-sm btn-outline-info">
                        <i class="fa fa-info-circle me-1"></i>{{#str}}viewdetails, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
        </div>
        {{/convocatoria}}

        {{! Filter Form }}
        {{#filterform}}
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light py-2">
                <h6 class="mb-0"><i class="fa fa-filter me-2 text-muted"></i>{{#str}}filtervacancies, local_jobboard{{/str}}</h6>
            </div>
            <div class="card-body py-3">
                <form method="get" action="{{action}}">
                    {{#hiddenfields}}
                    <input type="hidden" name="{{name}}" value="{{value}}">
                    {{/hiddenfields}}
                    <div class="row align-items-end">
                        <div class="col-lg-4 col-md-6 mb-2 mb-lg-0">
                            <label for="filter-search" class="form-label small text-muted mb-1">{{#str}}search{{/str}}</label>
                            <input type="search" name="search" id="filter-search" class="form-control form-control-sm" value="{{searchvalue}}" placeholder="{{#str}}searchvacancies, local_jobboard{{/str}}">
                        </div>
                        {{#showcontractfilter}}
                        <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                            <label for="filter-contracttype" class="form-label small text-muted mb-1">{{#str}}contracttype, local_jobboard{{/str}}</label>
                            <select name="contracttype" id="filter-contracttype" class="form-select form-select-sm">
                                <option value="">{{#str}}all{{/str}}</option>
                                {{#contractoptions}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/contractoptions}}
                            </select>
                        </div>
                        {{/showcontractfilter}}
                        {{#showlocationfilter}}
                        <div class="col-lg-3 col-md-6 mb-2 mb-lg-0">
                            <label for="filter-location" class="form-label small text-muted mb-1">{{#str}}location, local_jobboard{{/str}}</label>
                            <select name="location" id="filter-location" class="form-select form-select-sm">
                                <option value="">{{#str}}all{{/str}}</option>
                                {{#locationoptions}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/locationoptions}}
                            </select>
                        </div>
                        {{/showlocationfilter}}
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-search me-1"></i>{{#str}}filter, local_jobboard{{/str}}
                            </button>
                        </div>
                    </div>
                    {{#hasfilters}}
                    <div class="mt-3 pt-2 border-top">
                        <a href="{{clearfiltersurl}}" class="btn btn-sm btn-outline-danger">
                            <i class="fa fa-xmark me-1"></i>{{#str}}clearfilters, local_jobboard{{/str}}
                        </a>
                    </div>
                    {{/hasfilters}}
                </form>
            </div>
        </div>
        {{/filterform}}

        {{! Results Header }}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0"><i class="fa fa-briefcase me-2 text-primary"></i>{{#str}}vacancies, local_jobboard{{/str}}</h5>
            <small class="text-muted">{{resultstext}}</small>
        </div>

        {{! Vacancies Grid }}
        {{#hasvacancies}}
        <div class="row">
            {{#vacancies}}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm {{#isurgent}}border-warning{{/isurgent}}">
                    {{#isurgent}}
                    <div class="bg-warning text-dark py-1 px-3 small text-center">
                        <i class="fa fa-clock me-1"></i><strong>{{urgenttext}}</strong>
                    </div>
                    {{/isurgent}}
                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                        <code class="small text-muted">{{code}}</code>
                        <span class="badge bg-{{publicationtypecolor}}">{{publicationtypelabel}}</span>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title mb-3">
                            <a href="{{viewurl}}" class="text-decoration-none text-dark">{{title}}</a>
                        </h6>
                        <div class="small text-muted">
                            {{#location}}<div><i class="fa fa-location-dot text-primary me-2"></i>{{location}}</div>{{/location}}
                            {{#contracttypelabel}}<div><i class="fa fa-file-contract text-secondary me-2"></i>{{contracttypelabel}}</div>{{/contracttypelabel}}
                            <div><i class="fa fa-users text-success me-2"></i>{{positions}} {{#str}}positions, local_jobboard{{/str}}</div>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="{{#isurgent}}text-warning fw-bold{{/isurgent}}{{^isurgent}}text-muted{{/isurgent}}">
                                <i class="fa fa-calendar-xmark me-1"></i>{{closedateformatted}}
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="{{viewurl}}" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="fa fa-eye me-1"></i>{{#str}}view{{/str}}
                            </a>
                            {{#hasapplied}}
                            <span class="btn btn-sm btn-success disabled flex-fill"><i class="fa fa-check me-1"></i>{{#str}}applied, local_jobboard{{/str}}</span>
                            {{/hasapplied}}
                            {{^hasapplied}}
                            {{#canapply}}
                            <a href="{{applyurl}}" class="btn btn-sm btn-primary flex-fill"><i class="fa fa-paper-plane me-1"></i>{{#str}}apply, local_jobboard{{/str}}</a>
                            {{/canapply}}
                            {{^isloggedin}}
                            <a href="{{loginapplyurl}}" class="btn btn-sm btn-outline-secondary flex-fill"><i class="fa fa-sign-in-alt me-1"></i>{{#str}}login{{/str}}</a>
                            {{/isloggedin}}
                            {{/hasapplied}}
                        </div>
                    </div>
                </div>
            </div>
            {{/vacancies}}
        </div>
        {{/hasvacancies}}

        {{! Empty State }}
        {{^hasvacancies}}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fa fa-briefcase fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">{{#str}}novacancies, local_jobboard{{/str}}</h5>
                <p class="text-muted">{{#str}}novacancies_desc, local_jobboard{{/str}}</p>
            </div>
        </div>
        {{/hasvacancies}}

        {{! Pagination }}
        {{#pagination}}
        <nav class="mt-4 d-flex justify-content-center">{{{pagination}}}</nav>
        {{/pagination}}

        {{! CTA for Non-Logged In }}
        {{^isloggedin}}
        {{#hasvacancies}}
        <div class="card border-primary mt-4">
            <div class="card-body text-center py-4">
                <p class="mb-3 text-muted">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{signupurl}}" class="btn btn-primary"><i class="fa fa-user-plus me-2"></i>{{#str}}createaccount{{/str}}</a>
                    <a href="{{loginurl}}" class="btn btn-outline-secondary"><i class="fa fa-sign-in-alt me-2"></i>{{#str}}login{{/str}}</a>
                </div>
            </div>
        </div>
        {{/hasvacancies}}
        {{/isloggedin}}
        {{/showvacancies}}

        {{! ================================================================ }}
        {{! MODE: CONVOCATORIAS LIST (DEFAULT) }}
        {{! ================================================================ }}
        {{#showconvocatorias}}
        {{! Statistics Row }}
        {{#hasstats}}
        <div class="row mb-4">
            {{#stats}}
            <div class="col-lg-3 col-md-6 mb-2">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="h3 text-{{color}} mb-0">{{value}}</div>
                        <small class="text-muted">{{label}}</small>
                    </div>
                </div>
            </div>
            {{/stats}}
        </div>
        {{/hasstats}}

        {{! Section Title }}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0"><i class="fa fa-folder-open me-2 text-primary"></i>{{#str}}openconvocatorias, local_jobboard{{/str}}</h5>
        </div>

        {{! Convocatorias Grid }}
        {{#hasconvocatorias}}
        <div class="row">
            {{#convocatorias}}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm {{#isurgent}}border-warning{{/isurgent}}">
                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                        <code class="badge {{#isurgent}}bg-warning text-dark{{/isurgent}}{{^isurgent}}bg-primary{{/isurgent}}">{{code}}</code>
                        {{#isurgent}}
                        <span class="badge bg-danger small"><i class="fa fa-exclamation-triangle me-1"></i>{{urgenttext}}</span>
                        {{/isurgent}}
                        {{^isurgent}}
                        <span class="badge bg-success small"><i class="fa fa-check-circle me-1"></i>{{#str}}convocatoria_status_open, local_jobboard{{/str}}</span>
                        {{/isurgent}}
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title mb-3">
                            <a href="{{detailsurl}}" class="text-decoration-none text-dark">{{name}}</a>
                        </h6>
                        {{#descriptionexcerpt}}<p class="text-muted small mb-3">{{descriptionexcerpt}}</p>{{/descriptionexcerpt}}
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-light text-dark"><i class="fa fa-briefcase text-primary me-1"></i>{{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}</span>
                            <span class="badge bg-light text-dark"><i class="fa fa-users text-info me-1"></i>{{totalpositions}} {{#str}}positions, local_jobboard{{/str}}</span>
                        </div>
                        <div class="small text-muted mt-auto">
                            <div class="mb-1"><i class="fa fa-calendar-check text-success me-2"></i>{{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></div>
                            <div class="{{#isurgent}}text-danger fw-bold{{/isurgent}}"><i class="fa fa-calendar-xmark text-warning me-2"></i>{{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></div>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex gap-2">
                            <a href="{{detailsurl}}" class="btn btn-sm btn-outline-info flex-fill"><i class="fa fa-info-circle me-1"></i>{{#str}}details{{/str}}</a>
                            <a href="{{vacanciesurl}}" class="btn btn-sm btn-primary flex-fill"><i class="fa fa-briefcase me-1"></i>{{#str}}viewvacancies, local_jobboard{{/str}}</a>
                        </div>
                    </div>
                </div>
            </div>
            {{/convocatorias}}
        </div>
        {{/hasconvocatorias}}

        {{! Empty State }}
        {{^hasconvocatorias}}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fa fa-folder-open fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">{{#str}}noconvocatorias, local_jobboard{{/str}}</h5>
                <p class="text-muted">{{#str}}noconvocatorias_desc, local_jobboard{{/str}}</p>
            </div>
        </div>
        {{/hasconvocatorias}}

        {{! CTA for Non-Logged In }}
        {{^isloggedin}}
        {{#hasconvocatorias}}
        <div class="card border-primary mt-4">
            <div class="card-body text-center py-4">
                <p class="mb-3 text-muted">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{signupurl}}" class="btn btn-primary"><i class="fa fa-user-plus me-2"></i>{{#str}}createaccount{{/str}}</a>
                    <a href="{{loginurl}}" class="btn btn-outline-secondary"><i class="fa fa-sign-in-alt me-2"></i>{{#str}}login{{/str}}</a>
                </div>
            </div>
        </div>
        {{/hasconvocatorias}}
        {{/isloggedin}}
        {{/showconvocatorias}}
    </div>
</div>

{{! Minimal CSS }}
<style>
.jb-public-page .card { border-radius: 0.5rem; }
</style>
