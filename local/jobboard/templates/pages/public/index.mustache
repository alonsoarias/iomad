{{!
    @template local_jobboard/pages/public/index

    Public page - ISER Brand Design
    Based on Manual de Identidad Visual ISER (M-GCRP-01 v01)

    Context variables:
    * showconvocatorias - Boolean to show convocatorias list
    * showvacancies - Boolean to show vacancies for a convocatoria
    * pagetitle - Page title string
    * pagedescription - Page description HTML
    * stats - Array of statistic cards
    * isloggedin - Boolean if user is logged in
    * quickaccess - Quick access buttons for logged-in users
    * convocatoria - Current convocatoria data (for vacancies mode)
    * convocatorias - Array of convocatoria cards
    * vacancies - Array of vacancy cards
    * filterform - Filter form configuration
    * hasfilters - Boolean if filters are active
    * clearfiltersurl - URL to clear filters
    * pagination - Pagination HTML
    * loginurl - Login URL
    * signupurl - Signup URL
}}
<div class="jb-public-page jb-iser-theme" id="jobboard-public">
    {{! ================================================================ }}
    {{! HERO SECTION - ISER BRANDED }}
    {{! ================================================================ }}
    <div class="jb-hero-section" style="background: linear-gradient(135deg, var(--iser-verde) 0%, var(--iser-verde-dark) 100%); border-radius: var(--jb-radius-xl); padding: var(--jb-space-8); margin-bottom: var(--jb-space-6); color: var(--iser-blanco);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 style="font-size: var(--jb-text-4xl); font-weight: var(--jb-font-bold); margin-bottom: var(--jb-space-3);">
                    {{#showconvocatorias}}
                    <i class="fa fa-folder-open me-3"></i>{{#str}}openconvocatorias, local_jobboard{{/str}}
                    {{/showconvocatorias}}
                    {{#showvacancies}}
                    <i class="fa fa-briefcase me-3"></i>{{#str}}vacancies, local_jobboard{{/str}}
                    {{/showvacancies}}
                </h1>
                <p style="font-size: var(--jb-text-lg); opacity: 0.9; margin-bottom: 0;">
                    {{#showconvocatorias}}{{#str}}browseconvocatorias_desc, local_jobboard{{/str}}{{/showconvocatorias}}
                    {{#showvacancies}}{{#str}}browsevacancies_desc, local_jobboard{{/str}}{{/showvacancies}}
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                {{^isloggedin}}
                <a href="{{signupurl}}" class="btn btn-lg" style="background: var(--iser-amarillo); color: var(--iser-negro); font-weight: var(--jb-font-bold); border: none; padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md);">
                    <i class="fa fa-user-plus me-2"></i>{{#str}}createaccount{{/str}}
                </a>
                {{/isloggedin}}
            </div>
        </div>
    </div>

    {{! ================================================================ }}
    {{! MODE: VACANCIES FOR SPECIFIC CONVOCATORIA }}
    {{! ================================================================ }}
    {{#showvacancies}}
    {{! Convocatoria Info Card }}
    {{#convocatoria}}
    <div class="jb-convocatoria-header mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; {{#isurgent}}border-left: 4px solid var(--iser-amarillo);{{/isurgent}}">
        <div style="padding: var(--jb-space-4) var(--jb-space-5); border-bottom: 2px solid var(--iser-verde);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <code style="background: {{#isurgent}}var(--iser-amarillo){{/isurgent}}{{^isurgent}}var(--iser-verde){{/isurgent}}; color: {{#isurgent}}var(--iser-negro){{/isurgent}}{{^isurgent}}var(--iser-blanco){{/isurgent}}; padding: var(--jb-space-2) var(--jb-space-3); border-radius: var(--jb-radius-md); font-weight: var(--jb-font-bold);">{{code}}</code>
                    <h2 style="font-size: var(--jb-text-xl); font-weight: var(--jb-font-semibold); color: var(--iser-rojo); margin: 0;">{{name}}</h2>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <span style="background: var(--iser-verde-lighter); color: var(--iser-verde-dark); padding: var(--jb-space-1) var(--jb-space-3); border-radius: var(--jb-radius-full); font-size: var(--jb-text-sm);">
                        <i class="fa fa-briefcase me-1"></i>{{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                    </span>
                    <span style="background: var(--iser-azul-lighter); color: var(--iser-azul); padding: var(--jb-space-1) var(--jb-space-3); border-radius: var(--jb-radius-full); font-size: var(--jb-text-sm);">
                        <i class="fa fa-users me-1"></i>{{totalpositions}} {{#str}}positions, local_jobboard{{/str}}
                    </span>
                    {{#isurgent}}
                    <span style="background: var(--iser-rojo); color: var(--iser-blanco); padding: var(--jb-space-1) var(--jb-space-3); border-radius: var(--jb-radius-full); font-size: var(--jb-text-sm); font-weight: var(--jb-font-bold);">
                        <i class="fa fa-exclamation-triangle me-1"></i>{{urgenttext}}
                    </span>
                    {{/isurgent}}
                </div>
            </div>
        </div>
        <div style="padding: var(--jb-space-3) var(--jb-space-5); background: var(--jb-gray-50);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-4 flex-wrap" style="font-size: var(--jb-text-sm);">
                    <span><i class="fa fa-calendar-check me-2" style="color: var(--iser-verde);"></i>{{#str}}startdate, local_jobboard{{/str}}: <strong>{{startdateformatted}}</strong></span>
                    <span style="{{#isurgent}}color: var(--iser-rojo); font-weight: var(--jb-font-bold);{{/isurgent}}"><i class="fa fa-calendar-xmark me-2" style="color: var(--iser-amarillo);"></i>{{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></span>
                    {{#daysremaining}}
                    <span style="background: {{#isurgent}}var(--iser-amarillo){{/isurgent}}{{^isurgent}}var(--iser-azul-lighter){{/isurgent}}; color: {{#isurgent}}var(--iser-negro){{/isurgent}}{{^isurgent}}var(--iser-azul){{/isurgent}}; padding: 2px 10px; border-radius: var(--jb-radius-full); font-weight: var(--jb-font-semibold);">{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
                    {{/daysremaining}}
                </div>
                <a href="{{detailsurl}}" style="color: var(--iser-verde); font-weight: var(--jb-font-medium); text-decoration: none;">
                    <i class="fa fa-info-circle me-1"></i>{{#str}}viewdetails, local_jobboard{{/str}}
                </a>
            </div>
        </div>
    </div>
    {{/convocatoria}}

    {{! Filter Form }}
    {{#filterform}}
    <div class="jb-filter-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden;">
        <div style="padding: var(--jb-space-3) var(--jb-space-4); background: var(--jb-gray-50); border-bottom: 1px solid var(--jb-gray-200);">
            <h6 style="margin: 0; color: var(--iser-gris-oscuro); font-weight: var(--jb-font-semibold);">
                <i class="fa fa-filter me-2" style="color: var(--iser-verde);"></i>{{#str}}filtervacancies, local_jobboard{{/str}}
            </h6>
        </div>
        <div style="padding: var(--jb-space-4);">
            <form method="get" action="{{action}}" class="jb-filter-form">
                {{#hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="row align-items-end g-3">
                    <div class="col-lg-4 col-md-6">
                        <label for="filter-search" style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-1); display: block;">{{#str}}search{{/str}}</label>
                        <input type="search" name="search" id="filter-search" value="{{searchvalue}}" placeholder="{{#str}}searchvacancies, local_jobboard{{/str}}" style="width: 100%; padding: var(--jb-space-2) var(--jb-space-3); border: 2px solid var(--iser-gris-claro); border-radius: var(--jb-radius-md); font-size: var(--jb-text-base);">
                    </div>
                    {{#showcontractfilter}}
                    <div class="col-lg-3 col-md-6">
                        <label for="filter-contracttype" style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-1); display: block;">{{#str}}contracttype, local_jobboard{{/str}}</label>
                        <select name="contracttype" id="filter-contracttype" style="width: 100%; padding: var(--jb-space-2) var(--jb-space-3); border: 2px solid var(--iser-gris-claro); border-radius: var(--jb-radius-md); font-size: var(--jb-text-base); background: var(--iser-blanco);">
                            <option value="">{{#str}}all{{/str}}</option>
                            {{#contractoptions}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/contractoptions}}
                        </select>
                    </div>
                    {{/showcontractfilter}}
                    {{#showlocationfilter}}
                    <div class="col-lg-3 col-md-6">
                        <label for="filter-location" style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-1); display: block;">{{#str}}location, local_jobboard{{/str}}</label>
                        <select name="location" id="filter-location" style="width: 100%; padding: var(--jb-space-2) var(--jb-space-3); border: 2px solid var(--iser-gris-claro); border-radius: var(--jb-radius-md); font-size: var(--jb-text-base); background: var(--iser-blanco);">
                            <option value="">{{#str}}all{{/str}}</option>
                            {{#locationoptions}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/locationoptions}}
                        </select>
                    </div>
                    {{/showlocationfilter}}
                    <div class="col-auto">
                        <button type="submit" style="background: var(--iser-verde); color: var(--iser-blanco); border: none; padding: var(--jb-space-2) var(--jb-space-4); border-radius: var(--jb-radius-md); font-weight: var(--jb-font-semibold); cursor: pointer;">
                            <i class="fa fa-search me-1"></i>{{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
                {{#hasfilters}}
                <div style="margin-top: var(--jb-space-3); padding-top: var(--jb-space-3); border-top: 1px solid var(--jb-gray-200);">
                    <a href="{{clearfiltersurl}}" style="color: var(--iser-rojo); font-size: var(--jb-text-sm); text-decoration: none;">
                        <i class="fa fa-xmark me-1"></i>{{#str}}clearfilters, local_jobboard{{/str}}
                    </a>
                </div>
                {{/hasfilters}}
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! Results Header }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 style="font-size: var(--jb-text-xl); font-weight: var(--jb-font-semibold); color: var(--iser-rojo); margin: 0;">
            <i class="fa fa-briefcase me-2" style="color: var(--iser-verde);"></i>{{#str}}vacancies, local_jobboard{{/str}}
        </h3>
        <span style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio);">{{resultstext}}</span>
    </div>

    {{! Vacancies Grid }}
    {{#hasvacancies}}
    <div class="row g-4">
        {{#vacancies}}
        <div class="col-lg-4 col-md-6">
            <div class="jb-vacancy-card" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 16px rgba(0,0,0,0.08); overflow: hidden; height: 100%; display: flex; flex-direction: column; transition: transform 0.2s ease, box-shadow 0.2s ease; {{#isurgent}}border-top: 3px solid var(--iser-amarillo);{{/isurgent}}">
                {{#isurgent}}
                <div style="background: var(--iser-amarillo); color: var(--iser-negro); padding: var(--jb-space-1) var(--jb-space-3); font-size: var(--jb-text-xs); text-align: center; font-weight: var(--jb-font-bold);">
                    <i class="fa fa-clock me-1"></i>{{urgenttext}}
                </div>
                {{/isurgent}}
                <div style="padding: var(--jb-space-3) var(--jb-space-4); border-bottom: 1px solid var(--jb-gray-100); display: flex; justify-content: space-between; align-items: center;">
                    <code style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio);">{{code}}</code>
                    <span style="background: var(--iser-{{publicationtypecolor}}-lighter, var(--jb-gray-100)); color: var(--iser-{{publicationtypecolor}}, var(--iser-gris-oscuro)); padding: 2px 8px; border-radius: var(--jb-radius-full); font-size: var(--jb-text-xs);">{{publicationtypelabel}}</span>
                </div>
                <div style="padding: var(--jb-space-4); flex: 1;">
                    <h4 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); margin-bottom: var(--jb-space-3);">
                        <a href="{{viewurl}}" style="color: var(--iser-negro); text-decoration: none;">{{title}}</a>
                    </h4>
                    <div style="font-size: var(--jb-text-sm); color: var(--iser-gris-oscuro);">
                        {{#location}}<div style="margin-bottom: var(--jb-space-1);"><i class="fa fa-location-dot me-2" style="color: var(--iser-verde); width: 16px;"></i>{{location}}</div>{{/location}}
                        {{#contracttypelabel}}<div style="margin-bottom: var(--jb-space-1);"><i class="fa fa-file-contract me-2" style="color: var(--iser-gris-medio); width: 16px;"></i>{{contracttypelabel}}</div>{{/contracttypelabel}}
                        <div><i class="fa fa-users me-2" style="color: var(--iser-azul); width: 16px;"></i>{{positions}} {{#str}}positions, local_jobboard{{/str}}</div>
                    </div>
                </div>
                <div style="padding: var(--jb-space-3) var(--jb-space-4); background: var(--jb-gray-50); border-top: 1px solid var(--jb-gray-100);">
                    <div style="font-size: var(--jb-text-sm); margin-bottom: var(--jb-space-2); {{#isurgent}}color: var(--iser-rojo); font-weight: var(--jb-font-bold);{{/isurgent}}{{^isurgent}}color: var(--iser-gris-medio);{{/isurgent}}">
                        <i class="fa fa-calendar-xmark me-1"></i>{{closedateformatted}}
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{viewurl}}" style="flex: 1; text-align: center; padding: var(--jb-space-2); border: 2px solid var(--iser-verde); color: var(--iser-verde); border-radius: var(--jb-radius-md); text-decoration: none; font-size: var(--jb-text-sm); font-weight: var(--jb-font-medium);">
                            <i class="fa fa-eye me-1"></i>{{#str}}view{{/str}}
                        </a>
                        {{#hasapplied}}
                        <span style="flex: 1; text-align: center; padding: var(--jb-space-2); background: var(--iser-verde); color: var(--iser-blanco); border-radius: var(--jb-radius-md); font-size: var(--jb-text-sm); font-weight: var(--jb-font-medium);">
                            <i class="fa fa-check me-1"></i>{{#str}}applied, local_jobboard{{/str}}
                        </span>
                        {{/hasapplied}}
                        {{^hasapplied}}
                        {{#canapply}}
                        <a href="{{applyurl}}" style="flex: 1; text-align: center; padding: var(--jb-space-2); background: var(--iser-verde); color: var(--iser-blanco); border-radius: var(--jb-radius-md); text-decoration: none; font-size: var(--jb-text-sm); font-weight: var(--jb-font-medium);">
                            <i class="fa fa-paper-plane me-1"></i>{{#str}}apply, local_jobboard{{/str}}
                        </a>
                        {{/canapply}}
                        {{^isloggedin}}
                        <a href="{{loginapplyurl}}" style="flex: 1; text-align: center; padding: var(--jb-space-2); border: 2px solid var(--iser-gris-medio); color: var(--iser-gris-oscuro); border-radius: var(--jb-radius-md); text-decoration: none; font-size: var(--jb-text-sm); font-weight: var(--jb-font-medium);">
                            <i class="fa fa-sign-in-alt me-1"></i>{{#str}}login{{/str}}
                        </a>
                        {{/isloggedin}}
                        {{/hasapplied}}
                    </div>
                </div>
            </div>
        </div>
        {{/vacancies}}
    </div>
    {{/hasvacancies}}

    {{! Empty State }}
    {{^hasvacancies}}
    <div style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: var(--jb-space-8); text-align: center;">
        <i class="fa fa-briefcase" style="font-size: 4rem; color: var(--iser-gris-claro); margin-bottom: var(--jb-space-4); display: block;"></i>
        <h4 style="color: var(--iser-rojo); margin-bottom: var(--jb-space-2);">{{#str}}novacancies, local_jobboard{{/str}}</h4>
        <p style="color: var(--iser-gris-medio); max-width: 400px; margin: 0 auto;">{{#str}}novacancies_desc, local_jobboard{{/str}}</p>
    </div>
    {{/hasvacancies}}

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-5 d-flex justify-content-center">{{{pagination}}}</nav>
    {{/pagination}}

    {{! CTA for Non-Logged In }}
    {{^isloggedin}}
    {{#hasvacancies}}
    <div style="background: linear-gradient(135deg, var(--iser-verde-lighter) 0%, var(--iser-blanco) 100%); border: 2px solid var(--iser-verde); border-radius: var(--jb-radius-lg); padding: var(--jb-space-6); text-align: center; margin-top: var(--jb-space-6);">
        <p style="color: var(--iser-gris-oscuro); margin-bottom: var(--jb-space-4);">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="{{signupurl}}" style="background: var(--iser-verde); color: var(--iser-blanco); padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-semibold);">
                <i class="fa fa-user-plus me-2"></i>{{#str}}createaccount{{/str}}
            </a>
            <a href="{{loginurl}}" style="background: transparent; border: 2px solid var(--iser-gris-medio); color: var(--iser-gris-oscuro); padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-medium);">
                <i class="fa fa-sign-in-alt me-2"></i>{{#str}}login{{/str}}
            </a>
        </div>
    </div>
    {{/hasvacancies}}
    {{/isloggedin}}
    {{/showvacancies}}

    {{! ================================================================ }}
    {{! MODE: CONVOCATORIAS LIST (DEFAULT) }}
    {{! ================================================================ }}
    {{#showconvocatorias}}
    {{! Statistics Row }}
    {{#hasstats}}
    <div class="row g-4 mb-5">
        {{#stats}}
        <div class="col-lg-3 col-md-6">
            <div style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 16px rgba(0,0,0,0.08); padding: var(--jb-space-4); text-align: center; border-top: 4px solid var(--iser-{{color}}, var(--iser-verde));">
                <div style="font-size: var(--jb-text-3xl); font-weight: var(--jb-font-bold); color: var(--iser-{{color}}, var(--iser-verde)); margin-bottom: var(--jb-space-1);">{{value}}</div>
                <div style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio);">{{label}}</div>
            </div>
        </div>
        {{/stats}}
    </div>
    {{/hasstats}}

    {{! Section Title }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 style="font-size: var(--jb-text-xl); font-weight: var(--jb-font-semibold); color: var(--iser-rojo); margin: 0;">
            <i class="fa fa-folder-open me-2" style="color: var(--iser-verde);"></i>{{#str}}openconvocatorias, local_jobboard{{/str}}
        </h3>
    </div>

    {{! Convocatorias Grid }}
    {{#hasconvocatorias}}
    <div class="row g-4">
        {{#convocatorias}}
        <div class="col-lg-4 col-md-6">
            <div class="jb-convocatoria-card" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 16px rgba(0,0,0,0.08); overflow: hidden; height: 100%; display: flex; flex-direction: column; transition: transform 0.2s ease, box-shadow 0.2s ease; {{#isurgent}}border-top: 3px solid var(--iser-amarillo);{{/isurgent}}">
                <div style="padding: var(--jb-space-3) var(--jb-space-4); border-bottom: 1px solid var(--jb-gray-100); display: flex; justify-content: space-between; align-items: center;">
                    <code style="background: {{#isurgent}}var(--iser-amarillo){{/isurgent}}{{^isurgent}}var(--iser-verde){{/isurgent}}; color: {{#isurgent}}var(--iser-negro){{/isurgent}}{{^isurgent}}var(--iser-blanco){{/isurgent}}; padding: var(--jb-space-1) var(--jb-space-2); border-radius: var(--jb-radius-sm); font-size: var(--jb-text-sm); font-weight: var(--jb-font-bold);">{{code}}</code>
                    {{#isurgent}}
                    <span style="background: var(--iser-rojo); color: var(--iser-blanco); padding: 2px 8px; border-radius: var(--jb-radius-full); font-size: var(--jb-text-xs); font-weight: var(--jb-font-bold);">
                        <i class="fa fa-exclamation-triangle me-1"></i>{{urgenttext}}
                    </span>
                    {{/isurgent}}
                    {{^isurgent}}
                    <span style="background: var(--iser-verde-lighter); color: var(--iser-verde); padding: 2px 8px; border-radius: var(--jb-radius-full); font-size: var(--jb-text-xs);">
                        <i class="fa fa-check-circle me-1"></i>{{#str}}convocatoria_status_open, local_jobboard{{/str}}
                    </span>
                    {{/isurgent}}
                </div>
                <div style="padding: var(--jb-space-4); flex: 1; display: flex; flex-direction: column;">
                    <h4 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); margin-bottom: var(--jb-space-3);">
                        <a href="{{detailsurl}}" style="color: var(--iser-negro); text-decoration: none;">{{name}}</a>
                    </h4>
                    {{#descriptionexcerpt}}<p style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-3);">{{descriptionexcerpt}}</p>{{/descriptionexcerpt}}
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span style="background: var(--iser-verde-lighter); color: var(--iser-verde-dark); padding: 2px 10px; border-radius: var(--jb-radius-full); font-size: var(--jb-text-xs);">
                            <i class="fa fa-briefcase me-1"></i>{{vacancycount}} {{#str}}vacancies, local_jobboard{{/str}}
                        </span>
                        <span style="background: var(--iser-azul-lighter); color: var(--iser-azul); padding: 2px 10px; border-radius: var(--jb-radius-full); font-size: var(--jb-text-xs);">
                            <i class="fa fa-users me-1"></i>{{totalpositions}} {{#str}}positions, local_jobboard{{/str}}
                        </span>
                    </div>
                    <div style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-top: auto;">
                        <div style="margin-bottom: var(--jb-space-1);"><i class="fa fa-calendar-check me-2" style="color: var(--iser-verde);"></i>{{#str}}startdate, local_jobboard{{/str}}: <strong style="color: var(--iser-negro);">{{startdateformatted}}</strong></div>
                        <div style="{{#isurgent}}color: var(--iser-rojo); font-weight: var(--jb-font-bold);{{/isurgent}}"><i class="fa fa-calendar-xmark me-2" style="color: var(--iser-amarillo);"></i>{{#str}}enddate, local_jobboard{{/str}}: <strong>{{enddateformatted}}</strong></div>
                    </div>
                </div>
                <div style="padding: var(--jb-space-3) var(--jb-space-4); background: var(--jb-gray-50); border-top: 1px solid var(--jb-gray-100);">
                    <div class="d-flex gap-2">
                        <a href="{{detailsurl}}" style="flex: 1; text-align: center; padding: var(--jb-space-2); border: 2px solid var(--iser-azul); color: var(--iser-azul); border-radius: var(--jb-radius-md); text-decoration: none; font-size: var(--jb-text-sm); font-weight: var(--jb-font-medium);">
                            <i class="fa fa-info-circle me-1"></i>{{#str}}details{{/str}}
                        </a>
                        <a href="{{vacanciesurl}}" style="flex: 1; text-align: center; padding: var(--jb-space-2); background: var(--iser-verde); color: var(--iser-blanco); border-radius: var(--jb-radius-md); text-decoration: none; font-size: var(--jb-text-sm); font-weight: var(--jb-font-medium);">
                            <i class="fa fa-briefcase me-1"></i>{{#str}}viewvacancies, local_jobboard{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/convocatorias}}
    </div>
    {{/hasconvocatorias}}

    {{! Empty State }}
    {{^hasconvocatorias}}
    <div style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: var(--jb-space-8); text-align: center;">
        <i class="fa fa-folder-open" style="font-size: 4rem; color: var(--iser-gris-claro); margin-bottom: var(--jb-space-4); display: block;"></i>
        <h4 style="color: var(--iser-rojo); margin-bottom: var(--jb-space-2);">{{#str}}noconvocatorias, local_jobboard{{/str}}</h4>
        <p style="color: var(--iser-gris-medio); max-width: 400px; margin: 0 auto;">{{#str}}noconvocatorias_desc, local_jobboard{{/str}}</p>
    </div>
    {{/hasconvocatorias}}

    {{! CTA for Non-Logged In }}
    {{^isloggedin}}
    {{#hasconvocatorias}}
    <div style="background: linear-gradient(135deg, var(--iser-verde-lighter) 0%, var(--iser-blanco) 100%); border: 2px solid var(--iser-verde); border-radius: var(--jb-radius-lg); padding: var(--jb-space-6); text-align: center; margin-top: var(--jb-space-6);">
        <p style="color: var(--iser-gris-oscuro); margin-bottom: var(--jb-space-4);">{{#str}}createaccounttoapply, local_jobboard{{/str}}</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="{{signupurl}}" style="background: var(--iser-verde); color: var(--iser-blanco); padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-semibold);">
                <i class="fa fa-user-plus me-2"></i>{{#str}}createaccount{{/str}}
            </a>
            <a href="{{loginurl}}" style="background: transparent; border: 2px solid var(--iser-gris-medio); color: var(--iser-gris-oscuro); padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-medium);">
                <i class="fa fa-sign-in-alt me-2"></i>{{#str}}login{{/str}}
            </a>
        </div>
    </div>
    {{/hasconvocatorias}}
    {{/isloggedin}}
    {{/showconvocatorias}}
</div>

