{{!
    @template local_jobboard/pages/public_vacancy

    Public vacancy detail page template with enhanced UX.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * breadcrumbs - Array of breadcrumb items
    * vacancy - Vacancy data object
    * convocatoria - Optional convocatoria info
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * isloggedin - Boolean if user is logged in
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * userapplication - User's application if exists
    * sharelinks - Social sharing URLs
    * loading - Show skeleton loading state

    Example context (json):
    {
        "vacancy": {"id": 1, "title": "Developer", "code": "VAC-001"},
        "canapply": true,
        "hasapplied": false
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-public-vacancy" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-page-header mb-4">
        <div class="jb-skeleton-text" style="width: 250px; height: 1em;"></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="jb-skeleton-title" style="width: 60%;"></div>
            <div class="jb-skeleton-text" style="width: 140px; height: 45px;"></div>
        </div>
    </div>
    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 70px;"></div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 40%;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-text" style="width: 100%;"></div>
                    <div class="jb-skeleton-text" style="width: 90%;"></div>
                    <div class="jb-skeleton-text" style="width: 75%;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary"><div class="jb-skeleton-text bg-white" style="width: 50%; opacity: 0.3;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-text" style="width: 80%;"></div>
                    <div class="jb-skeleton-text" style="width: 60%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-public-vacancy" data-region="jobboard-public-vacancy" data-vacancy-id="{{vacancy.id}}">
    {{! Skip Link for Accessibility }}
    <a href="#vacancy-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header mb-4 jb-fade-in">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="fs-4 mb-1">{{vacancy.title}}</h1>
                <code class="small text-muted">{{vacancy.code}}</code>
            </div>
            {{^isclosed}}
            {{#canapply}}
            {{^hasapplied}}
            <a href="{{applyurl}}" class="btn btn-success btn-lg jb-hover-lift jb-pulse-subtle">
                <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                {{#str}}apply, local_jobboard{{/str}}
            </a>
            {{/hasapplied}}
            {{/canapply}}
            {{/isclosed}}
        </div>
    </header>

    {{! Urgent Banner }}
    {{#isurgent}}
    {{^isclosed}}
    <div class="alert alert-warning d-flex align-items-center justify-content-center mb-4 jb-fade-in-up" role="alert" aria-live="polite">
        <i class="fa fa-triangle-exclamation fa-lg me-3" aria-hidden="true"></i>
        <div>
            <strong>{{#str}}closingsoon, local_jobboard{{/str}}</strong>
            <span class="ms-2">{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
        </div>
    </div>
    {{/isclosed}}
    {{/isurgent}}

    {{! Status Banner }}
    <div class="alert jb-alert-{{statuscolor}} d-flex justify-content-between align-items-center mb-4 jb-fade-in-up" role="status">
        <span class="fw-medium d-flex align-items-center">
            <i class="fa fa-{{statusicon}} me-2" aria-hidden="true"></i>
            {{statusmessage}}
        </span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge jb-badge-{{vacancy.statuscolor}}">{{vacancy.statuslabel}}</span>
        </div>
    </div>

    <div class="row" id="vacancy-main-content">
        {{! Main Content Column }}
        <main class="col-lg-8">
            {{! Description Card }}
            {{#vacancy.description}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="desc-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                    <h2 class="fs-5 mb-0" id="desc-heading">
                        {{#str}}vacancydescription, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.description}}}
                </div>
            </section>
            {{/vacancy.description}}

            {{! Requirements Card }}
            {{#vacancy.requirements}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.2s;" aria-labelledby="req-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-list-check text-warning me-2" aria-hidden="true"></i>
                    <h2 class="fs-5 mb-0" id="req-heading">
                        {{#str}}requirements, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.requirements}}}
                </div>
            </section>
            {{/vacancy.requirements}}

            {{! Desirable Card }}
            {{#vacancy.desirable}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.3s;" aria-labelledby="des-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-star text-info me-2" aria-hidden="true"></i>
                    <h2 class="fs-5 mb-0" id="des-heading">
                        {{#str}}desirable, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.desirable}}}
                </div>
            </section>
            {{/vacancy.desirable}}

            {{! Benefits Card }}
            {{#vacancy.benefits}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.4s;" aria-labelledby="benefits-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-gift text-success me-2" aria-hidden="true"></i>
                    <h2 class="fs-5 mb-0" id="benefits-heading">
                        {{#str}}benefits, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.benefits}}}
                </div>
            </section>
            {{/vacancy.benefits}}
        </main>

        {{! Sidebar Column }}
        <aside class="col-lg-4">
            <div class="jb-sticky-sidebar">
                {{! Key Details Card }}
                <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="details-heading">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fa fa-circle-info fa-lg text-primary me-3" aria-hidden="true"></i>
                        <h2 class="fs-5 mb-0" id="details-heading">
                            {{#str}}details, local_jobboard{{/str}}
                        </h2>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            {{#vacancy.contracttypelabel}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-file-contract text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}contracttype, local_jobboard{{/str}}
                                </span>
                                <strong>{{vacancy.contracttypelabel}}</strong>
                            </li>
                            {{/vacancy.contracttypelabel}}

                            {{#vacancy.duration}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-hourglass-half text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}duration, local_jobboard{{/str}}
                                </span>
                                <strong>{{vacancy.duration}}</strong>
                            </li>
                            {{/vacancy.duration}}

                            {{#vacancy.location}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-location-dot text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}location, local_jobboard{{/str}}
                                </span>
                                <strong>{{vacancy.location}}</strong>
                            </li>
                            {{/vacancy.location}}

                            {{#vacancy.modality}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-house-laptop text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}modality, local_jobboard{{/str}}
                                </span>
                                <strong>{{vacancy.modality}}</strong>
                            </li>
                            {{/vacancy.modality}}

                            {{#vacancy.department}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-building text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}department, local_jobboard{{/str}}
                                </span>
                                <strong>{{vacancy.department}}</strong>
                            </li>
                            {{/vacancy.department}}

                            {{#vacancy.companyname}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-industry text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}company, local_jobboard{{/str}}
                                </span>
                                <strong>{{vacancy.companyname}}</strong>
                            </li>
                            {{/vacancy.companyname}}

                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-users text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}positions, local_jobboard{{/str}}
                                </span>
                                <span class="badge bg-primary rounded-pill">{{vacancy.positions}}</span>
                            </li>

                            {{#convocatoria}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="d-flex align-items-center">
                                    <i class="fa fa-folder-open text-muted me-2" aria-hidden="true"></i>
                                    {{#str}}convocatoria, local_jobboard{{/str}}
                                </span>
                                <a href="{{convocatoria.viewurl}}" class="badge bg-info text-dark jb-hover-lift">{{convocatoria.code}}</a>
                            </li>
                            {{/convocatoria}}
                        </ul>
                    </div>
                </section>

                {{! Dates Card }}
                <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.25s;" aria-labelledby="dates-heading">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                        <h2 class="fs-5 mb-0" id="dates-heading">
                            {{#str}}dates, local_jobboard{{/str}}
                        </h2>
                    </div>
                    <div class="card-body">
                        {{#convocatoria}}
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">{{#str}}startdate, local_jobboard{{/str}}</span>
                            <strong>{{convocatoria.startdateformatted}}</strong>
                        </div>
                        {{/convocatoria}}
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">{{#str}}closedate, local_jobboard{{/str}}</span>
                            <div class="text-end">
                                <strong class="{{#isurgent}}text-warning{{/isurgent}} {{#isclosed}}text-secondary{{/isclosed}}">{{closedateformatted}}</strong>
                                {{^isclosed}}
                                <span class="d-block small {{#isurgent}}text-warning fw-bold{{/isurgent}}{{^isurgent}}text-muted{{/isurgent}}">
                                    ({{daysremaining}} {{#str}}days, local_jobboard{{/str}})
                                </span>
                                {{/isclosed}}
                            </div>
                        </div>

                        {{! Deadline Progress Bar }}
                        {{^isclosed}}
                        {{#convocatoria}}
                        <div class="progress mb-2" style="height: 8px;" role="progressbar" aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}deadlineprogress, local_jobboard{{/str}}">
                            <div class="progress-bar jb-bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                        </div>
                        <small class="text-muted">{{#str}}deadlineprogress, local_jobboard{{/str}}</small>
                        {{/convocatoria}}
                        {{/isclosed}}
                    </div>
                </section>

                {{! Share Card }}
                {{#sharelinks}}
                <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.35s;" aria-labelledby="share-heading">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                        <h2 class="fs-5 mb-0" id="share-heading">
                            {{#str}}share, local_jobboard{{/str}}
                        </h2>
                    </div>
                    <div class="card-body text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{facebook}}" class="btn btn-outline-primary rounded-circle jb-social-btn jb-hover-grow" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareonfacebook, local_jobboard{{/str}}" style="width: 45px; height: 45px;">
                                <i class="fab fa-facebook-f" aria-hidden="true"></i>
                            </a>
                            <a href="{{twitter}}" class="btn btn-outline-info rounded-circle jb-social-btn jb-hover-grow" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareontwitter, local_jobboard{{/str}}" style="width: 45px; height: 45px;">
                                <i class="fab fa-twitter" aria-hidden="true"></i>
                            </a>
                            <a href="{{linkedin}}" class="btn btn-outline-primary rounded-circle jb-social-btn jb-hover-grow" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareonlinkedin, local_jobboard{{/str}}" style="width: 45px; height: 45px;">
                                <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                            </a>
                            <a href="{{whatsapp}}" class="btn btn-outline-success rounded-circle jb-social-btn jb-hover-grow" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" style="width: 45px; height: 45px;">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </section>
                {{/sharelinks}}

                {{! Apply CTA Card }}
                {{^isclosed}}
                {{^hasapplied}}
                {{#canapply}}
                <section class="card shadow-sm mb-4 jb-border-success jb-fade-in-up" style="animation-delay: 0.45s;" aria-labelledby="apply-heading">
                    <div class="card-body text-center py-4">
                        <div class="mb-3">
                            <i class="fa fa-paper-plane fa-2x text-success" aria-hidden="true"></i>
                        </div>
                        <h2 class="card-title fs-5" id="apply-heading">{{#str}}readytoapply, local_jobboard{{/str}}</h2>
                        <p class="card-text text-muted small mb-3">{{#str}}applynow_desc, local_jobboard{{/str}}</p>
                        <a href="{{applyurl}}" class="btn btn-success btn-lg w-100 jb-hover-lift">
                            <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                            {{#str}}apply, local_jobboard{{/str}}
                        </a>
                        {{#isurgent}}
                        <p class="text-warning small mt-2 mb-0">
                            <i class="fa fa-clock me-1" aria-hidden="true"></i>
                            {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                        </p>
                        {{/isurgent}}
                    </div>
                </section>
                {{/canapply}}

                {{^canapply}}
                {{^isloggedin}}
                {{! Login/Register CTA for non-authenticated users }}
                <section class="card shadow-sm mb-4 border-primary jb-fade-in-up" style="animation-delay: 0.45s;" aria-labelledby="login-heading">
                    <div class="card-body text-center py-4">
                        <i class="fa fa-circle-user fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <h2 class="card-title fs-5" id="login-heading">{{#str}}wanttoapply, local_jobboard{{/str}}</h2>
                        <p class="card-text text-muted small mb-3">{{#str}}loginrequiredtoapply, local_jobboard{{/str}}</p>
                        <a href="{{loginurl}}" class="btn btn-primary btn-lg w-100 mb-2 jb-hover-lift">
                            <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                            {{#str}}login{{/str}}
                        </a>
                        <a href="{{signupurl}}" class="btn btn-outline-primary w-100">
                            <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                            {{#str}}createaccount{{/str}}
                        </a>
                    </div>
                </section>
                {{/isloggedin}}
                {{/canapply}}
                {{/hasapplied}}
                {{/isclosed}}

                {{! Already Applied Card }}
                {{#hasapplied}}
                <section class="card shadow-sm mb-4 jb-border-info jb-fade-in-up" style="animation-delay: 0.45s;" aria-labelledby="applied-heading">
                    <div class="card-body text-center py-4">
                        <div class="mb-3">
                            <i class="fa fa-circle-check fa-3x text-info" aria-hidden="true"></i>
                        </div>
                        <h2 class="card-title fs-5" id="applied-heading">
                            {{#str}}applied, local_jobboard{{/str}}
                        </h2>
                        <p class="text-muted small mb-3">{{#str}}alreadyappliedtothisvacancy, local_jobboard{{/str}}</p>
                        <a href="{{viewapplicationurl}}" class="btn btn-info w-100 jb-hover-lift">
                            <i class="fa fa-eye me-2" aria-hidden="true"></i>
                            {{#str}}viewmyapplication, local_jobboard{{/str}}
                        </a>
                        <a href="{{myapplicationsurl}}" class="btn btn-outline-info w-100 mt-2">
                            {{#str}}viewmyapplications, local_jobboard{{/str}}
                        </a>
                    </div>
                </section>
                {{/hasapplied}}

                {{! Closed Card }}
                {{#isclosed}}
                <section class="card shadow-sm mb-4 jb-border-secondary jb-fade-in-up" style="animation-delay: 0.45s;" aria-labelledby="closed-heading">
                    <div class="card-body text-center py-4">
                        <div class="mb-3">
                            <i class="fa fa-lock fa-3x text-secondary" aria-hidden="true"></i>
                        </div>
                        <h2 class="card-title fs-5" id="closed-heading">
                            {{#str}}vacancyclosed, local_jobboard{{/str}}
                        </h2>
                        <p class="text-muted small mb-0">{{#str}}vacancycloseddesc, local_jobboard{{/str}}</p>
                    </div>
                </section>
                {{/isclosed}}
            </div>
        </aside>
    </div>

    {{! Navigation Footer }}
    <nav class="jb-navigation-footer d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{backurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{backlabel}}
        </a>
        {{#browseurl}}
        <a href="{{browseurl}}" class="btn btn-link text-muted">
            {{#str}}browsevacancies, local_jobboard{{/str}}
            <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
        </a>
        {{/browseurl}}
    </nav>
</div>
{{/loading}}
