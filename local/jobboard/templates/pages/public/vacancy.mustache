{{!
    @template local_jobboard/pages/public_vacancy

    Public vacancy detail page - ISER Brand Design
    Based on Manual de Identidad Visual ISER (M-GCRP-01 v01)

    Context variables:
    * vacancy - Vacancy data object
    * convocatoria - Optional convocatoria info
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * isloggedin - Boolean if user is logged in
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * sharelinks - Social sharing URLs
    * applyurl - URL to apply
    * backurl - Back URL
}}
<div class="jb-vacancy-page jb-iser-theme" data-region="jobboard-public-vacancy" data-vacancy-id="{{vacancy.id}}">
    {{! Hero Header }}
    <div class="jb-vacancy-hero" style="background: linear-gradient(135deg, var(--iser-verde) 0%, var(--iser-verde-dark) 100%); border-radius: var(--jb-radius-xl); padding: var(--jb-space-6); margin-bottom: var(--jb-space-5); color: var(--iser-blanco);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                    <code style="background: rgba(255,255,255,0.2); padding: var(--jb-space-2) var(--jb-space-3); border-radius: var(--jb-radius-md); font-weight: var(--jb-font-bold);">{{vacancy.code}}</code>
                    {{#isurgent}}{{^isclosed}}
                    <span style="background: var(--iser-amarillo); color: var(--iser-negro); padding: var(--jb-space-1) var(--jb-space-3); border-radius: var(--jb-radius-full); font-size: var(--jb-text-sm); font-weight: var(--jb-font-bold);">
                        <i class="fa fa-clock me-1"></i>{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                    </span>
                    {{/isclosed}}{{/isurgent}}
                    {{#isclosed}}
                    <span style="background: var(--iser-gris-oscuro); color: var(--iser-blanco); padding: var(--jb-space-1) var(--jb-space-3); border-radius: var(--jb-radius-full); font-size: var(--jb-text-sm);">
                        <i class="fa fa-lock me-1"></i>{{#str}}vacancyclosed, local_jobboard{{/str}}
                    </span>
                    {{/isclosed}}
                </div>
                <h1 style="font-size: var(--jb-text-3xl); font-weight: var(--jb-font-bold); margin-bottom: var(--jb-space-2);">{{vacancy.title}}</h1>
                {{#vacancy.department}}
                <p style="font-size: var(--jb-text-lg); opacity: 0.9; margin: 0;">
                    <i class="fa fa-building me-2"></i>{{vacancy.department}}
                </p>
                {{/vacancy.department}}
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                {{^isclosed}}{{#canapply}}{{^hasapplied}}
                <a href="{{applyurl}}" style="display: inline-block; background: var(--iser-amarillo); color: var(--iser-negro); padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-bold); font-size: var(--jb-text-lg);">
                    <i class="fa fa-paper-plane me-2"></i>{{#str}}apply, local_jobboard{{/str}}
                </a>
                {{/hasapplied}}{{/canapply}}{{/isclosed}}
                {{#hasapplied}}
                <span style="display: inline-block; background: rgba(255,255,255,0.2); padding: var(--jb-space-3) var(--jb-space-5); border-radius: var(--jb-radius-md); font-weight: var(--jb-font-medium);">
                    <i class="fa fa-check-circle me-2"></i>{{#str}}applied, local_jobboard{{/str}}
                </span>
                {{/hasapplied}}
            </div>
        </div>
    </div>

    <div class="row g-4">
        {{! Main Content Column }}
        <div class="col-lg-8">
            {{! Description Card }}
            {{#vacancy.description}}
            <div class="jb-content-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                <div style="padding: var(--jb-space-4) var(--jb-space-5); border-bottom: 3px solid var(--iser-verde); background: var(--jb-gray-50);">
                    <h2 style="font-size: var(--jb-text-lg); font-weight: var(--jb-font-semibold); color: var(--iser-rojo); margin: 0;">
                        <i class="fa fa-file-lines me-2" style="color: var(--iser-verde);"></i>{{#str}}vacancydescription, local_jobboard{{/str}}
                    </h2>
                </div>
                <div style="padding: var(--jb-space-5);">
                    <div class="jb-rich-content">{{{vacancy.description}}}</div>
                </div>
            </div>
            {{/vacancy.description}}

            {{! Requirements Card }}
            {{#vacancy.requirements}}
            <div class="jb-content-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                <div style="padding: var(--jb-space-4) var(--jb-space-5); border-bottom: 3px solid var(--iser-amarillo); background: var(--iser-amarillo-lighter);">
                    <h2 style="font-size: var(--jb-text-lg); font-weight: var(--jb-font-semibold); color: var(--iser-amarillo-darker); margin: 0;">
                        <i class="fa fa-list-check me-2" style="color: var(--iser-amarillo);"></i>{{#str}}requirements, local_jobboard{{/str}}
                    </h2>
                </div>
                <div style="padding: var(--jb-space-5);">
                    <div class="jb-rich-content">{{{vacancy.requirements}}}</div>
                </div>
            </div>
            {{/vacancy.requirements}}

            {{! Desirable Card }}
            {{#vacancy.desirable}}
            <div class="jb-content-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                <div style="padding: var(--jb-space-4) var(--jb-space-5); border-bottom: 3px solid var(--iser-azul); background: var(--iser-azul-lighter);">
                    <h2 style="font-size: var(--jb-text-lg); font-weight: var(--jb-font-semibold); color: var(--iser-azul); margin: 0;">
                        <i class="fa fa-star me-2"></i>{{#str}}desirable, local_jobboard{{/str}}
                    </h2>
                </div>
                <div style="padding: var(--jb-space-5);">
                    <div class="jb-rich-content">{{{vacancy.desirable}}}</div>
                </div>
            </div>
            {{/vacancy.desirable}}

            {{! Benefits Card }}
            {{#vacancy.benefits}}
            <div class="jb-content-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
                <div style="padding: var(--jb-space-4) var(--jb-space-5); border-bottom: 3px solid var(--iser-verde); background: var(--iser-verde-lighter);">
                    <h2 style="font-size: var(--jb-text-lg); font-weight: var(--jb-font-semibold); color: var(--iser-verde-dark); margin: 0;">
                        <i class="fa fa-gift me-2" style="color: var(--iser-verde);"></i>{{#str}}benefits, local_jobboard{{/str}}
                    </h2>
                </div>
                <div style="padding: var(--jb-space-5);">
                    <div class="jb-rich-content">{{{vacancy.benefits}}}</div>
                </div>
            </div>
            {{/vacancy.benefits}}
        </div>

        {{! Sidebar Column }}
        <div class="col-lg-4">
            <div class="jb-sidebar" style="position: sticky; top: 100px;">
                {{! Key Details Card }}
                <div class="jb-sidebar-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden;">
                    <div style="padding: var(--jb-space-3) var(--jb-space-4); background: var(--iser-verde-lighter); border-bottom: 2px solid var(--iser-verde);">
                        <h3 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-verde-dark); margin: 0;">
                            <i class="fa fa-circle-info me-2"></i>{{#str}}details, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div style="padding: var(--jb-space-4);">
                        <dl style="margin: 0;">
                            {{#vacancy.contracttypelabel}}
                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid var(--jb-gray-100);">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">
                                    <i class="fa fa-file-contract me-2"></i>{{#str}}contracttype, local_jobboard{{/str}}
                                </dt>
                                <dd style="margin: 0; font-weight: var(--jb-font-semibold); color: var(--iser-negro);">{{vacancy.contracttypelabel}}</dd>
                            </div>
                            {{/vacancy.contracttypelabel}}
                            {{#vacancy.duration}}
                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid var(--jb-gray-100);">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">
                                    <i class="fa fa-hourglass-half me-2"></i>{{#str}}duration, local_jobboard{{/str}}
                                </dt>
                                <dd style="margin: 0; font-weight: var(--jb-font-semibold); color: var(--iser-negro);">{{vacancy.duration}}</dd>
                            </div>
                            {{/vacancy.duration}}
                            {{#vacancy.location}}
                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid var(--jb-gray-100);">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">
                                    <i class="fa fa-location-dot me-2"></i>{{#str}}location, local_jobboard{{/str}}
                                </dt>
                                <dd style="margin: 0; font-weight: var(--jb-font-semibold); color: var(--iser-negro);">{{vacancy.location}}</dd>
                            </div>
                            {{/vacancy.location}}
                            {{#vacancy.modality}}
                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid var(--jb-gray-100);">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">
                                    <i class="fa fa-house-laptop me-2"></i>{{#str}}modality, local_jobboard{{/str}}
                                </dt>
                                <dd style="margin: 0; font-weight: var(--jb-font-semibold); color: var(--iser-negro);">{{vacancy.modality}}</dd>
                            </div>
                            {{/vacancy.modality}}
                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid var(--jb-gray-100);">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">
                                    <i class="fa fa-users me-2"></i>{{#str}}positions, local_jobboard{{/str}}
                                </dt>
                                <dd style="margin: 0;">
                                    <span style="background: var(--iser-verde); color: var(--iser-blanco); padding: 2px 10px; border-radius: var(--jb-radius-full); font-weight: var(--jb-font-bold);">{{vacancy.positions}}</span>
                                </dd>
                            </div>
                            {{#convocatoria}}
                            <div class="d-flex justify-content-between py-2">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">
                                    <i class="fa fa-folder-open me-2"></i>{{#str}}convocatoria, local_jobboard{{/str}}
                                </dt>
                                <dd style="margin: 0;">
                                    <a href="{{convocatoria.viewurl}}" style="background: var(--iser-azul-lighter); color: var(--iser-azul); padding: 2px 8px; border-radius: var(--jb-radius-sm); text-decoration: none; font-size: var(--jb-text-sm);">{{convocatoria.code}}</a>
                                </dd>
                            </div>
                            {{/convocatoria}}
                        </dl>
                    </div>
                </div>

                {{! Dates Card }}
                <div class="jb-sidebar-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden;">
                    <div style="padding: var(--jb-space-3) var(--jb-space-4); background: var(--iser-amarillo-lighter); border-bottom: 2px solid var(--iser-amarillo);">
                        <h3 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-amarillo-darker); margin: 0;">
                            <i class="fa fa-calendar-days me-2"></i>{{#str}}dates, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div style="padding: var(--jb-space-4);">
                        <dl style="margin: 0;">
                            {{#convocatoria}}
                            <div class="d-flex justify-content-between py-2" style="border-bottom: 1px solid var(--jb-gray-100);">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">{{#str}}startdate, local_jobboard{{/str}}</dt>
                                <dd style="margin: 0; font-weight: var(--jb-font-semibold); color: var(--iser-negro);">{{convocatoria.startdateformatted}}</dd>
                            </div>
                            {{/convocatoria}}
                            <div class="d-flex justify-content-between py-2">
                                <dt style="color: var(--iser-gris-medio); font-weight: var(--jb-font-normal); font-size: var(--jb-text-sm);">{{#str}}closedate, local_jobboard{{/str}}</dt>
                                <dd style="margin: 0; text-align: end;">
                                    <span style="font-weight: var(--jb-font-bold); {{#isurgent}}color: var(--iser-rojo);{{/isurgent}}{{#isclosed}}color: var(--iser-gris-medio);{{/isclosed}}">{{closedateformatted}}</span>
                                    {{^isclosed}}
                                    <span style="display: block; font-size: var(--jb-text-xs); {{#isurgent}}color: var(--iser-rojo);{{/isurgent}}{{^isurgent}}color: var(--iser-gris-medio);{{/isurgent}}">
                                        ({{daysremaining}} {{#str}}days, local_jobboard{{/str}})
                                    </span>
                                    {{/isclosed}}
                                </dd>
                            </div>
                        </dl>
                        {{^isclosed}}{{#convocatoria}}
                        <div style="margin-top: var(--jb-space-3); padding-top: var(--jb-space-3); border-top: 1px solid var(--jb-gray-100);">
                            <div style="height: 6px; background: var(--jb-gray-200); border-radius: var(--jb-radius-full); overflow: hidden;">
                                <div style="height: 100%; width: {{progresspercent}}%; background: var(--iser-{{progresscolor}}, var(--iser-verde)); border-radius: var(--jb-radius-full);"></div>
                            </div>
                            <p style="font-size: var(--jb-text-xs); color: var(--iser-gris-medio); margin: var(--jb-space-2) 0 0 0;">{{#str}}deadlineprogress, local_jobboard{{/str}}</p>
                        </div>
                        {{/convocatoria}}{{/isclosed}}
                    </div>
                </div>

                {{! Share Card }}
                {{#sharelinks}}
                <div class="jb-sidebar-card mb-4" style="background: var(--iser-blanco); border-radius: var(--jb-radius-lg); box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden;">
                    <div style="padding: var(--jb-space-3) var(--jb-space-4); background: var(--jb-gray-50); border-bottom: 1px solid var(--jb-gray-200);">
                        <h3 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-gris-oscuro); margin: 0;">
                            <i class="fa fa-share-nodes me-2" style="color: var(--iser-verde);"></i>{{#str}}share, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div style="padding: var(--jb-space-4); text-align: center;">
                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{facebook}}" target="_blank" rel="noopener" style="width: 40px; height: 40px; border-radius: var(--jb-radius-full); background: #1877F2; color: white; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-facebook-f"></i></a>
                            <a href="{{twitter}}" target="_blank" rel="noopener" style="width: 40px; height: 40px; border-radius: var(--jb-radius-full); background: #1DA1F2; color: white; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-twitter"></i></a>
                            <a href="{{linkedin}}" target="_blank" rel="noopener" style="width: 40px; height: 40px; border-radius: var(--jb-radius-full); background: #0A66C2; color: white; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-linkedin-in"></i></a>
                            <a href="{{whatsapp}}" target="_blank" rel="noopener" style="width: 40px; height: 40px; border-radius: var(--jb-radius-full); background: #25D366; color: white; display: flex; align-items: center; justify-content: center; text-decoration: none;"><i class="fab fa-whatsapp"></i></a>
                        </div>
                    </div>
                </div>
                {{/sharelinks}}

                {{! CTA Cards }}
                {{^isclosed}}{{^hasapplied}}{{#canapply}}
                <div style="background: linear-gradient(135deg, var(--iser-verde-lighter) 0%, var(--iser-blanco) 100%); border: 2px solid var(--iser-verde); border-radius: var(--jb-radius-lg); padding: var(--jb-space-5); text-align: center;">
                    <i class="fa fa-paper-plane" style="font-size: 2.5rem; color: var(--iser-verde); margin-bottom: var(--jb-space-3); display: block;"></i>
                    <h4 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-negro); margin-bottom: var(--jb-space-2);">{{#str}}readytoapply, local_jobboard{{/str}}</h4>
                    <p style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-4);">{{#str}}applynow_desc, local_jobboard{{/str}}</p>
                    <a href="{{applyurl}}" style="display: block; background: var(--iser-verde); color: var(--iser-blanco); padding: var(--jb-space-3); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-semibold);">
                        <i class="fa fa-paper-plane me-2"></i>{{#str}}apply, local_jobboard{{/str}}
                    </a>
                    {{#isurgent}}
                    <p style="font-size: var(--jb-text-sm); color: var(--iser-rojo); margin: var(--jb-space-3) 0 0 0;">
                        <i class="fa fa-clock me-1"></i>{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                    </p>
                    {{/isurgent}}
                </div>
                {{/canapply}}{{^canapply}}{{^isloggedin}}
                <div style="background: var(--iser-blanco); border: 2px solid var(--iser-verde); border-radius: var(--jb-radius-lg); padding: var(--jb-space-5); text-align: center;">
                    <i class="fa fa-circle-user" style="font-size: 2.5rem; color: var(--iser-gris-medio); margin-bottom: var(--jb-space-3); display: block;"></i>
                    <h4 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-negro); margin-bottom: var(--jb-space-2);">{{#str}}wanttoapply, local_jobboard{{/str}}</h4>
                    <p style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-4);">{{#str}}loginrequiredtoapply, local_jobboard{{/str}}</p>
                    <a href="{{loginurl}}" style="display: block; background: var(--iser-verde); color: var(--iser-blanco); padding: var(--jb-space-3); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-semibold); margin-bottom: var(--jb-space-2);">
                        <i class="fa fa-right-to-bracket me-2"></i>{{#str}}login{{/str}}
                    </a>
                    <a href="{{signupurl}}" style="display: block; background: transparent; border: 2px solid var(--iser-verde); color: var(--iser-verde); padding: var(--jb-space-3); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-medium);">
                        <i class="fa fa-user-plus me-2"></i>{{#str}}createaccount{{/str}}
                    </a>
                </div>
                {{/isloggedin}}{{/canapply}}{{/hasapplied}}{{/isclosed}}

                {{#hasapplied}}
                <div style="background: var(--iser-azul-lighter); border: 2px solid var(--iser-azul); border-radius: var(--jb-radius-lg); padding: var(--jb-space-5); text-align: center;">
                    <i class="fa fa-circle-check" style="font-size: 2.5rem; color: var(--iser-azul); margin-bottom: var(--jb-space-3); display: block;"></i>
                    <h4 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-negro); margin-bottom: var(--jb-space-2);">{{#str}}applied, local_jobboard{{/str}}</h4>
                    <p style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin-bottom: var(--jb-space-4);">{{#str}}alreadyappliedtothisvacancy, local_jobboard{{/str}}</p>
                    <a href="{{viewapplicationurl}}" style="display: block; background: var(--iser-azul); color: var(--iser-blanco); padding: var(--jb-space-3); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-semibold); margin-bottom: var(--jb-space-2);">
                        <i class="fa fa-eye me-2"></i>{{#str}}viewmyapplication, local_jobboard{{/str}}
                    </a>
                    <a href="{{myapplicationsurl}}" style="display: block; color: var(--iser-azul); padding: var(--jb-space-2); text-decoration: none; font-size: var(--jb-text-sm);">
                        {{#str}}viewmyapplications, local_jobboard{{/str}}
                    </a>
                </div>
                {{/hasapplied}}

                {{#isclosed}}
                <div style="background: var(--jb-gray-100); border: 2px solid var(--iser-gris-medio); border-radius: var(--jb-radius-lg); padding: var(--jb-space-5); text-align: center;">
                    <i class="fa fa-lock" style="font-size: 2.5rem; color: var(--iser-gris-medio); margin-bottom: var(--jb-space-3); display: block;"></i>
                    <h4 style="font-size: var(--jb-text-base); font-weight: var(--jb-font-semibold); color: var(--iser-gris-oscuro); margin-bottom: var(--jb-space-2);">{{#str}}vacancyclosed, local_jobboard{{/str}}</h4>
                    <p style="font-size: var(--jb-text-sm); color: var(--iser-gris-medio); margin: 0;">{{#str}}vacancycloseddesc, local_jobboard{{/str}}</p>
                </div>
                {{/isclosed}}
            </div>
        </div>
    </div>

    {{! Back Navigation }}
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--jb-space-3); margin-top: var(--jb-space-6); padding-top: var(--jb-space-4); border-top: 2px solid var(--jb-gray-200);">
        <a href="{{backurl}}" style="display: inline-flex; align-items: center; padding: var(--jb-space-2) var(--jb-space-4); border: 2px solid var(--iser-gris-medio); color: var(--iser-gris-oscuro); border-radius: var(--jb-radius-md); text-decoration: none; font-weight: var(--jb-font-medium);">
            <i class="fa fa-arrow-left me-2"></i>{{backlabel}}
        </a>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            {{#showsupport}}
            {{> local_jobboard/partials/support_button }}
            {{/showsupport}}
            {{#browseurl}}
            <a href="{{browseurl}}" style="color: var(--iser-verde); text-decoration: none; font-weight: var(--jb-font-medium);">
                {{#str}}browsevacancies, local_jobboard{{/str}}<i class="fa fa-arrow-right ms-2"></i>
            </a>
            {{/browseurl}}
