{{!
    @template local_jobboard/pages/public/vacancy

    Public vacancy detail page - Clean minimal design following jb-* pattern

    Context variables:
    * vacancy - Vacancy data object
    * convocatoria - Optional convocatoria info
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * isloggedin - Boolean if user is logged in
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * sharelinks - Social sharing URLs
    * applyurl - URL to apply
    * backurl - Back URL
}}
<div class="jb-vacancy-detail" id="jobboard-vacancy" data-vacancy-id="{{vacancy.id}}">
    {{! Support Banner }}
    {{#showsupport}}
    {{> local_jobboard/partials/support_button }}
    {{/showsupport}}

    {{! Header }}
    <div class="jb-detail-header">
        <div class="jb-detail-header__nav">
            <a href="{{backurl}}" class="jb-detail-header__back">
                <i class="fa fa-arrow-left"></i>
                {{backlabel}}
            </a>
            {{^isclosed}}{{#canapply}}{{^hasapplied}}
            <a href="{{applyurl}}" class="jb-btn jb-btn--primary jb-btn--lg">
                <i class="fa fa-paper-plane"></i> {{#str}}apply, local_jobboard{{/str}}
            </a>
            {{/hasapplied}}{{/canapply}}{{/isclosed}}
            {{#hasapplied}}
            <span class="jb-badge jb-badge--success jb-badge--lg">
                <i class="fa fa-check-circle"></i> {{#str}}applied, local_jobboard{{/str}}
            </span>
            {{/hasapplied}}
        </div>
        <div class="jb-detail-header__title-row">
            <span class="jb-code jb-code--primary">{{vacancy.code}}</span>
            {{#isurgent}}{{^isclosed}}
            <span class="jb-badge jb-badge--warning">
                <i class="fa fa-clock"></i> {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
            </span>
            {{/isclosed}}{{/isurgent}}
            {{#isclosed}}
            <span class="jb-badge jb-badge--secondary">
                <i class="fa fa-lock"></i> {{#str}}vacancyclosed, local_jobboard{{/str}}
            </span>
            {{/isclosed}}
        </div>
        <h1 class="jb-detail-header__title">{{vacancy.title}}</h1>
        {{#vacancy.department}}
        <p class="jb-detail-header__subtitle">
            <i class="fa fa-building"></i> {{vacancy.department}}
        </p>
        {{/vacancy.department}}
    </div>

    {{! Content Layout }}
    <div class="jb-detail-content">
        {{! Main Column }}
        <div class="jb-detail-main">
            {{! Description Card }}
            {{#vacancy.description}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-file-lines"></i>
                    {{#str}}vacancydescription, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.description}}}
                </div>
            </div>
            {{/vacancy.description}}

            {{! Requirements Card }}
            {{#vacancy.requirements}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--warning">
                    <i class="fa fa-list-check"></i>
                    {{#str}}requirements, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.requirements}}}
                </div>
            </div>
            {{/vacancy.requirements}}

            {{! Desirable Card }}
            {{#vacancy.desirable}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--info">
                    <i class="fa fa-star"></i>
                    {{#str}}desirable, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.desirable}}}
                </div>
            </div>
            {{/vacancy.desirable}}

            {{! Benefits Card }}
            {{#vacancy.benefits}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--success">
                    <i class="fa fa-gift"></i>
                    {{#str}}benefits, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.benefits}}}
                </div>
            </div>
            {{/vacancy.benefits}}
        </div>

        {{! Sidebar }}
        <aside class="jb-detail-sidebar">
            {{! Key Details Card }}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--accent">
                    <i class="fa fa-circle-info"></i>
                    {{#str}}details, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    {{#vacancy.contracttypelabel}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-file-contract"></i> {{#str}}contracttype, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.contracttypelabel}}</strong>
                    </div>
                    {{/vacancy.contracttypelabel}}
                    {{#vacancy.duration}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-hourglass-half"></i> {{#str}}duration, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.duration}}</strong>
                    </div>
                    {{/vacancy.duration}}
                    {{#vacancy.location}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-location-dot"></i> {{#str}}location, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.location}}</strong>
                    </div>
                    {{/vacancy.location}}
                    {{#vacancy.modality}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-house-laptop"></i> {{#str}}modality, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.modality}}</strong>
                    </div>
                    {{/vacancy.modality}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-users"></i> {{#str}}positions, local_jobboard{{/str}}</span>
                        <span class="jb-badge jb-badge--primary">{{vacancy.positions}}</span>
                    </div>
                    {{#convocatoria}}
                    <div class="jb-info-row jb-info-row--last">
                        <span class="jb-info-label"><i class="fa fa-folder-open"></i> {{#str}}convocatoria, local_jobboard{{/str}}</span>
                        <a href="{{convocatoria.viewurl}}" class="jb-badge jb-badge--info">{{convocatoria.code}}</a>
                    </div>
                    {{/convocatoria}}
                </div>
            </div>

            {{! Dates Card }}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--warning-light">
                    <i class="fa fa-calendar-days"></i>
                    {{#str}}dates, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    {{#convocatoria}}
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}startdate, local_jobboard{{/str}}</span>
                        <strong>{{convocatoria.startdateformatted}}</strong>
                    </div>
                    {{/convocatoria}}
                    <div class="jb-info-row jb-info-row--last">
                        <span class="jb-info-label">{{#str}}closedate, local_jobboard{{/str}}</span>
                        <div class="jb-info-value--stacked">
                            <strong class="{{#isurgent}}jb-text-danger{{/isurgent}}{{#isclosed}}jb-text-muted{{/isclosed}}">{{closedateformatted}}</strong>
                            {{^isclosed}}
                            <small class="{{#isurgent}}jb-text-danger{{/isurgent}}">({{daysremaining}} {{#str}}days, local_jobboard{{/str}})</small>
                            {{/isclosed}}
                        </div>
                    </div>

                    {{! Progress Bar }}
                    {{^isclosed}}{{#convocatoria}}
                    <div class="jb-progress-section">
                        <div class="jb-progress">
                            <div class="jb-progress__bar jb-progress__bar--{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                        </div>
                        <span class="jb-progress-label">{{#str}}deadlineprogress, local_jobboard{{/str}}</span>
                    </div>
                    {{/convocatoria}}{{/isclosed}}
                </div>
            </div>

            {{! Share Card }}
            {{#sharelinks}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-share-nodes"></i>
                    {{#str}}share, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--center">
                    <div class="jb-share-buttons">
                        <a href="{{facebook}}" class="jb-share-btn jb-share-btn--facebook" target="_blank" rel="noopener" title="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="{{twitter}}" class="jb-share-btn jb-share-btn--twitter" target="_blank" rel="noopener" title="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="{{linkedin}}" class="jb-share-btn jb-share-btn--linkedin" target="_blank" rel="noopener" title="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="{{whatsapp}}" class="jb-share-btn jb-share-btn--whatsapp" target="_blank" rel="noopener" title="WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    </div>
                </div>
            </div>
            {{/sharelinks}}

            {{! Apply CTA }}
            {{^isclosed}}{{^hasapplied}}{{#canapply}}
            <div class="jb-card jb-card--cta">
                <div class="jb-cta-card">
                    <i class="fa fa-paper-plane jb-cta-card__icon"></i>
                    <h4 class="jb-cta-card__title">{{#str}}readytoapply, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}applynow_desc, local_jobboard{{/str}}</p>
                    <a href="{{applyurl}}" class="jb-btn jb-btn--primary jb-btn--block">
                        <i class="fa fa-paper-plane"></i> {{#str}}apply, local_jobboard{{/str}}
                    </a>
                    {{#isurgent}}
                    <p class="jb-cta-card__urgent">
                        <i class="fa fa-clock"></i> {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                    </p>
                    {{/isurgent}}
                </div>
            </div>
            {{/canapply}}{{^canapply}}{{^isloggedin}}
            <div class="jb-card jb-card--cta">
                <div class="jb-cta-card">
                    <i class="fa fa-circle-user jb-cta-card__icon jb-cta-card__icon--muted"></i>
                    <h4 class="jb-cta-card__title">{{#str}}wanttoapply, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}loginrequiredtoapply, local_jobboard{{/str}}</p>
                    <a href="{{loginurl}}" class="jb-btn jb-btn--primary jb-btn--block">
                        <i class="fa fa-right-to-bracket"></i> {{#str}}login{{/str}}
                    </a>
                    <a href="{{signupurl}}" class="jb-btn jb-btn--outline jb-btn--block">
                        <i class="fa fa-user-plus"></i> {{#str}}createaccount{{/str}}
                    </a>
                </div>
            </div>
            {{/isloggedin}}{{/canapply}}{{/hasapplied}}{{/isclosed}}

            {{! Already Applied }}
            {{#hasapplied}}
            <div class="jb-card jb-card--cta-info">
                <div class="jb-cta-card">
                    <i class="fa fa-circle-check jb-cta-card__icon jb-cta-card__icon--info"></i>
                    <h4 class="jb-cta-card__title">{{#str}}applied, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}alreadyappliedtothisvacancy, local_jobboard{{/str}}</p>
                    <a href="{{viewapplicationurl}}" class="jb-btn jb-btn--info jb-btn--block">
                        <i class="fa fa-eye"></i> {{#str}}viewmyapplication, local_jobboard{{/str}}
                    </a>
                    <a href="{{myapplicationsurl}}" class="jb-link jb-link--center">
                        {{#str}}viewmyapplications, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
            {{/hasapplied}}

            {{! Closed }}
            {{#isclosed}}
            <div class="jb-card jb-card--closed">
                <div class="jb-cta-card">
                    <i class="fa fa-lock jb-cta-card__icon jb-cta-card__icon--muted"></i>
                    <h4 class="jb-cta-card__title">{{#str}}vacancyclosed, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}vacancycloseddesc, local_jobboard{{/str}}</p>
                </div>
            </div>
            {{/isclosed}}
        </aside>
    </div>

    {{! Footer Navigation }}
    <div class="jb-detail-footer">
        <a href="{{backurl}}" class="jb-btn jb-btn--outline">
            <i class="fa fa-arrow-left"></i> {{backlabel}}
        </a>
        {{#browseurl}}
        <a href="{{browseurl}}" class="jb-link">
            {{#str}}browsevacancies, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i>
        </a>
        {{/browseurl}}
    </div>
</div>

<style>
/* ================================================================
   VACANCY DETAIL PAGE - CLEAN MINIMAL DESIGN
   Following jb-* pattern
   ================================================================ */
.jb-vacancy-detail {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
}

/* Header */
.jb-detail-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-detail-header__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.jb-detail-header__back {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-detail-header__back:hover {
    color: var(--iser-verde-dark, #157a6a);
}

.jb-detail-header__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
}

.jb-detail-header__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-detail-header__subtitle {
    font-size: 1rem;
    color: var(--iser-gris-medio, #666);
    margin: 0.5rem 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-detail-header__subtitle i {
    color: var(--iser-verde, #1b9e88);
}

/* Content Layout */
.jb-detail-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: start;
}

.jb-detail-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.jb-detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
}

/* Cards */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.jb-card--cta { border-color: var(--iser-verde, #1b9e88); }
.jb-card--cta-info { border-color: var(--iser-azul, #0d6efd); }
.jb-card--closed { border-color: var(--iser-gris-medio, #666); background: #f9fafb; }

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i { color: var(--iser-verde, #1b9e88); }

.jb-card__header--accent {
    background: rgba(27, 158, 136, 0.1);
    border-bottom: 2px solid var(--iser-verde, #1b9e88);
}

.jb-card__header--warning {
    background: rgba(255, 193, 7, 0.15);
    border-bottom: 2px solid var(--iser-amarillo, #ffc107);
    color: #856404;
}

.jb-card__header--warning i { color: #856404; }

.jb-card__header--warning-light {
    background: rgba(255, 193, 7, 0.1);
    border-bottom: 2px solid var(--iser-amarillo, #ffc107);
}

.jb-card__header--info {
    background: rgba(13, 110, 253, 0.1);
    border-bottom: 2px solid var(--iser-azul, #0d6efd);
    color: var(--iser-azul, #0d6efd);
}

.jb-card__header--info i { color: var(--iser-azul, #0d6efd); }

.jb-card__header--success {
    background: rgba(27, 158, 136, 0.1);
    border-bottom: 2px solid var(--iser-verde, #1b9e88);
    color: var(--iser-verde-dark, #157a6a);
}

.jb-card__body { padding: 1rem; }

.jb-card__body--content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--iser-gris-oscuro, #333);
}

.jb-card__body--content p { margin-bottom: 0.75rem; }
.jb-card__body--content p:last-child { margin-bottom: 0; }
.jb-card__body--content ul, .jb-card__body--content ol { padding-left: 1.25rem; margin-bottom: 0.75rem; }
.jb-card__body--content li { margin-bottom: 0.25rem; }

.jb-card__body--center { text-align: center; }

/* Info Rows */
.jb-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.8125rem;
}

.jb-info-row--last { border-bottom: none; padding-bottom: 0; }

.jb-info-label {
    color: var(--iser-gris-medio, #666);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-info-label i { width: 16px; text-align: center; }

.jb-info-value--stacked { text-align: right; }
.jb-info-value--stacked small { display: block; font-size: 0.6875rem; }

/* Badges */
.jb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-decoration: none;
}

.jb-badge i { font-size: 0.625rem; }
.jb-badge--lg { padding: 0.375rem 0.75rem; font-size: 0.8125rem; }
.jb-badge--primary { background: rgba(27, 158, 136, 0.15); color: var(--iser-verde-dark, #157a6a); }
.jb-badge--success { background: rgba(40, 167, 69, 0.15); color: #1e7e34; }
.jb-badge--warning { background: rgba(255, 193, 7, 0.2); color: #856404; }
.jb-badge--danger { background: rgba(220, 53, 69, 0.15); color: #c41e3a; }
.jb-badge--info { background: rgba(13, 110, 253, 0.15); color: #0d6efd; }
.jb-badge--secondary { background: #e9ecef; color: #6c757d; }

/* Code */
.jb-code {
    font-family: monospace;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
}

.jb-code--primary { background: var(--iser-verde, #1b9e88); color: #fff; }

/* Progress */
.jb-progress-section {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f0f0f0;
}

.jb-progress {
    height: 6px;
    background: #e5e5e5;
    border-radius: 3px;
    overflow: hidden;
}

.jb-progress__bar {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s;
}

.jb-progress__bar--success, .jb-progress__bar--verde { background: #28a745; }
.jb-progress__bar--warning, .jb-progress__bar--amarillo { background: #ffc107; }
.jb-progress__bar--danger, .jb-progress__bar--rojo { background: #dc3545; }
.jb-progress__bar--primary { background: var(--iser-verde, #1b9e88); }

.jb-progress-label {
    display: block;
    font-size: 0.6875rem;
    color: var(--iser-gris-medio, #666);
    margin-top: 0.375rem;
}

/* Share Buttons */
.jb-share-buttons {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
}

.jb-share-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.15s;
    color: #fff;
}

.jb-share-btn--facebook { background: #1877f2; }
.jb-share-btn--facebook:hover { background: #166fe5; color: #fff; }
.jb-share-btn--twitter { background: #1da1f2; }
.jb-share-btn--twitter:hover { background: #1a91da; color: #fff; }
.jb-share-btn--linkedin { background: #0a66c2; }
.jb-share-btn--linkedin:hover { background: #095bb5; color: #fff; }
.jb-share-btn--whatsapp { background: #25d366; }
.jb-share-btn--whatsapp:hover { background: #22c35e; color: #fff; }

/* CTA Card */
.jb-cta-card {
    padding: 1.5rem;
    text-align: center;
}

.jb-cta-card__icon {
    font-size: 2rem;
    color: var(--iser-verde, #1b9e88);
    margin-bottom: 0.75rem;
}

.jb-cta-card__icon--info { color: var(--iser-azul, #0d6efd); }
.jb-cta-card__icon--muted { color: var(--iser-gris-medio, #666); }

.jb-cta-card__title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.375rem 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-cta-card__text {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 1rem 0;
}

.jb-cta-card__urgent {
    font-size: 0.8125rem;
    color: var(--iser-rojo, #c41e3a);
    margin: 0.75rem 0 0 0;
}

/* Buttons */
.jb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
}

.jb-btn--lg { padding: 0.625rem 1.25rem; font-size: 0.9375rem; }
.jb-btn--block { width: 100%; margin-bottom: 0.5rem; }
.jb-btn--block:last-child { margin-bottom: 0; }
.jb-btn--primary { background: var(--iser-verde, #1b9e88); color: #fff; }
.jb-btn--primary:hover { background: var(--iser-verde-dark, #157a6a); color: #fff; }
.jb-btn--info { background: var(--iser-azul, #0d6efd); color: #fff; }
.jb-btn--info:hover { background: #0b5ed7; color: #fff; }
.jb-btn--outline { background: transparent; border-color: #d1d5db; color: var(--iser-gris-oscuro, #333); }
.jb-btn--outline:hover { border-color: var(--iser-verde, #1b9e88); color: var(--iser-verde, #1b9e88); }

/* Links */
.jb-link {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
}

