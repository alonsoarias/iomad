{{!
    @template local_jobboard/pages/public_vacancy

    Public vacancy detail page template.
    Simplified design following apply.mustache pattern.

    Context variables:
    * vacancy - Vacancy data object
    * convocatoria - Optional convocatoria info
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * isloggedin - Boolean if user is logged in
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * sharelinks - Social sharing URLs
    * applyurl - URL to apply
    * backurl - Back URL

    Example context (json):
    {
        "vacancy": {"id": 1, "title": "Developer", "code": "VAC-001"},
        "canapply": true,
        "hasapplied": false
    }
}}
<div class="jb-vacancy-page" data-region="jobboard-public-vacancy" data-vacancy-id="{{vacancy.id}}">
    <div class="container-fluid px-0">
        {{! Quick Info Bar }}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div class="d-flex align-items-center gap-3">
                <code class="badge bg-primary">{{vacancy.code}}</code>
                {{#isurgent}}
                {{^isclosed}}
                <span class="badge bg-warning text-dark">
                    <i class="fa fa-clock me-1" aria-hidden="true"></i>
                    {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                </span>
                {{/isclosed}}
                {{/isurgent}}
            </div>
            {{^isclosed}}
            {{#canapply}}
            {{^hasapplied}}
            <a href="{{applyurl}}" class="btn btn-success jb-btn-success">
                <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                {{#str}}apply, local_jobboard{{/str}}
            </a>
            {{/hasapplied}}
            {{/canapply}}
            {{/isclosed}}
        </div>

        <div class="row">
            {{! Main Content Column }}
            <div class="col-lg-8">
                {{! Description Card }}
                {{#vacancy.description}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                            {{#str}}vacancydescription, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.description}}}
                    </div>
                </div>
                {{/vacancy.description}}

                {{! Requirements Card }}
                {{#vacancy.requirements}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-list-check text-warning me-2" aria-hidden="true"></i>
                            {{#str}}requirements, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.requirements}}}
                    </div>
                </div>
                {{/vacancy.requirements}}

                {{! Desirable Card }}
                {{#vacancy.desirable}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-star text-info me-2" aria-hidden="true"></i>
                            {{#str}}desirable, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.desirable}}}
                    </div>
                </div>
                {{/vacancy.desirable}}

                {{! Benefits Card }}
                {{#vacancy.benefits}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-gift text-success me-2" aria-hidden="true"></i>
                            {{#str}}benefits, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.benefits}}}
                    </div>
                </div>
                {{/vacancy.benefits}}
            </div>

            {{! Sidebar Column }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 1rem;">
                    {{! Key Details Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-circle-info text-primary me-2" aria-hidden="true"></i>
                                {{#str}}details, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="mb-0">
                                {{#vacancy.contracttypelabel}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-file-contract me-2" aria-hidden="true"></i>
                                        {{#str}}contracttype, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.contracttypelabel}}</dd>
                                </div>
                                {{/vacancy.contracttypelabel}}

                                {{#vacancy.duration}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-hourglass-half me-2" aria-hidden="true"></i>
                                        {{#str}}duration, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.duration}}</dd>
                                </div>
                                {{/vacancy.duration}}

                                {{#vacancy.location}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-location-dot me-2" aria-hidden="true"></i>
                                        {{#str}}location, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.location}}</dd>
                                </div>
                                {{/vacancy.location}}

                                {{#vacancy.modality}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-house-laptop me-2" aria-hidden="true"></i>
                                        {{#str}}modality, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.modality}}</dd>
                                </div>
                                {{/vacancy.modality}}

                                {{#vacancy.department}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-building me-2" aria-hidden="true"></i>
                                        {{#str}}department, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.department}}</dd>
                                </div>
                                {{/vacancy.department}}

                                {{#vacancy.companyname}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-industry me-2" aria-hidden="true"></i>
                                        {{#str}}company, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.companyname}}</dd>
                                </div>
                                {{/vacancy.companyname}}

                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-users me-2" aria-hidden="true"></i>
                                        {{#str}}positions, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0"><span class="badge bg-primary">{{vacancy.positions}}</span></dd>
                                </div>

                                {{#convocatoria}}
                                <div class="d-flex justify-content-between py-2">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                                        {{#str}}convocatoria, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0">
                                        <a href="{{convocatoria.viewurl}}" class="badge bg-info text-dark">{{convocatoria.code}}</a>
                                    </dd>
                                </div>
                                {{/convocatoria}}
                            </dl>
                        </div>
                    </div>

                    {{! Dates Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-calendar-days text-primary me-2" aria-hidden="true"></i>
                                {{#str}}dates, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="mb-0">
                                {{#convocatoria}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">{{#str}}startdate, local_jobboard{{/str}}</dt>
                                    <dd class="mb-0 fw-bold">{{convocatoria.startdateformatted}}</dd>
                                </div>
                                {{/convocatoria}}
                                <div class="d-flex justify-content-between py-2">
                                    <dt class="fw-normal text-muted">{{#str}}closedate, local_jobboard{{/str}}</dt>
                                    <dd class="mb-0 text-end">
                                        <span class="fw-bold {{#isurgent}}text-warning{{/isurgent}} {{#isclosed}}text-secondary{{/isclosed}}">{{closedateformatted}}</span>
                                        {{^isclosed}}
                                        <span class="d-block small {{#isurgent}}text-warning{{/isurgent}}{{^isurgent}}text-muted{{/isurgent}}">
                                            ({{daysremaining}} {{#str}}days, local_jobboard{{/str}})
                                        </span>
                                        {{/isclosed}}
                                    </dd>
                                </div>
                            </dl>

                            {{! Progress Bar }}
                            {{^isclosed}}
                            {{#convocatoria}}
                            <div class="mt-3 pt-3 border-top">
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                                </div>
                                <small class="text-muted d-block mt-1">{{#str}}deadlineprogress, local_jobboard{{/str}}</small>
                            </div>
                            {{/convocatoria}}
                            {{/isclosed}}
                        </div>
                    </div>

                    {{! Share Card }}
                    {{#sharelinks}}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                                {{#str}}share, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{facebook}}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                </a>
                                <a href="{{twitter}}" class="btn btn-outline-info" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                                    <i class="fab fa-twitter" aria-hidden="true"></i>
                                </a>
                                <a href="{{linkedin}}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                    <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                                </a>
                                <a href="{{whatsapp}}" class="btn btn-outline-success" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                                    <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    {{/sharelinks}}

                    {{! Apply CTA Card }}
                    {{^isclosed}}
                    {{^hasapplied}}
                    {{#canapply}}
                    <div class="card shadow-sm mb-4 border-success">
                        <div class="card-body text-center py-4">
                            <i class="fa fa-paper-plane fa-2x text-success mb-3" aria-hidden="true"></i>
                            <h6 class="mb-2">{{#str}}readytoapply, local_jobboard{{/str}}</h6>
                            <p class="text-muted small mb-3">{{#str}}applynow_desc, local_jobboard{{/str}}</p>
                            <a href="{{applyurl}}" class="btn btn-success jb-btn-success w-100">
                                <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                                {{#str}}apply, local_jobboard{{/str}}
                            </a>
                            {{#isurgent}}
                            <p class="text-warning small mt-2 mb-0">
                                <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                            </p>
                            {{/isurgent}}
                        </div>
                    </div>
                    {{/canapply}}

                    {{^canapply}}
                    {{^isloggedin}}
                    {{! Login CTA }}
                    <div class="card shadow-sm mb-4 border-primary">
                        <div class="card-body text-center py-4">
                            <i class="fa fa-circle-user fa-2x text-muted mb-3" aria-hidden="true"></i>
                            <h6 class="mb-2">{{#str}}wanttoapply, local_jobboard{{/str}}</h6>
                            <p class="text-muted small mb-3">{{#str}}loginrequiredtoapply, local_jobboard{{/str}}</p>
                            <a href="{{loginurl}}" class="btn btn-primary jb-btn-primary w-100 mb-2">
                                <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                                {{#str}}login{{/str}}
                            </a>
                            <a href="{{signupurl}}" class="btn btn-outline-primary jb-btn-outline-primary w-100">
                                <i class="fa fa-user-plus me-2" aria-hidden="true"></i>
                                {{#str}}createaccount{{/str}}
                            </a>
                        </div>
                    </div>
                    {{/isloggedin}}
                    {{/canapply}}
                    {{/hasapplied}}
                    {{/isclosed}}

                    {{! Already Applied Card }}
                    {{#hasapplied}}
                    <div class="card shadow-sm mb-4 border-info">
                        <div class="card-body text-center py-4">
                            <i class="fa fa-circle-check fa-2x text-info mb-3" aria-hidden="true"></i>
                            <h6 class="mb-2">{{#str}}applied, local_jobboard{{/str}}</h6>
                            <p class="text-muted small mb-3">{{#str}}alreadyappliedtothisvacancy, local_jobboard{{/str}}</p>
                            <a href="{{viewapplicationurl}}" class="btn btn-info jb-btn-info w-100 mb-2">
                                <i class="fa fa-eye me-2" aria-hidden="true"></i>
                                {{#str}}viewmyapplication, local_jobboard{{/str}}
                            </a>
                            <a href="{{myapplicationsurl}}" class="btn btn-outline-info jb-btn-outline-info w-100">
                                {{#str}}viewmyapplications, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>
                    {{/hasapplied}}

                    {{! Closed Card }}
                    {{#isclosed}}
                    <div class="card shadow-sm mb-4 border-secondary">
                        <div class="card-body text-center py-4">
                            <i class="fa fa-lock fa-2x text-secondary mb-3" aria-hidden="true"></i>
                            <h6 class="mb-2">{{#str}}vacancyclosed, local_jobboard{{/str}}</h6>
                            <p class="text-muted small mb-0">{{#str}}vacancycloseddesc, local_jobboard{{/str}}</p>
                        </div>
                    </div>
                    {{/isclosed}}
                </div>
            </div>
        </div>

        {{! Back Navigation }}
        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a href="{{backurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{backlabel}}
            </a>
            {{#browseurl}}
            <a href="{{browseurl}}" class="btn btn-link text-muted">
                {{#str}}browsevacancies, local_jobboard{{/str}}
                <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
            </a>
            {{/browseurl}}
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
