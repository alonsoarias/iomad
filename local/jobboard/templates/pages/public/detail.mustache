{{!
    @template local_jobboard/pages/public/detail

    Public vacancy detail page template.
    Simplified design following apply.mustache pattern.

    Context variables:
    * vacancy (object) - Vacancy data
    * backurl (string) - Back URL
    * convocatoria (object) - Convocatoria info if exists
    * isloggedin (bool) - User is logged in
    * canapply (bool) - Can apply
    * hasapplied (bool) - Already applied
    * applyurl (string) - Apply URL
    * applicationsurl (string) - My applications URL
    * loginapplyurl (string) - Login and apply URL
    * sharelinks (object) - Social sharing links

    Example context (json):
    {
        "vacancy": {"id": 1, "title": "Developer", "code": "DEV-001"},
        "isloggedin": true,
        "canapply": true
    }
}}
<div class="jb-detail-page" data-region="jobboard-public-detail" data-vacancy-id="{{vacancy.id}}">
    <div class="container-fluid px-0">
        {{! Back Navigation }}
        <div class="mb-4">
            <a href="{{backurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}backtovacancies, local_jobboard{{/str}}
            </a>
        </div>

        <div class="row">
            {{! Main Content Column }}
            <div class="col-lg-8">
                {{! Vacancy Header Card }}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary">
                            <i class="fa fa-hashtag me-1" aria-hidden="true"></i>
                            {{vacancy.code}}
                        </span>
                        <span class="badge bg-{{vacancy.publicationtypecolor}}">
                            {{vacancy.publicationtypelabel}}
                        </span>
                    </div>
                    <div class="card-body">
                        <h1 class="h4 mb-3">{{vacancy.title}}</h1>

                        {{! Convocatoria Info }}
                        {{#convocatoria}}
                        <div class="mb-3 p-2 bg-light rounded">
                            <i class="fa fa-folder-open text-primary me-2" aria-hidden="true"></i>
                            {{#str}}convocatoria, local_jobboard{{/str}}:
                            <strong>{{name}}</strong>
                        </div>
                        {{/convocatoria}}

                        {{! Quick Details }}
                        <div class="mb-3 d-flex flex-wrap gap-2">
                            {{#vacancy.location}}
                            <span class="badge bg-light text-dark py-2 px-3">
                                <i class="fa fa-location-dot text-danger me-1" aria-hidden="true"></i>
                                {{vacancy.location}}
                            </span>
                            {{/vacancy.location}}

                            {{#vacancy.contracttypelabel}}
                            <span class="badge bg-light text-dark py-2 px-3">
                                <i class="fa fa-file-contract text-info me-1" aria-hidden="true"></i>
                                {{vacancy.contracttypelabel}}
                            </span>
                            {{/vacancy.contracttypelabel}}

                            <span class="badge bg-light text-dark py-2 px-3">
                                <i class="fa fa-users text-success me-1" aria-hidden="true"></i>
                                {{#str}}positions, local_jobboard{{/str}}: <strong>{{vacancy.positions}}</strong>
                            </span>
                        </div>

                        {{! Urgent Warning }}
                        {{#vacancy.isurgent}}
                        <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                            <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
                            <div>
                                <strong>{{#str}}urgent, local_jobboard{{/str}}:</strong>
                                {{#str}}closesin, local_jobboard, {{vacancy.daysremaining}}{{/str}}
                            </div>
                        </div>
                        {{/vacancy.isurgent}}
                    </div>
                </div>

                {{! Description Card }}
                {{#vacancy.description}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                            {{#str}}vacancydescription, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.description}}}
                    </div>
                </div>
                {{/vacancy.description}}

                {{! Requirements Card }}
                {{#vacancy.requirements}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-circle-check text-success me-2" aria-hidden="true"></i>
                            {{#str}}requirements, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.requirements}}}
                    </div>
                </div>
                {{/vacancy.requirements}}

                {{! Desirable Card }}
                {{#vacancy.desirable}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-star text-warning me-2" aria-hidden="true"></i>
                            {{#str}}desirable, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{vacancy.desirable}}}
                    </div>
                </div>
                {{/vacancy.desirable}}
            </div>

            {{! Sidebar Column }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 1rem;">
                    {{! Apply CTA Card }}
                    <div class="card shadow-sm mb-4 border-primary">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-paper-plane text-primary me-2" aria-hidden="true"></i>
                                {{#str}}readytoapply, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body text-center py-4">
                            {{#isloggedin}}
                                {{#hasapplied}}
                                <div class="text-success">
                                    <i class="fa fa-circle-check fa-2x mb-3" aria-hidden="true"></i>
                                    <p class="fw-bold mb-3">{{#str}}alreadyapplied, local_jobboard{{/str}}</p>
                                </div>
                                <a href="{{applicationsurl}}" class="btn btn-outline-primary w-100">
                                    <i class="fa fa-list me-2" aria-hidden="true"></i>
                                    {{#str}}viewmyapplications, local_jobboard{{/str}}
                                </a>
                                {{/hasapplied}}

                                {{^hasapplied}}
                                    {{#canapply}}
                                    <p class="text-muted mb-3">{{#str}}applynowdesc, local_jobboard{{/str}}</p>
                                    <a href="{{applyurl}}" class="btn btn-primary btn-lg w-100">
                                        <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                                        {{#str}}apply, local_jobboard{{/str}}
                                    </a>
                                    {{/canapply}}

                                    {{^canapply}}
                                    <i class="fa fa-lock fa-2x text-muted mb-2" aria-hidden="true"></i>
                                    <p class="text-muted mb-0">{{#str}}cannotapply, local_jobboard{{/str}}</p>
                                    {{/canapply}}
                                {{/hasapplied}}
                            {{/isloggedin}}

                            {{^isloggedin}}
                            <i class="fa fa-user fa-2x text-muted mb-3" aria-hidden="true"></i>
                            <p class="text-muted mb-3">{{#str}}logintoapply, local_jobboard{{/str}}</p>
                            <a href="{{loginapplyurl}}" class="btn btn-primary btn-lg w-100">
                                <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                                {{#str}}loginandapply, local_jobboard{{/str}}
                            </a>
                            {{/isloggedin}}
                        </div>
                    </div>

                    {{! Details Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-circle-info text-info me-2" aria-hidden="true"></i>
                                {{#str}}details, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="mb-0">
                                {{#vacancy.duration}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-clock me-2" aria-hidden="true"></i>
                                        {{#str}}duration, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.duration}}</dd>
                                </div>
                                {{/vacancy.duration}}

                                {{#vacancy.department}}
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-building me-2" aria-hidden="true"></i>
                                        {{#str}}department, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 fw-bold">{{vacancy.department}}</dd>
                                </div>
                                {{/vacancy.department}}

                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-calendar-check me-2" aria-hidden="true"></i>
                                        {{#str}}opendate, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0">{{vacancy.opendateformatted}}</dd>
                                </div>

                                <div class="d-flex justify-content-between py-2">
                                    <dt class="fw-normal text-muted">
                                        <i class="fa fa-calendar-xmark me-2" aria-hidden="true"></i>
                                        {{#str}}closedate, local_jobboard{{/str}}
                                    </dt>
                                    <dd class="mb-0 {{#vacancy.isurgent}}text-warning fw-bold{{/vacancy.isurgent}}">
                                        {{#vacancy.isurgent}}<i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>{{/vacancy.isurgent}}
                                        {{vacancy.closedateformatted}}
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>

                    {{! Share Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0">
                                <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                                {{#str}}share, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{sharelinks.linkedin}}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                    <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                                </a>
                                <a href="{{sharelinks.facebook}}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                </a>
                                <a href="{{sharelinks.twitter}}" class="btn btn-outline-info" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                                    <i class="fab fa-twitter" aria-hidden="true"></i>
                                </a>
                                <a href="{{sharelinks.whatsapp}}" class="btn btn-outline-success" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                                    <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.jb-detail-page .card {
    border-radius: 0.5rem;
}
.jb-detail-page .card-header {
    border-bottom: 1px solid rgba(0,0,0,.05);
}
</style>
