{{!
    @template local_jobboard/pages/public/detail

    Public vacancy detail page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * vacancy (object) - Vacancy data
    * backurl (string) - Back URL
    * convocatoria (object) - Convocatoria info if exists
    * isloggedin (bool) - User is logged in
    * canapply (bool) - Can apply
    * hasapplied (bool) - Already applied
    * applyurl (string) - Apply URL
    * applicationsurl (string) - My applications URL
    * loginapplyurl (string) - Login and apply URL
    * sharelinks (object) - Social sharing links
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "vacancy": {"id": 1, "title": "Developer", "code": "DEV-001"},
        "isloggedin": true,
        "canapply": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-public-detail" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton-text mb-4" style="width: 120px; height: 40px;"></div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="jb-skeleton-title mb-3" style="width: 80%;"></div>
                    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 200px;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="jb-skeleton-text mb-3" style="width: 100%; height: 120px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-public-detail" data-region="jobboard-public-detail" data-vacancy-id="{{vacancy.id}}">
    {{! Skip Link for Accessibility }}
    <a href="#vacancy-detail-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Back Button }}
    <nav class="mb-4 jb-fade-in" aria-label="{{#str}}navigation, local_jobboard{{/str}}">
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}backtovacancies, local_jobboard{{/str}}
        </a>
    </nav>

    {{! Two Column Layout }}
    <div class="row">
        {{! Left Column - Main Content }}
        <main class="col-lg-8" id="vacancy-detail-content">
            {{! Vacancy Header Card }}
            <article class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="vacancy-detail-title" style="animation-delay: 0.05s;">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <span class="badge bg-light text-dark fw-bold" aria-label="{{#str}}vacancycode, local_jobboard{{/str}}: {{vacancy.code}}">
                        <i class="fa fa-hashtag me-1" aria-hidden="true"></i>
                        {{vacancy.code}}
                    </span>
                    <span class="badge jb-badge-{{vacancy.publicationtypecolor}}">
                        {{vacancy.publicationtypelabel}}
                    </span>
                </div>

                <div class="card-body">
                    <h1 class="card-title fs-2 mb-3" id="vacancy-detail-title">{{vacancy.title}}</h1>

                    {{! Convocatoria Info }}
                    {{#convocatoria}}
                    <div class="mb-3 p-2 bg-light rounded">
                        <i class="fa fa-folder-open text-primary me-2" aria-hidden="true"></i>
                        {{#str}}convocatoria, local_jobboard{{/str}}:
                        <strong>{{name}}</strong>
                    </div>
                    {{/convocatoria}}

                    {{! Quick Details Badges }}
                    <div class="mb-3 jb-vacancy-badges d-flex flex-wrap gap-2" role="list" aria-label="{{#str}}vacancydetails, local_jobboard{{/str}}">
                        {{#vacancy.location}}
                        <span class="badge bg-light text-dark py-2 px-3" role="listitem">
                            <i class="fa fa-location-dot text-danger me-1" aria-hidden="true"></i>
                            <span class="visually-hidden">{{#str}}location, local_jobboard{{/str}}:</span>
                            {{vacancy.location}}
                        </span>
                        {{/vacancy.location}}

                        {{#vacancy.contracttypelabel}}
                        <span class="badge bg-light text-dark py-2 px-3" role="listitem">
                            <i class="fa fa-file-contract text-info me-1" aria-hidden="true"></i>
                            <span class="visually-hidden">{{#str}}contracttype, local_jobboard{{/str}}:</span>
                            {{vacancy.contracttypelabel}}
                        </span>
                        {{/vacancy.contracttypelabel}}

                        <span class="badge bg-light text-dark py-2 px-3" role="listitem">
                            <i class="fa fa-users text-success me-1" aria-hidden="true"></i>
                            {{#str}}positions, local_jobboard{{/str}}: <strong>{{vacancy.positions}}</strong>
                        </span>
                    </div>

                    {{! Urgent Warning }}
                    {{#vacancy.isurgent}}
                    <div class="alert alert-warning d-flex align-items-center jb-pulse" role="alert">
                        <i class="fa fa-triangle-exclamation fa-lg me-3" aria-hidden="true"></i>
                        <div>
                            <strong>{{#str}}urgent, local_jobboard{{/str}}:</strong>
                            {{#str}}closesin, local_jobboard, {{vacancy.daysremaining}}{{/str}}
                        </div>
                    </div>
                    {{/vacancy.isurgent}}
                </div>
            </article>

            {{! Description Card }}
            {{#vacancy.description}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="description-heading" style="animation-delay: 0.1s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0 fw-bold" id="description-heading">
                        <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                        {{#str}}vacancydescription, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.description}}}
                </div>
            </section>
            {{/vacancy.description}}

            {{! Requirements Card }}
            {{#vacancy.requirements}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="requirements-heading" style="animation-delay: 0.15s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0 fw-bold" id="requirements-heading">
                        <i class="fa fa-circle-check text-success me-2" aria-hidden="true"></i>
                        {{#str}}requirements, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.requirements}}}
                </div>
            </section>
            {{/vacancy.requirements}}

            {{! Desirable Card }}
            {{#vacancy.desirable}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="desirable-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0 fw-bold" id="desirable-heading">
                        <i class="fa fa-star text-warning me-2" aria-hidden="true"></i>
                        {{#str}}desirable, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.desirable}}}
                </div>
            </section>
            {{/vacancy.desirable}}
        </main>

        {{! Right Column - Sidebar }}
        <aside class="col-lg-4">
            {{! Apply CTA Card }}
            <section class="card shadow-sm mb-4 border-primary jb-fade-in-up" aria-labelledby="apply-cta-heading" style="animation-delay: 0.1s;">
                <div class="card-header bg-primary text-white">
                    <h2 class="fs-5 mb-0 fw-bold" id="apply-cta-heading">
                        <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                        {{#str}}readytoapply, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body text-center py-4">
                    {{#isloggedin}}
                        {{#hasapplied}}
                        <div class="text-success" role="status">
                            <div class="jb-icon-circle-lg bg-success text-white mx-auto mb-3">
                                <i class="fa fa-check fa-2x" aria-hidden="true"></i>
                            </div>
                            <p class="fw-bold mb-3">{{#str}}alreadyapplied, local_jobboard{{/str}}</p>
                        </div>
                        <a href="{{applicationsurl}}" class="btn btn-outline-primary w-100 jb-hover-lift">
                            <i class="fa fa-list me-2" aria-hidden="true"></i>
                            {{#str}}viewmyapplications, local_jobboard{{/str}}
                        </a>
                        {{/hasapplied}}

                        {{^hasapplied}}
                            {{#canapply}}
                            <p class="text-muted mb-3">{{#str}}applynowdesc, local_jobboard{{/str}}</p>
                            <a href="{{applyurl}}" class="btn btn-primary btn-lg w-100 jb-hover-lift" aria-label="{{#str}}applyto, local_jobboard{{/str}}: {{vacancy.title}}">
                                <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                                {{#str}}apply, local_jobboard{{/str}}
                            </a>
                            {{/canapply}}

                            {{^canapply}}
                            <div class="text-muted">
                                <i class="fa fa-lock fa-2x mb-2" aria-hidden="true"></i>
                                <p class="mb-0">{{#str}}cannotapply, local_jobboard{{/str}}</p>
                            </div>
                            {{/canapply}}
                        {{/hasapplied}}
                    {{/isloggedin}}

                    {{^isloggedin}}
                    <div class="jb-icon-circle-lg bg-light text-muted mx-auto mb-3">
                        <i class="fa fa-user fa-2x" aria-hidden="true"></i>
                    </div>
                    <p class="text-muted mb-3">{{#str}}logintoapply, local_jobboard{{/str}}</p>
                    <a href="{{loginapplyurl}}" class="btn btn-primary btn-lg w-100 jb-hover-lift">
                        <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                        {{#str}}loginandapply, local_jobboard{{/str}}
                    </a>
                    {{/isloggedin}}
                </div>
            </section>

            {{! Details Card }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="details-heading" style="animation-delay: 0.15s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0 fw-bold" id="details-heading">
                        <i class="fa fa-circle-info text-info me-2" aria-hidden="true"></i>
                        {{#str}}details, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        {{#vacancy.duration}}
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <dt class="text-muted fw-normal">
                                <i class="fa fa-clock me-2" aria-hidden="true"></i>
                                {{#str}}duration, local_jobboard{{/str}}
                            </dt>
                            <dd class="mb-0 fw-bold">{{vacancy.duration}}</dd>
                        </div>
                        {{/vacancy.duration}}

                        {{#vacancy.department}}
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <dt class="text-muted fw-normal">
                                <i class="fa fa-building me-2" aria-hidden="true"></i>
                                {{#str}}department, local_jobboard{{/str}}
                            </dt>
                            <dd class="mb-0 fw-bold">{{vacancy.department}}</dd>
                        </div>
                        {{/vacancy.department}}

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <dt class="text-muted fw-normal">
                                <i class="fa fa-calendar-check me-2" aria-hidden="true"></i>
                                {{#str}}opendate, local_jobboard{{/str}}
                            </dt>
                            <dd class="mb-0">{{vacancy.opendateformatted}}</dd>
                        </div>

                        <div class="d-flex justify-content-between py-2">
                            <dt class="text-muted fw-normal">
                                <i class="fa fa-calendar-xmark me-2" aria-hidden="true"></i>
                                {{#str}}closedate, local_jobboard{{/str}}
                            </dt>
                            <dd class="mb-0 {{#vacancy.isurgent}}text-warning fw-bold{{/vacancy.isurgent}}">
                                {{#vacancy.isurgent}}<i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>{{/vacancy.isurgent}}
                                {{vacancy.closedateformatted}}
                            </dd>
                        </div>
                    </dl>
                </div>
            </section>

            {{! Share Card }}
            <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="share-heading" style="animation-delay: 0.2s;">
                <div class="card-header bg-white">
                    <h2 class="fs-5 mb-0 fw-bold" id="share-heading">
                        <i class="fa fa-share-nodes text-primary me-2" aria-hidden="true"></i>
                        {{#str}}share, local_jobboard{{/str}}
                    </h2>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-center gap-2" role="group" aria-label="{{#str}}sharethisvacancy, local_jobboard{{/str}}">
                        <a href="{{sharelinks.linkedin}}" class="btn btn-outline-primary btn-lg jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareonlinkedin, local_jobboard{{/str}}">
                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                            <span class="visually-hidden">LinkedIn</span>
                        </a>
                        <a href="{{sharelinks.facebook}}" class="btn btn-outline-primary btn-lg jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareonfacebook, local_jobboard{{/str}}">
                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                            <span class="visually-hidden">Facebook</span>
                        </a>
                        <a href="{{sharelinks.twitter}}" class="btn btn-outline-info btn-lg jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="{{#str}}shareontwitter, local_jobboard{{/str}}">
                            <i class="fab fa-twitter" aria-hidden="true"></i>
                            <span class="visually-hidden">Twitter</span>
                        </a>
                        <a href="{{sharelinks.whatsapp}}" class="btn btn-outline-success btn-lg jb-hover-lift" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                            <i class="fab fa-whatsapp" aria-hidden="true"></i>
                            <span class="visually-hidden">WhatsApp</span>
                        </a>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>
{{/loading}}
