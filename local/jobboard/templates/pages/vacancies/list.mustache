{{!
    @template local_jobboard/pages/vacancies

    Vacancies list page template for applicants with enhanced UX.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * dashboardurl - URL to dashboard
    * convocatoria - Convocatoria data if filtering by one
    * welcometitle - Welcome banner title
    * welcomedesc - Welcome banner description
    * stats - Array of stat cards
    * filterform - Filter form data
    * showinginfo - Showing X-Y of Z text
    * hasvacancies - Boolean
    * vacancies - Array of vacancy card data
    * pagination - Pagination HTML
    * browseconvocatoriasurl - URL to browse convocatorias
    * loading - Show skeleton loading state

    Example context (json):
    {
        "hasvacancies": true,
        "vacancies": [{"id": 1, "title": "Developer", "code": "VAC-001"}]
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-vacancies" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-page-header mb-4">
        <div class="jb-skeleton-text" style="width: 200px; height: 1em;"></div>
        <div class="jb-skeleton-title mt-3" style="width: 50%;"></div>
    </div>
    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 90px; border-radius: 0.5rem;"></div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card shadow-sm"><div class="card-body"><div class="jb-skeleton-title"></div><div class="jb-skeleton-text" style="width: 80%;"></div></div></div>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card shadow-sm"><div class="card-body"><div class="jb-skeleton-title"></div><div class="jb-skeleton-text" style="width: 70%;"></div></div></div>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card shadow-sm"><div class="card-body"><div class="jb-skeleton-title"></div><div class="jb-skeleton-text" style="width: 90%;"></div></div></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-vacancies" data-region="jobboard-vacancies">
    {{! Skip Link - Hidden until focused (Bootstrap 5 native) }}
    <a href="#vacancies-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header - Breadcrumbs handled by Moodle via $PAGE->navbar }}
    <header class="mb-4">
        <h1 class="h4 mb-2">
            <i class="fa fa-briefcase text-primary me-2" aria-hidden="true"></i>
            {{#convocatoria}}
            {{#str}}vacancies, local_jobboard{{/str}}: {{convocatoria.name}}
            {{/convocatoria}}
            {{^convocatoria}}
            {{#str}}vacancies, local_jobboard{{/str}}
            {{/convocatoria}}
        </h1>
        {{#welcomedesc}}
        <p class="text-muted mb-0">{{welcomedesc}}</p>
        {{/welcomedesc}}
    </header>

    {{! Statistics Row }}
    {{#stats.0}}
    <section class="row mb-4" role="region" aria-label="{{#str}}applicantstatistics, local_jobboard{{/str}}">
        {{#stats}}
        <div class="col-lg-3 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
            {{> local_jobboard/components/stat_card }}
        </div>
        {{/stats}}
    </section>
    {{/stats.0}}

    {{! Filter Form }}
    {{#filterform}}
    <div class="card mb-4 jb-fade-in-up" style="animation-delay: 0.1s;">
        <div class="card-body">
            <form method="get" action="{{filterform.action}}" class="jb-filter-form" role="search" aria-label="{{#str}}filtervacancies, local_jobboard{{/str}}">
                {{#filterform.hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/filterform.hiddenfields}}
                <div class="row align-items-end">
                    {{#filterform.fields}}
                    <div class="{{col}} mb-2">
                        {{#istext}}
                        <label for="filter-{{name}}" class="form-label small text-muted visually-hidden">{{label}}</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-magnifying-glass text-muted" aria-hidden="true"></i>
                            </span>
                            <input type="text" name="{{name}}" id="filter-{{name}}" class="form-control" placeholder="{{placeholder}}" value="{{value}}">
                        </div>
                        {{/istext}}
                        {{#isselect}}
                        <label for="filter-{{name}}" class="form-label small text-muted">{{label}}</label>
                        <select name="{{name}}" id="filter-{{name}}" class="form-select">
                            {{#options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                        {{/isselect}}
                    </div>
                    {{/filterform.fields}}
                    <div class="jb-col-auto mb-2">
                        <button type="submit" class="btn btn-primary jb-btn-primary">
                            <i class="fa fa-filter me-1" aria-hidden="true"></i>
                            {{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! Results Info }}
    {{#showinginfo}}
    <p class="text-muted small mb-3 jb-fade-in" role="status" aria-live="polite">
        <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
        {{showinginfo}}
    </p>
    {{/showinginfo}}

    {{! Vacancy Cards Grid }}
    <div id="vacancies-main-content">
        {{#hasvacancies}}
        <section class="row" aria-label="{{#str}}vacancies, local_jobboard{{/str}}">
            {{#vacancies}}
            <div class="col-lg-4 col-md-6 mb-4">
                <article class="card h-100 shadow-sm jb-vacancy-card jb-hover-lift jb-fade-in-up {{#urgent}}border-warning{{/urgent}} {{#isclosed}}opacity-75{{/isclosed}}"
                         data-vacancy-id="{{id}}"
                         aria-labelledby="vac-title-{{id}}"
                         style="animation-delay: {{animdelay}}s;">
                    {{! Urgent Banner }}
                    {{#urgent}}
                    {{^isclosed}}
                    <div class="jb-card-urgent-banner bg-warning text-dark py-1 px-3 small text-center fw-bold">
                        <i class="fa fa-clock me-1" aria-hidden="true"></i>
                        {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                    </div>
                    {{/isclosed}}
                    {{/urgent}}

                    {{! Card Header }}
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                        <code class="small text-muted">{{code}}</code>
                        <div class="d-flex align-items-center gap-1">
                            {{#convocatoriacode}}
                            <span class="badge bg-light text-dark" title="{{#str}}convocatoria, local_jobboard{{/str}}">
                                <i class="fa fa-folder-open text-info" aria-hidden="true"></i>
                            </span>
                            {{/convocatoriacode}}
                            <span class="badge jb-badge-{{statuscolor}}">{{statuslabel}}</span>
                        </div>
                    </div>

                    {{! Card Body }}
                    <div class="card-body">
                        <h2 class="card-title fs-5" id="vac-title-{{id}}">
                            <a href="{{viewurl}}" class="text-dark text-decoration-none jb-hover-primary">
                                {{title}}
                            </a>
                        </h2>

                        <div class="small text-muted">
                            {{#location}}
                            <p class="mb-1 d-flex align-items-center">
                                <i class="fa fa-location-dot me-2 text-primary" aria-hidden="true"></i>
                                {{location}}
                            </p>
                            {{/location}}

                            {{#contracttypelabel}}
                            <p class="mb-1 d-flex align-items-center">
                                <i class="fa fa-file-contract me-2 text-secondary" aria-hidden="true"></i>
                                {{contracttypelabel}}
                            </p>
                            {{/contracttypelabel}}

                            <p class="mb-0 d-flex align-items-center">
                                <i class="fa fa-users me-2 text-success" aria-hidden="true"></i>
                                {{#str}}positions, local_jobboard{{/str}}: <span class="badge bg-light text-dark ms-1">{{positions}}</span>
                            </p>
                        </div>
                    </div>

                    {{! Card Footer }}
                    <footer class="card-footer bg-white d-flex justify-content-between align-items-center">
                        <small class="{{#urgent}}text-warning fw-bold{{/urgent}} {{^urgent}}text-muted{{/urgent}}">
                            <i class="fa fa-calendar-xmark me-1" aria-hidden="true"></i>
                            {{closedateformatted}}
                        </small>
                        <div class="d-flex align-items-center gap-2">
                            {{#hasapplied}}
                            <span class="badge bg-info text-dark rounded-pill">
                                <i class="fa fa-check me-1" aria-hidden="true"></i>
                                {{#str}}applied, local_jobboard{{/str}}
                            </span>
                            {{/hasapplied}}
                            {{^hasapplied}}
                            {{#canapply}}
                            {{^isclosed}}
                            <a href="{{applyurl}}" class="btn btn-sm btn-success jb-card-action jb-hover-lift">
                                <i class="fa fa-paper-plane me-1" aria-hidden="true"></i>
                                {{#str}}apply, local_jobboard{{/str}}
                            </a>
                            {{/isclosed}}
                            {{/canapply}}
                            {{#isclosed}}
                            <span class="badge bg-secondary">
                                <i class="fa fa-lock me-1" aria-hidden="true"></i>
                                {{#str}}status:closed, local_jobboard{{/str}}
                            </span>
                            {{/isclosed}}
                            {{/hasapplied}}
                        </div>
                    </footer>
                </article>
            </div>
            {{/vacancies}}
        </section>
        {{/hasvacancies}}

        {{! Empty State }}
        {{^hasvacancies}}
        <div class="jb-empty-state py-5" role="status">
            <i class="fa fa-briefcase jb-empty-state-icon" aria-hidden="true"></i>
            <h2 class="jb-empty-state-title">{{#str}}noresults, local_jobboard{{/str}}</h2>
            <p class="jb-empty-state-description">{{#str}}novacancies, local_jobboard{{/str}}</p>
            {{#browseconvocatoriasurl}}
            <div class="jb-empty-state-actions">
                <a href="{{browseconvocatoriasurl}}" class="btn btn-primary jb-btn-primary">
                    <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                    {{#str}}browseconvocatorias, local_jobboard{{/str}}
                </a>
            </div>
            {{/browseconvocatoriasurl}}
        </div>
        {{/hasvacancies}}
    </div>

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-4 jb-fade-in" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
        {{{pagination}}}
    </nav>
    {{/pagination}}

    {{! Navigation Footer }}
    <nav class="jb-navigation-footer d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}backtodashboard, local_jobboard{{/str}}
        </a>
        <a href="{{browseconvocatoriasurl}}" class="btn btn-link text-muted">
            {{#str}}browseconvocatorias, local_jobboard{{/str}}
            <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
        </a>
    </nav>
</div>
{{/loading}}
