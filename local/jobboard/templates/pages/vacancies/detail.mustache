{{!
    @template local_jobboard/pages/vacancies/detail

    Vacancy detail page - Clean minimal design following jb-* pattern.

    Context variables:
    * vacancy - Vacancy data
    * convocatoria - Convocatoria info
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * canedit - Boolean if can edit
    * canmanage - Boolean if can manage
    * applicationstats - Stats for managers
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * progresspercent - Progress bar percentage
    * progresscolor - Progress bar color class
    * isloggedin - Boolean if user is logged in
    * applyurl - URL to apply
    * editurl - URL to edit vacancy
    * myapplicationsurl - URL to user's applications
    * loginurl - URL to login
    * backurl - URL to go back
    * backlabel - Label for back button
    * dashboardurl - URL to dashboard
}}
<div class="jb-vacancy-detail" id="jobboard-vacancy-detail" data-vacancy-id="{{vacancy.id}}">
    {{! Header }}
    <div class="jb-detail-header">
        <div class="jb-detail-header__nav">
            <a href="{{backurl}}" class="jb-detail-header__back">
                <i class="fa fa-arrow-left"></i>
                {{backlabel}}
            </a>
            {{#canedit}}
            <a href="{{editurl}}" class="jb-btn jb-btn--outline jb-btn--sm">
                <i class="fa fa-edit"></i> {{#str}}edit{{/str}}
            </a>
            {{/canedit}}
        </div>
        <div class="jb-detail-header__title-row">
            <span class="jb-code jb-code--primary">{{vacancy.code}}</span>
            <span class="jb-badge jb-badge--{{vacancy.statuscolor}}">{{vacancy.statuslabel}}</span>
            {{#isurgent}}{{^isclosed}}
            <span class="jb-badge jb-badge--warning">
                <i class="fa fa-clock"></i> {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
            </span>
            {{/isclosed}}{{/isurgent}}
        </div>
        <h1 class="jb-detail-header__title">{{vacancy.title}}</h1>
        {{#vacancy.department}}
        <p class="jb-detail-header__subtitle">
            <i class="fa fa-building"></i> {{vacancy.department}}
        </p>
        {{/vacancy.department}}
    </div>

    {{! Urgent Warning }}
    {{#isurgent}}{{^isclosed}}
    <div class="jb-alert jb-alert--warning">
        <i class="fa fa-clock"></i>
        <div class="jb-alert__content">
            <strong>{{#str}}closingsoon, local_jobboard{{/str}}</strong>
            <span>{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
        </div>
    </div>
    {{/isclosed}}{{/isurgent}}

    {{! Closed Notice }}
    {{#isclosed}}
    <div class="jb-alert jb-alert--secondary">
        <i class="fa fa-lock"></i>
        <div class="jb-alert__content">
            <strong>{{#str}}vacancyclosed, local_jobboard{{/str}}</strong>
            <span>{{#str}}vacancyclosed_desc, local_jobboard{{/str}}</span>
        </div>
    </div>
    {{/isclosed}}

    {{! Content Layout }}
    <div class="jb-detail-content">
        {{! Main Column }}
        <div class="jb-detail-main">
            {{! Description Card }}
            {{#vacancy.description}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-file-lines"></i>
                    {{#str}}description, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.description}}}
                </div>
            </div>
            {{/vacancy.description}}

            {{! Requirements Card }}
            {{#vacancy.requirements}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--warning">
                    <i class="fa fa-list-check"></i>
                    {{#str}}requirements, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.requirements}}}
                </div>
            </div>
            {{/vacancy.requirements}}

            {{! Desirable Card }}
            {{#vacancy.desirable}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--info">
                    <i class="fa fa-star"></i>
                    {{#str}}desirable, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.desirable}}}
                </div>
            </div>
            {{/vacancy.desirable}}

            {{! Benefits Card }}
            {{#vacancy.benefits}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--success">
                    <i class="fa fa-gift"></i>
                    {{#str}}benefits, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content">
                    {{{vacancy.benefits}}}
                </div>
            </div>
            {{/vacancy.benefits}}
        </div>

        {{! Sidebar }}
        <aside class="jb-detail-sidebar">
            {{! Apply CTA Card }}
            <div class="jb-card {{^isclosed}}jb-card--cta{{/isclosed}}">
                <div class="jb-card__header">
                    <i class="fa fa-paper-plane"></i>
                    {{#str}}readytoapply, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-text-center">
                    {{#hasapplied}}
                    <div class="jb-cta-card">
                        <i class="fa fa-check-circle jb-cta-card__icon jb-cta-card__icon--success"></i>
                        <h4 class="jb-cta-card__title jb-text-success">{{#str}}alreadyapplied, local_jobboard{{/str}}</h4>
                        <a href="{{myapplicationsurl}}" class="jb-btn jb-btn--outline jb-btn--block">
                            <i class="fa fa-folder-open"></i> {{#str}}viewmyapplications, local_jobboard{{/str}}
                        </a>
                    </div>
                    {{/hasapplied}}

                    {{^hasapplied}}
                    {{#canapply}}{{^isclosed}}
                    <div class="jb-cta-card">
                        <p class="jb-cta-card__text">{{#str}}applynowdesc, local_jobboard{{/str}}</p>
                        <a href="{{applyurl}}" class="jb-btn jb-btn--success jb-btn--lg jb-btn--block">
                            <i class="fa fa-paper-plane"></i> {{#str}}apply, local_jobboard{{/str}}
                        </a>
                        {{#isurgent}}
                        <p class="jb-cta-card__urgent">
                            <i class="fa fa-clock"></i> {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                        </p>
                        {{/isurgent}}
                    </div>
                    {{/isclosed}}{{/canapply}}

                    {{#isclosed}}
                    <div class="jb-cta-card">
                        <i class="fa fa-lock jb-cta-card__icon jb-cta-card__icon--muted"></i>
                        <p class="jb-cta-card__text">{{#str}}vacancyclosed, local_jobboard{{/str}}</p>
                    </div>
                    {{/isclosed}}

                    {{^canapply}}{{^isclosed}}
                    {{#isloggedin}}
                    <div class="jb-cta-card">
                        <i class="fa fa-ban jb-cta-card__icon jb-cta-card__icon--muted"></i>
                        <p class="jb-cta-card__text">{{#str}}cannotapply, local_jobboard{{/str}}</p>
                    </div>
                    {{/isloggedin}}
                    {{^isloggedin}}
                    <div class="jb-cta-card">
                        <p class="jb-cta-card__text">{{#str}}logintoapply, local_jobboard{{/str}}</p>
                        <a href="{{loginurl}}" class="jb-btn jb-btn--primary jb-btn--lg jb-btn--block">
                            <i class="fa fa-sign-in-alt"></i> {{#str}}login{{/str}}
                        </a>
                    </div>
                    {{/isloggedin}}
                    {{/isclosed}}{{/canapply}}
                    {{/hasapplied}}
                </div>
            </div>

            {{! Details Card }}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--accent">
                    <i class="fa fa-circle-info"></i>
                    {{#str}}details, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    {{#vacancy.location}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-location-dot"></i> {{#str}}location, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.location}}</strong>
                    </div>
                    {{/vacancy.location}}
                    {{#vacancy.modality}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-house-laptop"></i> {{#str}}modality, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.modality}}</strong>
                    </div>
                    {{/vacancy.modality}}
                    {{#vacancy.department}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-building"></i> {{#str}}department, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.department}}</strong>
                    </div>
                    {{/vacancy.department}}
                    {{#vacancy.contracttypelabel}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-file-contract"></i> {{#str}}contracttype, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.contracttypelabel}}</strong>
                    </div>
                    {{/vacancy.contracttypelabel}}
                    {{#vacancy.duration}}
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-hourglass-half"></i> {{#str}}duration, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.duration}}</strong>
                    </div>
                    {{/vacancy.duration}}
                    <div class="jb-info-row jb-info-row--last">
                        <span class="jb-info-label"><i class="fa fa-users"></i> {{#str}}positions, local_jobboard{{/str}}</span>
                        <span class="jb-badge jb-badge--primary">{{vacancy.positions}}</span>
                    </div>
                </div>
            </div>

            {{! Dates Card }}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--warning-light">
                    <i class="fa fa-calendar-days"></i>
                    {{#str}}dates, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-info-row">
                        <span class="jb-info-label"><i class="fa fa-calendar-check jb-text-success"></i> {{#str}}opendate, local_jobboard{{/str}}</span>
                        <strong>{{vacancy.opendateformatted}}</strong>
                    </div>
                    <div class="jb-info-row jb-info-row--last {{#isurgent}}jb-info-row--urgent{{/isurgent}}">
                        <span class="jb-info-label"><i class="fa fa-calendar-xmark jb-text-danger"></i> {{#str}}closedate, local_jobboard{{/str}}</span>
                        <strong class="{{#isurgent}}jb-text-warning{{/isurgent}}">{{vacancy.closedateformatted}}</strong>
                    </div>

                    {{! Deadline Progress }}
                    {{^isclosed}}
                    <div class="jb-progress-section">
                        <div class="jb-progress-header">
                            <span>{{#str}}deadlineprogress, local_jobboard{{/str}}</span>
                            <strong class="{{#isurgent}}jb-text-warning{{/isurgent}}">{{daysremaining}} {{#str}}days, local_jobboard{{/str}}</strong>
                        </div>
                        <div class="jb-progress">
                            <div class="jb-progress__bar jb-progress__bar--{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                        </div>
                    </div>
                    {{/isclosed}}
                </div>
            </div>

            {{! Application Stats (for managers) }}
            {{#applicationstats}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-chart-bar"></i>
                    {{#str}}applicationstats, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-doc-stats">
                        <div class="jb-doc-stat jb-doc-stat--primary">
                            <span class="jb-doc-stat__value">{{total}}</span>
                            <span class="jb-doc-stat__label">{{#str}}total{{/str}}</span>
                        </div>
                        <div class="jb-doc-stat jb-doc-stat--warning">
                            <span class="jb-doc-stat__value">{{pending}}</span>
                            <span class="jb-doc-stat__label">{{#str}}pending, local_jobboard{{/str}}</span>
                        </div>
                        <div class="jb-doc-stat jb-doc-stat--success">
                            <span class="jb-doc-stat__value">{{validated}}</span>
                            <span class="jb-doc-stat__label">{{#str}}validated, local_jobboard{{/str}}</span>
                        </div>
                    </div>
                    <a href="{{manageurl}}" class="jb-btn jb-btn--info jb-btn--block">
                        <i class="fa fa-list-check"></i> {{#str}}manageapplications, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
            {{/applicationstats}}

            {{! Metadata (for managers) }}
            {{#canmanage}}
            <div class="jb-card jb-card--muted">
                <div class="jb-card__body jb-text-muted jb-text-sm">
                    <div class="jb-meta-item">
                        <i class="fa fa-user"></i>
                        {{#str}}createdby, local_jobboard{{/str}}: <strong>{{createdbyname}}</strong>
                    </div>
                    <div class="jb-meta-item">
                        <i class="fa fa-calendar"></i>
                        {{timecreatedformatted}}
                    </div>
                    {{#modifiedbyname}}
                    <div class="jb-meta-item">
                        <i class="fa fa-edit"></i>
                        {{#str}}modifiedby, local_jobboard{{/str}}: <strong>{{modifiedbyname}}</strong>
                    </div>
                    {{/modifiedbyname}}
                </div>
            </div>
            {{/canmanage}}
        </aside>
    </div>

    {{! Footer Navigation }}
    <div class="jb-detail-footer">
        <a href="{{backurl}}" class="jb-btn jb-btn--outline">
            <i class="fa fa-arrow-left"></i> {{backlabel}}
        </a>
        <a href="{{dashboardurl}}" class="jb-link">
            {{#str}}backtodashboard, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i>
        </a>
    </div>
</div>

<style>
/* ================================================================
   VACANCY DETAIL PAGE - CLEAN MINIMAL DESIGN
   Following jb-* pattern
   ================================================================ */
.jb-vacancy-detail {
    max-width: 1200px;
    padding: 1rem;
}

/* Header */
.jb-detail-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-detail-header__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.jb-detail-header__back {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-detail-header__back:hover {
    color: var(--iser-verde-dark, #157a6a);
}

.jb-detail-header__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
}

.jb-detail-header__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-detail-header__subtitle {
    font-size: 1rem;
    color: var(--iser-gris-medio, #666);
    margin: 0.5rem 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-detail-header__subtitle i {
    color: var(--iser-verde, #1b9e88);
}

/* Content Layout */
.jb-detail-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: start;
}

.jb-detail-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.jb-detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
}

/* Alerts */
.jb-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
}

.jb-alert > i {
    font-size: 1.25rem;
    margin-top: 0.125rem;
}

.jb-alert__content {
    flex: 1;
}

.jb-alert__content strong {
    display: block;
}

.jb-alert__content span {
    font-size: 0.875rem;
    opacity: 0.9;
}

.jb-alert--warning { background: rgba(255, 193, 7, 0.15); border: 1px solid rgba(255, 193, 7, 0.3); color: #856404; }
.jb-alert--secondary { background: #f9fafb; border: 1px solid #e5e5e5; color: #6c757d; }

/* Cards */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.jb-card--cta { border-color: var(--iser-verde, #1b9e88); }
.jb-card--muted { background: #f9fafb; border: none; }

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i { color: var(--iser-verde, #1b9e88); }

.jb-card__header--accent {
    background: rgba(27, 158, 136, 0.1);
    border-bottom: 2px solid var(--iser-verde, #1b9e88);
}

.jb-card__header--warning {
    background: rgba(255, 193, 7, 0.15);
    border-bottom: 2px solid var(--iser-amarillo, #ffc107);
    color: #856404;
}

.jb-card__header--warning i { color: #856404; }

.jb-card__header--warning-light {
    background: rgba(255, 193, 7, 0.1);
    border-bottom: 2px solid var(--iser-amarillo, #ffc107);
}

.jb-card__header--info {
    background: rgba(13, 110, 253, 0.1);
    border-bottom: 2px solid var(--iser-azul, #0d6efd);
    color: var(--iser-azul, #0d6efd);
}

.jb-card__header--info i { color: var(--iser-azul, #0d6efd); }

.jb-card__header--success {
    background: rgba(40, 167, 69, 0.1);
    border-bottom: 2px solid #28a745;
    color: #1e7e34;
}

.jb-card__header--success i { color: #28a745; }

.jb-card__body { padding: 1rem; }

.jb-card__body--content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--iser-gris-oscuro, #333);
}

.jb-card__body--content p { margin-bottom: 0.75rem; }
.jb-card__body--content p:last-child { margin-bottom: 0; }
.jb-card__body--content ul, .jb-card__body--content ol { padding-left: 1.25rem; margin-bottom: 0.75rem; }
.jb-card__body--content li { margin-bottom: 0.25rem; }

/* Info Rows */
.jb-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.8125rem;
}

.jb-info-row--last { border-bottom: none; padding-bottom: 0; }
.jb-info-row--urgent { background: rgba(255, 193, 7, 0.1); margin: 0 -1rem; padding-left: 1rem; padding-right: 1rem; border-radius: 4px; }

.jb-info-label {
    color: var(--iser-gris-medio, #666);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-info-label i { width: 16px; text-align: center; }

/* Progress */
.jb-progress-section {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #f0f0f0;
}

.jb-progress-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--iser-gris-medio, #666);
    margin-bottom: 0.375rem;
}

.jb-progress {
    height: 6px;
    background: #e5e5e5;
    border-radius: 3px;
    overflow: hidden;
}

.jb-progress__bar {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s;
}

.jb-progress__bar--success { background: #28a745; }
.jb-progress__bar--warning { background: #ffc107; }
.jb-progress__bar--danger { background: #dc3545; }
.jb-progress__bar--primary { background: var(--iser-verde, #1b9e88); }

/* Doc Stats */
.jb-doc-stats {
    display: flex;
    justify-content: space-around;
    text-align: center;
    margin-bottom: 0.75rem;
}

.jb-doc-stat__value {
    font-size: 1.5rem;
    font-weight: 700;
    display: block;
}

.jb-doc-stat__label {
    font-size: 0.6875rem;
    color: var(--iser-gris-medio, #666);
}

.jb-doc-stat--primary .jb-doc-stat__value { color: var(--iser-verde, #1b9e88); }
.jb-doc-stat--success .jb-doc-stat__value { color: #28a745; }
.jb-doc-stat--warning .jb-doc-stat__value { color: #ffc107; }

/* CTA Card */
.jb-cta-card {
    padding: 0.5rem 0;
}

.jb-cta-card__icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
}

.jb-cta-card__icon--success { color: #28a745; }
.jb-cta-card__icon--muted { color: var(--iser-gris-medio, #666); }

.jb-cta-card__title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
}

.jb-cta-card__text {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin: 0 0 1rem 0;
}

.jb-cta-card__urgent {
    font-size: 0.8125rem;
    color: var(--iser-rojo, #c41e3a);
    margin: 0.75rem 0 0 0;
}

/* Meta Items */
.jb-meta-item {
    margin-bottom: 0.375rem;
}

.jb-meta-item:last-child {
    margin-bottom: 0;
}

.jb-meta-item i {
    width: 16px;
    margin-right: 0.5rem;
}

/* Badges */
.jb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
}

.jb-badge i { font-size: 0.625rem; }
.jb-badge--primary { background: rgba(27, 158, 136, 0.15); color: var(--iser-verde-dark, #157a6a); }
.jb-badge--success { background: rgba(40, 167, 69, 0.15); color: #1e7e34; }
.jb-badge--warning { background: rgba(255, 193, 7, 0.2); color: #856404; }
.jb-badge--danger { background: rgba(220, 53, 69, 0.15); color: #c41e3a; }
.jb-badge--info { background: rgba(13, 110, 253, 0.15); color: #0d6efd; }
.jb-badge--secondary { background: #e9ecef; color: #6c757d; }

/* Code */
.jb-code {
    font-family: monospace;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
}

.jb-code--primary { background: var(--iser-verde, #1b9e88); color: #fff; }

/* Buttons */
.jb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
}

.jb-btn--sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }
