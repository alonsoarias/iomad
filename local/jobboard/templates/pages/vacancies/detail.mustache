{{!
    @template local_jobboard/pages/vacancies/detail

    Vacancy detail page - Clean and professional design.
    Follows the same pattern as the application form page.

    Context variables:
    * vacancy - Vacancy data {id, code, title, description, requirements, etc.}
    * convocatoria - Convocatoria info {id, name, viewurl}
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * canedit - Boolean if can edit
    * canmanage - Boolean if can manage
    * applicationstats - Stats for managers {total, pending, validated, manageurl}
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * progresspercent - Progress bar percentage
    * progresscolor - Progress bar color class
    * isloggedin - Boolean if user is logged in
    * applyurl - URL to apply
    * editurl - URL to edit vacancy
    * myapplicationsurl - URL to user's applications
    * loginurl - URL to login
    * backurl - URL to go back
    * backlabel - Label for back button
    * dashboardurl - URL to dashboard

    Example context (json):
    {
        "vacancy": {"id": 1, "code": "VAC-001", "title": "Professor Position"},
        "canapply": true,
        "hasapplied": false
    }
}}
<div class="jb-vacancy-detail" id="jobboard-vacancy-detail">
    <div class="container-fluid px-0">
        <div class="row g-4">
            {{! Main Content }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                            </li>
                            {{#convocatoria}}
                            <li class="breadcrumb-item">
                                <a href="{{convocatoria.viewurl}}">{{convocatoria.name}}</a>
                            </li>
                            {{/convocatoria}}
                            {{^convocatoria}}
                            <li class="breadcrumb-item">
                                <a href="{{backurl}}">{{#str}}vacancies, local_jobboard{{/str}}</a>
                            </li>
                            {{/convocatoria}}
                            <li class="breadcrumb-item active" aria-current="page">{{vacancy.code}}</li>
                        </ol>
                    </nav>
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h1 class="h3 mb-1">{{vacancy.title}}</h1>
                            <div class="d-flex align-items-center gap-2">
                                <code class="small">{{vacancy.code}}</code>
                                <span class="badge bg-{{vacancy.statuscolor}}">{{vacancy.statuslabel}}</span>
                            </div>
                        </div>
                        {{#canedit}}
                        <a href="{{editurl}}" class="btn btn-outline-primary jb-btn-outline-primary btn-sm">
                            <i class="fa fa-edit me-1"></i>
                            {{#str}}edit{{/str}}
                        </a>
                        {{/canedit}}
                    </div>
                </div>

                {{! Urgent Warning }}
                {{#isurgent}}
                {{^isclosed}}
                <div class="alert alert-warning jb-alert-warning d-flex align-items-center mb-4 jb-fade-in-up" role="alert">
                    <i class="fa fa-clock fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}closingsoon, local_jobboard{{/str}}</strong>
                        <span class="d-block">{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
                    </div>
                </div>
                {{/isclosed}}
                {{/isurgent}}

                {{! Closed Notice }}
                {{#isclosed}}
                <div class="alert alert-secondary jb-alert-secondary d-flex align-items-center mb-4 jb-fade-in-up" role="alert">
                    <i class="fa fa-lock fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}vacancyclosed, local_jobboard{{/str}}</strong>
                        <span class="d-block">{{#str}}vacancyclosed_desc, local_jobboard{{/str}}</span>
                    </div>
                </div>
                {{/isclosed}}

                {{! Description Card }}
                {{#vacancy.description}}
                <div class="card shadow-sm mb-4 jb-fade-in-up">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-file-lines text-primary me-2"></i>
                            {{#str}}description, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body jb-prose">
                        {{{vacancy.description}}}
                    </div>
                </div>
                {{/vacancy.description}}

                {{! Requirements Card }}
                {{#vacancy.requirements}}
                <div class="card shadow-sm mb-4 jb-fade-in-up">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-check-circle text-success me-2"></i>
                            {{#str}}requirements, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body jb-prose">
                        {{{vacancy.requirements}}}
                    </div>
                </div>
                {{/vacancy.requirements}}

                {{! Desirable Card }}
                {{#vacancy.desirable}}
                <div class="card shadow-sm mb-4 jb-fade-in-up">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-star text-warning me-2"></i>
                            {{#str}}desirable, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body jb-prose">
                        {{{vacancy.desirable}}}
                    </div>
                </div>
                {{/vacancy.desirable}}

                {{! Benefits Card }}
                {{#vacancy.benefits}}
                <div class="card shadow-sm mb-4 jb-fade-in-up">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-gift text-info me-2"></i>
                            {{#str}}benefits, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body jb-prose">
                        {{{vacancy.benefits}}}
                    </div>
                </div>
                {{/vacancy.benefits}}
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Apply CTA Card }}
                    <div class="card shadow-sm mb-4 jb-hover-lift {{^isclosed}}border-primary{{/isclosed}}">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-paper-plane text-primary me-2"></i>
                                {{#str}}readytoapply, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            {{#hasapplied}}
                            <div class="py-2">
                                <i class="fa fa-check-circle fa-3x text-success mb-3"></i>
                                <p class="text-success fw-bold mb-3">{{#str}}alreadyapplied, local_jobboard{{/str}}</p>
                                <a href="{{myapplicationsurl}}" class="btn btn-outline-primary jb-btn-outline-primary w-100">
                                    <i class="fa fa-folder-open me-2"></i>
                                    {{#str}}viewmyapplications, local_jobboard{{/str}}
                                </a>
                            </div>
                            {{/hasapplied}}

                            {{^hasapplied}}
                            {{#canapply}}
                            {{^isclosed}}
                            <div class="py-2">
                                <p class="text-muted mb-3">{{#str}}applynowdesc, local_jobboard{{/str}}</p>
                                <a href="{{applyurl}}" class="btn btn-success jb-btn-success btn-lg w-100">
                                    <i class="fa fa-paper-plane me-2"></i>
                                    {{#str}}apply, local_jobboard{{/str}}
                                </a>
                                {{#isurgent}}
                                <p class="text-warning small mt-2 mb-0">
                                    <i class="fa fa-clock me-1"></i>
                                    {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                                </p>
                                {{/isurgent}}
                            </div>
                            {{/isclosed}}
                            {{#isclosed}}
                            <div class="py-3 text-muted">
                                <i class="fa fa-lock fa-2x mb-2"></i>
                                <p class="mb-0">{{#str}}vacancyclosed, local_jobboard{{/str}}</p>
                            </div>
                            {{/isclosed}}
                            {{/canapply}}

                            {{^canapply}}
                            {{#isclosed}}
                            <div class="py-3 text-muted">
                                <i class="fa fa-lock fa-2x mb-2"></i>
                                <p class="mb-0">{{#str}}vacancyclosed, local_jobboard{{/str}}</p>
                            </div>
                            {{/isclosed}}
                            {{^isclosed}}
                            {{#isloggedin}}
                            <div class="py-3 text-muted">
                                <i class="fa fa-ban fa-2x mb-2"></i>
                                <p class="mb-0">{{#str}}cannotapply, local_jobboard{{/str}}</p>
                            </div>
                            {{/isloggedin}}
                            {{^isloggedin}}
                            <div class="py-2">
                                <p class="text-muted mb-3">{{#str}}logintoapply, local_jobboard{{/str}}</p>
                                <a href="{{loginurl}}" class="btn btn-primary jb-btn-primary btn-lg w-100">
                                    <i class="fa fa-sign-in-alt me-2"></i>
                                    {{#str}}login{{/str}}
                                </a>
                            </div>
                            {{/isloggedin}}
                            {{/isclosed}}
                            {{/canapply}}
                            {{/hasapplied}}
                        </div>
                    </div>

                    {{! Details Card }}
                    <div class="card shadow-sm mb-4 jb-hover-lift">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-info-circle text-info me-2"></i>
                                {{#str}}details, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush small">
                                {{#vacancy.location}}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">{{#str}}location, local_jobboard{{/str}}</span>
                                    <span class="fw-medium">{{vacancy.location}}</span>
                                </li>
                                {{/vacancy.location}}

                                {{#vacancy.modality}}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">{{#str}}modality, local_jobboard{{/str}}</span>
                                    <span class="fw-medium">{{vacancy.modality}}</span>
                                </li>
                                {{/vacancy.modality}}

                                {{#vacancy.department}}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">{{#str}}department, local_jobboard{{/str}}</span>
                                    <span class="fw-medium">{{vacancy.department}}</span>
                                </li>
                                {{/vacancy.department}}

                                {{#vacancy.contracttypelabel}}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">{{#str}}contracttype, local_jobboard{{/str}}</span>
                                    <span class="fw-medium">{{vacancy.contracttypelabel}}</span>
                                </li>
                                {{/vacancy.contracttypelabel}}

                                {{#vacancy.duration}}
                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">{{#str}}duration, local_jobboard{{/str}}</span>
                                    <span class="fw-medium">{{vacancy.duration}}</span>
                                </li>
                                {{/vacancy.duration}}

                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">{{#str}}positions, local_jobboard{{/str}}</span>
                                    <span class="fw-medium">{{vacancy.positions}}</span>
                                </li>

                                <li class="list-group-item d-flex justify-content-between">
                                    <span class="text-muted">
                                        <i class="fa fa-calendar-check text-success me-1"></i>
                                        {{#str}}opendate, local_jobboard{{/str}}
                                    </span>
                                    <span class="fw-medium">{{vacancy.opendateformatted}}</span>
                                </li>

                                <li class="list-group-item d-flex justify-content-between {{#isurgent}}bg-warning-subtle{{/isurgent}}">
                                    <span class="text-muted">
                                        <i class="fa fa-calendar-xmark text-danger me-1"></i>
                                        {{#str}}closedate, local_jobboard{{/str}}
                                    </span>
                                    <span class="fw-medium {{#isurgent}}text-warning{{/isurgent}}">{{vacancy.closedateformatted}}</span>
                                </li>
                            </ul>
                        </div>

                        {{! Deadline Progress }}
                        {{^isclosed}}
                        <div class="card-footer bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">{{#str}}deadlineprogress, local_jobboard{{/str}}</small>
                                <small class="{{#isurgent}}text-warning fw-bold{{/isurgent}}">
                                    {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                                </small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                            </div>
                        </div>
                        {{/isclosed}}
                    </div>

                    {{! Application Stats (for managers) }}
                    {{#applicationstats}}
                    <div class="card shadow-sm mb-4 jb-hover-lift">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-chart-bar text-info me-2"></i>
                                {{#str}}applicationstats, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="h4 mb-0 text-primary">{{total}}</div>
                                    <small class="text-muted">{{#str}}total{{/str}}</small>
                                </div>
                                <div class="col-4">
                                    <div class="h4 mb-0 text-warning">{{pending}}</div>
                                    <small class="text-muted">{{#str}}pending, local_jobboard{{/str}}</small>
                                </div>
                                <div class="col-4">
                                    <div class="h4 mb-0 text-success">{{validated}}</div>
                                    <small class="text-muted">{{#str}}validated, local_jobboard{{/str}}</small>
                                </div>
                            </div>
                            <a href="{{manageurl}}" class="btn btn-info jb-btn-info w-100">
                                <i class="fa fa-list-check me-2"></i>
                                {{#str}}manageapplications, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>
                    {{/applicationstats}}

                    {{! Metadata (for managers) }}
                    {{#canmanage}}
                    <div class="card shadow-sm bg-light">
                        <div class="card-body py-3">
                            <div class="small text-muted">
                                <div class="mb-1">
                                    <i class="fa fa-user me-2"></i>
                                    {{#str}}createdby, local_jobboard{{/str}}: <span class="fw-medium">{{createdbyname}}</span>
                                </div>
                                <div class="mb-1">
                                    <i class="fa fa-calendar me-2"></i>
                                    {{timecreatedformatted}}
                                </div>
                                {{#modifiedbyname}}
                                <div>
                                    <i class="fa fa-edit me-2"></i>
                                    {{#str}}modifiedby, local_jobboard{{/str}}: <span class="fw-medium">{{modifiedbyname}}</span>
                                </div>
                                {{/modifiedbyname}}
                            </div>
                        </div>
                    </div>
                    {{/canmanage}}
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top jb-fade-in">
                    <a href="{{backurl}}" class="btn btn-outline-secondary jb-btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{backlabel}}
                    </a>
                    <a href="{{dashboardurl}}" class="btn btn-link text-muted jb-hover-primary">
                        {{#str}}backtodashboard, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
