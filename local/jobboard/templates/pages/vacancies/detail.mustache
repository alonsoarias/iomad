{{!
    @template local_jobboard/pages/vacancy_detail

    Vacancy detail page template with enhanced UX.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * breadcrumbs - Array of breadcrumb items
    * vacancy - Vacancy data object
    * convocatoria - Optional convocatoria info
    * canapply - Boolean if user can apply
    * hasapplied - Boolean if already applied
    * canedit - Boolean if can edit
    * canmanage - Boolean if can manage
    * applicationstats - Stats for managers
    * isurgent - Boolean if closing soon
    * isclosed - Boolean if closed
    * daysremaining - Days until close
    * loading - Show skeleton loading state

    Example context (json):
    {
        "vacancy": {"id": 1, "title": "Developer", "code": "VAC-001"},
        "canapply": true,
        "hasapplied": false
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-vacancy-detail" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-page-header mb-4">
        <div class="jb-skeleton-text" style="width: 200px; height: 1em;"></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="jb-skeleton-title" style="width: 60%;"></div>
            <div class="jb-skeleton-text" style="width: 120px; height: 40px;"></div>
        </div>
    </div>
    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 60px;"></div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 40%;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-text" style="width: 100%;"></div>
                    <div class="jb-skeleton-text" style="width: 90%;"></div>
                    <div class="jb-skeleton-text" style="width: 75%;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 50%;"></div></div>
                <div class="card-body text-center">
                    <div class="jb-skeleton-text mx-auto" style="width: 80%; height: 45px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-vacancy-detail" data-region="jobboard-vacancy" data-vacancy-id="{{vacancy.id}}">
    {{! Skip Link for Accessibility }}
    <a href="#vacancy-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header with Animation }}
    <header class="jb-page-header mb-4 jb-fade-in">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="fs-4 mb-1">{{vacancy.title}}</h1>
                <code class="small text-muted">{{vacancy.code}}</code>
            </div>
            <div class="btn-group" role="group" aria-label="{{#str}}vacancyactions, local_jobboard{{/str}}">
                {{#canedit}}
                <a href="{{editurl}}" class="btn btn-outline-primary">
                    <i class="fa fa-pen-to-square me-1" aria-hidden="true"></i>
                    {{#str}}edit{{/str}}
                </a>
                {{/canedit}}
                {{#canapply}}
                {{^hasapplied}}
                {{^isclosed}}
                <a href="{{applyurl}}" class="btn btn-success btn-lg jb-pulse-subtle">
                    <i class="fa fa-paper-plane me-1" aria-hidden="true"></i>
                    {{#str}}apply, local_jobboard{{/str}}
                </a>
                {{/isclosed}}
                {{/hasapplied}}
                {{/canapply}}
            </div>
        </div>
    </header>

    {{! Urgent Banner - Full Width }}
    {{#isurgent}}
    {{^isclosed}}
    <div class="alert alert-warning d-flex align-items-center justify-content-center mb-4 jb-fade-in" role="alert" aria-live="polite">
        <i class="fa fa-triangle-exclamation fa-lg me-3" aria-hidden="true"></i>
        <div>
            <strong>{{#str}}closingsoon, local_jobboard{{/str}}</strong>
            <span class="ms-2">{{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}</span>
        </div>
    </div>
    {{/isclosed}}
    {{/isurgent}}

    {{! Status Banner }}
    <div class="alert jb-alert-{{statuscolor}} d-flex justify-content-between align-items-center mb-4 jb-fade-in-up" role="status">
        <span class="d-flex align-items-center">
            <i class="fa fa-{{statusicon}} me-2" aria-hidden="true"></i>
            <span class="fw-medium">{{statusmessage}}</span>
        </span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge jb-badge-{{vacancy.statuscolor}}">{{vacancy.statuslabel}}</span>
        </div>
    </div>

    <div class="row" id="vacancy-main-content">
        {{! Main Content Column }}
        <main class="col-lg-8">
            {{! Vacancy Header Card }}
            <article class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-briefcase" aria-hidden="true"></i>
                        <span class="fw-medium">{{#str}}vacancyoverview, local_jobboard{{/str}}</span>
                    </div>
                    <span class="badge bg-light text-dark">{{vacancy.statuslabel}}</span>
                </div>
                <div class="card-body">
                    <h2 class="card-title fs-4 mb-3">{{vacancy.title}}</h2>

                    {{! Convocatoria Badge }}
                    {{#convocatoria}}
                    <div class="mb-3">
                        <a href="{{convocatoria.viewurl}}" class="badge bg-info text-dark rounded-pill jb-hover-lift">
                            <i class="fa fa-folder-open me-1" aria-hidden="true"></i>
                            {{convocatoria.name}}
                        </a>
                    </div>
                    {{/convocatoria}}

                    {{! Quick Info Badges }}
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        {{#vacancy.location}}
                        <span class="badge bg-light text-dark" title="{{#str}}location, local_jobboard{{/str}}">
                            <i class="fa fa-location-dot text-primary me-1" aria-hidden="true"></i>
                            {{vacancy.location}}
                        </span>
                        {{/vacancy.location}}
                        {{#vacancy.modality}}
                        <span class="badge bg-light text-dark" title="{{#str}}modality, local_jobboard{{/str}}">
                            <i class="fa fa-{{#vacancy.modalityicon}}{{vacancy.modalityicon}}{{/vacancy.modalityicon}}{{^vacancy.modalityicon}}laptop-house{{/vacancy.modalityicon}} text-info me-1" aria-hidden="true"></i>
                            {{vacancy.modality}}
                        </span>
                        {{/vacancy.modality}}
                        {{#vacancy.contracttypelabel}}
                        <span class="badge bg-light text-dark" title="{{#str}}contracttype, local_jobboard{{/str}}">
                            <i class="fa fa-file-contract text-secondary me-1" aria-hidden="true"></i>
                            {{vacancy.contracttypelabel}}
                        </span>
                        {{/vacancy.contracttypelabel}}
                        <span class="badge bg-light text-dark" title="{{#str}}positions, local_jobboard{{/str}}">
                            <i class="fa fa-users text-success me-1" aria-hidden="true"></i>
                            {{vacancy.positions}} {{#str}}positions, local_jobboard{{/str}}
                        </span>
                    </div>
                </div>
            </article>

            {{! Description Card }}
            {{#vacancy.description}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.2s;" aria-labelledby="desc-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-file-lines text-primary me-2" aria-hidden="true"></i>
                    <h3 class="fs-5 mb-0" id="desc-heading">
                        {{#str}}vacancydescription, local_jobboard{{/str}}
                    </h3>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.description}}}
                </div>
            </section>
            {{/vacancy.description}}

            {{! Requirements Card }}
            {{#vacancy.requirements}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.3s;" aria-labelledby="req-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-circle-check text-success me-2" aria-hidden="true"></i>
                    <h3 class="fs-5 mb-0" id="req-heading">
                        {{#str}}requirements, local_jobboard{{/str}}
                    </h3>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.requirements}}}
                </div>
            </section>
            {{/vacancy.requirements}}

            {{! Desirable Card }}
            {{#vacancy.desirable}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.4s;" aria-labelledby="des-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-star text-warning me-2" aria-hidden="true"></i>
                    <h3 class="fs-5 mb-0" id="des-heading">
                        {{#str}}desirable, local_jobboard{{/str}}
                    </h3>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.desirable}}}
                </div>
            </section>
            {{/vacancy.desirable}}

            {{! Benefits Card }}
            {{#vacancy.benefits}}
            <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.5s;" aria-labelledby="benefits-heading">
                <div class="card-header bg-white d-flex align-items-center">
                    <i class="fa fa-gift text-info me-2" aria-hidden="true"></i>
                    <h3 class="fs-5 mb-0" id="benefits-heading">
                        {{#str}}benefits, local_jobboard{{/str}}
                    </h3>
                </div>
                <div class="card-body jb-prose">
                    {{{vacancy.benefits}}}
                </div>
            </section>
            {{/vacancy.benefits}}
        </main>

        {{! Sidebar Column }}
        <aside class="col-lg-4">
            {{! Apply CTA Card - Sticky }}
            <div class="jb-sticky-sidebar">
                <section class="card shadow-sm mb-4 border-primary jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="apply-heading">
                    <div class="card-header bg-primary text-white">
                        <h3 class="fs-5 mb-0 d-flex align-items-center" id="apply-heading">
                            <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                            {{#str}}readytoapply, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div class="card-body text-center">
                        {{#hasapplied}}
                        <div class="py-3">
                            <div class="text-success mb-3">
                                <i class="fa fa-circle-check fa-3x" aria-hidden="true"></i>
                            </div>
                            <p class="text-success fw-bold fs-5">{{#str}}alreadyapplied, local_jobboard{{/str}}</p>
                            <a href="{{myapplicationsurl}}" class="btn btn-outline-primary w-100">
                                <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                                {{#str}}viewmyapplications, local_jobboard{{/str}}
                            </a>
                        </div>
                        {{/hasapplied}}

                        {{^hasapplied}}
                        {{#canapply}}
                        {{^isclosed}}
                        <div class="py-2">
                            <p class="text-muted mb-3">{{#str}}applynowdesc, local_jobboard{{/str}}</p>
                            <a href="{{applyurl}}" class="btn btn-success btn-lg w-100 jb-hover-lift">
                                <i class="fa fa-paper-plane me-2" aria-hidden="true"></i>
                                {{#str}}apply, local_jobboard{{/str}}
                            </a>
                            {{#isurgent}}
                            <p class="text-warning small mt-2 mb-0">
                                <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                            </p>
                            {{/isurgent}}
                        </div>
                        {{/isclosed}}
                        {{#isclosed}}
                        <div class="py-3 text-muted">
                            <i class="fa fa-lock fa-2x mb-2" aria-hidden="true"></i>
                            <p class="mb-0">{{#str}}vacancyclosed, local_jobboard{{/str}}</p>
                        </div>
                        {{/isclosed}}
                        {{/canapply}}

                        {{^canapply}}
                        {{#isclosed}}
                        <div class="py-3 text-muted">
                            <i class="fa fa-lock fa-2x mb-2" aria-hidden="true"></i>
                            <p class="mb-0">{{#str}}vacancyclosed, local_jobboard{{/str}}</p>
                        </div>
                        {{/isclosed}}
                        {{^isclosed}}
                        {{#isloggedin}}
                        <div class="py-3 text-muted">
                            <i class="fa fa-ban fa-2x mb-2" aria-hidden="true"></i>
                            <p class="mb-0">{{#str}}cannotapply, local_jobboard{{/str}}</p>
                        </div>
                        {{/isloggedin}}
                        {{^isloggedin}}
                        <div class="py-2">
                            <p class="text-muted mb-3">{{#str}}logintoapply, local_jobboard{{/str}}</p>
                            <a href="{{loginurl}}" class="btn btn-primary btn-lg w-100">
                                <i class="fa fa-right-to-bracket me-2" aria-hidden="true"></i>
                                {{#str}}login{{/str}}
                            </a>
                        </div>
                        {{/isloggedin}}
                        {{/isclosed}}
                        {{/canapply}}
                        {{/hasapplied}}
                    </div>
                </section>

                {{! Details Card }}
                <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.25s;" aria-labelledby="details-heading">
                    <div class="card-header bg-white d-flex align-items-center">
                        <i class="fa fa-circle-info text-info me-2" aria-hidden="true"></i>
                        <h3 class="fs-5 mb-0" id="details-heading">
                            {{#str}}details, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            {{#vacancy.department}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted small">{{#str}}department, local_jobboard{{/str}}</span>
                                <span class="fw-medium">{{vacancy.department}}</span>
                            </li>
                            {{/vacancy.department}}

                            {{#vacancy.companyname}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted small">{{#str}}company, local_jobboard{{/str}}</span>
                                <span class="fw-medium">{{vacancy.companyname}}</span>
                            </li>
                            {{/vacancy.companyname}}

                            {{#vacancy.duration}}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted small">{{#str}}duration, local_jobboard{{/str}}</span>
                                <span class="fw-medium">{{vacancy.duration}}</span>
                            </li>
                            {{/vacancy.duration}}

                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span class="text-muted small">
                                    <i class="fa fa-calendar-days text-success me-1" aria-hidden="true"></i>
                                    {{#str}}opendate, local_jobboard{{/str}}
                                </span>
                                <span class="fw-medium">{{vacancy.opendateformatted}}</span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between align-items-center {{#isurgent}}bg-warning-light{{/isurgent}}">
                                <span class="text-muted small">
                                    <i class="fa fa-calendar-xmark text-danger me-1" aria-hidden="true"></i>
                                    {{#str}}closedate, local_jobboard{{/str}}
                                </span>
                                <span class="fw-medium {{#isurgent}}text-warning{{/isurgent}}">{{vacancy.closedateformatted}}</span>
                            </li>
                        </ul>
                    </div>

                    {{! Deadline Progress }}
                    {{^isclosed}}
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted">{{#str}}deadlineprogress, local_jobboard{{/str}}</small>
                            <small class="{{#isurgent}}text-warning fw-bold{{/isurgent}}{{^isurgent}}text-muted{{/isurgent}}">
                                {{daysremaining}} {{#str}}daysremaining, local_jobboard{{/str}}
                            </small>
                        </div>
                        <div class="progress" style="height: 8px;" role="progressbar" aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}deadlineprogress, local_jobboard{{/str}}">
                            <div class="progress-bar jb-bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                        </div>
                    </div>
                    {{/isclosed}}
                </section>

                {{! Application Stats (for managers) }}
                {{#applicationstats}}
                <section class="card shadow-sm mb-4 jb-border-info jb-fade-in-up" style="animation-delay: 0.35s;" aria-labelledby="stats-heading">
                    <div class="card-header bg-info text-white d-flex align-items-center">
                        <i class="fa fa-chart-bar me-2" aria-hidden="true"></i>
                        <h3 class="fs-5 mb-0" id="stats-heading">
                            {{#str}}applicationstats, local_jobboard{{/str}}
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <div class="fs-3 fw-bold text-primary">{{total}}</div>
                                <small class="text-muted">{{#str}}total{{/str}}</small>
                            </div>
                            <div class="col-4">
                                <div class="fs-3 fw-bold text-warning">{{pending}}</div>
                                <small class="text-muted">{{#str}}pending, local_jobboard{{/str}}</small>
                            </div>
                            <div class="col-4">
                                <div class="fs-3 fw-bold text-success">{{validated}}</div>
                                <small class="text-muted">{{#str}}validated, local_jobboard{{/str}}</small>
                            </div>
                        </div>
                        <a href="{{manageurl}}" class="btn btn-info w-100">
                            <i class="fa fa-list-check me-2" aria-hidden="true"></i>
                            {{#str}}manageapplications, local_jobboard{{/str}}
                        </a>
                    </div>
                </section>
                {{/applicationstats}}

                {{! Metadata (for managers) }}
                {{#canmanage}}
                <section class="card mb-4 bg-light jb-fade-in-up" style="animation-delay: 0.45s;" aria-labelledby="meta-heading">
                    <div class="card-body py-3">
                        <h4 class="visually-hidden" id="meta-heading">{{#str}}metadata, local_jobboard{{/str}}</h4>
                        <div class="small text-muted">
                            <div class="mb-1">
                                <i class="fa fa-user me-2" aria-hidden="true"></i>
                                {{#str}}createdby, local_jobboard{{/str}}: <span class="fw-medium">{{createdbyname}}</span>
                            </div>
                            <div class="mb-1">
                                <i class="fa fa-calendar me-2" aria-hidden="true"></i>
                                {{timecreatedformatted}}
                            </div>
                            {{#modifiedbyname}}
                            <div>
                                <i class="fa fa-pen-to-square me-2" aria-hidden="true"></i>
                                {{#str}}modifiedby, local_jobboard{{/str}}: <span class="fw-medium">{{modifiedbyname}}</span>
                            </div>
                            {{/modifiedbyname}}
                        </div>
                    </div>
                </section>
                {{/canmanage}}
            </div>
        </aside>
    </div>

    {{! Navigation Footer }}
    <nav class="jb-navigation-footer d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{backurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{backlabel}}
        </a>
        <a href="{{dashboardurl}}" class="btn btn-link text-muted">
            {{#str}}backtodashboard, local_jobboard{{/str}}
            <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
        </a>
    </nav>
</div>
{{/loading}}
