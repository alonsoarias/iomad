{{!
    @template local_jobboard/pages/vacancies/edit

    Vacancy edit/create form page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * pagetitle (string) - Page title
    * isedit (bool) - Is editing (vs creating)
    * hasconvocatoria (bool) - Has associated convocatoria
    * convocatoria (object) - Convocatoria info {name, daterange, statuscolor, statuslabel}
    * formhtml (string) - Rendered form HTML
    * backurl (string) - Back URL
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "pagetitle": "Edit Vacancy",
        "isedit": true,
        "hasconvocatoria": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-edit-vacancy" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton-title mb-4" style="width: 40%;"></div>
    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 80px;"></div>
    <div class="card">
        <div class="card-body">
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 150px;"></div>
            <div class="jb-skeleton-text" style="width: 150px; height: 45px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-edit-vacancy" data-region="jobboard-edit-form">
    {{! Skip Link for Accessibility }}
    <a href="#vacancy-form-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header mb-4 jb-fade-in">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="fs-3 mb-0">
                {{#isedit}}
                <i class="fa fa-pen-to-square text-primary me-2" aria-hidden="true"></i>
                {{/isedit}}
                {{^isedit}}
                <i class="fa fa-circle-plus text-success me-2" aria-hidden="true"></i>
                {{/isedit}}
                {{pagetitle}}
            </h1>
            {{#backurl}}
            <a href="{{backurl}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
                {{#str}}back, local_jobboard{{/str}}
            </a>
            {{/backurl}}
        </div>
    </header>

    {{! Convocatoria Info Banner }}
    {{#hasconvocatoria}}
    <div class="alert alert-info jb-alert-info d-flex justify-content-between align-items-center mb-4 jb-fade-in-up" role="status" style="animation-delay: 0.05s;">
        <div class="d-flex align-items-center">
            <i class="fa fa-calendar-days fa-lg text-info me-3" aria-hidden="true"></i>
            <div>
                <strong class="d-block">
                    {{#str}}convocatoria, local_jobboard{{/str}}: {{convocatoria.name}}
                </strong>
                <small class="text-muted">{{convocatoria.daterange}}</small>
            </div>
        </div>
        <span class="badge jb-badge-{{convocatoria.statuscolor}} rounded-pill">
            {{convocatoria.statuslabel}}
        </span>
    </div>
    {{/hasconvocatoria}}

    {{! Form Card }}
    <main id="vacancy-form-content">
        <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.1s;">
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </div>
    </main>

    {{! Help Section }}
    <aside class="mt-4 jb-fade-in" style="animation-delay: 0.15s;">
        <div class="alert jb-alert-light d-flex align-items-start">
            <i class="fa fa-lightbulb text-warning me-3 mt-1" aria-hidden="true"></i>
            <div>
                <strong class="d-block mb-1">{{#str}}formhelptitle, local_jobboard{{/str}}</strong>
                <p class="mb-0 small text-muted">{{#str}}formhelpdesc, local_jobboard{{/str}}</p>
            </div>
        </div>
    </aside>
</div>
{{/loading}}
