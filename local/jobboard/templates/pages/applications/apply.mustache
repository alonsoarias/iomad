{{!
    @template local_jobboard/pages/applications/apply

    Application form page - Clean minimal design

    Context variables:
    * vacancy - Vacancy data
    * daysuntilclose - Days remaining
    * showdeadlinewarning - Urgent deadline warning
    * showdaysremaining - Show days badge
    * daysremainingtext - Days remaining text
    * isexemption - User has exemption
    * exemptioninfo - Exemption details
    * formhtml - Moodle form HTML
    * requireddocs - Required documents
    * hasrequireddocs - Has documents
    * requireddocscount - Document count
    * viewvacancyurl - View vacancy URL
    * backvacancyurl - Back URL
    * browservacanciesurl - Browse URL
}}
<div class="jb-apply" id="jobboard-apply">
    {{! Header }}
    <div class="jb-apply-header">
        <div class="jb-apply-header__nav">
            <a href="{{browservacanciesurl}}" class="jb-apply-header__back">
                <i class="fa fa-arrow-left"></i>
                {{#str}}vacancies, local_jobboard{{/str}}
            </a>
            {{#showdaysremaining}}
            <span class="jb-apply-header__deadline {{#showdeadlinewarning}}jb-apply-header__deadline--urgent{{/showdeadlinewarning}}">
                <i class="fa fa-clock"></i> {{daysremainingtext}}
            </span>
            {{/showdaysremaining}}
        </div>
        <h1 class="jb-apply-header__title">{{#str}}applytovacancy, local_jobboard{{/str}}</h1>
        <p class="jb-apply-header__vacancy">{{vacancy.title}}</p>
    </div>

    {{! Alerts }}
    {{#showdeadlinewarning}}
    <div class="jb-alert jb-alert--warning">
        <i class="fa fa-exclamation-triangle"></i>
        <span>{{#str}}deadlinewarning_title, local_jobboard{{/str}}: {{deadlinewarningtext}}</span>
    </div>
    {{/showdeadlinewarning}}

    {{#isexemption}}
    <div class="jb-alert jb-alert--info">
        <i class="fa fa-id-badge"></i>
        <span>{{#str}}exemptionapplied, local_jobboard{{/str}}{{#exemptioninfo}}: {{exemptiontype}}{{/exemptioninfo}}</span>
    </div>
    {{/isexemption}}

    {{! Main Content }}
    <div class="jb-apply-content">
        {{! Form }}
        <div class="jb-apply-form">
            <div class="jb-form-wrapper">
                {{{formhtml}}}
            </div>
        </div>

        {{! Sidebar }}
        <aside class="jb-apply-sidebar">
            {{! Vacancy Info }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-briefcase"></i>
                    {{#str}}vacancysummary, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}code, local_jobboard{{/str}}</span>
                        <span class="jb-info-value jb-code">{{vacancy.code}}</span>
                    </div>
                    {{#vacancy.location}}
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}location, local_jobboard{{/str}}</span>
                        <span class="jb-info-value">{{vacancy.location}}</span>
                    </div>
                    {{/vacancy.location}}
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}closedate, local_jobboard{{/str}}</span>
                        <span class="jb-info-value {{#showdeadlinewarning}}jb-text-danger{{/showdeadlinewarning}}">{{vacancy.closedateformatted}}</span>
                    </div>
                </div>
                <a href="{{viewvacancyurl}}" class="jb-card__link">
                    {{#str}}viewvacancydetails, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i>
                </a>
            </div>

            {{! Document Checklist }}
            {{#hasrequireddocs}}
            <div class="jb-card" data-region="document-checklist" data-total="{{requireddocscount}}">
                <div class="jb-card__header jb-card__header--accent">
                    <span><i class="fa fa-list-check"></i> {{#str}}documentchecklist, local_jobboard{{/str}}</span>
                    <span data-region="checklist-counter" class="jb-badge">
                        <span data-count="uploaded">0</span>/{{requireddocscount}}
                    </span>
                </div>
                <div class="jb-progress" data-region="checklist-progress"></div>
                <ul class="jb-checklist" data-region="checklist-items">
                    {{#requireddocs}}
                    <li class="jb-checklist__item" data-doc-code="{{code}}" data-action="scroll-to-doc" data-target="doc_{{code}}">
                        <span class="jb-checklist__icon" data-icon="unchecked"><i class="fa fa-circle"></i></span>
                        <span class="jb-checklist__icon jb-checklist__icon--done d-none" data-icon="checked"><i class="fa fa-check-circle"></i></span>
                        <span class="jb-checklist__text">{{name}}</span>
                        {{#isrequired}}<span class="jb-text-danger">*</span>{{/isrequired}}
                    </li>
                    {{/requireddocs}}
                </ul>
                <div data-region="all-complete" class="jb-checklist__done d-none">
                    <i class="fa fa-check-circle"></i> {{#str}}alldocumentsuploaded, local_jobboard{{/str}}
                </div>
            </div>
            {{/hasrequireddocs}}

            {{! Help }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-circle-question"></i>
                    {{#str}}needhelp, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <p class="jb-text-muted">{{#str}}applyhelp_text, local_jobboard{{/str}}</p>
                    {{#supportemail}}
                    <a href="mailto:{{supportemail}}" class="jb-card__link">
                        <i class="fa fa-envelope"></i> {{supportemail}}
                    </a>
                    {{/supportemail}}
                </div>
            </div>
        </aside>
    </div>
</div>

<style>
/* ================================================================
   APPLY PAGE - CLEAN MINIMAL DESIGN
   ================================================================ */
.jb-apply {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
}

/* Header */
.jb-apply-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-apply-header__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.jb-apply-header__back {
    color: var(--iser-verde);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-apply-header__back:hover {
    color: var(--iser-verde-dark);
}

.jb-apply-header__deadline {
    font-size: 0.875rem;
    color: var(--iser-gris-medio);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
}

.jb-apply-header__deadline--urgent {
    color: var(--iser-rojo);
    font-weight: 600;
}

.jb-apply-header__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    color: var(--iser-negro);
}

.jb-apply-header__vacancy {
    font-size: 1rem;
    color: var(--iser-gris-medio);
    margin: 0;
}

/* Alerts */
.jb-alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
    font-size: 0.875rem;
}

.jb-alert--warning {
    background: #fef3cd;
    color: #856404;
}

.jb-alert--info {
    background: #d1ecf1;
    color: #0c5460;
}

/* Content Layout */
.jb-apply-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 1.5rem;
    align-items: start;
}

@media (max-width: 900px) {
    .jb-apply-content {
        grid-template-columns: 1fr;
    }
    .jb-apply-sidebar {
        order: -1;
    }
}

/* Form Area */
.jb-apply-form {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
}

.jb-form-wrapper {
    padding: 1.5rem;
}

/* Moodle Form Overrides - Clean */
.jb-form-wrapper .mform {
    max-width: 100%;
}

.jb-form-wrapper .ftoggler,
.jb-form-wrapper .fheader,
.jb-form-wrapper fieldset > legend {
    font-size: 1rem;
    font-weight: 600;
    color: var(--iser-verde-dark);
    padding: 0.75rem 0;
    margin: 1.25rem 0 0.75rem 0;
    border-bottom: 2px solid var(--iser-verde);
    background: none;
    width: 100%;
}

.jb-form-wrapper fieldset:first-of-type .ftoggler,
.jb-form-wrapper fieldset:first-of-type legend {
    margin-top: 0;
}

.jb-form-wrapper .fitem,
.jb-form-wrapper .form-group {
    margin-bottom: 1rem;
}

.jb-form-wrapper label {
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--iser-negro);
    margin-bottom: 0.375rem;
}

.jb-form-wrapper input[type="text"],
.jb-form-wrapper input[type="email"],
.jb-form-wrapper textarea,
.jb-form-wrapper select,
.jb-form-wrapper .form-control {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.9375rem;
    transition: border-color 0.15s;
}

.jb-form-wrapper input:focus,
.jb-form-wrapper textarea:focus,
.jb-form-wrapper select:focus,
.jb-form-wrapper .form-control:focus {
    border-color: var(--iser-verde);
    outline: none;
    box-shadow: 0 0 0 2px rgba(27, 158, 136, 0.1);
}

.jb-form-wrapper textarea {
    min-height: 100px;
}

/* Checkboxes */
.jb-form-wrapper .form-check,
.jb-form-wrapper .fcheckbox {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.625rem;
    background: #f9fafb;
    border-radius: 6px;
    margin-bottom: 0.5rem;
}

.jb-form-wrapper input[type="checkbox"] {
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    accent-color: var(--iser-verde);
}

.jb-form-wrapper .form-check-label {
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--iser-gris-oscuro);
    line-height: 1.4;
}

/* File Upload */
.jb-form-wrapper .filepicker-container,
.jb-form-wrapper .filemanager {
    border: 1px dashed #d1d5db;
    border-radius: 6px;
    background: #f9fafb;
}

.jb-form-wrapper .filepicker-container:hover,
.jb-form-wrapper .filemanager:hover {
    border-color: var(--iser-verde);
}

/* Help Text */
.jb-form-wrapper .form-text,
.jb-form-wrapper .fdescription {
    font-size: 0.75rem;
    color: var(--iser-gris-medio);
    margin-top: 0.25rem;
}

/* Error Messages */
.jb-form-wrapper .error,
.jb-form-wrapper .invalid-feedback {
    color: var(--iser-rojo);
    font-size: 0.75rem;
    margin-top: 0.25rem;
}

/* Buttons - Clean and Simple */
.jb-form-wrapper #fgroup_id_buttonar,
.jb-form-wrapper .fitem_actionbuttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid #e5e5e5;
}

.jb-form-wrapper input[type="submit"],
.jb-form-wrapper button[type="submit"],
.jb-form-wrapper .btn-primary {
    background: var(--iser-verde);
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s;
}

.jb-form-wrapper input[type="submit"]:hover,
.jb-form-wrapper button[type="submit"]:hover,
.jb-form-wrapper .btn-primary:hover {
    background: var(--iser-verde-dark);
}

.jb-form-wrapper .btn-secondary,
.jb-form-wrapper input[name="savedraft"] {
    background: #fff;
    color: var(--iser-verde);
    border: 1px solid var(--iser-verde);
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
}

.jb-form-wrapper .btn-secondary:hover,
.jb-form-wrapper input[name="savedraft"]:hover {
    background: var(--iser-verde-lighter);
}

.jb-form-wrapper input[name="cancel"],
.jb-form-wrapper .btn-cancel {
    background: transparent;
    color: var(--iser-gris-medio);
    border: 1px solid #d1d5db;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
}

.jb-form-wrapper input[name="cancel"]:hover,
.jb-form-wrapper .btn-cancel:hover {
    background: #f5f5f5;
    border-color: #bbb;
}

/* Sidebar */
.jb-apply-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
}

@media (max-width: 900px) {
    .jb-apply-sidebar {
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
    }
    .jb-card {
        flex: 1 1 250px;
    }
}

/* Cards */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i {
    color: var(--iser-verde);
}

.jb-card__header--accent {
    background: var(--iser-verde-lighter);
    border-bottom-color: var(--iser-verde);
}

.jb-card__header--accent,
.jb-card__header--accent i {
    color: var(--iser-verde-dark);
}

.jb-card__body {
    padding: 1rem;
}

.jb-card__link {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    color: var(--iser-verde);
    text-decoration: none;
    text-align: center;
    border-top: 1px solid #e5e5e5;
}

.jb-card__link:hover {
    background: #f9fafb;
    color: var(--iser-verde-dark);
}

/* Info Rows */
.jb-info-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.8125rem;
}

.jb-info-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.jb-info-label {
    color: var(--iser-gris-medio);
}

.jb-info-value {
    font-weight: 500;
    color: var(--iser-negro);
}

.jb-code {
    font-family: monospace;
    background: #f0f0f0;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    font-size: 0.75rem;
}

/* Progress */
.jb-progress {
    height: 3px;
    background: #e5e5e5;
}

.jb-progress::after {
    content: '';
    display: block;
    height: 100%;
    background: var(--iser-verde);
    width: 0%;
    transition: width 0.3s;
}

/* Badge */
.jb-badge {
    background: var(--iser-gris-medio);
    color: #fff;
    padding: 0.125rem 0.5rem;
    border-radius: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
}

/* Checklist */
.jb-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
}

.jb-checklist__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--iser-gris-oscuro);
    cursor: pointer;
    border-bottom: 1px solid #f5f5f5;
}

.jb-checklist__item:last-child {
    border-bottom: none;
}

.jb-checklist__item:hover {
    background: #f9fafb;
}

.jb-checklist__icon {
    color: #d1d5db;
    font-size: 0.875rem;
}

.jb-checklist__icon--done {
    color: var(--iser-verde);
}

.jb-checklist__text {
    flex: 1;
}

.jb-checklist__done {
    padding: 0.75rem 1rem;
    background: var(--iser-verde-lighter);
    color: var(--iser-verde-dark);
    font-size: 0.8125rem;
    text-align: center;
}

/* Utilities */
.jb-text-danger {
    color: var(--iser-rojo) !important;
}

.jb-text-muted {
    color: var(--iser-gris-medio);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0;
}

/* Mobile */
@media (max-width: 600px) {
    .jb-apply-header__title {
        font-size: 1.25rem;
    }

    .jb-form-wrapper {
        padding: 1rem;
    }

    .jb-form-wrapper #fgroup_id_buttonar,
    .jb-form-wrapper .fitem_actionbuttons {
        flex-direction: column;
    }

    .jb-form-wrapper #fgroup_id_buttonar input,
    .jb-form-wrapper .fitem_actionbuttons .btn {
        width: 100%;
    }
}

/* Print */
@media print {
    .jb-apply-sidebar {
        display: none;
    }
    .jb-apply-content {
        display: block;
    }
}
</style>
