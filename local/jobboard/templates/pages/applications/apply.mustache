{{!
    @template local_jobboard/pages/applications/apply

    Application form page - Clean and professional design.

    Context variables:
    * vacancy - Vacancy data {id, code, title, location, modality, closedateformatted}
    * convocatoria - Convocatoria info {code, name}
    * daysuntilclose - Days remaining until deadline
    * showdeadlinewarning - Whether to show urgent deadline warning
    * isexemption - Boolean if user has exemption
    * exemptioninfo - Exemption details if applicable
    * formhtml - Moodle form HTML
    * requireddocs - Array of required document types
    * hasrequireddocs - Boolean if there are required documents
    * requireddocscount - Number of required documents
    * viewvacancyurl - URL to view vacancy details
    * backvacancyurl - URL to vacancy details
    * browservacanciesurl - URL to browse vacancies

    Example context (json):
    {
        "vacancy": {"code": "VAC-001", "title": "Professor Position"},
        "showdeadlinewarning": true
    }
}}
<div class="jb-apply-page" id="jobboard-apply">
    <div class="container-fluid px-0">
        <div class="row g-4">
            {{! Main Content }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{browservacanciesurl}}">{{#str}}vacancies, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{viewvacancyurl}}">{{vacancy.code}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{#str}}apply, local_jobboard{{/str}}</li>
                        </ol>
                    </nav>
                    <h1 class="h3 mb-1">{{#str}}applytovacancy, local_jobboard{{/str}}</h1>
                    <p class="text-muted mb-0">{{vacancy.title}}</p>
                </div>

                {{! Deadline Warning }}
                {{#showdeadlinewarning}}
                <div class="alert alert-danger jb-alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-exclamation-triangle fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}deadlinewarning_title, local_jobboard{{/str}}</strong>
                        <span class="d-block">{{deadlinewarningtext}}</span>
                    </div>
                </div>
                {{/showdeadlinewarning}}

                {{! Exemption Notice }}
                {{#isexemption}}
                <div class="alert alert-info jb-alert-info d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-id-badge fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}exemptionapplied, local_jobboard{{/str}}</strong>
                        {{#exemptioninfo}}
                        <span class="d-block small">{{exemptiontype}}</span>
                        {{/exemptioninfo}}
                    </div>
                </div>
                {{/isexemption}}

                {{! Application Form Card }}
                <div class="card shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-file-signature text-primary me-2"></i>
                            {{#str}}applicationform, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        {{{formhtml}}}
                    </div>
                </div>
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Vacancy Summary }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-briefcase text-primary me-2"></i>
                                {{#str}}vacancysummary, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-5 text-muted">{{#str}}code, local_jobboard{{/str}}</dt>
                                <dd class="col-7"><code>{{vacancy.code}}</code></dd>

                                <dt class="col-5 text-muted">{{#str}}title, local_jobboard{{/str}}</dt>
                                <dd class="col-7">{{vacancy.title}}</dd>

                                {{#vacancy.location}}
                                <dt class="col-5 text-muted">{{#str}}location, local_jobboard{{/str}}</dt>
                                <dd class="col-7">{{vacancy.location}}</dd>
                                {{/vacancy.location}}

                                {{#vacancy.modality}}
                                <dt class="col-5 text-muted">{{#str}}modality, local_jobboard{{/str}}</dt>
                                <dd class="col-7">{{vacancy.modality}}</dd>
                                {{/vacancy.modality}}

                                <dt class="col-5 text-muted">{{#str}}closedate, local_jobboard{{/str}}</dt>
                                <dd class="col-7">
                                    <span class="{{#showdeadlinewarning}}text-danger fw-bold{{/showdeadlinewarning}}">
                                        {{vacancy.closedateformatted}}
                                    </span>
                                </dd>
                            </dl>

                            {{#showdaysremaining}}
                            <div class="text-center mt-3 pt-3 border-top">
                                <span class="badge bg-{{deadlinebadgecolor}} py-2 px-3">
                                    <i class="fa fa-clock me-1"></i>
                                    {{daysremainingtext}}
                                </span>
                            </div>
                            {{/showdaysremaining}}
                        </div>
                        <div class="card-footer bg-light">
                            <a href="{{viewvacancyurl}}" class="btn btn-outline-primary jb-btn-outline-primary btn-sm w-100">
                                <i class="fa fa-eye me-1"></i>
                                {{#str}}viewvacancydetails, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>

                    {{! Document Checklist }}
                    {{#hasrequireddocs}}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="fa fa-list-check text-warning me-2"></i>
                                    {{#str}}documentchecklist, local_jobboard{{/str}}
                                </h6>
                                <span class="badge bg-secondary">{{requireddocscount}}</span>
                            </div>
                        </div>
                        <ul class="list-group list-group-flush small">
                            {{#requireddocs}}
                            <li class="list-group-item d-flex align-items-center py-2">
                                <i class="fa fa-square text-muted me-2"></i>
                                <span class="flex-grow-1">{{name}}</span>
                                {{#isrequired}}
                                <span class="text-danger" title="{{#str}}required{{/str}}">*</span>
                                {{/isrequired}}
                            </li>
                            {{/requireddocs}}
                        </ul>
                        <div class="card-footer bg-light small text-muted">
                            <span class="text-danger">*</span> {{#str}}indicatesrequired, local_jobboard{{/str}}
                        </div>
                    </div>
                    {{/hasrequireddocs}}

                    {{! Help Card }}
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-circle-question text-info me-2"></i>
                                {{#str}}needhelp, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body small">
                            <p class="mb-2">{{#str}}applyhelp_text, local_jobboard{{/str}}</p>
                            <ul class="mb-0 ps-3">
                                {{#quicktips}}
                                <li class="mb-1">{{.}}</li>
                                {{/quicktips}}
                            </ul>

                            {{#supportemail}}
                            <div class="mt-3 pt-3 border-top">
                                <strong class="d-block mb-2">{{#str}}contactsupport, local_jobboard{{/str}}</strong>
                                <a href="mailto:{{supportemail}}" class="btn btn-outline-secondary btn-sm w-100">
                                    <i class="fa fa-envelope me-1"></i>
                                    {{supportemail}}
                                </a>
                            </div>
                            {{/supportemail}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top">
                    <a href="{{backvacancyurl}}" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{#str}}backtovacancy, local_jobboard{{/str}}
                    </a>
                    <a href="{{browservacanciesurl}}" class="btn btn-link text-muted">
                        {{#str}}browservacancies, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
