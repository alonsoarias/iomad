{{!
    @template local_jobboard/pages/applications/manage

    Manage applications for a vacancy page template.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * vacancytitle (string) - Vacancy title
    * vacancyid (number) - Vacancy ID
    * backurl (string) - Back to manage URL
    * reseturl (string) - Reset filters URL
    * stats (array) - Status statistics cards {color, count, label}
    * statuses (array) - Available statuses for filter
    * currentstatus (string) - Current status filter
    * currentsearch (string) - Current search term
    * hasapplications (bool) - Has applications
    * applications (array) - List of applications
    * tableheaders (array) - Table column headers
    * paginationhtml (string) - Pagination HTML
    * exportcsvurl (string) - CSV export URL
    * exportexcelurl (string) - Excel export URL
    * loading (bool) - Show skeleton loading state

    Example context (json):
    {
        "vacancytitle": "Docente de Matemáticas",
        "vacancyid": 123,
        "hasapplications": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-manage-applications" aria-busy="true" aria-label="{{#str}}loading, local_jobboard{{/str}}">
    <div class="jb-skeleton-title mb-3" style="width: 50%;"></div>
    <div class="jb-skeleton-text mb-4" style="width: 120px;"></div>
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-2">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            {{> local_jobboard/components/stat_card }}
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            {{> local_jobboard/components/table }}
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-manage-applications" data-region="jobboard-manage-applications" data-vacancy-id="{{vacancyid}}">
    {{! Skip Link for Accessibility }}
    <a href="#applications-main-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="jb-page-header mb-4 jb-fade-in">
        <nav aria-label="{{#str}}breadcrumb, local_jobboard{{/str}}" class="mb-2">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item">
                    <a href="{{backurl}}">{{#str}}managevacancies, local_jobboard{{/str}}</a>
                </li>
                <li class="breadcrumb-item jb-active" aria-current="page">
                    {{#str}}applications, local_jobboard{{/str}}
                </li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="fs-3 mb-0">
                <i class="fa fa-users text-primary me-2" aria-hidden="true"></i>
                {{#str}}manageapplications, local_jobboard{{/str}}
            </h1>
            <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>
                {{#str}}backtomanage, local_jobboard{{/str}}
            </a>
        </div>
        <p class="text-muted mt-2 mb-0">
            <i class="fa fa-briefcase me-1" aria-hidden="true"></i>
            <strong>{{vacancytitle}}</strong>
        </p>
    </header>

    {{! Stats Cards }}
    {{#stats.0}}
    <section class="row mb-4" role="region" aria-label="{{#str}}statistics, local_jobboard{{/str}}">
        {{#stats}}
        <div class="col-md-3 col-sm-6 mb-2 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
            <div class="card shadow-sm jb-stat-card jb-bg-{{color}} text-white jb-hover-lift">
                <div class="card-body text-center py-3">
                    <h2 class="fs-2 mb-1">{{count}}</h2>
                    <p class="mb-0 small opacity-75">{{label}}</p>
                </div>
            </div>
        </div>
        {{/stats}}
    </section>
    {{/stats.0}}

    {{! Filter Form }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.15s;">
        <div class="card-body">
            <form class="jb-filter-form" method="get" role="search" aria-label="{{#str}}filterapplications, local_jobboard{{/str}}">
                <input type="hidden" name="vacancyid" value="{{vacancyid}}">
                <div class="row align-items-end">
                    <div class="col-lg-5 col-md-6 mb-2">
                        <label class="form-label small text-muted visually-hidden" for="search">{{#str}}search{{/str}}</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-magnifying-glass text-muted" aria-hidden="true"></i>
                            </span>
                            <input type="text" name="search" id="search" class="form-control"
                                   placeholder="{{#str}}searchapplicant, local_jobboard{{/str}}" value="{{currentsearch}}">
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 mb-2">
                        <label class="form-label small text-muted" for="status">{{#str}}status, local_jobboard{{/str}}</label>
                        <select name="status" id="status" class="form-select">
                            <option value="">{{#str}}allstatuses, local_jobboard{{/str}}</option>
                            {{#statuses}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/statuses}}
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-2 mb-2">
                        <div class="btn-group w-100" role="group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-filter me-1" aria-hidden="true"></i>
                                {{#str}}filter{{/str}}
                            </button>
                            <a href="{{reseturl}}" class="btn btn-outline-secondary">
                                <i class="fa fa-rotate-left" aria-hidden="true"></i>
                                <span class="visually-hidden">{{#str}}reset{{/str}}</span>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </section>

    {{! Main Content }}
    <main id="applications-main-content">
        {{#hasapplications}}
        {{! Applications Table }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" aria-labelledby="applications-heading" style="animation-delay: 0.2s;">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="fs-5 mb-0" id="applications-heading">
                    <i class="fa fa-list text-primary me-2" aria-hidden="true"></i>
                    {{#str}}applicationslist, local_jobboard{{/str}}
                </h2>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" aria-label="{{#str}}applicationslist, local_jobboard{{/str}}">
                        <thead class="table-light">
                            <tr>
                                {{#tableheaders}}
                                <th scope="col">
                                    {{#sortable}}
                                    <a href="{{sorturl}}" class="text-dark text-decoration-none">
                                        {{label}}
                                        {{{sorticon}}}
                                    </a>
                                    {{/sortable}}
                                    {{^sortable}}
                                    {{label}}
                                    {{/sortable}}
                                </th>
                                {{/tableheaders}}
                            </tr>
                        </thead>
                        <tbody>
                            {{#applications}}
                            <tr data-application-id="{{id}}">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="jb-avatar jb-avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center d-none jb-d-sm-flex" style="width: 36px; height: 36px;">
                                            <i class="fa fa-user text-muted" aria-hidden="true"></i>
                                        </div>
                                        <div>
                                            <strong class="d-block">{{fullname}}</strong>
                                            <small class="text-muted">{{email}}</small>
                                            {{#isexemption}}
                                            <span class="badge bg-info text-dark ms-1">
                                                <i class="fa fa-shield me-1" aria-hidden="true"></i>
                                                {{#str}}exemption, local_jobboard{{/str}}
                                            </span>
                                            {{/isexemption}}
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">{{dateapplied}}</small>
                                </td>
                                <td>
                                    <span class="badge {{statusbadgeclass}} rounded-pill">
                                        {{#statusicon}}<i class="fa fa-{{statusicon}} me-1" aria-hidden="true"></i>{{/statusicon}}
                                        {{statuslabel}}
                                    </span>
                                </td>
                                <td>
                                    {{{docstatushtml}}}
                                </td>
                                <td>
                                    <a href="{{viewurl}}" class="btn btn-sm btn-primary jb-hover-lift">
                                        <i class="fa fa-eye me-1" aria-hidden="true"></i>
                                        {{#str}}view, local_jobboard{{/str}}
                                    </a>
                                </td>
                            </tr>
                            {{/applications}}
                        </tbody>
                    </table>
                </div>
            </div>
            {{#paginationhtml}}
            <div class="card-footer bg-white">
                <nav aria-label="{{#str}}pagination, local_jobboard{{/str}}">
                    {{{paginationhtml}}}
                </nav>
            </div>
            {{/paginationhtml}}
        </section>
        {{/hasapplications}}

        {{! Empty State }}
        {{^hasapplications}}
        <div class="text-center py-5" role="status">
            <i class="fa fa-users fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
            <h2 class="h5 text-muted mb-2">{{#str}}noapplicationsfound, local_jobboard{{/str}}</h2>
            <p class="text-muted mb-3">{{#str}}noapplicationsfound_desc, local_jobboard{{/str}}</p>
            {{#currentsearch}}
            <a href="{{reseturl}}" class="btn btn-outline-primary">
                <i class="fa fa-rotate-left me-2" aria-hidden="true"></i>
                {{#str}}clearfilters, local_jobboard{{/str}}
            </a>
            {{/currentsearch}}
        </div>
        {{/hasapplications}}

        {{! Export Section }}
        {{#hasapplications}}
        <section class="card shadow-sm jb-fade-in-up" aria-labelledby="export-heading" style="animation-delay: 0.25s;">
            <div class="card-header bg-white">
                <h2 class="fs-5 mb-0" id="export-heading">
                    <i class="fa fa-download text-primary me-2" aria-hidden="true"></i>
                    {{#str}}export, local_jobboard{{/str}}
                </h2>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">{{#str}}exportdesc, local_jobboard{{/str}}</p>
                <div class="btn-group" role="group" aria-label="{{#str}}exportformats, local_jobboard{{/str}}">
                    <a href="{{exportcsvurl}}" class="btn btn-outline-success jb-hover-lift">
                        <i class="fa fa-file-csv me-2" aria-hidden="true"></i>
                        {{#str}}exportcsv, local_jobboard{{/str}}
                    </a>
                    <a href="{{exportexcelurl}}" class="btn btn-outline-primary jb-hover-lift">
                        <i class="fa fa-file-excel me-2" aria-hidden="true"></i>
                        {{#str}}exportexcel, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
        </section>
        {{/hasapplications}}
    </main>

    {{! Navigation Footer }}
    <nav class="jb-navigation-footer d-flex justify-content-between align-items-center mt-4 py-3 border-top jb-fade-in" aria-label="{{#str}}pagenavigation, local_jobboard{{/str}}">
        <a href="{{backurl}}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}backtomanage, local_jobboard{{/str}}
        </a>
    </nav>
</div>
{{/loading}}
