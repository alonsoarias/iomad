{{!
    @template local_jobboard/pages/applications/manage

    Manage applications for a vacancy page template.
    Redesigned to follow apply.mustache pattern with 2-column layout.

    Context variables:
    * vacancytitle (string) - Vacancy title
    * vacancycode (string) - Vacancy code
    * vacancyid (number) - Vacancy ID
    * backurl (string) - Back to manage URL
    * reseturl (string) - Reset filters URL
    * stats (array) - Status statistics cards {color, count, label}
    * statuses (array) - Available statuses for filter
    * currentstatus (string) - Current status filter
    * currentsearch (string) - Current search term
    * hasapplications (bool) - Has applications
    * applications (array) - List of applications
    * tableheaders (array) - Table column headers
    * paginationhtml (string) - Pagination HTML
    * exportcsvurl (string) - CSV export URL
    * exportexcelurl (string) - Excel export URL
    * browseurl (string) - Browse vacancies URL
    * dashboardurl (string) - Dashboard URL

    Example context (json):
    {
        "vacancytitle": "Docente de Matemáticas",
        "vacancycode": "VAC-001",
        "vacancyid": 123,
        "hasapplications": true
    }
}}
<div class="jb-manage-applications-page" id="jobboard-manage-applications" data-vacancy-id="{{vacancyid}}">
    <div class="container-fluid px-0">
        <div class="row g-4">
            {{! Main Content }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{backurl}}">{{#str}}managevacancies, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{#str}}applications, local_jobboard{{/str}}</li>
                        </ol>
                    </nav>
                    <h1 class="h3 mb-1">{{#str}}manageapplications, local_jobboard{{/str}}</h1>
                    <p class="text-muted mb-0">{{vacancytitle}}</p>
                </div>

                {{! Applications Table Card }}
                {{#hasapplications}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fa fa-users text-primary me-2"></i>
                                {{#str}}applicantslist, local_jobboard{{/str}}
                            </h5>
                            <span class="badge bg-secondary">{{totalapplications}} {{#str}}total, local_jobboard{{/str}}</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        {{#tableheaders}}
                                        <th scope="col" class="small">
                                            {{#sortable}}
                                            <a href="{{sorturl}}" class="text-dark text-decoration-none">
                                                {{label}}
                                                {{{sorticon}}}
                                            </a>
                                            {{/sortable}}
                                            {{^sortable}}
                                            {{label}}
                                            {{/sortable}}
                                        </th>
                                        {{/tableheaders}}
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#applications}}
                                    <tr data-application-id="{{id}}">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <strong class="d-block">{{fullname}}</strong>
                                                    <small class="text-muted">{{email}}</small>
                                                    {{#isexemption}}
                                                    <span class="badge bg-info text-dark ms-1">
                                                        <i class="fa fa-shield me-1" aria-hidden="true"></i>
                                                        {{#str}}exemption, local_jobboard{{/str}}
                                                    </span>
                                                    {{/isexemption}}
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <small class="text-muted">{{dateapplied}}</small>
                                        </td>
                                        <td>
                                            <span class="badge {{statusbadgeclass}} rounded-pill">
                                                {{#statusicon}}<i class="fa fa-{{statusicon}} me-1" aria-hidden="true"></i>{{/statusicon}}
                                                {{statuslabel}}
                                            </span>
                                        </td>
                                        <td>
                                            {{{docstatushtml}}}
                                        </td>
                                        <td>
                                            <a href="{{viewurl}}" class="btn btn-sm btn-primary">
                                                <i class="fa fa-eye me-1" aria-hidden="true"></i>
                                                {{#str}}view, local_jobboard{{/str}}
                                            </a>
                                        </td>
                                    </tr>
                                    {{/applications}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {{#paginationhtml}}
                    <div class="card-footer bg-white">
                        {{{paginationhtml}}}
                    </div>
                    {{/paginationhtml}}
                </div>

                {{! Export Section }}
                <div class="card shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-download text-success me-2"></i>
                            {{#str}}export, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">{{#str}}exportdesc, local_jobboard{{/str}}</p>
                        <div class="btn-group">
                            <a href="{{exportcsvurl}}" class="btn btn-outline-success">
                                <i class="fa fa-file-csv me-2" aria-hidden="true"></i>
                                {{#str}}exportcsv, local_jobboard{{/str}}
                            </a>
                            <a href="{{exportexcelurl}}" class="btn btn-outline-primary">
                                <i class="fa fa-file-excel me-2" aria-hidden="true"></i>
                                {{#str}}exportexcel, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>
                </div>
                {{/hasapplications}}

                {{! Empty State }}
                {{^hasapplications}}
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fa fa-users fa-3x text-muted mb-3" aria-hidden="true"></i>
                        <h5 class="text-muted">{{#str}}noapplicationsfound, local_jobboard{{/str}}</h5>
                        <p class="text-muted mb-3">{{#str}}noapplicationsfound_desc, local_jobboard{{/str}}</p>
                        {{#currentsearch}}
                        <a href="{{reseturl}}" class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-rotate-left me-2" aria-hidden="true"></i>
                            {{#str}}clearfilters, local_jobboard{{/str}}
                        </a>
                        {{/currentsearch}}
                    </div>
                </div>
                {{/hasapplications}}
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Vacancy Summary Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-briefcase text-primary me-2"></i>
                                {{#str}}vacancysummary, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-4 text-muted">{{#str}}code, local_jobboard{{/str}}</dt>
                                <dd class="col-8"><code>{{vacancycode}}</code></dd>

                                <dt class="col-4 text-muted">{{#str}}title, local_jobboard{{/str}}</dt>
                                <dd class="col-8">{{vacancytitle}}</dd>
                            </dl>
                        </div>
                    </div>

                    {{! Stats Cards }}
                    {{#stats.0}}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-chart-pie text-info me-2"></i>
                                {{#str}}statistics, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body py-3">
                            <div class="row g-2">
                                {{#stats}}
                                <div class="col-6">
                                    <div class="text-center p-2 rounded bg-{{color}}-subtle">
                                        <div class="h4 text-{{color}} mb-0">{{count}}</div>
                                        <small class="text-muted">{{label}}</small>
                                    </div>
                                </div>
                                {{/stats}}
                            </div>
                        </div>
                    </div>
                    {{/stats.0}}

                    {{! Filter Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-filter text-warning me-2"></i>
                                {{#str}}filterapplications, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <form method="get" action="">
                                <input type="hidden" name="view" value="manage_applications">
                                <input type="hidden" name="vacancyid" value="{{vacancyid}}">

                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1" for="search">{{#str}}search{{/str}}</label>
                                    <input type="text" name="search" id="search" class="form-control form-control-sm"
                                           placeholder="{{#str}}searchapplicant, local_jobboard{{/str}}" value="{{currentsearch}}">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1" for="status">{{#str}}status, local_jobboard{{/str}}</label>
                                    <select name="status" id="status" class="form-select form-select-sm">
                                        <option value="">{{#str}}allstatuses, local_jobboard{{/str}}</option>
                                        {{#statuses}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/statuses}}
                                    </select>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="fa fa-search me-1" aria-hidden="true"></i>
                                        {{#str}}filter, local_jobboard{{/str}}
                                    </button>
                                    <a href="{{reseturl}}" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-rotate-left me-1" aria-hidden="true"></i>
                                        {{#str}}reset{{/str}}
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>

                    {{! Quick Actions Card }}
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-bolt text-warning me-2"></i>
                                {{#str}}quickactions, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="{{reviewurl}}" class="btn btn-outline-primary btn-sm">
                                    <i class="fa fa-magnifying-glass me-2"></i>
                                    {{#str}}reviewdocuments, local_jobboard{{/str}}
                                </a>
                                <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-arrow-left me-2"></i>
                                    {{#str}}backtomanage, local_jobboard{{/str}}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top">
                    <a href="{{backurl}}" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{#str}}backtomanage, local_jobboard{{/str}}
                    </a>
                    <a href="{{dashboardurl}}" class="btn btn-link text-muted">
                        {{#str}}dashboard, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{! Minimal CSS for page styling }}
<style>
.jb-manage-applications-page .card {
    border-radius: 0.5rem;
}
.jb-manage-applications-page .jb-sidebar {
    z-index: 10;
}
.jb-manage-applications-page .bg-primary-subtle {
    background-color: rgba(13, 110, 253, 0.1) !important;
}
.jb-manage-applications-page .bg-success-subtle {
    background-color: rgba(25, 135, 84, 0.1) !important;
}
.jb-manage-applications-page .bg-danger-subtle {
    background-color: rgba(220, 53, 69, 0.1) !important;
}
.jb-manage-applications-page .bg-warning-subtle {
    background-color: rgba(255, 193, 7, 0.1) !important;
}
.jb-manage-applications-page .bg-info-subtle {
    background-color: rgba(13, 202, 240, 0.1) !important;
}
.jb-manage-applications-page .bg-secondary-subtle {
    background-color: rgba(108, 117, 125, 0.1) !important;
}
</style>
