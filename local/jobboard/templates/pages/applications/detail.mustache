{{!
    @template local_jobboard/pages/applications/detail

    Application detail page - Clean minimal design following jb-* pattern.

    Context variables:
    * application - Application data
    * vacancy - Vacancy data
    * applicant - Applicant info (for reviewers)
    * documents - Array of document data
    * hasdocuments - Boolean
    * documentcount - Number of documents
    * docsapproved - Approved count
    * docsrejected - Rejected count
    * docspending - Pending count
    * history - Status history
    * hashistory - Boolean
    * workflowactions - Available workflow actions
    * hasworkflowactions - Boolean
    * canmanage - Boolean
    * canreview - Boolean
    * isowner - Boolean
    * canwithdraw - Boolean
    * hasexemption - Boolean
    * exemptiontype - Exemption type
    * exemptionref - Exemption reference
    * backurl - Back URL
    * backlabel - Back label
    * dashboardurl - Dashboard URL
    * reviewurl - Review URL
    * withdrawurl - Withdraw URL
    * sesskey - Session key
}}
<div class="jb-application-detail" id="jobboard-application-detail" data-application-id="{{application.id}}">
    {{! Header }}
    <div class="jb-detail-header">
        <div class="jb-detail-header__nav">
            <a href="{{backurl}}" class="jb-detail-header__back">
                <i class="fa fa-arrow-left"></i>
                {{backlabel}}
            </a>
            {{#isdraft}}
            <a href="{{continueurl}}" class="jb-btn jb-btn--success">
                <i class="fa fa-edit"></i> {{#str}}completeandsubmit, local_jobboard{{/str}}
            </a>
            {{/isdraft}}
        </div>
        <div class="jb-detail-header__title-row">
            <span class="jb-code jb-code--primary">{{vacancy.code}}</span>
            <span class="jb-badge jb-badge--{{application.statuscolor}}">
                <i class="fa fa-{{application.statusicon}}"></i> {{application.statuslabel}}
            </span>
        </div>
        <h1 class="jb-detail-header__title">{{vacancy.title}}</h1>
        <p class="jb-detail-header__subtitle">
            <i class="fa fa-hashtag"></i> {{#str}}application, local_jobboard{{/str}} #{{application.id}}
        </p>
    </div>

    {{! Status Alert }}
    <div class="jb-alert jb-alert--{{application.statuscolor}}">
        <i class="fa fa-{{application.statusicon}}"></i>
        <div class="jb-alert__content">
            <strong>{{#str}}currentstatus, local_jobboard{{/str}}: {{application.statuslabel}}</strong>
            {{#application.statusnotes}}
            <span>{{application.statusnotes}}</span>
            {{/application.statusnotes}}
        </div>
    </div>

    {{! Draft Alert }}
    {{#isdraft}}
    <div class="jb-alert jb-alert--warning jb-alert--action">
        <i class="fa fa-pencil-alt"></i>
        <div class="jb-alert__content">
            <strong>{{#str}}draft_pending, local_jobboard{{/str}}</strong>
            <span>{{#str}}draft_pending_desc, local_jobboard{{/str}}</span>
        </div>
        <a href="{{continueurl}}" class="jb-btn jb-btn--success jb-btn--sm">
            <i class="fa fa-edit"></i> {{#str}}completeandsubmit, local_jobboard{{/str}}
        </a>
    </div>
    {{/isdraft}}

    {{! Exemption Notice }}
    {{#hasexemption}}
    <div class="jb-alert jb-alert--info">
        <i class="fa fa-id-badge"></i>
        <div class="jb-alert__content">
            <strong>{{#str}}exemptionapplied, local_jobboard{{/str}}</strong>
            <span>{{exemptiontype}}{{#exemptionref}} ({{exemptionref}}){{/exemptionref}}</span>
        </div>
    </div>
    {{/hasexemption}}

    {{! Content Layout }}
    <div class="jb-detail-content">
        {{! Main Column }}
        <div class="jb-detail-main">
            {{! Applicant Info Card (for reviewers) }}
            {{#applicant}}
            <div class="jb-card">
                <div class="jb-card__header jb-card__header--accent">
                    <i class="fa fa-user"></i>
                    {{#str}}applicantinfo, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-applicant-info">
                        <div class="jb-applicant-info__avatar">{{initials}}</div>
                        <div class="jb-applicant-info__details">
                            <h4>{{fullname}}</h4>
                            <a href="mailto:{{email}}" class="jb-link">{{email}}</a>
                        </div>
                    </div>
                    <div class="jb-info-grid">
                        {{#idnumber}}
                        <div class="jb-info-item">
                            <span class="jb-info-item__label"><i class="fa fa-id-card"></i> {{#str}}idnumber{{/str}}</span>
                            <span class="jb-info-item__value">{{idnumber}}</span>
                        </div>
                        {{/idnumber}}
                        {{#phone}}
                        <div class="jb-info-item">
                            <span class="jb-info-item__label"><i class="fa fa-phone"></i> {{#str}}phone{{/str}}</span>
                            <span class="jb-info-item__value">{{phone}}</span>
                        </div>
                        {{/phone}}
                    </div>
                </div>
            </div>
            {{/applicant}}

            {{! Cover Letter Card }}
            {{#application.coverletter}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-envelope-open-text"></i>
                    {{#str}}coverletter, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body jb-card__body--content jb-card__body--quote">
                    {{{application.coverletter}}}
                </div>
            </div>
            {{/application.coverletter}}

            {{! Documents Card }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-file-lines"></i>
                    {{#str}}uploadeddocuments, local_jobboard{{/str}}
                    <span class="jb-badge jb-badge--secondary">{{documentcount}}</span>
                </div>
                {{#hasdocuments}}
                <div class="jb-table-wrapper">
                    <table class="jb-table">
                        <thead>
                            <tr>
                                <th>{{#str}}documenttype, local_jobboard{{/str}}</th>
                                <th class="jb-hide-mobile">{{#str}}filename, local_jobboard{{/str}}</th>
                                <th class="jb-text-center">{{#str}}status, local_jobboard{{/str}}</th>
                                <th class="jb-text-right">{{#str}}actions{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#documents}}
                            <tr>
                                <td>
                                    <i class="fa fa-file jb-text-{{statuscolor}}"></i>
                                    {{typename}}
                                </td>
                                <td class="jb-hide-mobile jb-text-muted">
                                    <span class="jb-truncate" title="{{filename}}">{{filename}}</span>
                                </td>
                                <td class="jb-text-center">
                                    <span class="jb-badge jb-badge--{{statuscolor}}">
                                        <i class="fa fa-{{statusicon}}"></i> {{statuslabel}}
                                    </span>
                                </td>
                                <td class="jb-text-right">
                                    <div class="jb-btn-group">
                                        {{#downloadurl}}
                                        <a href="{{downloadurl}}" class="jb-btn jb-btn--outline jb-btn--sm" target="_blank" title="{{#str}}download{{/str}}">
                                            <i class="fa fa-download"></i>
                                        </a>
                                        {{/downloadurl}}
                                        {{#canreupload}}
                                        <a href="{{reuploadurl}}" class="jb-btn jb-btn--warning jb-btn--sm" title="{{#str}}reupload, local_jobboard{{/str}}">
                                            <i class="fa fa-upload"></i>
                                        </a>
                                        {{/canreupload}}
                                    </div>
                                </td>
                            </tr>
                            {{#rejectreason}}
                            <tr class="jb-table-row--danger">
                                <td colspan="4">
                                    <i class="fa fa-exclamation-circle jb-text-danger"></i>
                                    <strong>{{#str}}rejectreason, local_jobboard{{/str}}:</strong> {{rejectreason}}
                                </td>
                            </tr>
                            {{/rejectreason}}
                            {{/documents}}
                        </tbody>
                    </table>
                </div>
                {{/hasdocuments}}
                {{^hasdocuments}}
                <div class="jb-empty jb-empty--small">
                    <i class="fa fa-file-circle-question"></i>
                    <p>{{#str}}nodocuments, local_jobboard{{/str}}</p>
                </div>
                {{/hasdocuments}}
            </div>

            {{! Status History Card }}
            {{#hashistory}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-clock-rotate-left"></i>
                    {{#str}}statushistory, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-timeline">
                        {{#history}}
                        <div class="jb-timeline-item {{^islast}}jb-timeline-item--border{{/islast}}">
                            <div class="jb-timeline-item__dot jb-timeline-item__dot--{{statuscolor}}"></div>
                            <div class="jb-timeline-item__content">
                                <div class="jb-timeline-item__header">
                                    <span class="jb-badge jb-badge--{{statuscolor}}">{{statuslabel}}</span>
                                    <span class="jb-timeline-item__time">{{timeformatted}}</span>
                                </div>
                                {{#notes}}
                                <p class="jb-timeline-item__notes">{{notes}}</p>
                                {{/notes}}
                                {{#changedbyname}}
                                <span class="jb-timeline-item__by">
                                    <i class="fa fa-user"></i> {{changedbyname}}
                                </span>
                                {{/changedbyname}}
                            </div>
                        </div>
                        {{/history}}
                    </div>
                </div>
            </div>
            {{/hashistory}}
        </div>

        {{! Sidebar }}
        <aside class="jb-detail-sidebar">
            {{! Vacancy Summary Card }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-briefcase"></i>
                    {{#str}}vacancysummary, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}code, local_jobboard{{/str}}</span>
                        <code>{{vacancy.code}}</code>
                    </div>
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}title, local_jobboard{{/str}}</span>
                        <span>{{vacancy.title}}</span>
                    </div>
                    {{#vacancy.location}}
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}location, local_jobboard{{/str}}</span>
                        <span>{{vacancy.location}}</span>
                    </div>
                    {{/vacancy.location}}
                    <div class="jb-info-row jb-info-row--last">
                        <span class="jb-info-label">{{#str}}dateapplied, local_jobboard{{/str}}</span>
                        <strong>{{application.dateapplied}}</strong>
                    </div>
                </div>
                <div class="jb-card__footer">
                    <a href="{{vacancy.viewurl}}" class="jb-btn jb-btn--outline jb-btn--block">
                        <i class="fa fa-eye"></i> {{#str}}viewvacancydetails, local_jobboard{{/str}}
                    </a>
                </div>
            </div>

            {{! Documents Summary Card }}
            {{#hasdocuments}}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-list-check"></i>
                    {{#str}}documentstatus, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-doc-stats">
                        <div class="jb-doc-stat jb-doc-stat--success">
                            <span class="jb-doc-stat__value">{{docsapproved}}</span>
                            <span class="jb-doc-stat__label">{{#str}}approved, local_jobboard{{/str}}</span>
                        </div>
                        <div class="jb-doc-stat jb-doc-stat--warning">
                            <span class="jb-doc-stat__value">{{docspending}}</span>
                            <span class="jb-doc-stat__label">{{#str}}pending, local_jobboard{{/str}}</span>
                        </div>
                        <div class="jb-doc-stat jb-doc-stat--danger">
                            <span class="jb-doc-stat__value">{{docsrejected}}</span>
                            <span class="jb-doc-stat__label">{{#str}}rejected, local_jobboard{{/str}}</span>
                        </div>
                    </div>
                    {{#docsprogress}}
                    <div class="jb-progress">
                        <div class="jb-progress__bar jb-progress__bar--success" style="width: {{docsprogress}}%;"></div>
                        <div class="jb-progress__bar jb-progress__bar--danger" style="width: {{docsrejectedpercent}}%;"></div>
                    </div>
                    {{/docsprogress}}
                </div>
            </div>
            {{/hasdocuments}}

            {{! Application Details Card }}
            <div class="jb-card">
                <div class="jb-card__header">
                    <i class="fa fa-circle-info"></i>
                    {{#str}}applicationdetails, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}applicationid, local_jobboard{{/str}}</span>
                        <code>#{{application.id}}</code>
                    </div>
                    {{#application.digitalsignature}}
                    <div class="jb-info-row">
                        <span class="jb-info-label">{{#str}}digitalsignature, local_jobboard{{/str}}</span>
                        <code class="jb-code--small">{{application.digitalsignature}}</code>
                    </div>
                    {{/application.digitalsignature}}
                    {{#application.consenttimestamp}}
                    <div class="jb-info-row jb-info-row--last">
                        <span class="jb-info-label">{{#str}}consentgiven, local_jobboard{{/str}}</span>
                        <span class="jb-badge jb-badge--success">
                            <i class="fa fa-check"></i> {{application.consenttimestamp}}
                        </span>
                    </div>
                    {{/application.consenttimestamp}}
                </div>
            </div>

            {{! Workflow Actions Card (for managers) }}
            {{#canmanage}}
            {{#hasworkflowactions}}
            <div class="jb-card jb-card--cta-warning">
                <div class="jb-card__header jb-card__header--warning">
                    <i class="fa fa-list-check"></i>
                    {{#str}}workflowactions, local_jobboard{{/str}}
                </div>
                <div class="jb-card__body">
                    <form method="post" action="{{workflowurl}}" class="jb-form">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="view" value="application">
                        <input type="hidden" name="id" value="{{application.id}}">
                        <input type="hidden" name="action" value="changestatus">
                        <div class="jb-form-group">
                            <label class="jb-form-label">{{#str}}changestatus, local_jobboard{{/str}}</label>
                            <select name="newstatus" class="jb-select" required>
                                <option value="">{{#str}}selectstatus, local_jobboard{{/str}}</option>
                                {{#workflowactions}}
                                <option value="{{value}}">{{label}}</option>
                                {{/workflowactions}}
                            </select>
                        </div>
                        <div class="jb-form-group">
                            <label class="jb-form-label">{{#str}}optionalnotes, local_jobboard{{/str}}</label>
                            <textarea name="notes" class="jb-textarea" rows="2"></textarea>
                        </div>
                        <button type="submit" class="jb-btn jb-btn--warning jb-btn--block">
                            <i class="fa fa-save"></i> {{#str}}updatestatus, local_jobboard{{/str}}
                        </button>
                    </form>
                </div>
            </div>
            {{/hasworkflowactions}}
            {{/canmanage}}

            {{! Review Documents Card (for reviewers) }}
            {{#canreview}}
            <div class="jb-card jb-card--cta">
                <div class="jb-cta-card">
                    <i class="fa fa-check-double jb-cta-card__icon jb-cta-card__icon--success"></i>
                    <h4 class="jb-cta-card__title">{{#str}}reviewdocuments, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}reviewdocuments_desc, local_jobboard{{/str}}</p>
                    <a href="{{reviewurl}}" class="jb-btn jb-btn--success jb-btn--block">
                        <i class="fa fa-clipboard-check"></i> {{#str}}startreview, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
            {{/canreview}}

            {{! Continue Draft Card }}
            {{#isdraft}}
            <div class="jb-card jb-card--cta">
                <div class="jb-cta-card">
                    <i class="fa fa-edit jb-cta-card__icon jb-cta-card__icon--success"></i>
                    <h4 class="jb-cta-card__title">{{#str}}completeapplication, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}draft_action_desc, local_jobboard{{/str}}</p>
                    <a href="{{continueurl}}" class="jb-btn jb-btn--success jb-btn--block">
                        <i class="fa fa-arrow-right"></i> {{#str}}completeandsubmit, local_jobboard{{/str}}
                    </a>
                </div>
            </div>
            {{/isdraft}}

            {{! Withdraw Card }}
            {{#canwithdraw}}
            <div class="jb-card jb-card--closed">
                <div class="jb-cta-card">
                    <i class="fa fa-xmark jb-cta-card__icon jb-cta-card__icon--muted"></i>
                    <h4 class="jb-cta-card__title">{{#str}}withdrawapplication, local_jobboard{{/str}}</h4>
                    <p class="jb-cta-card__text">{{#str}}withdrawwarning, local_jobboard{{/str}}</p>
                    <button type="button" class="jb-btn jb-btn--danger-outline jb-btn--block"
                            data-action="withdraw"
                            data-url="{{withdrawurl}}"
                            data-confirm="{{#str}}confirmwithdraw, local_jobboard{{/str}}">
                        <i class="fa fa-xmark"></i> {{#str}}withdraw, local_jobboard{{/str}}
                    </button>
                </div>
            </div>
            {{/canwithdraw}}
        </aside>
    </div>

    {{! Footer Navigation }}
    <div class="jb-detail-footer">
        <a href="{{backurl}}" class="jb-btn jb-btn--outline">
            <i class="fa fa-arrow-left"></i> {{backlabel}}
        </a>
        <a href="{{dashboardurl}}" class="jb-link">
            {{#str}}backtodashboard, local_jobboard{{/str}} <i class="fa fa-arrow-right"></i>
        </a>
    </div>
</div>

<style>
/* ================================================================
   APPLICATION DETAIL PAGE - CLEAN MINIMAL DESIGN
   Following jb-* pattern
   ================================================================ */
.jb-application-detail {
    max-width: 1200px;
    padding: 1rem;
}

/* Header */
.jb-detail-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e5e5;
}

.jb-detail-header__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.jb-detail-header__back {
    color: var(--iser-verde, #1b9e88);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-detail-header__back:hover {
    color: var(--iser-verde-dark, #157a6a);
}

.jb-detail-header__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
}

.jb-detail-header__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--iser-negro, #1a1a1a);
}

.jb-detail-header__subtitle {
    font-size: 0.875rem;
    color: var(--iser-gris-medio, #666);
    margin: 0.25rem 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.375rem;
}

/* Content Layout */
.jb-detail-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: start;
}

.jb-detail-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.jb-detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
}

/* Alerts */
.jb-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
}

.jb-alert > i {
    font-size: 1.25rem;
    margin-top: 0.125rem;
}

.jb-alert__content {
    flex: 1;
}

.jb-alert__content strong {
    display: block;
}

.jb-alert__content span {
    font-size: 0.875rem;
    opacity: 0.9;
}

.jb-alert--action {
    flex-wrap: wrap;
}

.jb-alert--success { background: rgba(40, 167, 69, 0.1); border: 1px solid rgba(40, 167, 69, 0.2); color: #1e7e34; }
.jb-alert--warning { background: rgba(255, 193, 7, 0.15); border: 1px solid rgba(255, 193, 7, 0.3); color: #856404; }
.jb-alert--danger { background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.2); color: #c41e3a; }
.jb-alert--info { background: rgba(13, 110, 253, 0.1); border: 1px solid rgba(13, 110, 253, 0.2); color: #0d6efd; }
.jb-alert--secondary { background: #f9fafb; border: 1px solid #e5e5e5; color: #6c757d; }
.jb-alert--primary { background: rgba(27, 158, 136, 0.1); border: 1px solid rgba(27, 158, 136, 0.2); color: var(--iser-verde-dark, #157a6a); }

/* Cards */
.jb-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
}

.jb-card--cta { border-color: var(--iser-verde, #1b9e88); }
.jb-card--cta-warning { border-color: var(--iser-amarillo, #ffc107); }
.jb-card--closed { border-color: var(--iser-gris-medio, #666); background: #f9fafb; }

.jb-card__header {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--iser-gris-oscuro, #333);
    background: #f9fafb;
    border-bottom: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-card__header i { color: var(--iser-verde, #1b9e88); }
.jb-card__header .jb-badge { margin-left: auto; }

.jb-card__header--accent {
    background: rgba(27, 158, 136, 0.1);
    border-bottom: 2px solid var(--iser-verde, #1b9e88);
}

.jb-card__header--warning {
    background: rgba(255, 193, 7, 0.15);
    color: #856404;
}

.jb-card__header--warning i { color: #856404; }

.jb-card__body { padding: 1rem; }

.jb-card__body--content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--iser-gris-oscuro, #333);
}

.jb-card__body--quote {
    border-left: 3px solid var(--iser-verde, #1b9e88);
    padding-left: 1rem;
    margin-left: 0.5rem;
}

.jb-card__footer {
    padding: 0.75rem 1rem;
    background: #f9fafb;
    border-top: 1px solid #e5e5e5;
}

/* Applicant Info */
.jb-applicant-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
}

.jb-applicant-info__avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--iser-verde, #1b9e88);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.125rem;
}

.jb-applicant-info__details h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
}

/* Info Grid */
.jb-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
}

.jb-info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.jb-info-item__label {
    font-size: 0.75rem;
    color: var(--iser-gris-medio, #666);
}

.jb-info-item__label i {
    margin-right: 0.375rem;
}

.jb-info-item__value {
    font-weight: 500;
}

/* Info Rows */
.jb-info-row {
    display: flex;
    justify-content: space-between;
