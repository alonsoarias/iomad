{{!
    @template local_jobboard/pages/applications/detail

    Application detail page - Clean and professional design.
    Follows the same pattern as the apply page.

    Context variables:
    * application - Application data {id, status, statuslabel, statuscolor, statusicon, statusnotes, dateapplied, coverletter, digitalsignature, consenttimestamp}
    * vacancy - Vacancy data {id, code, title, location, viewurl}
    * applicant - Applicant info for reviewers {fullname, email, idnumber, phone, initials}
    * documents - Array of document data
    * hasdocuments - Boolean if has documents
    * documentcount - Number of documents
    * docsapproved - Number of approved documents
    * docsrejected - Number of rejected documents
    * docspending - Number of pending documents
    * history - Status history timeline data
    * hashistory - Boolean if has history
    * workflowactions - Available workflow actions (for managers)
    * hasworkflowactions - Boolean if has workflow actions
    * canmanage - Boolean if can manage workflow
    * canreview - Boolean if can review documents
    * isowner - Boolean if viewing own application
    * canwithdraw - Boolean if can withdraw
    * hasexemption - Boolean if has exemption
    * exemptiontype - Exemption type label
    * exemptionref - Exemption reference
    * backurl - URL to go back
    * backlabel - Label for back button
    * dashboardurl - URL to dashboard
    * reviewurl - URL to review documents
    * withdrawurl - URL to withdraw
    * workflowurl - URL for workflow actions
    * sesskey - Session key

    Example context (json):
    {
        "application": {"id": 1, "status": "submitted", "statuslabel": "Submitted"},
        "vacancy": {"code": "VAC-001", "title": "Developer"}
    }
}}
<div class="jb-application-detail" id="jobboard-application-detail" data-application-id="{{application.id}}">
    <div class="container-fluid px-0">
        <div class="row g-4">
            {{! Main Content }}
            <div class="col-lg-8">
                {{! Page Header }}
                <div class="jb-page-header mb-4">
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="{{backurl}}">{{backlabel}}</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{#str}}application, local_jobboard{{/str}} #{{application.id}}</li>
                        </ol>
                    </nav>
                    <h1 class="h3 mb-1">{{vacancy.title}}</h1>
                    <p class="text-muted mb-0">
                        <code class="me-2">{{vacancy.code}}</code>
                        <span class="badge bg-{{application.statuscolor}}">{{application.statuslabel}}</span>
                    </p>
                </div>

                {{! Status Alert }}
                <div class="alert alert-{{application.statuscolor}} d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-{{application.statusicon}} fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}currentstatus, local_jobboard{{/str}}: {{application.statuslabel}}</strong>
                        {{#application.statusnotes}}
                        <span class="d-block small">{{application.statusnotes}}</span>
                        {{/application.statusnotes}}
                    </div>
                </div>

                {{! Exemption Notice }}
                {{#hasexemption}}
                <div class="alert alert-info jb-alert-info d-flex align-items-center mb-4" role="alert">
                    <i class="fa fa-id-badge fa-lg me-3"></i>
                    <div>
                        <strong>{{#str}}exemptionapplied, local_jobboard{{/str}}</strong>
                        <span class="d-block small">{{exemptiontype}}{{#exemptionref}} ({{exemptionref}}){{/exemptionref}}</span>
                    </div>
                </div>
                {{/hasexemption}}

                {{! Applicant Info Card (for reviewers) }}
                {{#applicant}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-user text-primary me-2"></i>
                            {{#str}}applicantinfo, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <span class="fs-5 fw-bold">{{initials}}</span>
                            </div>
                            <div>
                                <h6 class="mb-0">{{fullname}}</h6>
                                <a href="mailto:{{email}}" class="text-muted small">{{email}}</a>
                            </div>
                        </div>
                        <dl class="row mb-0 small">
                            {{#idnumber}}
                            <dt class="col-4 text-muted">{{#str}}idnumber{{/str}}</dt>
                            <dd class="col-8">{{idnumber}}</dd>
                            {{/idnumber}}
                            {{#phone}}
                            <dt class="col-4 text-muted">{{#str}}phone{{/str}}</dt>
                            <dd class="col-8">{{phone}}</dd>
                            {{/phone}}
                        </dl>
                    </div>
                </div>
                {{/applicant}}

                {{! Cover Letter Card }}
                {{#application.coverletter}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-envelope-open-text text-primary me-2"></i>
                            {{#str}}coverletter, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="border-start border-primary border-3 ps-3">
                            {{{application.coverletter}}}
                        </div>
                    </div>
                </div>
                {{/application.coverletter}}

                {{! Documents Card }}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fa fa-file-lines text-primary me-2"></i>
                                {{#str}}uploadeddocuments, local_jobboard{{/str}}
                            </h5>
                            <span class="badge bg-secondary">{{documentcount}}</span>
                        </div>
                    </div>

                    {{#hasdocuments}}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>{{#str}}documenttype, local_jobboard{{/str}}</th>
                                    <th class="d-none d-md-table-cell">{{#str}}filename, local_jobboard{{/str}}</th>
                                    <th class="text-center">{{#str}}status, local_jobboard{{/str}}</th>
                                    <th class="text-end">{{#str}}actions{{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#documents}}
                                <tr>
                                    <td>
                                        <i class="fa fa-file text-{{statuscolor}} me-2"></i>
                                        {{typename}}
                                    </td>
                                    <td class="text-muted d-none d-md-table-cell">
                                        <span class="text-truncate d-inline-block" style="max-width: 150px;" title="{{filename}}">
                                            {{filename}}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-{{statuscolor}}">
                                            <i class="fa fa-{{statusicon}} me-1"></i>
                                            {{statuslabel}}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            {{#downloadurl}}
                                            <a href="{{downloadurl}}" class="btn btn-outline-primary" target="_blank" title="{{#str}}download{{/str}}">
                                                <i class="fa fa-download"></i>
                                            </a>
                                            {{/downloadurl}}
                                            {{#canreupload}}
                                            <a href="{{reuploadurl}}" class="btn btn-outline-warning" title="{{#str}}reupload, local_jobboard{{/str}}">
                                                <i class="fa fa-upload"></i>
                                            </a>
                                            {{/canreupload}}
                                        </div>
                                    </td>
                                </tr>
                                {{#rejectreason}}
                                <tr class="table-danger">
                                    <td colspan="4" class="small py-2">
                                        <i class="fa fa-exclamation-circle text-danger me-2"></i>
                                        <strong>{{#str}}rejectreason, local_jobboard{{/str}}:</strong> {{rejectreason}}
                                    </td>
                                </tr>
                                {{/rejectreason}}
                                {{/documents}}
                            </tbody>
                        </table>
                    </div>
                    {{/hasdocuments}}

                    {{^hasdocuments}}
                    <div class="card-body text-center py-4">
                        <i class="fa fa-file-circle-question fa-3x text-muted mb-3"></i>
                        <p class="text-muted mb-0">{{#str}}nodocuments, local_jobboard{{/str}}</p>
                    </div>
                    {{/hasdocuments}}
                </div>

                {{! Status History Card }}
                {{#hashistory}}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="fa fa-clock-rotate-left text-secondary me-2"></i>
                            {{#str}}statushistory, local_jobboard{{/str}}
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="jb-timeline">
                            {{#history}}
                            <div class="d-flex mb-3 {{^islast}}pb-3 border-bottom{{/islast}}">
                                <div class="flex-shrink-0 me-3">
                                    <span class="badge bg-{{statuscolor}} rounded-circle p-2">
                                        <i class="fa fa-circle" style="font-size: 8px;"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="badge bg-{{statuscolor}}">{{statuslabel}}</span>
                                        <small class="text-muted">{{timeformatted}}</small>
                                    </div>
                                    {{#notes}}
                                    <p class="small text-muted mb-1 mt-1">{{notes}}</p>
                                    {{/notes}}
                                    {{#changedbyname}}
                                    <small class="text-muted">
                                        <i class="fa fa-user me-1"></i>{{changedbyname}}
                                    </small>
                                    {{/changedbyname}}
                                </div>
                            </div>
                            {{/history}}
                        </div>
                    </div>
                </div>
                {{/hashistory}}
            </div>

            {{! Sidebar }}
            <div class="col-lg-4">
                <div class="jb-sidebar sticky-top" style="top: 80px;">
                    {{! Vacancy Summary Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-briefcase text-primary me-2"></i>
                                {{#str}}vacancysummary, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0 small">
                                <dt class="col-5 text-muted">{{#str}}code, local_jobboard{{/str}}</dt>
                                <dd class="col-7"><code>{{vacancy.code}}</code></dd>

                                <dt class="col-5 text-muted">{{#str}}title, local_jobboard{{/str}}</dt>
                                <dd class="col-7">{{vacancy.title}}</dd>

                                {{#vacancy.location}}
                                <dt class="col-5 text-muted">{{#str}}location, local_jobboard{{/str}}</dt>
                                <dd class="col-7">{{vacancy.location}}</dd>
                                {{/vacancy.location}}

                                <dt class="col-5 text-muted">{{#str}}dateapplied, local_jobboard{{/str}}</dt>
                                <dd class="col-7">{{application.dateapplied}}</dd>
                            </dl>
                        </div>
                        <div class="card-footer bg-light">
                            <a href="{{vacancy.viewurl}}" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fa fa-eye me-1"></i>
                                {{#str}}viewvacancydetails, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>

                    {{! Documents Summary Card }}
                    {{#hasdocuments}}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="fa fa-list-check text-info me-2"></i>
                                    {{#str}}documentstatus, local_jobboard{{/str}}
                                </h6>
                                <span class="badge bg-secondary">{{documentcount}}</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="h4 text-success mb-0">{{docsapproved}}</div>
                                    <small class="text-muted">{{#str}}approved, local_jobboard{{/str}}</small>
                                </div>
                                <div class="col-4">
                                    <div class="h4 text-warning mb-0">{{docspending}}</div>
                                    <small class="text-muted">{{#str}}pending, local_jobboard{{/str}}</small>
                                </div>
                                <div class="col-4">
                                    <div class="h4 text-danger mb-0">{{docsrejected}}</div>
                                    <small class="text-muted">{{#str}}rejected, local_jobboard{{/str}}</small>
                                </div>
                            </div>
                            {{#docsprogress}}
                            <div class="progress mt-3" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: {{docsprogress}}%"></div>
                                <div class="progress-bar bg-danger" style="width: {{docsrejectedpercent}}%"></div>
                            </div>
                            {{/docsprogress}}
                        </div>
                    </div>
                    {{/hasdocuments}}

                    {{! Application Details Card }}
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-circle-info text-primary me-2"></i>
                                {{#str}}applicationdetails, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">{{#str}}applicationid, local_jobboard{{/str}}</span>
                                <code>#{{application.id}}</code>
                            </li>
                            {{#application.digitalsignature}}
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">{{#str}}digitalsignature, local_jobboard{{/str}}</span>
                                <code class="small">{{application.digitalsignature}}</code>
                            </li>
                            {{/application.digitalsignature}}
                            {{#application.consenttimestamp}}
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">{{#str}}consentgiven, local_jobboard{{/str}}</span>
                                <span class="badge bg-success">
                                    <i class="fa fa-check me-1"></i>{{application.consenttimestamp}}
                                </span>
                            </li>
                            {{/application.consenttimestamp}}
                        </ul>
                    </div>

                    {{! Workflow Actions Card (for managers) }}
                    {{#canmanage}}
                    {{#hasworkflowactions}}
                    <div class="card shadow-sm mb-4 border-warning">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-list-check text-warning me-2"></i>
                                {{#str}}workflowactions, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <form method="post" action="{{workflowurl}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="view" value="application">
                                <input type="hidden" name="id" value="{{application.id}}">
                                <input type="hidden" name="action" value="changestatus">

                                <div class="mb-3">
                                    <label for="newstatus" class="form-label small fw-bold">
                                        {{#str}}changestatus, local_jobboard{{/str}}
                                    </label>
                                    <select name="newstatus" id="newstatus" class="form-select form-select-sm" required>
                                        <option value="">{{#str}}selectstatus, local_jobboard{{/str}}</option>
                                        {{#workflowactions}}
                                        <option value="{{value}}">{{label}}</option>
                                        {{/workflowactions}}
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="notes" class="form-label small">
                                        {{#str}}optionalnotes, local_jobboard{{/str}}
                                    </label>
                                    <textarea name="notes" id="notes" class="form-control form-control-sm" rows="2"></textarea>
                                </div>

                                <button type="submit" class="btn btn-warning jb-btn-warning btn-sm w-100">
                                    <i class="fa fa-save me-1"></i>
                                    {{#str}}updatestatus, local_jobboard{{/str}}
                                </button>
                            </form>
                        </div>
                    </div>
                    {{/hasworkflowactions}}
                    {{/canmanage}}

                    {{! Review Documents Card (for reviewers) }}
                    {{#canreview}}
                    <div class="card shadow-sm mb-4 border-success">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-check-double text-success me-2"></i>
                                {{#str}}reviewdocuments, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <p class="small text-muted mb-3">{{#str}}reviewdocuments_desc, local_jobboard{{/str}}</p>
                            <a href="{{reviewurl}}" class="btn btn-success jb-btn-success btn-sm w-100">
                                <i class="fa fa-clipboard-check me-1"></i>
                                {{#str}}startreview, local_jobboard{{/str}}
                            </a>
                        </div>
                    </div>
                    {{/canreview}}

                    {{! Withdraw Card (for owner) }}
                    {{#canwithdraw}}
                    <div class="card shadow-sm mb-4 border-danger">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">
                                <i class="fa fa-xmark text-danger me-2"></i>
                                {{#str}}withdrawapplication, local_jobboard{{/str}}
                            </h6>
                        </div>
                        <div class="card-body">
                            <p class="small text-muted mb-3">{{#str}}withdrawwarning, local_jobboard{{/str}}</p>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm w-100"
                                    data-action="withdraw"
                                    data-url="{{withdrawurl}}"
                                    data-confirm="{{#str}}confirmwithdraw, local_jobboard{{/str}}">
                                <i class="fa fa-xmark me-1"></i>
                                {{#str}}withdraw, local_jobboard{{/str}}
                            </button>
                        </div>
                    </div>
                    {{/canwithdraw}}

                    {{! Back Navigation Card }}
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="fa fa-arrow-left me-1"></i>
                                {{backlabel}}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top">
                    <a href="{{backurl}}" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{backlabel}}
                    </a>
                    <a href="{{dashboardurl}}" class="btn btn-link text-muted">
                        {{#str}}backtodashboard, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
