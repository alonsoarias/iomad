{{!
    @template local_jobboard/pages/applications

    My applications list page template with enhanced UX.
    Includes accessibility features, animations, and loading states.

    Context variables:
    * hasexemption - Boolean if user has active exemption
    * exemption - Exemption data {type, typeformatted, documentref}
    * stats - Array of stat cards
    * pendingdocscount - Number of pending documents
    * filterform - Filter form data
    * showinginfo - Showing X-Y of Z text
    * hasapplications - Boolean
    * applications - Array of application data
    * pagination - Pagination HTML
    * browseurl - URL to browse vacancies
    * loading - Show skeleton loading state

    Example context (json):
    {
        "hasapplications": true,
        "applications": [{"id": 1, "vacancytitle": "Developer"}]
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="local-jobboard-applications" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-page-header mb-4">
        <div class="jb-skeleton-text" style="width: 200px; height: 1em;"></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="jb-skeleton-title" style="width: 40%;"></div>
            <div class="jb-skeleton-text" style="width: 150px; height: 40px;"></div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            {{> local_jobboard/components/stat_card }}
        </div>
    </div>
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-title" style="width: 80%;"></div>
                    <div class="jb-skeleton-text" style="width: 100%;"></div>
                    <div class="jb-skeleton-text" style="width: 70%;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
                <div class="card-body">
                    <div class="jb-skeleton-title" style="width: 80%;"></div>
                    <div class="jb-skeleton-text" style="width: 100%;"></div>
                    <div class="jb-skeleton-text" style="width: 70%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="local-jobboard-applications" data-region="jobboard-applications">
    {{! Skip Link - Hidden until focused (Bootstrap 5 native) }}
    <a href="#applications-main-content" class="visually-hidden-focusable">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header - Breadcrumbs handled by Moodle via $PAGE->navbar }}
    <header class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="h4 mb-0">
            <i class="fa fa-folder-open text-primary me-2" aria-hidden="true"></i>
            {{#str}}myapplications, local_jobboard{{/str}}
        </h1>
        <a href="{{browseurl}}" class="btn btn-primary">
            <i class="fa fa-magnifying-glass me-2" aria-hidden="true"></i>
            {{#str}}browsevacancies, local_jobboard{{/str}}
        </a>
    </header>

    {{! Exemption Notice }}
    {{#hasexemption}}
    <div class="alert alert-success d-flex align-items-center mb-4 jb-fade-in-up" role="alert" aria-live="polite">
        <div class="flex-shrink-0 me-3">
            <i class="fa fa-certificate fa-2x text-success" aria-hidden="true"></i>
        </div>
        <div class="flex-grow-1">
            <strong class="d-block mb-1">{{#str}}exemptionactive, local_jobboard{{/str}}</strong>
            <span class="text-muted">
                {{exemption.typeformatted}}
                {{#exemption.documentref}}
                <span class="badge bg-light text-dark ms-2">{{exemption.documentref}}</span>
                {{/exemption.documentref}}
            </span>
        </div>
        <div class="flex-shrink-0">
            <span class="badge bg-success rounded-pill">
                <i class="fa fa-check me-1" aria-hidden="true"></i>
                {{#str}}active, local_jobboard{{/str}}
            </span>
        </div>
    </div>
    {{/hasexemption}}

    {{! Statistics Row }}
    {{#stats.0}}
    <section class="row mb-4" role="region" aria-label="{{#str}}applicantstatistics, local_jobboard{{/str}}">
        {{#stats}}
        <div class="col-lg-3 col-md-6 mb-3 jb-fade-in-up" style="animation-delay: {{animdelay}}s;">
            {{> local_jobboard/components/stat_card }}
        </div>
        {{/stats}}
    </section>
    {{/stats.0}}

    {{! Pending Actions Alert }}
    {{#pendingdocscount}}
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4 jb-fade-in-up" role="alert" aria-live="polite">
        <div class="d-flex align-items-center">
            <i class="fa fa-triangle-exclamation fa-lg me-3" aria-hidden="true"></i>
            <div>
                <strong>{{#str}}actionrequired, local_jobboard{{/str}}</strong>
                <span class="d-block jb-d-sm-inline jb-ml-sm-2">
                    {{#str}}pending_docs_alert, local_jobboard, {{pendingdocscount}}{{/str}}
                </span>
            </div>
        </div>
        <span class="badge bg-warning text-dark rounded-pill fs-5">{{pendingdocscount}}</span>
    </div>
    {{/pendingdocscount}}

    {{! Filter Form }}
    {{#filterform}}
    <div class="card mb-4 jb-fade-in-up" style="animation-delay: 0.1s;">
        <div class="card-body">
            <form method="get" action="{{filterform.action}}" class="jb-filter-form" role="search" aria-label="{{#str}}filterapplications, local_jobboard{{/str}}">
                {{#filterform.hiddenfields}}
                <input type="hidden" name="{{name}}" value="{{value}}">
                {{/filterform.hiddenfields}}
                <div class="row align-items-end">
                    {{#filterform.fields}}
                    <div class="{{col}} mb-2">
                        {{#isselect}}
                        <label for="filter-{{name}}" class="form-label small text-muted">{{label}}</label>
                        <select name="{{name}}" id="filter-{{name}}" class="form-select">
                            {{#options}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                        {{/isselect}}
                    </div>
                    {{/filterform.fields}}
                    <div class="jb-col-auto mb-2">
                        <button type="submit" class="btn btn-secondary">
                            <i class="fa fa-filter me-1" aria-hidden="true"></i>
                            {{#str}}filter, local_jobboard{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {{/filterform}}

    {{! Results Info }}
    {{#showinginfo}}
    <p class="text-muted small mb-3 jb-fade-in" role="status" aria-live="polite">
        <i class="fa fa-circle-info me-1" aria-hidden="true"></i>
        {{showinginfo}}
    </p>
    {{/showinginfo}}

    {{! Applications List }}
    <div id="applications-main-content">
        {{#hasapplications}}
        <section class="row" aria-label="{{#str}}myapplications, local_jobboard{{/str}}">
            {{#applications}}
            <div class="col-lg-6 mb-4">
                <article class="card h-100 shadow-sm jb-application-card jb-hover-lift jb-fade-in-up"
                         data-application-id="{{id}}"
                         aria-labelledby="app-title-{{id}}"
                         style="animation-delay: {{animdelay}}s;">
                    {{! Card Header with Status }}
                    <div class="card-header jb-bg-{{statuscolor}} text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                {{#vacancycode}}
                                <span class="badge bg-light text-dark">{{vacancycode}}</span>
                                {{/vacancycode}}
                                <span class="fw-bold">{{statuslabel}}</span>
                            </div>
                            <small class="opacity-75">
                                <i class="fa fa-calendar-days me-1" aria-hidden="true"></i>
                                {{dateapplied}}
                            </small>
                        </div>
                    </div>

                    {{! Card Body }}
                    <div class="card-body">
                        <h2 class="card-title fs-5 mb-2" id="app-title-{{id}}">
                            <a href="{{vacancyurl}}" class="text-dark text-decoration-none jb-hover-primary">
                                {{vacancytitle}}
                            </a>
                        </h2>

                        {{#convocatorianame}}
                        <p class="small text-muted mb-3">
                            <i class="fa fa-folder-open me-1" aria-hidden="true"></i>
                            {{convocatorianame}}
                        </p>
                        {{/convocatorianame}}

                        {{! Progress Indicator }}
                        {{#progresssteps}}
                        <div class="mb-3" role="group" aria-label="{{#str}}applicationprogress, local_jobboard{{/str}}">
                            <div class="d-flex justify-content-between mb-2">
                                <small class="text-muted">{{#str}}progress, local_jobboard{{/str}}</small>
                                <small class="fw-medium">{{progresspercent}}%</small>
                            </div>
                            <div class="progress" style="height: 6px;" role="progressbar" aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar jb-bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                            </div>
                        </div>
                        {{/progresssteps}}

                        {{! Document Status Summary }}
                        <div class="d-flex jb-justify-content-around text-center py-2 bg-light rounded" role="group" aria-label="{{#str}}documentstatus, local_jobboard{{/str}}">
                            <div class="px-2">
                                <span class="badge bg-success fs-6">{{docsapproved}}</span>
                                <div class="text-muted small">{{#str}}approved, local_jobboard{{/str}}</div>
                            </div>
                            <div class="px-2 jb-border-left jb-border-right">
                                <span class="badge bg-warning text-dark fs-6">{{docspending}}</span>
                                <div class="text-muted small">{{#str}}pending, local_jobboard{{/str}}</div>
                            </div>
                            <div class="px-2">
                                <span class="badge bg-danger fs-6">{{docsrejected}}</span>
                                <div class="text-muted small">{{#str}}rejected, local_jobboard{{/str}}</div>
                            </div>
                        </div>

                        {{! Status Notes }}
                        {{#statusnotes}}
                        <div class="mt-3 p-2 bg-light rounded small">
                            <i class="fa fa-comment text-muted me-1" aria-hidden="true"></i>
                            <em class="text-muted">{{statusnotes}}</em>
                        </div>
                        {{/statusnotes}}

                        {{! Pending Docs Alert }}
                        {{#haspendingdocs}}
                        <div class="alert alert-warning mt-3 mb-0 py-2 d-flex align-items-center" role="alert">
                            <i class="fa fa-circle-exclamation me-2" aria-hidden="true"></i>
                            <span class="small">{{#str}}uploaddocsreminder, local_jobboard{{/str}}</span>
                        </div>
                        {{/haspendingdocs}}
                    </div>

                    {{! Card Footer }}
                    <footer class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fa fa-file-lines me-1" aria-hidden="true"></i>
                                {{documentcount}} {{#str}}documents, local_jobboard{{/str}}
                            </small>
                            <div class="btn-group btn-group-sm" role="group" aria-label="{{#str}}applicationactions, local_jobboard{{/str}}">
                                {{#canwithdraw}}
                                <button type="button"
                                        class="btn btn-outline-danger"
                                        data-action="withdraw"
                                        data-url="{{withdrawurl}}"
                                        data-confirm="{{#str}}confirmwithdraw, local_jobboard{{/str}}"
                                        aria-label="{{#str}}withdraw, local_jobboard{{/str}}">
                                    <i class="fa fa-xmark" aria-hidden="true"></i>
                                </button>
                                {{/canwithdraw}}
                                <a href="{{viewurl}}" class="btn btn-primary">
                                    {{#str}}viewdetails, local_jobboard{{/str}}
                                    <i class="fa fa-arrow-right ms-1" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </footer>
                </article>
            </div>
            {{/applications}}
        </section>
        {{/hasapplications}}

        {{! Empty State }}
        {{^hasapplications}}
        {{> local_jobboard/components/empty_state }}
        {{/hasapplications}}
    </div>

    {{! Pagination }}
    {{#pagination}}
    <nav class="mt-4 jb-fade-in" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
        {{{pagination}}}
    </nav>
    {{/pagination}}
</div>
{{/loading}}
