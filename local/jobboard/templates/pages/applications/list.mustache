{{!
    @template local_jobboard/pages/applications/list

    My applications list page - Clean and professional design.
    Follows the same pattern as the apply page.

    Context variables:
    * hasexemption - Boolean if user has active exemption
    * exemption - Exemption data {type, typeformatted, documentref}
    * stats - Array of stat cards
    * pendingdocscount - Number of pending documents
    * filterform - Filter form data
    * showinginfo - Showing X-Y of Z text
    * hasapplications - Boolean
    * applications - Array of application data
    * pagination - Pagination HTML
    * browseurl - URL to browse vacancies
    * dashboardurl - URL to dashboard

    Example context (json):
    {
        "hasapplications": true,
        "applications": [{"id": 1, "vacancytitle": "Developer"}]
    }
}}
<div class="jb-applications-list" id="jobboard-applications-list">
    <div class="container-fluid px-0">
        {{! Page Header }}
        <div class="jb-page-header mb-4">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{dashboardurl}}">{{#str}}dashboard, local_jobboard{{/str}}</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">{{#str}}myapplications, local_jobboard{{/str}}</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h1 class="h3 mb-0">{{#str}}myapplications, local_jobboard{{/str}}</h1>
                <a href="{{browseurl}}" class="btn btn-primary jb-btn-primary jb-hover-lift">
                    <i class="fa fa-search me-1"></i>
                    {{#str}}browsevacancies, local_jobboard{{/str}}
                </a>
            </div>
        </div>

        {{! Exemption Notice }}
        {{#hasexemption}}
        <div class="alert jb-alert-info d-flex align-items-center mb-4" role="alert">
            <i class="fa fa-id-badge fa-lg me-3"></i>
            <div>
                <strong>{{#str}}exemptionactive, local_jobboard{{/str}}</strong>
                <span class="d-block small">
                    {{exemption.typeformatted}}
                    {{#exemption.documentref}} ({{exemption.documentref}}){{/exemption.documentref}}
                </span>
            </div>
        </div>
        {{/hasexemption}}

        {{! Pending Documents Alert }}
        {{#pendingdocscount}}
        <div class="alert jb-alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="fa fa-exclamation-triangle fa-lg me-3"></i>
            <div>
                <strong>{{#str}}actionrequired, local_jobboard{{/str}}</strong>
                <span class="d-block small">{{#str}}pending_docs_alert, local_jobboard, {{pendingdocscount}}{{/str}}</span>
            </div>
        </div>
        {{/pendingdocscount}}

        {{! Statistics Cards }}
        {{#stats.0}}
        <div class="row mb-4">
            {{#stats}}
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm h-100 jb-stat-card jb-card-accent-{{color}}">
                    <div class="card-body text-center">
                        <div class="h2 text-{{color}} mb-1 jb-stat-value">{{value}}</div>
                        <small class="text-muted jb-stat-label">{{label}}</small>
                    </div>
                </div>
            </div>
            {{/stats}}
        </div>
        {{/stats.0}}

        {{! Filter Form }}
        {{#filterform}}
        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">
                <form method="get" action="{{filterform.action}}">
                    {{#filterform.hiddenfields}}
                    <input type="hidden" name="{{name}}" value="{{value}}">
                    {{/filterform.hiddenfields}}
                    <div class="row align-items-end">
                        {{#filterform.fields}}
                        <div class="col-md-4 mb-2 mb-md-0">
                            {{#isselect}}
                            <label for="filter-{{name}}" class="form-label small text-muted mb-1">{{label}}</label>
                            <select name="{{name}}" id="filter-{{name}}" class="form-select form-select-sm">
                                {{#options}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/options}}
                            </select>
                            {{/isselect}}
                        </div>
                        {{/filterform.fields}}
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm jb-btn-primary">
                                <i class="fa fa-filter me-1"></i>
                                {{#str}}filter, local_jobboard{{/str}}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        {{/filterform}}

        {{! Results Info }}
        {{#showinginfo}}
        <p class="text-muted small mb-3">
            <i class="fa fa-info-circle me-1"></i>
            {{showinginfo}}
        </p>
        {{/showinginfo}}

        {{! Applications List }}
        {{#hasapplications}}
        <div class="row">
            {{#applications}}
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    {{! Card Header with Status }}
                    <div class="card-header bg-{{statuscolor}} text-white py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                {{#vacancycode}}
                                <code class="text-white-50 me-2">{{vacancycode}}</code>
                                {{/vacancycode}}
                                <span class="fw-bold">{{statuslabel}}</span>
                            </div>
                            <small class="opacity-75">{{dateapplied}}</small>
                        </div>
                    </div>

                    {{! Card Body }}
                    <div class="card-body">
                        <h5 class="card-title mb-2">
                            <a href="{{vacancyurl}}" class="text-decoration-none text-dark">
                                {{vacancytitle}}
                            </a>
                        </h5>

                        {{#convocatorianame}}
                        <p class="small text-muted mb-3">
                            <i class="fa fa-folder me-1"></i>
                            {{convocatorianame}}
                        </p>
                        {{/convocatorianame}}

                        {{! Progress Bar }}
                        {{#progresssteps}}
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">{{#str}}progress, local_jobboard{{/str}}</span>
                                <span class="fw-medium">{{progresspercent}}%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-{{progresscolor}}" style="width: {{progresspercent}}%;"></div>
                            </div>
                        </div>
                        {{/progresssteps}}

                        {{! Document Summary }}
                        <div class="row text-center small bg-light rounded py-2 mx-0">
                            <div class="col-4">
                                <div class="fw-bold text-success">{{docsapproved}}</div>
                                <div class="text-muted">{{#str}}approved, local_jobboard{{/str}}</div>
                            </div>
                            <div class="col-4 border-start border-end">
                                <div class="fw-bold text-warning">{{docspending}}</div>
                                <div class="text-muted">{{#str}}pending, local_jobboard{{/str}}</div>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-danger">{{docsrejected}}</div>
                                <div class="text-muted">{{#str}}rejected, local_jobboard{{/str}}</div>
                            </div>
                        </div>

                        {{! Status Notes }}
                        {{#statusnotes}}
                        <div class="mt-3 small text-muted bg-light rounded p-2">
                            <i class="fa fa-comment me-1"></i>
                            <em>{{statusnotes}}</em>
                        </div>
                        {{/statusnotes}}

                        {{! Pending Alert }}
                        {{#haspendingdocs}}
                        <div class="alert alert-warning jb-alert-warning mt-3 mb-0 py-2 small">
                            <i class="fa fa-exclamation-circle me-1"></i>
                            {{#str}}uploaddocsreminder, local_jobboard{{/str}}
                        </div>
                        {{/haspendingdocs}}
                    </div>

                    {{! Card Footer }}
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fa fa-file me-1"></i>
                                {{documentcount}} {{#str}}documents, local_jobboard{{/str}}
                            </small>
                            <div class="btn-group btn-group-sm">
                                {{#canwithdraw}}
                                <button type="button"
                                        class="btn btn-outline-danger jb-btn-outline-danger"
                                        data-action="withdraw"
                                        data-url="{{withdrawurl}}"
                                        data-confirm="{{#str}}confirmwithdraw, local_jobboard{{/str}}"
                                        title="{{#str}}withdraw, local_jobboard{{/str}}">
                                    <i class="fa fa-xmark"></i>
                                </button>
                                {{/canwithdraw}}
                                <a href="{{viewurl}}" class="btn btn-primary jb-btn-primary">
                                    {{#str}}viewdetails, local_jobboard{{/str}}
                                    <i class="fa fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/applications}}
        </div>
        {{/hasapplications}}

        {{! Empty State }}
        {{^hasapplications}}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="jb-empty-state">
                    <i class="fa fa-folder-open jb-empty-state-icon" aria-hidden="true"></i>
                    <h5 class="jb-empty-state-title">{{#str}}noapplications, local_jobboard{{/str}}</h5>
                    <p class="jb-empty-state-description">{{#str}}noapplications_desc, local_jobboard{{/str}}</p>
                    <div class="jb-empty-state-actions">
                        <a href="{{browseurl}}" class="btn btn-primary jb-btn-primary">
                            <i class="fa fa-search me-1"></i>
                            {{#str}}browsevacancies, local_jobboard{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/hasapplications}}

        {{! Pagination }}
        {{#pagination}}
        <nav class="mt-4" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
            {{{pagination}}}
        </nav>
        {{/pagination}}

        {{! Navigation Footer }}
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center py-3 border-top">
                    <a href="{{dashboardurl}}" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-2"></i>
                        {{#str}}backtodashboard, local_jobboard{{/str}}
                    </a>
                    <a href="{{browseurl}}" class="btn btn-link text-muted">
                        {{#str}}browsevacancies, local_jobboard{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{! Styles consolidated in styles.css }}
