{{!
    @template local_jobboard/pages/exemption_revoke

    Exemption revoke confirmation page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * id - int - Exemption ID
    * userfullname - string - User full name
    * useremail - string - User email
    * exemptiontype - string - Exemption type label
    * validfrom - string - Valid from date
    * validuntil - string - Valid until date
    * sesskey - string - Session key
    * cancelurl - string - Cancel URL
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "id": 123,
        "userfullname": "John Doe",
        "sesskey": "abc123"
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-exemptions" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="card">
        <div class="card-header bg-danger">
            <div class="jb-skeleton-text" style="width: 200px; height: 24px;"></div>
        </div>
        <div class="card-body">
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 80px;"></div>
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 100px;"></div>
            <div class="d-flex gap-2">
                <div class="jb-skeleton-text" style="width: 120px; height: 40px;"></div>
                <div class="jb-skeleton-text" style="width: 100px; height: 40px;"></div>
            </div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-exemptions" data-region="jobboard-exemption-revoke">
    {{! Skip Link for Accessibility }}
    <a href="#revoke-form-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h3 class="mb-0">
            <i class="fa fa-ban text-danger me-2" aria-hidden="true"></i>
            {{str.revokeexemption}}
        </h3>
        <a href="{{cancelurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{str.cancel}}
        </a>
    </header>

    {{! Warning Alert }}
    <div class="alert alert-danger d-flex align-items-start mb-4 jb-fade-in-up" role="alert" style="animation-delay: 0.05s;">
        <i class="fa fa-triangle-exclamation fa-lg text-danger me-3 mt-1" aria-hidden="true"></i>
        <div>
            <strong class="d-block mb-1">{{#str}}warningirreversible, local_jobboard{{/str}}</strong>
            <p class="mb-0">
                {{str.confirmrevokeexemption_prefix}} <strong>{{userfullname}}</strong>{{str.confirmrevokeexemption_suffix}}
            </p>
        </div>
    </div>

    {{! Exemption Details Card }}
    <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;" aria-labelledby="exemption-details-heading">
        <div class="card-header bg-light">
            <h5 class="mb-0" id="exemption-details-heading">
                <i class="fa fa-certificate text-info me-2" aria-hidden="true"></i>
                {{#str}}exemptiondetails, local_jobboard{{/str}}
            </h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">
                    <i class="fa fa-user me-1" aria-hidden="true"></i>
                    {{#str}}user{{/str}}
                </dt>
                <dd class="col-sm-8">
                    <strong>{{userfullname}}</strong>
                    {{#useremail}}
                    <br><small class="text-muted">{{useremail}}</small>
                    {{/useremail}}
                </dd>

                <dt class="col-sm-4 text-muted">
                    <i class="fa fa-tag me-1" aria-hidden="true"></i>
                    {{#str}}type{{/str}}
                </dt>
                <dd class="col-sm-8">
                    <span class="badge bg-secondary">{{exemptiontype}}</span>
                </dd>

                {{#validfrom}}
                <dt class="col-sm-4 text-muted">
                    <i class="fa fa-calendar-check me-1" aria-hidden="true"></i>
                    {{#str}}validfrom, local_jobboard{{/str}}
                </dt>
                <dd class="col-sm-8">{{validfrom}}</dd>
                {{/validfrom}}

                {{#validuntil}}
                <dt class="col-sm-4 text-muted">
                    <i class="fa fa-calendar-xmark me-1" aria-hidden="true"></i>
                    {{#str}}validuntil, local_jobboard{{/str}}
                </dt>
                <dd class="col-sm-8">{{validuntil}}</dd>
                {{/validuntil}}
            </dl>
        </div>
    </section>

    {{! Revoke Form Card }}
    <main id="revoke-form-content">
        <section class="card shadow-sm jb-border-danger jb-fade-in-up" style="animation-delay: 0.15s;">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="fa fa-ban me-2" aria-hidden="true"></i>
                    {{#str}}confirmrevocation, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body">
                <form method="post" action="">
                    <input type="hidden" name="action" value="revoke">
                    <input type="hidden" name="id" value="{{id}}">
                    <input type="hidden" name="confirm" value="1">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">

                    <div class="mb-3 mb-4">
                        <label for="reason" class="form-label fw-bold">
                            <i class="fa fa-message me-1" aria-hidden="true"></i>
                            {{str.revokereason}}
                            <span class="text-danger">*</span>
                        </label>
                        <textarea name="reason" id="reason" class="form-control" rows="4" required
                                  placeholder="{{#str}}revokereason_placeholder, local_jobboard{{/str}}"></textarea>
                        <small class="form-text text-muted">
                            {{#str}}revokereason_help, local_jobboard{{/str}}
                        </small>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
                        <small>{{#str}}revocationwarning, local_jobboard{{/str}}</small>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-danger jb-hover-lift"
                                onclick="return confirm('{{#str}}finalconfirmrevoke, local_jobboard{{/str}}');">
                            <i class="fa fa-ban me-2" aria-hidden="true"></i>
                            {{str.confirm}}
                        </button>
                        <a href="{{cancelurl}}" class="btn btn-outline-secondary jb-hover-lift">
                            <i class="fa fa-xmark me-2" aria-hidden="true"></i>
                            {{str.cancel}}
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </main>
</div>
{{/loading}}
