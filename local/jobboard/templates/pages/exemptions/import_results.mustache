{{!
    @template local_jobboard/pages/import_exemptions_results

    CSV import results page for ISER exemptions.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pagetitle - string - Page title
    * ispreview - bool - Whether showing preview results
    * haspreview - bool - Whether there are preview items
    * previewitems - array - Preview items (row, user, email, type, docs)
    * previewtotal - int - Total preview count
    * successcount - int - Number of successful imports
    * skippedcount - int - Number of skipped items
    * hasskipped - bool - Whether there are skipped items
    * haserrors - bool - Whether there are errors
    * errors - array - Error messages (limited to 20)
    * moreerrors - int - Count of additional errors beyond 20
    * continueurl - string - URL to continue
    * confirmurl - string - URL to confirm import
    * backurl - string - Back URL
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "pagetitle": "Import Results",
        "ispreview": true,
        "haspreview": true,
        "previewtotal": 5
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-local-jobboard-import-results" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="jb-skeleton-title mb-4" style="width: 200px;"></div>
    <div class="jb-skeleton-text mb-4" style="width: 100%; height: 60px;"></div>
    <div class="row mb-4">
        <div class="col-md-4"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-md-4"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
        <div class="col-md-4"><div class="jb-skeleton-text" style="height: 100px;"></div></div>
    </div>
    <div class="jb-skeleton-text" style="height: 200px;"></div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-local-jobboard-import-results" data-region="jobboard-import-exemptions-results">
    {{! Skip Link for Accessibility }}
    <a href="#import-results-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h2 class="mb-0">
            <i class="fa fa-file-import text-primary me-2" aria-hidden="true"></i>
            {{pagetitle}}
        </h2>
        {{#backurl}}
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{#str}}back, local_jobboard{{/str}}
        </a>
        {{/backurl}}
    </header>

    <main id="import-results-content">
        {{#ispreview}}
        {{! Preview Mode }}
        <div class="alert alert-warning d-flex align-items-center mb-4 jb-fade-in-up" role="status" style="animation-delay: 0.05s;">
            <i class="fa fa-eye fa-lg me-3" aria-hidden="true"></i>
            <div>
                <strong class="d-block">{{#str}}previewmode, local_jobboard{{/str}}</strong>
                <small>{{str.preview_notice}}</small>
            </div>
        </div>

        {{#haspreview}}
        {{! Preview Stats }}
        <section class="row mb-4" aria-label="{{#str}}previewsummary, local_jobboard{{/str}}">
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm text-center jb-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="card-body py-3">
                        <i class="fa fa-check fa-2x text-success mb-2" aria-hidden="true"></i>
                        <h3 class="text-success mb-1">{{previewtotal}}</h3>
                        <p class="text-muted small mb-0">{{#str}}recordstoprocess, local_jobboard{{/str}}</p>
                    </div>
                </div>
            </div>
        </section>

        {{! Preview Table }}
        <section class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="preview-table-heading">
            <div class="card-header bg-white">
                <h5 class="mb-0" id="preview-table-heading">
                    <i class="fa fa-table text-primary me-2" aria-hidden="true"></i>
                    {{#str}}previewdata, local_jobboard{{/str}}
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0" aria-describedby="preview-table-heading">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">{{str.row}}</th>
                                <th scope="col">{{str.user}}</th>
                                <th scope="col">{{str.email}}</th>
                                <th scope="col">{{str.exemptiontype}}</th>
                                <th scope="col" class="text-center">{{str.numdocs}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#previewitems}}
                            <tr class="jb-fade-in" style="animation-delay: calc(0.2s + {{@index}} * 0.03s);">
                                <td><span class="badge bg-light text-dark">{{row}}</span></td>
                                <td><strong>{{user}}</strong></td>
                                <td><a href="mailto:{{email}}" class="text-muted">{{email}}</a></td>
                                <td><span class="badge bg-secondary">{{type}}</span></td>
                                <td class="text-center"><span class="badge bg-info text-dark">{{docs}}</span></td>
                            </tr>
                            {{/previewitems}}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        {{! Confirm Actions }}
        <div class="card shadow-sm jb-border-success jb-fade-in-up" style="animation-delay: 0.25s;">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <p class="text-success fw-bold mb-1">
                        <i class="fa fa-circle-check me-2" aria-hidden="true"></i>
                        {{str.preview_total}}
                    </p>
                    <p class="mb-0 text-muted small">{{str.preview_confirm}}</p>
                </div>
                <div class="d-flex gap-2 mt-3 jb-mt-md-0">
                    <a href="{{confirmurl}}" class="btn btn-success jb-hover-lift">
                        <i class="fa fa-check me-2" aria-hidden="true"></i>
                        {{#str}}confirmimport, local_jobboard{{/str}}
                    </a>
                    <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
                        <i class="fa fa-xmark me-2" aria-hidden="true"></i>
                        {{#str}}cancel{{/str}}
                    </a>
                </div>
            </div>
        </div>
        {{/haspreview}}

        {{^haspreview}}
        <div class="text-center py-5" role="status">
            <i class="fa fa-file-excel fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
            <h5 class="text-muted">{{#str}}nopreviewdata, local_jobboard{{/str}}</h5>
        </div>
        {{/haspreview}}
        {{/ispreview}}

        {{^ispreview}}
        {{! Actual Import Results }}
        <div class="alert alert-success d-flex align-items-center mb-4 jb-fade-in" role="status">
            <i class="fa fa-check fa-lg text-success me-3" aria-hidden="true"></i>
            <div>
                <strong class="d-block">{{str.import_complete}}</strong>
                <span>{{str.imported_success}}</span>
                {{#hasskipped}}
                <br><span class="text-warning">{{str.imported_skipped}}</span>
                {{/hasskipped}}
            </div>
        </div>

        {{! Results Stats }}
        <section class="row mb-4" aria-label="{{#str}}importresults, local_jobboard{{/str}}">
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm text-center jb-fade-in-up" style="animation-delay: 0.05s;">
                    <div class="card-body py-3">
                        <i class="fa fa-check fa-2x text-success mb-2" aria-hidden="true"></i>
                        <h3 class="text-success mb-1">{{successcount}}</h3>
                        <p class="mb-0 text-muted">{{#str}}exemptionsimported, local_jobboard{{/str}}</p>
                    </div>
                </div>
            </div>
            {{#hasskipped}}
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm text-center jb-fade-in-up" style="animation-delay: 0.1s;">
                    <div class="card-body py-3">
                        <i class="fa fa-forward fa-2x text-warning mb-2" aria-hidden="true"></i>
                        <h3 class="text-warning mb-1">{{skippedcount}}</h3>
                        <p class="mb-0 text-muted">{{#str}}exemptionsskipped, local_jobboard{{/str}}</p>
                    </div>
                </div>
            </div>
            {{/hasskipped}}
        </section>
        {{/ispreview}}

        {{! Errors Section }}
        {{#haserrors}}
        <section class="card shadow-sm jb-border-danger mb-4 jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="errors-heading">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0" id="errors-heading">
                    <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
                    {{str.import_errors}}
                </h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    {{#errors}}
                    <li class="list-group-item list-group-item-danger d-flex align-items-start">
                        <i class="fa fa-circle-xmark me-2 mt-1" aria-hidden="true"></i>
                        {{.}}
                    </li>
                    {{/errors}}
                    {{#hasmoreerrors}}
                    <li class="list-group-item list-group-item-warning text-center">
                        <i class="fa fa-ellipsis me-2" aria-hidden="true"></i>
                        {{str.and_more}}
                    </li>
                    {{/hasmoreerrors}}
                </ul>
            </div>
        </section>
        {{/haserrors}}

        {{! Continue Button }}
        <div class="d-flex gap-2 mt-4 jb-fade-in" style="animation-delay: 0.2s;">
            <a href="{{continueurl}}" class="btn btn-primary jb-hover-lift">
                <i class="fa fa-arrow-right me-2" aria-hidden="true"></i>
                {{str.continue}}
            </a>
        </div>
    </main>
</div>
{{/loading}}
