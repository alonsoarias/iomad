{{!
    @template local_jobboard/pages/exemption_form

    Exemption add/edit form page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * pagetitle - string - Page title
    * backurl - string - Back URL
    * isedit - bool - True if editing, false if adding
    * formhtml - string - Rendered form HTML
    * exemption - object - Exemption data if editing {userfullname, type, validfrom}
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "pagetitle": "Add Exemption",
        "backurl": "/local/jobboard/admin/manage_exemptions.php",
        "isedit": false
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-exemptions" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton-title" style="width: 180px;"></div>
        <div class="jb-skeleton-text" style="width: 100px; height: 38px;"></div>
    </div>
    <div class="card">
        <div class="card-header">
            <div class="jb-skeleton-text" style="width: 150px;"></div>
        </div>
        <div class="card-body">
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 50px;"></div>
            <div class="jb-skeleton-text mb-3" style="width: 100%; height: 100px;"></div>
            <div class="jb-skeleton-text" style="width: 150px; height: 45px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-exemptions" data-region="jobboard-exemption-form">
    {{! Skip Link for Accessibility }}
    <a href="#exemption-form-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h3 class="mb-0">
            {{#isedit}}
            <i class="fa fa-pen-to-square text-primary me-2" aria-hidden="true"></i>
            {{/isedit}}
            {{^isedit}}
            <i class="fa fa-circle-plus text-success me-2" aria-hidden="true"></i>
            {{/isedit}}
            {{pagetitle}}
        </h3>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{str.back}}
        </a>
    </header>

    {{! Edit Mode Info Banner }}
    {{#isedit}}
    <div class="alert alert-info jb-alert-info d-flex align-items-center mb-4 jb-fade-in-up" role="status" style="animation-delay: 0.05s;">
        <i class="fa fa-circle-info me-3" aria-hidden="true"></i>
        <div>
            <strong class="d-block">{{#str}}editingexemption, local_jobboard{{/str}}</strong>
            {{#exemption.userfullname}}
            <small class="text-muted">
                {{#str}}user{{/str}}: <strong>{{exemption.userfullname}}</strong>
            </small>
            {{/exemption.userfullname}}
        </div>
    </div>
    {{/isedit}}

    {{! Form Card }}
    <main id="exemption-form-content">
        <div class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.1s;">
            <div class="card-header bg-white d-flex align-items-center">
                {{#isedit}}
                <i class="fa fa-pen-to-square fa-lg text-primary me-3" aria-hidden="true"></i>
                {{/isedit}}
                {{^isedit}}
                <i class="fa fa-plus fa-lg text-success me-3" aria-hidden="true"></i>
                {{/isedit}}
                <h5 class="mb-0">
                    {{#isedit}}
                    {{str.editexemption}}
                    {{/isedit}}
                    {{^isedit}}
                    {{str.addexemption}}
                    {{/isedit}}
                </h5>
            </div>
            <div class="card-body">
                {{{formhtml}}}
            </div>
        </div>
    </main>

    {{! Help Section }}
    <aside class="mt-4 jb-fade-in" style="animation-delay: 0.15s;">
        <div class="alert jb-alert-light d-flex align-items-start">
            <i class="fa fa-lightbulb text-warning me-3 mt-1" aria-hidden="true"></i>
            <div>
                <strong class="d-block mb-1">{{#str}}exemptionhelptitle, local_jobboard{{/str}}</strong>
                <p class="mb-0 small text-muted">{{#str}}exemptionhelpdesc, local_jobboard{{/str}}</p>
            </div>
        </div>
    </aside>

    {{! Exemption Types Info }}
    <div class="card shadow-sm mt-4 jb-fade-in" style="animation-delay: 0.2s;">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fa fa-list fa-lg text-secondary me-3" aria-hidden="true"></i>
            <h6 class="mb-0">
                {{#str}}exemptiontypes, local_jobboard{{/str}}
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-start">
                        <span class="badge bg-info text-dark me-2">{{#str}}permanent, local_jobboard{{/str}}</span>
                        <small class="text-muted">{{#str}}permanentdesc, local_jobboard{{/str}}</small>
                    </div>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-start">
                        <span class="badge bg-warning text-dark me-2">{{#str}}temporary, local_jobboard{{/str}}</span>
                        <small class="text-muted">{{#str}}temporarydesc, local_jobboard{{/str}}</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <span class="badge bg-success me-2">{{#str}}conditional, local_jobboard{{/str}}</span>
                        <small class="text-muted">{{#str}}conditionaldesc, local_jobboard{{/str}}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/loading}}
