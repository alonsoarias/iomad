{{!
    @template local_jobboard/pages/exemption_view

    Exemption view details page.
    Uses jb-* CSS classes for consistent styling.
    Includes accessibility features, animations, and loading states.

    Context variables required for this template:
    * id - int - Exemption ID
    * backurl - string - Back URL
    * userfullname - string - User full name
    * useremail - string - User email
    * exemptiontype - string - Exemption type label
    * documentref - string - Document reference
    * doctypesbadges - array - Document type badges [{label, class}]
    * validfrom - string - Valid from date
    * validuntil - string - Valid until date or "No expiry"
    * notes - string - Notes
    * createdbyinfo - string - Created by info
    * statusbadge - object - Status badge {label, class}
    * isrevoked - bool - Whether exemption is revoked
    * revokedbyinfo - string - Revoked by info (if revoked)
    * revokereason - string - Revoke reason (if revoked)
    * canmodify - bool - Can edit/revoke
    * editurl - string - Edit URL
    * revokeurl - string - Revoke URL
    * usagehistory - array - Usage history items [{vacancy, date}]
    * hasusagehistory - bool - Has usage history
    * loading - bool - Show skeleton loading state
    * str - object - Language strings

    Example context (json):
    {
        "id": 123,
        "userfullname": "John Doe",
        "isrevoked": false,
        "canmodify": true
    }
}}
{{#loading}}
{{! Skeleton Loading State }}
<div class="jb-exemptions" aria-busy="true" aria-label="{{#str}}loading{{/str}}">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="jb-skeleton-title" style="width: 200px;"></div>
        <div class="jb-skeleton-text" style="width: 100px; height: 38px;"></div>
    </div>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between">
            <div class="jb-skeleton-text" style="width: 150px;"></div>
            <div class="jb-skeleton-text" style="width: 80px;"></div>
        </div>
        <div class="card-body">
            {{#items}}
            <div class="row mb-3">
                <div class="col-sm-3"><div class="jb-skeleton-text" style="width: 80%;"></div></div>
                <div class="col-sm-9"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
            </div>
            {{/items}}
            {{^items}}
            <div class="row mb-3">
                <div class="col-sm-3"><div class="jb-skeleton-text" style="width: 80%;"></div></div>
                <div class="col-sm-9"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3"><div class="jb-skeleton-text" style="width: 80%;"></div></div>
                <div class="col-sm-9"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3"><div class="jb-skeleton-text" style="width: 80%;"></div></div>
                <div class="col-sm-9"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-3"><div class="jb-skeleton-text" style="width: 80%;"></div></div>
                <div class="col-sm-9"><div class="jb-skeleton-text" style="width: 60%;"></div></div>
            </div>
            {{/items}}
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <div class="jb-skeleton-text" style="width: 150px;"></div>
        </div>
        <div class="card-body">
            <div class="jb-skeleton-text" style="width: 100%; height: 100px;"></div>
        </div>
    </div>
</div>
{{/loading}}

{{^loading}}
<div class="jb-exemptions" data-region="jobboard-exemption-view">
    {{! Skip Link for Accessibility }}
    <a href="#exemption-details-content" class="jb-skip-link">
        {{#str}}skiptocontent, local_jobboard{{/str}}
    </a>

    {{! Page Header }}
    <header class="d-flex justify-content-between align-items-center mb-4 jb-fade-in">
        <h3 class="mb-0">
            <i class="fa fa-certificate text-primary me-2" aria-hidden="true"></i>
            {{str.exemptiondetails}}
        </h3>
        <a href="{{backurl}}" class="btn btn-outline-secondary jb-hover-lift">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
            {{str.back}}
        </a>
    </header>

    {{! Revoked Alert Banner }}
    {{#isrevoked}}
    <div class="alert alert-danger d-flex align-items-center mb-4 jb-fade-in-up" role="alert" style="animation-delay: 0.05s;">
        <i class="fa fa-ban fa-2x me-3" aria-hidden="true"></i>
        <div>
            <strong class="d-block">{{#str}}exemptionrevoked, local_jobboard{{/str}}</strong>
            <small>{{revokedbyinfo}}</small>
        </div>
    </div>
    {{/isrevoked}}

    {{! Exemption Details Card }}
    <main id="exemption-details-content">
        <div class="card shadow-sm mb-4 jb-fade-in-up" style="animation-delay: 0.1s;">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fa fa-user text-primary me-2" aria-hidden="true"></i>
                    {{userfullname}}
                </h5>
                <span class="badge {{statusbadge.class}} jb-badge-lg">
                    {{statusbadge.label}}
                </span>
            </div>
            <div class="card-body">
                <dl class="row jb-detail-list">
                    {{! User Info }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-user me-1" aria-hidden="true"></i>
                        {{str.user}}
                    </dt>
                    <dd class="col-sm-9">
                        <strong>{{userfullname}}</strong>
                        <br>
                        <a href="mailto:{{useremail}}" class="text-muted small">
                            <i class="fa fa-envelope me-1" aria-hidden="true"></i>
                            {{useremail}}
                        </a>
                    </dd>

                    {{! Exemption Type }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-tag me-1" aria-hidden="true"></i>
                        {{str.exemptiontype}}
                    </dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">{{exemptiontype}}</span>
                    </dd>

                    {{! Document Reference }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-hashtag me-1" aria-hidden="true"></i>
                        {{str.documentref}}
                    </dt>
                    <dd class="col-sm-9">
                        {{#documentref}}
                        <code class="text-primary">{{documentref}}</code>
                        {{/documentref}}
                        {{^documentref}}
                        <span class="text-muted">-</span>
                        {{/documentref}}
                    </dd>

                    {{! Exempted Documents }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-file-lines me-1" aria-hidden="true"></i>
                        {{str.exempteddocs}}
                    </dt>
                    <dd class="col-sm-9">
                        {{#doctypesbadges}}
                        <span class="badge bg-info text-dark me-1 mb-1">
                            <i class="fa fa-file me-1" aria-hidden="true"></i>
                            {{label}}
                        </span>
                        {{/doctypesbadges}}
                        {{^doctypesbadges}}
                        <span class="text-muted">-</span>
                        {{/doctypesbadges}}
                    </dd>

                    {{! Validity Period }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-calendar-check me-1" aria-hidden="true"></i>
                        {{str.validfrom}}
                    </dt>
                    <dd class="col-sm-9">
                        <i class="fa fa-play text-success me-1" aria-hidden="true"></i>
                        {{validfrom}}
                    </dd>

                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-calendar-xmark me-1" aria-hidden="true"></i>
                        {{str.validuntil}}
                    </dt>
                    <dd class="col-sm-9">
                        <i class="fa fa-stop text-danger me-1" aria-hidden="true"></i>
                        {{validuntil}}
                    </dd>

                    {{! Notes }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-note-sticky me-1" aria-hidden="true"></i>
                        {{str.notes}}
                    </dt>
                    <dd class="col-sm-9">
                        {{#notes}}
                        <div class="bg-light p-2 rounded">{{notes}}</div>
                        {{/notes}}
                        {{^notes}}
                        <span class="text-muted">-</span>
                        {{/notes}}
                    </dd>

                    {{! Created By }}
                    <dt class="col-sm-3 text-muted">
                        <i class="fa fa-user-plus me-1" aria-hidden="true"></i>
                        {{str.createdby}}
                    </dt>
                    <dd class="col-sm-9">
                        <small class="text-muted">{{createdbyinfo}}</small>
                    </dd>

                    {{! Revoked Info (if applicable) }}
                    {{#isrevoked}}
                    <dt class="col-sm-3 text-danger">
                        <i class="fa fa-user-slash me-1" aria-hidden="true"></i>
                        {{str.revokedby}}
                    </dt>
                    <dd class="col-sm-9 text-danger">
                        {{revokedbyinfo}}
                    </dd>

                    <dt class="col-sm-3 text-danger">
                        <i class="fa fa-comment-slash me-1" aria-hidden="true"></i>
                        {{str.revokereason}}
                    </dt>
                    <dd class="col-sm-9">
                        <div class="alert alert-danger py-2 mb-0">
                            {{{revokereason}}}
                        </div>
                    </dd>
                    {{/isrevoked}}
                </dl>
            </div>

            {{! Actions Footer }}
            {{#canmodify}}
            {{^isrevoked}}
            <div class="card-footer bg-light d-flex gap-2">
                <a href="{{editurl}}" class="btn btn-primary jb-hover-lift">
                    <i class="fa fa-pen-to-square me-2" aria-hidden="true"></i>
                    {{str.edit}}
                </a>
                <a href="{{revokeurl}}" class="btn btn-outline-danger jb-hover-lift">
                    <i class="fa fa-ban me-2" aria-hidden="true"></i>
                    {{str.revoke}}
                </a>
            </div>
            {{/isrevoked}}
            {{/canmodify}}
        </div>
    </main>

    {{! Usage History Card }}
    <section class="card shadow-sm jb-fade-in-up" style="animation-delay: 0.15s;" aria-labelledby="usage-history-heading">
        <div class="card-header bg-white">
            <h5 class="mb-0" id="usage-history-heading">
                <i class="fa fa-clock-rotate-left text-info me-2" aria-hidden="true"></i>
                {{str.exemptionusagehistory}}
            </h5>
        </div>
        <div class="card-body">
            {{#hasusagehistory}}
            <div class="table-responsive">
                <table class="table table-hover table-striped" aria-describedby="usage-history-heading">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">
                                <i class="fa fa-briefcase me-1" aria-hidden="true"></i>
                                {{str.vacancy}}
                            </th>
                            <th scope="col">
                                <i class="fa fa-clock me-1" aria-hidden="true"></i>
                                {{str.date}}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#usagehistory}}
                        <tr class="jb-fade-in" style="animation-delay: calc(0.2s + {{@index}} * 0.05s);">
                            <td>
                                <i class="fa fa-briefcase text-muted me-2" aria-hidden="true"></i>
                                {{vacancy}}
                            </td>
                            <td>
                                <span class="text-muted">{{date}}</span>
                            </td>
                        </tr>
                        {{/usagehistory}}
                    </tbody>
                </table>
            </div>
            {{/hasusagehistory}}
            {{^hasusagehistory}}
            <div class="text-center py-5" role="status">
                <i class="fa fa-clock-rotate-left fa-4x text-muted opacity-50 mb-3" aria-hidden="true"></i>
                <h6 class="text-muted mb-2">{{str.noexemptionusage}}</h6>
                <p class="text-muted small mb-0">
                    {{#str}}exemptionnotused, local_jobboard{{/str}}
                </p>
            </div>
            {{/hasusagehistory}}
        </div>
    </section>
</div>
{{/loading}}
