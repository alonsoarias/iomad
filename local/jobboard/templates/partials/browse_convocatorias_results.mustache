{{!
    @template local_jobboard/partials/browse_convocatorias_results

    Partial template for browse convocatorias results (AJAX).
    Contains just the convocatoria cards grid and pagination for AJAX refresh.

    Context variables:
    * hasconvocatorias (bool) - Has convocatorias to display
    * convocatorias (array) - Convocatoria card data
    * pagination (string) - Pagination HTML
    * dashboardurl (string) - URL to dashboard
}}
{{#hasconvocatorias}}
<div class="jb-grid">
    {{#convocatorias}}
    <div class="jb-conv-card {{#isclosingsoon}}jb-conv-card--urgent{{/isclosingsoon}}">
        {{! Card Header }}
        <div class="jb-conv-card__header">
            <span class="jb-conv-card__code {{#isclosingsoon}}jb-conv-card__code--urgent{{/isclosingsoon}}{{^isclosingsoon}}{{#isopen}}jb-conv-card__code--open{{/isopen}}{{#isclosed}}jb-conv-card__code--closed{{/isclosed}}{{/isclosingsoon}}">
                {{code}}
            </span>
            {{#isclosingsoon}}
            <span class="jb-conv-card__badge jb-conv-card__badge--danger">
                <i class="fa fa-clock"></i>
                {{daysremaining}} {{#str}}days, local_jobboard{{/str}}
            </span>
            {{/isclosingsoon}}
            {{^isclosingsoon}}
            {{#isopen}}
            <span class="jb-conv-card__badge jb-conv-card__badge--success">
                <i class="fa fa-check-circle"></i>
                {{#str}}convocatoria_status_open, local_jobboard{{/str}}
            </span>
            {{/isopen}}
            {{#isclosed}}
            <span class="jb-conv-card__badge jb-conv-card__badge--secondary">
                {{#str}}convocatoria_status_closed, local_jobboard{{/str}}
            </span>
            {{/isclosed}}
            {{/isclosingsoon}}
        </div>

        {{! Card Body }}
        <div class="jb-conv-card__body">
            <h4 class="jb-conv-card__title">
                <a href="{{viewurl}}">{{name}}</a>
            </h4>

            {{#description}}
            <p class="jb-conv-card__desc">{{description}}</p>
            {{/description}}

            <div class="jb-conv-card__meta">
                <div class="jb-conv-card__dates">
                    <i class="fa fa-calendar-check"></i>
                    {{startdateformatted}} → {{enddateformatted}}
                </div>
                <div class="jb-conv-card__vacancies">
                    <i class="fa fa-briefcase"></i>
                    {{#hasvacancies}}
                    <span class="jb-conv-card__vacancies-count">{{vacancycount}}</span>
                    <span>{{#str}}vacancies, local_jobboard{{/str}}</span>
                    {{/hasvacancies}}
                    {{^hasvacancies}}
                    <span class="jb-text-muted">{{#str}}novacancies, local_jobboard{{/str}}</span>
                    {{/hasvacancies}}
                </div>
            </div>
        </div>

        {{! Card Footer }}
        <div class="jb-conv-card__footer">
            {{#hasvacancies}}
            {{#isopen}}
            <a href="{{viewurl}}" class="jb-btn jb-btn--primary jb-btn--block">
                {{#str}}viewvacancies, local_jobboard{{/str}}
                <i class="fa fa-arrow-right"></i>
            </a>
            {{/isopen}}
            {{^isopen}}
            <a href="{{viewurl}}" class="jb-btn jb-btn--outline jb-btn--block">
                <i class="fa fa-eye"></i> {{#str}}viewconvocatoria, local_jobboard{{/str}}
            </a>
            {{/isopen}}
            {{/hasvacancies}}
            {{^hasvacancies}}
            <span class="jb-btn jb-btn--outline jb-btn--block jb-btn--disabled">
                {{#str}}novacancies, local_jobboard{{/str}}
            </span>
            {{/hasvacancies}}
        </div>
    </div>
    {{/convocatorias}}
</div>
{{/hasconvocatorias}}

{{! Empty State }}
{{^hasconvocatorias}}
<div class="jb-empty">
    <i class="fa fa-calendar-xmark"></i>
    <h3>{{#str}}noconvocatorias, local_jobboard{{/str}}</h3>
    <p>{{#str}}noconvocatorias_desc, local_jobboard{{/str}}</p>
    <a href="{{dashboardurl}}" class="jb-btn jb-btn--primary">
        <i class="fa fa-house"></i> {{#str}}backtodashboard, local_jobboard{{/str}}
    </a>
</div>
{{/hasconvocatorias}}

{{! Pagination }}
{{#pagination}}
<nav class="jb-pagination" aria-label="{{#str}}pagination, local_jobboard{{/str}}">
    {{{pagination}}}
</nav>
{{/pagination}}
