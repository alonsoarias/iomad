{{!
    @template local_jobboard/partials/public_vacancies_results

    Partial template for vacancy results (AJAX filterable)
    Clean minimal design following jb-* pattern

    Context variables:
    * resultstext - String showing number of results
    * hasvacancies - Boolean if vacancies exist
    * vacancies - Array of vacancy data
    * pagination - Pagination HTML
}}
{{! Results Header }}
<div class="jb-section-header">
    <h3 class="jb-section-header__title">
        <i class="fa fa-briefcase"></i> {{#str}}vacancies, local_jobboard{{/str}}
    </h3>
    <span class="jb-section-header__count">{{resultstext}}</span>
</div>

{{! Vacancies Grid }}
{{#hasvacancies}}
<div class="jb-grid">
    {{#vacancies}}
    <div class="jb-card jb-vacancy-card {{#isurgent}}jb-vacancy-card--urgent{{/isurgent}}">
        {{#isurgent}}
        <div class="jb-vacancy-card__urgent-banner">
            <i class="fa fa-clock"></i> {{urgenttext}}
        </div>
        {{/isurgent}}
        <div class="jb-vacancy-card__header">
            <span class="jb-code jb-code--muted">{{code}}</span>
            <span class="jb-badge jb-badge--{{publicationtypecolor}}">{{publicationtypelabel}}</span>
        </div>
        <div class="jb-vacancy-card__body">
            <h4 class="jb-vacancy-card__title">
                <a href="{{viewurl}}">{{title}}</a>
            </h4>
            <div class="jb-vacancy-card__meta">
                {{#location}}<div class="jb-vacancy-card__meta-item"><i class="fa fa-location-dot jb-text-primary"></i> {{location}}</div>{{/location}}
                {{#contracttypelabel}}<div class="jb-vacancy-card__meta-item"><i class="fa fa-file-contract"></i> {{contracttypelabel}}</div>{{/contracttypelabel}}
                {{#modality}}<div class="jb-vacancy-card__meta-item"><i class="fa fa-laptop-house jb-text-info"></i> {{modality}}</div>{{/modality}}
                {{#department}}<div class="jb-vacancy-card__meta-item"><i class="fa fa-graduation-cap jb-text-primary"></i> {{department}}</div>{{/department}}
                <div class="jb-vacancy-card__meta-item"><i class="fa fa-users jb-text-info"></i> {{positions}} {{#str}}positions, local_jobboard{{/str}}</div>
            </div>
        </div>
        <div class="jb-vacancy-card__footer">
            <div class="jb-vacancy-card__deadline {{#isurgent}}jb-text-danger{{/isurgent}}">
                <i class="fa fa-calendar-xmark"></i> {{closedateformatted}}
            </div>
            <div class="jb-vacancy-card__actions">
                <a href="{{viewurl}}" class="jb-btn jb-btn--outline jb-btn--sm">
                    <i class="fa fa-eye"></i> {{#str}}view{{/str}}
                </a>
                {{#hasapplied}}
                <span class="jb-btn jb-btn--success jb-btn--sm">
                    <i class="fa fa-check"></i> {{#str}}applied, local_jobboard{{/str}}
                </span>
                {{/hasapplied}}
                {{^hasapplied}}
                {{#canapply}}
                <a href="{{applyurl}}" class="jb-btn jb-btn--primary jb-btn--sm">
                    <i class="fa fa-paper-plane"></i> {{#str}}apply, local_jobboard{{/str}}
                </a>
                {{/canapply}}
                {{^isloggedin}}
                <a href="{{loginapplyurl}}" class="jb-btn jb-btn--primary jb-btn--sm">
                    <i class="fa fa-sign-in-alt"></i> {{#str}}login{{/str}}
                </a>
                {{/isloggedin}}
                {{/hasapplied}}
            </div>
        </div>
    </div>
    {{/vacancies}}
</div>
{{/hasvacancies}}

{{! Empty State }}
{{^hasvacancies}}
<div class="jb-empty">
    <i class="fa fa-briefcase"></i>
    <h3>{{#str}}novacancies, local_jobboard{{/str}}</h3>
    <p>{{#str}}novacancies_desc, local_jobboard{{/str}}</p>
</div>
{{/hasvacancies}}

{{! Pagination }}
{{#pagination}}
<nav class="jb-pagination">{{{pagination}}}</nav>
{{/pagination}}

<style>
/* Vacancy Card */
.jb-vacancy-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
}

.jb-vacancy-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}

.jb-vacancy-card--urgent {
    border-top: 3px solid var(--iser-amarillo, #ffc107);
}

.jb-vacancy-card__urgent-banner {
    background: var(--iser-amarillo, #ffc107);
    color: var(--iser-negro, #1a1a1a);
    padding: 0.25rem 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-align: center;
}

.jb-vacancy-card__urgent-banner i {
    margin-right: 0.25rem;
}

.jb-vacancy-card__header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.jb-vacancy-card__body {
    padding: 1rem;
    flex: 1;
}

.jb-vacancy-card__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
}

.jb-vacancy-card__title a {
    color: var(--iser-negro, #1a1a1a);
    text-decoration: none;
}

.jb-vacancy-card__title a:hover {
    color: var(--iser-verde, #1b9e88);
}

.jb-vacancy-card__meta {
    font-size: 0.8125rem;
    color: var(--iser-gris-oscuro, #333);
}

.jb-vacancy-card__meta-item {
    margin-bottom: 0.375rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.jb-vacancy-card__meta-item i {
    width: 16px;
    color: var(--iser-gris-medio, #666);
}

.jb-vacancy-card__meta-item i.jb-text-primary {
    color: var(--iser-verde, #1b9e88);
}

.jb-vacancy-card__meta-item i.jb-text-info {
    color: var(--iser-azul, #0d6efd);
}

.jb-vacancy-card__footer {
    padding: 0.75rem 1rem;
    background: #f9fafb;
    border-top: 1px solid #f0f0f0;
}

.jb-vacancy-card__deadline {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
    margin-bottom: 0.5rem;
}

.jb-vacancy-card__deadline i {
    margin-right: 0.375rem;
}

.jb-vacancy-card__actions {
    display: flex;
    gap: 0.5rem;
}

.jb-vacancy-card__actions .jb-btn {
    flex: 1;
}

/* Section Header */
.jb-section-header__count {
    font-size: 0.8125rem;
    color: var(--iser-gris-medio, #666);
}

/* Code muted variant */
.jb-code--muted {
    background: transparent;
    color: var(--iser-gris-medio, #666);
    font-weight: 500;
}

/* Pagination */
.jb-pagination {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
}

.jb-pagination .pagination {
    margin: 0;
}

/* Publication type colors */
.jb-badge--verde { background: rgba(27, 158, 136, 0.15); color: var(--iser-verde-dark, #157a6a); }
.jb-badge--azul { background: rgba(13, 110, 253, 0.15); color: #0d6efd; }
.jb-badge--amarillo { background: rgba(255, 193, 7, 0.2); color: #856404; }
.jb-badge--rojo { background: rgba(220, 53, 69, 0.15); color: #c41e3a; }
</style>
