  "classes": {
    "document": {
      "namespace": "local_jobboard",
      "file": "classes/document.php",
      "description": "Represents an uploaded document with validation tracking",
      "constants": {
        "COMPONENT": "local_jobboard",
        "FILEAREA": "application_documents",
        "FILENAME_PREFIXES": {
          "description": "Mapping of document types to standardized filename prefixes",
          "examples": {
            "rut": "Rut",
            "sigep": "Hv",
            "cedula": "Di",
            "diploma_pregrado": "Preg",
            "experiencia_docente": "Edoc"
          }
        }
      },
      "properties": [
        {"name": "id", "type": "int", "description": "Document ID"},
        {"name": "applicationid", "type": "int", "description": "Parent application ID"},
        {"name": "documenttype", "type": "string", "description": "Document type code"},
        {"name": "filename", "type": "string", "description": "Original filename"},
        {"name": "contenthash", "type": "string", "description": "Moodle file contenthash"},
        {"name": "filesize", "type": "int", "description": "File size in bytes"},
        {"name": "mimetype", "type": "string", "description": "MIME type"},
        {"name": "issuedate", "type": "int|null", "description": "Document issue date"},
        {"name": "expirydate", "type": "int|null", "description": "Document expiry date"},
        {"name": "isencrypted", "type": "int", "description": "Whether file is encrypted"},
        {"name": "issuperseded", "type": "int", "description": "Whether document is superseded"}
      ],
      "methods": [
        {
          "name": "get",
          "visibility": "public static",
          "params": [{"name": "id", "type": "int"}],
          "returns": "self|null",
          "description": "Get document by ID"
        },
        {
          "name": "create_from_file",
          "visibility": "public static",
          "params": [
            {"name": "applicationid", "type": "int"},
            {"name": "documenttype", "type": "string"},
            {"name": "file", "type": "stored_file"},
            {"name": "issuedate", "type": "int|null"}
          ],
          "returns": "self",
          "description": "Create new document from uploaded file, marks previous as superseded"
        },
        {
          "name": "create_text_document",
          "visibility": "public static",
          "params": [
            {"name": "applicationid", "type": "int"},
            {"name": "documenttype", "type": "string"},
            {"name": "textcontent", "type": "string"}
          ],
          "returns": "self",
          "description": "Create document record for text content (textarea fields)"
        },
        {
          "name": "store_from_draft",
          "visibility": "public static",
          "params": [
            {"name": "applicationid", "type": "int"},
            {"name": "documenttype", "type": "string"},
            {"name": "draftitemid", "type": "int"},
            {"name": "issuedate", "type": "int|null"}
          ],
          "returns": "self|null",
          "description": "Store uploaded file from form draft area"
        },
        {
          "name": "validate",
          "visibility": "public",
          "params": [{"name": "userid", "type": "int"}],
          "returns": "bool",
          "description": "Approve document validation"
        },
        {
          "name": "reject",
          "visibility": "public",
          "params": [
            {"name": "userid", "type": "int"},
            {"name": "reason", "type": "string"}
          ],
          "returns": "bool",
          "description": "Reject document with reason"
        },
        {
          "name": "get_by_application",
          "visibility": "public static",
          "params": [
            {"name": "applicationid", "type": "int"},
            {"name": "includesuperseded", "type": "bool"}
          ],
          "returns": "array",
          "description": "Get all documents for an application"
        },
        {
          "name": "get_stats",
          "visibility": "public static",
          "params": [{"name": "applicationid", "type": "int"}],
          "returns": "array",
          "description": "Get document statistics (total, pending, approved, rejected)"
        },
        {
          "name": "get_required_types",
          "visibility": "public static",
          "params": [
            {"name": "vacancyid", "type": "int"},
            {"name": "userid", "type": "int|null"}
          ],
          "returns": "array",
          "description": "Get required document types for vacancy considering exemptions"
        },
        {
          "name": "get_download_url",
          "visibility": "public",
          "params": [{"name": "forcedownload", "type": "bool"}],
          "returns": "moodle_url|null",
          "description": "Get file download URL"
        },
        {
          "name": "is_text_document",
          "visibility": "public",
          "params": [],
          "returns": "bool",
          "description": "Check if document is text-based (not a file)"
        },
        {
          "name": "generate_standardized_filename",
          "visibility": "public static",
          "params": [
            {"name": "documenttype", "type": "string"},
            {"name": "userid", "type": "int"},
            {"name": "originalfilename", "type": "string"}
          ],
          "returns": "string",
          "description": "Generate standardized filename (Prefix_Lastname.ext)"
        }
      ]
    },
    "audit": {
      "namespace": "local_jobboard",
