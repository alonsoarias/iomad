            {"name": "entitytype", "type": "string"}
          ],
          "returns": "int|bool",
          "description": "Log email sent event"
        },
        {
          "name": "get_trail",
          "visibility": "public static",
          "params": [
            {"name": "entitytype", "type": "string"},
            {"name": "entityid", "type": "int"},
            {"name": "limit", "type": "int"}
          ],
          "returns": "array",
          "description": "Get complete audit trail for an entity"
        },
        {
          "name": "get_user_activity",
          "visibility": "public static",
          "params": [
            {"name": "userid", "type": "int"},
            {"name": "limit", "type": "int"}
          ],
          "returns": "array",
          "description": "Get user activity log"
        },
        {
          "name": "cleanup",
          "visibility": "public static",
          "params": [{"name": "daystokeep", "type": "int"}],
          "returns": "int",
          "description": "Delete old audit records"
        }
      ]
