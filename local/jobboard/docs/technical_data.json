        "entities": [
          "ENTITY_VACANCY",
          "ENTITY_APPLICATION",
          "ENTITY_DOCUMENT",
          "ENTITY_EXEMPTION",
          "ENTITY_CONVOCATORIA",
          "ENTITY_CONFIG",
          "ENTITY_USER",
          "ENTITY_EMAIL_TEMPLATE",
          "ENTITY_INTERVIEW",
          "ENTITY_CONSENT",
          "ENTITY_PROFILE",
          "ENTITY_DOCTYPE",
          "ENTITY_NOTIFICATION"
        ]
      },
      "methods": [
        {
          "name": "log",
          "visibility": "public static",
          "params": [
            {"name": "action", "type": "string"},
            {"name": "entitytype", "type": "string"},
            {"name": "entityid", "type": "int|null"},
            {"name": "extradata", "type": "mixed"},
            {"name": "previousvalue", "type": "mixed"},
            {"name": "newvalue", "type": "mixed"},
            {"name": "userid", "type": "int|null"}
          ],
          "returns": "int|bool",
          "description": "Log action with optional before/after values (JSON encoded)"
        },
        {
          "name": "log_transition",
          "visibility": "public static",
          "params": [
            {"name": "entitytype", "type": "string"},
            {"name": "entityid", "type": "int"},
