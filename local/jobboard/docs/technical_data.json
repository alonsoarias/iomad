  "workflows": {
    "vacancy_workflow": {
      "description": "Lifecycle of a job vacancy from creation to closure",
      "states": ["draft", "published", "closed", "assigned"],
      "transitions": [
        {"from": "draft", "to": "published", "action": "publish", "capability": "local/jobboard:publishvacancy"},
        {"from": "published", "to": "closed", "action": "close", "triggers": ["manual", "closedate_reached"]},
        {"from": "closed", "to": "published", "action": "reopen", "capability": "local/jobboard:editvacancy"},
        {"from": "closed", "to": "assigned", "action": "assign", "description": "All positions filled"}
      ],
      "flow": [
        {
          "step": 1,
          "name": "Create Convocatoria",
          "description": "Admin creates convocatoria with dates, terms, and PDF",
          "actor": "Manager"
        },
        {
          "step": 2,
          "name": "Create Vacancies",
          "description": "Add vacancies to convocatoria with requirements",
          "actor": "Manager/Coordinator"
        },
        {
          "step": 3,
          "name": "Open Convocatoria",
          "description": "Change status to 'open', vacancies inherit publicationtype and become published",
          "actor": "Manager"
        },
        {
          "step": 4,
          "name": "Close",
          "description": "Manual close or automatic via scheduled task when enddate reached",
          "actor": "System/Manager"
        }
      ]
    },
    "application_workflow": {
      "description": "Job application lifecycle from submission to selection",
      "states": {
        "submitted": "Initial state after applicant submits",
        "under_review": "Documents being reviewed by assigned reviewer",
        "docs_validated": "All documents approved",
        "docs_rejected": "One or more documents rejected (can be corrected)",
        "interview": "Scheduled for interview",
        "selected": "Applicant selected for position",
        "rejected": "Application rejected",
        "withdrawn": "Applicant withdrew application"
      },
      "transitions": [
        {"from": "submitted", "to": "under_review", "action": "start_review"},
        {"from": "submitted", "to": "rejected", "action": "reject"},
        {"from": "under_review", "to": "docs_validated", "action": "validate_all_docs"},
        {"from": "under_review", "to": "docs_rejected", "action": "reject_document"},
        {"from": "docs_rejected", "to": "under_review", "action": "reupload_document"},
        {"from": "docs_validated", "to": "interview", "action": "schedule_interview"},
        {"from": "docs_validated", "to": "rejected", "action": "reject"},
        {"from": "interview", "to": "selected", "action": "select"},
        {"from": "interview", "to": "rejected", "action": "reject"}
      ],
      "flow": [
        {
          "step": 1,
          "name": "Browse & Apply",
          "description": "Applicant browses convocatorias, selects vacancy, uploads required documents",
          "actor": "Applicant",
          "checks": ["convocatoria_open", "not_already_applied", "application_limit"]
        },
        {
          "step": 2,
          "name": "Document Submission",
          "description": "Upload all required documents based on profile (gender, age exemptions)",
          "actor": "Applicant",
          "documents_filtered_by": ["gender_condition", "age_exemption_threshold", "iser_exemption"]
        },
        {
          "step": 3,
          "name": "Consent & Submit",
          "description": "Accept terms, provide digital signature, submit application",
          "actor": "Applicant",
          "records": ["consent_timestamp", "ip_address", "user_agent", "digital_signature"]
        },
        {
          "step": 4,
          "name": "Reviewer Assignment",
          "description": "Application assigned to reviewer based on program",
          "actor": "Coordinator"
        },
        {
          "step": 5,
          "name": "Document Review",
          "description": "Reviewer validates each document against checklist",
          "actor": "Reviewer",
          "actions": ["approve", "reject_with_reason", "add_observations"]
        },
        {
          "step": 6,
          "name": "Correction Cycle",
          "description": "If documents rejected, applicant can reupload, reviewer re-validates",
          "actor": "Applicant/Reviewer",
          "documents_superseded": true
        },
        {
          "step": 7,
          "name": "Interview (optional)",
          "description": "Schedule and conduct interview if required",
          "actor": "Interview Panel",
          "records": ["rating", "feedback", "recommendation"]
        },
        {
          "step": 8,
          "name": "Final Decision",
          "description": "Select or reject applicant",
          "actor": "HR/Manager"
        }
      ]
    },
    "document_validation_workflow": {
      "description": "Individual document validation process",
      "states": ["pending", "approved", "rejected"],
      "transitions": [
        {"from": "pending", "to": "approved", "action": "validate"},
        {"from": "pending", "to": "rejected", "action": "reject_with_reason"},
        {"from": "rejected", "to": "pending", "action": "reupload", "creates_new_document": true}
      ],
      "validation_criteria": {
        "issue_date": "Document not older than maxagedays",
        "format": "PDF only by default",
        "size": "Configurable max file size",
        "checklist": "Doctype-specific validation checklist items"
      }
    },
    "dean_hr_review_workflow": {
      "description": "Two-phase review by Faculty Dean and HR",
      "phases": [
        {
          "name": "Dean Review",
          "period": "dean_review_startdate to dean_review_enddate",
          "capability": "local/jobboard:approveprofile",
          "actions": ["review_profile", "add_observations", "approve", "reject"]
        },
        {
          "name": "HR Validation",
          "period": "hr_review_startdate to hr_review_enddate",
          "capability": "local/jobboard:validatehr",
          "actions": ["final_validation", "approve", "reject"]
        }
      ]
    }
  },
  "custom_roles": {
    "jobboard_reviewer": {
      "description": "Document reviewer for applications",
