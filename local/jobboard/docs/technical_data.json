          "ACTION_EMAIL_SENT",
          "ACTION_UPLOAD",
          "ACTION_APPROVE",
          "ACTION_REVOKE",
          "ACTION_ASSIGN",
          "ACTION_PUBLISH",
          "ACTION_CLOSE",
          "ACTION_REUPLOAD",
          "ACTION_IMPORT"
