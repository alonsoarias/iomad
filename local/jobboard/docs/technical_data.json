            {"name": "oldvalue", "type": "mixed"},
            {"name": "newvalue", "type": "mixed"},
            {"name": "extradata", "type": "array"}
          ],
          "returns": "int|bool",
          "description": "Log state transition with field change tracking"
        },
        {
          "name": "log_email",
          "visibility": "public static",
          "params": [
            {"name": "templatekey", "type": "string"},
