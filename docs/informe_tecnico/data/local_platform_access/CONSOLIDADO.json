  "optimizaciones_rendimiento": {
    "tecnicas": [
      {
        "nombre": "Buffering masivo",
        "descripcion": "Acumulación de 500 registros antes de INSERT",
        "impacto": "Reduce queries de N a N/500"
      },
      {
        "nombre": "Pre-carga de enrollments",
        "descripcion": "Una sola query para todas las matriculaciones",
        "impacto": "Evita N queries por usuario"
      },
      {
        "nombre": "Cache de contextos",
        "descripcion": "Almacena contextos en memoria para reutilización",
        "impacto": "Evita llamadas repetidas a context::instance()"
      },
      {
        "nombre": "TRUNCATE vs DELETE",
        "descripcion": "Usa TRUNCATE para limpieza completa de tablas",
        "impacto": "10-100x más rápido que DELETE"
      },
      {
        "nombre": "Verificación cacheada de tablas",
        "descripcion": "Verifica existencia de tablas opcionales una sola vez",
        "impacto": "Evita queries repetidas a información del esquema"
      },
      {
        "nombre": "Construcción directa de eventos",
        "descripcion": "Crea arrays de log sin instanciar eventos Moodle",
        "impacto": "Evita overhead de clases de eventos"
      }
    ],
    "constantes": {
      "BATCH_SIZE": 500,
      "memoria": "MEMORY_HUGE",
      "tiempo": "ilimitado (0)"
    }
  },

