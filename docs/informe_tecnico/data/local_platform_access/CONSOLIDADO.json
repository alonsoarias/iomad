{
  "plugin": "local_platform_access",
  "nombre_completo": "Platform Access Generator",
  "tipo": "local",
  "fecha_analisis": "2025-12-30",

  "resumen_ejecutivo": {
    "proposito": "Plugin para generar registros de acceso ficticios a la plataforma Moodle/IOMAD, incluyendo inicios de sesión, accesos a cursos, actividades y eventos relacionados. Útil para pruebas, desarrollo y análisis de reportes.",
    "arquitectura": "Diseño moderno con clases orientadas a objetos, sin lib.php, optimizado para inserciones masivas en base de datos",
    "caracteristicas_principales": [
      "Generación masiva de registros de acceso con buffering",
      "Soporte multi-empresa (IOMAD)",
      "Configuración flexible por formulario web",
      "Optimización con inserciones en lotes de 500 registros",
      "Sistema de caching para contextos y matriculaciones",
      "Limpieza opcional de registros existentes con TRUNCATE",
      "Generación de eventos avanzados (dashboard, logout, completions)",
      "Barra de progreso para procesos largos",
      "Estadísticas detalladas post-generación"
    ],
    "estado_desarrollo": "Stable (MATURITY_STABLE)",
    "integracion_iomad": "Totalmente integrado con sistema multi-empresa de IOMAD"
  },

  "version": {
    "version_numerica": "2025112904",
    "release": "2.1.0 (Build: 20251129)",
    "requires": "2024100700",
    "maturity": "MATURITY_STABLE",
    "copyright": "2024 IOMAD",
    "licencia": "GNU GPL v3 or later"
  },

  "base_datos": {
    "tiene_tablas_propias": false,
    "tablas_estandar_utilizadas": [
      {
        "tabla": "logstore_standard_log",
        "operacion": "INSERT masivo",
        "proposito": "Registros de eventos de log (logins, vistas de cursos, actividades, etc.)"
      },
      {
        "tabla": "user",
        "operacion": "UPDATE",
        "proposito": "Actualización de campos de acceso (firstaccess, lastaccess, lastlogin, currentlogin, lastip, timecreated)"
      },
      {
        "tabla": "user_lastaccess",
        "operacion": "INSERT/UPDATE",
        "proposito": "Último acceso de usuarios a cursos específicos"
      },
      {
        "tabla": "course_modules_completion",
        "operacion": "INSERT masivo",
        "proposito": "Estado de finalización de actividades"
      },
      {
        "tabla": "course_modules_viewed",
        "operacion": "INSERT masivo",
        "proposito": "Registro de visualizaciones de módulos (si tabla existe)"
      },
      {
        "tabla": "course_completions",
        "operacion": "INSERT",
        "proposito": "Finalizaciones de cursos"
      }
    ],
    "tablas_iomad_utilizadas": [
      {
        "tabla": "company",
        "operacion": "SELECT",
        "proposito": "Obtener lista de empresas"
      },
      {
        "tabla": "company_users",
        "operacion": "SELECT",
        "proposito": "Relación usuarios-empresas"
      },
      {
        "tabla": "company_course",
        "operacion": "SELECT",
        "proposito": "Relación cursos-empresas"
      },
      {
        "tabla": "local_report_user_logins",
        "operacion": "INSERT/UPDATE",
        "proposito": "Estadísticas de inicio de sesión (si existe)"
      }
    ],
    "operaciones_limpieza": [
      "TRUNCATE logstore_standard_log",
      "TRUNCATE user_lastaccess",
      "TRUNCATE course_modules_completion",
      "TRUNCATE course_completions",
      "TRUNCATE local_report_user_logins (si existe)",
      "TRUNCATE course_modules_viewed (si existe)",
      "UPDATE user SET firstaccess=0, lastaccess=0, lastlogin=0, currentlogin=0, lastip='' (usuarios seleccionados)"
    ]
  },

  "capacidades": {
    "total": 2,
    "lista": [
      {
        "nombre": "local/platform_access:generate",
        "tipo": "write",
        "nivel": "CONTEXT_SYSTEM",
        "riesgos": ["RISK_CONFIG", "RISK_DATALOSS"],
        "proposito": "Permite generar y limpiar registros de acceso",
        "roles_por_defecto": ["manager"]
      },
      {
        "nombre": "local/platform_access:view",
        "tipo": "read",
        "nivel": "CONTEXT_SYSTEM",
        "riesgos": ["RISK_PERSONAL"],
        "proposito": "Permite ver la interfaz del generador",
        "roles_por_defecto": ["manager"]
      }
    ]
  },

  "arquitectura": {
    "clases": [
      {
        "nombre": "generator",
        "namespace": "local_platform_access",
        "tipo": "Servicio principal",
        "responsabilidad": "Generación masiva de registros con optimizaciones de rendimiento",
        "metodos_publicos_clave": [
          "get_users(): Obtiene usuarios a procesar",
          "run(callable $callback): Ejecuta generación completa",
          "get_stats(): Retorna estadísticas",
          "clean_existing_records(array $users): Limpia registros existentes",
          "get_companies(): Obtiene lista de empresas (estático)"
        ],
        "optimizaciones": [
          "Buffering con lotes de 500 registros",
          "Pre-carga de matriculaciones en memoria",
          "Cache de contextos (course, module, user)",
          "Uso de TRUNCATE para limpieza rápida",
          "Verificación cacheada de existencia de tablas"
        ]
      },
      {
        "nombre": "generate_form",
        "namespace": "local_platform_access\\form",
        "tipo": "Formulario Moodle",
        "responsabilidad": "Interfaz de configuración de generación",
        "secciones": [
          "General Options",
          "User Settings",
          "Date Range",
          "Access Counts",
          "Advanced Events"
        ]
      },
      {
        "nombre": "provider",
        "namespace": "local_platform_access\\privacy",
        "tipo": "Proveedor de privacidad",
        "responsabilidad": "Cumplimiento GDPR - declara que no almacena datos personales propios"
      }
    ],
    "sin_lib_php": true,
    "sin_templates_mustache": true,
    "patron_diseno": "Generador con buffer pattern y cache pattern"
  },

  "paginas_interfaz": [
    {
