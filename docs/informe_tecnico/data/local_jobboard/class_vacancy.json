      "descripcion": "ID único de la vacante"
    },
    {
      "nombre": "code",
      "tipo": "string",
      "descripcion": "Código único de la vacante (generado automáticamente)"
    },
    {
      "nombre": "title",
      "tipo": "string",
      "descripcion": "Título de la vacante"
    },
    {
      "nombre": "description",
      "tipo": "string",
      "descripcion": "Descripción completa de la vacante"
    },
    {
      "nombre": "requirements",
      "tipo": "string",
      "descripcion": "Requisitos para aplicar"
    },
    {
      "nombre": "responsibilities",
      "tipo": "string",
      "descripcion": "Responsabilidades del cargo"
    },
    {
      "nombre": "benefits",
      "tipo": "string",
      "descripcion": "Beneficios ofrecidos"
    },
    {
      "nombre": "companyid",
      "tipo": "int",
      "descripcion": "ID de la compañía (IOMAD multi-tenant)"
