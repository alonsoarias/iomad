{
  "clase": "vacancy",
  "namespace": "local_jobboard",
  "archivo": "local/jobboard/classes/vacancy.php",
  "descripcion": "Clase para gestionar vacantes/convocatorias laborales en el sistema",
  "constantes": {
    "estados_vacante": [
      {
        "nombre": "STATUS_DRAFT",
