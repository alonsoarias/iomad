      {
        "nombre": "STATUS_OPEN",
        "valor": "open",
        "descripcion": "Vacante abierta y disponible para postulaciones"
      },
      {
        "nombre": "STATUS_CLOSED",
        "valor": "closed",
        "descripcion": "Vacante cerrada, no acepta más postulaciones"
      },
      {
        "nombre": "STATUS_CANCELLED",
        "valor": "cancelled",
        "descripcion": "Vacante cancelada"
      },
      {
        "nombre": "STATUS_FILLED",
        "valor": "filled",
        "descripcion": "Vacante completada, posición llenada"
      }
    ],
    "tipos_contrato": [
      {
        "nombre": "CONTRACT_FULLTIME",
        "valor": "fulltime",
        "descripcion": "Contrato a tiempo completo"
      },
      {
        "nombre": "CONTRACT_PARTTIME",
        "valor": "parttime",
        "descripcion": "Contrato a tiempo parcial"
      },
      {
        "nombre": "CONTRACT_TEMPORAL",
        "valor": "temporal",
        "descripcion": "Contrato temporal"
      },
      {
        "nombre": "CONTRACT_PRESTACION",
        "valor": "prestacion_servicios",
        "descripcion": "Prestación de servicios"
      }
    ],
    "visibilidad": [
      {
        "nombre": "VISIBILITY_PUBLIC",
        "valor": "public",
        "descripcion": "Visible para todos los usuarios"
      },
      {
        "nombre": "VISIBILITY_INTERNAL",
        "valor": "internal",
        "descripcion": "Visible solo para usuarios internos de la compañía"
      },
      {
        "nombre": "VISIBILITY_PRIVATE",
        "valor": "private",
        "descripcion": "Visible solo para usuarios específicos"
      }
    ]
