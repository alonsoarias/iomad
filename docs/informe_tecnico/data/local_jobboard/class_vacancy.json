    {
      "nombre": "categoryid",
      "tipo": "int",
      "descripcion": "ID de categoría del curso (programa académico)"
    },
    {
      "nombre": "status",
      "tipo": "string",
      "descripcion": "Estado actual de la vacante"
    },
    {
      "nombre": "contracttype",
      "tipo": "string",
      "descripcion": "Tipo de contrato"
