  "patrones_uso": [
    {
      "flujo": "Creación de postulación",
      "eventos": [
        "vacancy_created -> vacancy_published -> application_created -> document_uploaded"
      ]
    },
    {
      "flujo": "Proceso de revisión",
      "eventos": [
        "application_created -> document_uploaded -> application_status_changed"
      ]
    },
    {
      "flujo": "Cierre de proceso",
      "eventos": [
        "application_status_changed -> vacancy_closed"
      ]
    }
  ],
  "integracion_con_moodle": {
