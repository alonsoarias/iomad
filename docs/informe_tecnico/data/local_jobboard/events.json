{
  "descripcion": "Eventos del sistema disparados por el plugin local_jobboard",
  "eventos": [
    {
      "nombre": "application_created",
      "clase": "local_jobboard\\event\\application_created",
      "descripcion": "Evento disparado cuando se crea una nueva aplicación/postulación",
      "tipo_accion": "create",
      "nivel_educativo": "LEVEL_PARTICIPATING",
      "tabla_bd": "local_jobboard_application",
      "datos_contenidos": [
        {
          "campo": "objectid",
          "descripcion": "ID de la aplicación creada"
        },
        {
          "campo": "relateduserid",
          "descripcion": "ID del usuario que creó la aplicación (postulante)"
        },
        {
          "campo": "other['vacancyid']",
          "descripcion": "ID de la vacante a la que se postula"
        }
      ],
      "disparado_por": [
        "Creación de una nueva postulación a una vacante"
      ],
      "url_relacionada": "/local/jobboard/index.php?view=application&id={objectid}"
    },
    {
      "nombre": "application_deleted",
      "clase": "local_jobboard\\event\\application_deleted",
      "descripcion": "Evento disparado cuando se elimina una aplicación",
      "tipo_accion": "delete",
      "nivel_educativo": "LEVEL_OTHER",
      "tabla_bd": "local_jobboard_application",
      "datos_contenidos": [
        {
          "campo": "objectid",
          "descripcion": "ID de la aplicación eliminada"
        },
        {
          "campo": "userid",
          "descripcion": "ID del usuario que eliminó la aplicación"
        },
        {
          "campo": "other['vacancyid']",
          "descripcion": "ID de la vacante asociada"
        },
        {
          "campo": "other['applicantuserid']",
          "descripcion": "ID del usuario postulante"
        },
        {
          "campo": "other['reason']",
          "descripcion": "Razón de la eliminación (opcional)"
        }
      ],
      "disparado_por": [
        "Eliminación de una aplicación por parte de un administrador o usuario con permisos"
      ],
      "url_relacionada": "/local/jobboard/index.php?view=review"
    },
    {
      "nombre": "application_status_changed",
      "clase": "local_jobboard\\event\\application_status_changed",
      "descripcion": "Evento disparado cuando cambia el estado de una aplicación",
      "tipo_accion": "update",
      "nivel_educativo": "LEVEL_PARTICIPATING",
      "tabla_bd": "local_jobboard_application",
      "datos_contenidos": [
        {
          "campo": "objectid",
          "descripcion": "ID de la aplicación"
        },
        {
          "campo": "other['oldstatus']",
          "descripcion": "Estado anterior de la aplicación"
        },
        {
          "campo": "other['newstatus']",
          "descripcion": "Nuevo estado de la aplicación"
        }
      ],
      "disparado_por": [
        "Cambio de estado de una aplicación (ej: pending -> approved, pending -> rejected)"
      ],
      "url_relacionada": "/local/jobboard/index.php?view=application&id={objectid}",
      "estados_posibles": [
        "pending",
        "approved",
        "rejected",
        "shortlisted",
        "interview",
        "hired"
      ]
    },
    {
      "nombre": "document_uploaded",
      "clase": "local_jobboard\\event\\document_uploaded",
      "descripcion": "Evento disparado cuando se sube un documento a una aplicación",
      "tipo_accion": "create",
      "nivel_educativo": "LEVEL_PARTICIPATING",
      "tabla_bd": "local_jobboard_document",
      "datos_contenidos": [
        {
          "campo": "objectid",
          "descripcion": "ID del documento subido"
        },
        {
          "campo": "other['documenttype']",
          "descripcion": "Tipo de documento subido"
        },
        {
          "campo": "other['applicationid']",
          "descripcion": "ID de la aplicación asociada"
        }
      ],
      "disparado_por": [
        "Subida de un documento requerido por parte del postulante"
      ],
      "tipos_documento": [
        "CV",
        "Carta de presentación",
        "Certificados",
        "Diplomas",
        "Referencias"
      ]
    },
    {
      "nombre": "vacancy_closed",
      "clase": "local_jobboard\\event\\vacancy_closed",
      "descripcion": "Evento disparado cuando se cierra una vacante",
